            '    double-click title  maximize / restore',
            '    F7                  move with the arrow keys',
            '    F8                  resize with the arrow keys',
            '    F9                  maximize / restore',
            '    [X] [^]             close / maximize buttons',
            '    taskbar             click a window to raise it',
