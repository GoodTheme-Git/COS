            '  RENDERERS AsciiPic/AsciiVid in-window, or ffplay full-screen.',
            '  TOOLS     files, editor, calculator, monitor, processes,',
            '            clock, server wizard.',
            '',
            '  "The channel is always open."',
            '',
        ], w=66))
    elif action == 'help':
        wm.open(TextWindow('COS Help', [
            '  GETTING AROUND',
            '    F10 or Alt+letter   open a menu (F E A C S W P H)',
            '    bare letter         opens a menu when no window is focused',
            '    TAB / Shift-TAB     next / previous window',
            '    ^W                  close the focused window',
            '    ^Q                  quit COS',
            '    F1                  this help',
            '',
            '  WINDOWS',
            '    drag the title bar  move (shows a wireframe, then teleports)',
