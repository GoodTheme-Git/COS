#!/usr/bin/env python3
"""
COS - Channel Operating System  "Druman"
TTY-native desktop shell.  Part of TCF (The Coloradan Financial).

New in v3.0
-----------
  * Direct trackpad support via raw Linux evdev (/dev/input/eventN).
    Works in a bare TTY with no X, no gpm, no mouse. Tap-to-click,
    two-finger scroll, two-finger right-click, clickpad press.
  * Real window manager: overlapping windows, z-order, focus, taskbar,
    desktop icons, maximize, and Windows-2000-style OUTLINE DRAG
    (drag shows a wireframe; the window teleports on release).
  * Sound engine. Synthesizes its own WAV set on first run and plays
    notification blips through pw-play / aplay / ffplay.
  * Druman -- the COS music AND VIDEO player (drum + man = druman).
    Video is decoded by ffmpeg and rendered into character cells, so it
    plays inside its window on a bare console with no framebuffer access.
  * Image viewer, built on the same cell renderer. Zoom, pan, rotate.
  * Either renderer, per preference: AsciiPic/AsciiVid in the window, or
    hand the screen to ffplay. COS puts the console into KD_GRAPHICS for
    the latter, which fixes the classic blank-until-you-switch-VT bug.
  * Quality settings including inter-cell dithering, a frame-rate cap, and
    pre-rendering a whole video before playback. Cell aspect ratio is
    measured from the panel size, and console fonts can be switched to
    give the renderer more cells.
  * Webinator -- a text-mode web browser with its own HTML renderer.
  * A customisable desktop: 14 wallpaper patterns, independent colours,
    ANSI-art banners (it will happily use your own cos.txt), icon
    layouts, and twelve pointer shapes including console-style invert.
  * Better tools: real file manager (copy/move/delete/rename/exec),
    text editor, scientific calculator, live system monitor,
    process manager with kill, disk/network panels.

Usage
-----
  python3 'cos(10).py'                  start COS
  python3 'cos(10).py' --grant-input   add yourself to the 'input' group
  python3 'cos(10).py' --test-input    raw trackpad event dump
  python3 'cos(10).py' --test-sound     synthesize + play the sound set
  COS_SILENT=1 python3 'cos(10).py'     start with all sound suppressed
  python3 'cos(10).py' --mouse-bridge <dev>   internal: sudo pointer helper
"""

import curses, os, sys, subprocess, platform, shlex, random, math
import json, time, struct, threading, select, wave, array, errno, signal, shutil
import termios, fcntl, atexit
from collections import deque
from datetime import datetime

VERSION = '3.2'
CODENAME = 'Druman'

# COS_SILENT=1 starts COS with every sound suppressed, whatever the config
# says. Useful for testing, and for not waking the house.
# This gates every sound COS can make: notification blips, Druman playback,
# and the audio track of a video. "Silent" has to mean silent, or a stray
# keypress can blast whoever is wearing headphones.
SILENT = os.environ.get('COS_SILENT', '') not in ('', '0', 'no', 'false')

COS_HOME     = os.path.expanduser('~/.cos')
COS_CONFIG   = os.path.expanduser('~/.cos_config')
SOUND_DIR    = os.path.join(COS_HOME, 'sounds')        # drop your own here
BUILTIN_DIR  = os.path.join(SOUND_DIR, 'builtin')      # COS's synthesized tones
DRUMAN_STATE = os.path.join(COS_HOME, 'druman.json')

# =============================================================================
# COLOR PAIRS
# =============================================================================
CP_MENUBAR, CP_MENU_SEL, CP_DESKTOP, CP_WINDOW, CP_WIN_TITLE = 1, 2, 3, 4, 5
CP_STATUS, CP_CURSOR, CP_TEXT, CP_BRIGHT, CP_SHADOW          = 6, 7, 8, 9, 10
CP_INPUT, CP_WARN, CP_GREEN                                  = 11, 12, 13
CP_TITLE_IDLE, CP_ICON, CP_TASKBAR, CP_TASK_ON               = 14, 15, 16, 17
CP_OUTLINE, CP_METER, CP_ACCENT, CP_SCROLL, CP_SEL           = 18, 19, 20, 21, 22

# A Linux console gives 8 colours and 64 colour pairs. The UI uses 1..22, so
# media rendering gets a block of 28: every unordered pair of the 8 colours.
# Combined with a density ramp and A_BOLD that is over a thousand distinct
# tones, which is enough to recognise a photograph.
BACKEND_LABELS = {
    'ascii':  'COS AsciiPic / AsciiVid',
    'ffplay': 'FFplay (full graphics)',
}

MEDIA_PAIR_BASE = 24
MEDIA_COMBOS = [(a, b) for a in range(8) for b in range(a + 1, 8)]   # 28

C = curses

THEMES = [
    # name                          menu          desktop        window        title          accent
    ('COS Classic (Blue/Cyan)',  (0, 6),       (6, 4),        (7, 0),       (0, 7),        3),
    ('Night Mode (Black/Green)', (2, 0),       (2, 0),        (2, 0),       (0, 2),        2),
    ('Retro Amber (Amber/Black)',(0, 3),       (3, 0),        (3, 0),       (0, 3),        3),
    ('High Contrast (Mono)',     (0, 7),       (7, 0),        (7, 0),       (0, 7),        7),
    ('TCF Blue (Blue/White)',    (7, 4),       (4, 7),        (7, 4),       (4, 7),        6),
    ('Magenta Dream',            (0, 5),       (5, 0),        (7, 0),       (0, 5),        5),
    ('Deep Sea (Cyan/Blue)',     (7, 4),       (4, 0),        (6, 4),       (4, 6),        6),
]
THEME_NAMES = [t[0] for t in THEMES]

# Linux console fonts carry only 256 glyphs, so wallpapers stay ASCII (or use
# a curses ACS glyph, signalled by returning None). Each entry is
# (name, cell function); the function takes the cell position plus a scale
# and returns the character for that cell.
def _wp_solid(x, y, s):   return ' '
def _wp_fine(x, y, s):    return '.'
def _wp_dots(x, y, s):    return '.' if (x % s == 0 and y % max(1, s // 2) == 0) else ' '
def _wp_grid(x, y, s):    return '+' if (x % s == 0 or y % max(1, s // 2) == 0) else ' '
def _wp_weave(x, y, s):   return ':' if ((x + y) % s == 0) else ' '
def _wp_diag(x, y, s):    return '/' if ((x + y) % s == 0) else ' '
def _wp_back(x, y, s):    return '\\' if ((x - y) % s == 0) else ' '
def _wp_cross(x, y, s):   return 'x' if ((x + y) % s == 0 or (x - y) % s == 0) else ' '
def _wp_stars(x, y, s):   return '*' if ((x * 7 + y * 13) % (s * 3) == 0) else ' '
def _wp_tilde(x, y, s):   return '~'
def _wp_stipple(x, y, s): return None
def _wp_checker(x, y, s): return None if (((x // s) + (y // max(1, s // 2))) % 2 == 0) else ' '

def _wp_bricks(x, y, s):
    h = max(2, s // 2)
    if y % h == 0:
        return '-'
    return '|' if ((x + (y // h) * (s // 2)) % s == 0) else ' '

def _wp_waves(x, y, s):
    return '~' if int(2.0 * math.sin(x / max(2.0, s / 2.0))) == (y % 5) - 2 else ' '

WALLPAPERS = [
    ('Solid',     _wp_solid),
    ('Dots fine', _wp_fine),
    ('Dots wide', _wp_dots),
    ('Grid',      _wp_grid),
    ('Weave',     _wp_weave),
    ('Diagonal',  _wp_diag),
    ('Backslash', _wp_back),
    ('Crosses',   _wp_cross),
    ('Stars',     _wp_stars),
    ('Tilde',     _wp_tilde),
    ('Stipple',   _wp_stipple),
    ('Checker',   _wp_checker),
    ('Bricks',    _wp_bricks),
    ('Waves',     _wp_waves),
]


def wallpaper_rows(idx, scale, cols, rows):
    """Render one screenful of wallpaper: [(text, [acs column indexes])]."""
    _name, fn = WALLPAPERS[idx % len(WALLPAPERS)]
    scale = max(2, int(scale))
    out = []
    for y in range(rows):
        chars = []
        acs = []
        for x in range(cols):
            ch = fn(x, y, scale)
            if ch is None:
                acs.append(x)
                chars.append(' ')
            else:
                chars.append(ch)
        out.append((''.join(chars), acs))
    return out


# -- ANSI art -------------------------------------------------------------
def parse_ansi_art(text, max_w=240, max_h=80):
    """Parse SGR-coloured text art into rows of (char, fg, bg, bold).

    COS already ships its logo this way (cos.txt), so the desktop can use
    any such file as its banner.
    """
    import re as _re
    rows = []
    fg, bg, bold = 7, 0, False
    for line in text.split('\n')[:max_h]:
        cells = []
        i = 0
        while i < len(line) and len(cells) < max_w:
            mm = _re.match(r'\x1b\[([0-9;]*)m', line[i:])
            if mm:
                for part in (mm.group(1) or '0').split(';'):
                    if part in ('', '0'):
                        fg, bg, bold = 7, 0, False
                    elif part == '1':
                        bold = True
                    elif part == '22':
                        bold = False
                    elif part.isdigit():
                        n = int(part)
                        if 30 <= n <= 37:     fg = n - 30
                        elif 40 <= n <= 47:   bg = n - 40
                        elif 90 <= n <= 97:   fg, bold = n - 90, True
                        elif 100 <= n <= 107: bg = n - 100
                        elif n == 39:         fg = 7
                        elif n == 49:         bg = 0
                i += mm.end()
                continue
            ch = line[i]
            i += 1
            if ch in '\r\x1b':
                continue
            cells.append((ch, fg, bg, bold))
        rows.append(cells)
    while rows and not any(c[0].strip() for c in rows[-1]):
        rows.pop()
    while rows and not any(c[0].strip() for c in rows[0]):
        rows.pop(0)
    return rows


def load_ansi_art(path):
    try:
        with open(os.path.expanduser(path), 'r', errors='replace') as f:
            return parse_ansi_art(f.read())
    except OSError:
        return []


def init_colors():
    curses.start_color()
    try: curses.use_default_colors()
    except curses.error: pass
    apply_theme(0)
    init_media_pairs()


def apply_theme(idx):
    if not (0 <= idx < len(THEMES)):
        idx = 0
    _, (mf, mb), (df, db), (wf, wb), (tf, tb), ac = THEMES[idx]
    P = curses.init_pair
    try:
        P(CP_MENUBAR,    mf, mb)
        P(CP_MENU_SEL,   tb, tf)
        P(CP_DESKTOP,    df, db)
        P(CP_WINDOW,     wf, wb)
        P(CP_WIN_TITLE,  tf, tb)
        P(CP_STATUS,     mf, mb)
        P(CP_CURSOR,     0,  3)
        P(CP_TEXT,       wf, wb)
        P(CP_BRIGHT,     ac, wb)
        P(CP_SHADOW,     db if db != wb else 0, wb)
        P(CP_INPUT,      wb, wf)
        P(CP_WARN,       1,  wb)
        P(CP_GREEN,      2,  wb)
        P(CP_TITLE_IDLE, wf, db if db != wb else 0)
        P(CP_ICON,       ac, db)
        P(CP_TASKBAR,    mf, mb)
        P(CP_TASK_ON,    mb, mf)
        P(CP_OUTLINE,    7,  db)
        P(CP_METER,      ac, wb)
        P(CP_ACCENT,     ac, db)
        P(CP_SCROLL,     wf, wb)
        P(CP_SEL,        tb, tf)
    except (curses.error, ValueError):
        # colours are not available yet (or not at all); keep the defaults
        pass


def init_media_pairs():
    for i, (a, b) in enumerate(MEDIA_COMBOS):
        try:
            curses.init_pair(MEDIA_PAIR_BASE + i, b, a)
        except curses.error:
            return i
    return len(MEDIA_COMBOS)


def media_attr(fg, bg, bold=False):
    """An attribute for an arbitrary fg/bg pair, out of the media pair block.

    The 28 media pairs cover every unordered pair of the eight colours, so
    any combination is reachable -- reversed when the pair happens to hold
    the two colours the other way round.
    """
    fg &= 7
    bg &= 7
    extra = curses.A_BOLD if bold else 0
    if fg == bg:
        # a flat field of one colour: draw a space over that background
        if bg < 7:
            i = MEDIA_COMBOS.index((bg, bg + 1))
            return curses.color_pair(MEDIA_PAIR_BASE + i) | extra
        i = MEDIA_COMBOS.index((6, 7))
        return curses.color_pair(MEDIA_PAIR_BASE + i) | curses.A_REVERSE | extra
    lo, hi = (fg, bg) if fg < bg else (bg, fg)
    i = MEDIA_COMBOS.index((lo, hi))
    attr = curses.color_pair(MEDIA_PAIR_BASE + i) | extra
    if fg == lo:                    # pair renders hi on lo; we want the swap
        attr |= curses.A_REVERSE
    return attr


def cp(n, bold=False, dim=False, rev=False):
    a = curses.color_pair(n)
    if bold: a |= curses.A_BOLD
    if dim:  a |= curses.A_DIM
    if rev:  a |= curses.A_REVERSE
    return a


