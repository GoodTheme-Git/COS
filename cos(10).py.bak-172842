def load_config(state):
    for k, v in DEFAULTS.items():
        state.setdefault(k, v.copy() if isinstance(v, list) else v)
    if not os.path.exists(COS_CONFIG):
        return
    try:
        with open(COS_CONFIG) as f:
            cfg = json.load(f)
    except Exception as e:
        state['messages'].append(f'[COS] Config load error: {e}')
        return
    legacy = 'wallpaper_scale' not in cfg      # written before v3.1
    for k in DEFAULTS:
        if k in cfg:
            state[k] = cfg[k]
    if legacy and 'wallpaper_idx' in cfg:
        # the pattern list was reordered and extended in v3.1
        state['wallpaper_idx'] = {0: 1, 1: 0, 2: 3, 3: 4, 4: 10,
                                  5: 9, 6: 8}.get(int(cfg['wallpaper_idx']), 1)
    # legacy keys from cos_setup.py
    if 'desktop_fill' in cfg:
        state['pref_dots'] = cfg['desktop_fill'] != ' '
    state['theme_idx'] = int(state.get('theme_idx', 0))
    apply_theme(state['theme_idx'])
    if cfg.get('node_name'):
        state['messages'].append(
            f'[COS] Node: {cfg["node_name"]}  Role: {cfg.get("role","?")}  '
            f'Conn: {cfg.get("conn_type","?")}')


def save_config(state):
    cfg = {k: state.get(k, DEFAULTS[k]) for k in DEFAULTS}
    try:
        os.makedirs(COS_HOME, exist_ok=True)
        with open(COS_CONFIG, 'w') as f:
            json.dump(cfg, f, indent=2)
        return True
    except Exception:
        return False


# =============================================================================
# SOUND ENGINE
# =============================================================================
RATE = 22050

def _env(i, n, attack=0.01, release=0.25):
    """Attack/release envelope so tones don't click."""
    a = max(1, int(n * attack))
    r = max(1, int(n * release))
    if i < a:
        return i / a
    if i > n - r:
        return max(0.0, (n - i) / r)
    return 1.0


def _render(spec, rate=RATE):
    """spec = list of (freq_or_None, seconds, amplitude, wave_kind)."""
    buf = array.array('h')
    for freq, dur, amp, kind in spec:
        n = int(rate * dur)
        for i in range(n):
            t = i / rate
            if freq is None:
                s = 0.0
            elif kind == 'sine':
                s = math.sin(2 * math.pi * freq * t)
            elif kind == 'square':
                s = 1.0 if (freq * t) % 1.0 < 0.5 else -1.0
            elif kind == 'saw':
                s = 2.0 * ((freq * t) % 1.0) - 1.0
            elif kind == 'tri':
                p = (freq * t) % 1.0
                s = 4 * p - 1 if p < 0.5 else 3 - 4 * p
            elif kind == 'noise':
                s = random.uniform(-1, 1)
            else:
                s = math.sin(2 * math.pi * freq * t)
            v = s * amp * _env(i, n)
            buf.append(max(-32767, min(32767, int(v * 32767))))
    return buf


# Each entry: list of (freq, duration, amplitude, waveform)
SOUND_SPECS = {
    'boot':     [(392, .10, .30, 'tri'), (523, .10, .30, 'tri'),
                 (659, .10, .30, 'tri'), (784, .22, .34, 'tri')],
    'click':    [(1800, .012, .16, 'square'), (None, .006, 0, 'sine'),
                 (900, .018, .10, 'square')],
    'menu':     [(1200, .030, .16, 'tri')],
    'open':     [(440, .040, .20, 'tri'), (660, .045, .20, 'tri')],
    'close':    [(660, .040, .18, 'tri'), (415, .050, .18, 'tri')],
    'notify':   [(880, .090, .26, 'sine'), (1174, .150, .26, 'sine')],
    'error':    [(220, .110, .28, 'square'), (None, .030, 0, 'sine'),
                 (185, .180, .28, 'square')],
    'warn':     [(330, .080, .22, 'saw'), (294, .140, .22, 'saw')],
    'drop':     [(520, .025, .18, 'square'), (300, .035, .16, 'square')],
    'key':      [(2400, .008, .07, 'square')],
    'shutdown': [(784, .12, .30, 'tri'), (587, .12, .30, 'tri'),
                 (392, .30, .32, 'tri')],
    'coin':     [(988, .06, .22, 'square'), (1319, .20, .22, 'square')],
}


class SoundEngine:
    """Synthesizes a WAV set once, then fires them off as detached processes."""

    BACKENDS = [
        ('pw-play',  lambda p, v: ['pw-play', '--volume', f'{v/100:.2f}', p]),
        ('aplay',    lambda p, v: ['aplay', '-q', p]),
        ('ffplay',   lambda p, v: ['ffplay', '-nodisp', '-autoexit',
                                   '-loglevel', 'quiet', '-volume', str(v), p]),
        ('paplay',   lambda p, v: ['paplay', p]),
    ]

    # No sound may repeat faster than this, and no more than BURST_MAX may
    # start inside BURST_WINDOW. A runaway caller should never be able to turn
    # the speakers into a wall of noise.
    REPEAT_GAP = 0.12
    BURST_WINDOW = 1.0
    BURST_MAX = 8

    def __init__(self, state):
        self.state = state
        self.backend = None
        self.builder = None
        self.procs = []
        self.ready = False
        self.note = 'not initialized'
        self._last_played = {}
        self._recent = deque(maxlen=self.BURST_MAX)

    # -- synthesis ----------------------------------------------------------
    def ensure_sounds(self, force=False):
        try:
            os.makedirs(BUILTIN_DIR, exist_ok=True)
        except Exception as e:
            self.note = f'cannot create {BUILTIN_DIR}: {e}'
            return False
        made = 0
        for name, spec in SOUND_SPECS.items():
            path = os.path.join(BUILTIN_DIR, name + '.wav')
            if force or not os.path.exists(path):
                try:
                    data = _render(spec)
                    with wave.open(path, 'wb') as w:
                        w.setnchannels(1)
                        w.setsampwidth(2)
                        w.setframerate(RATE)
                        w.writeframes(data.tobytes())
                    made += 1
                except Exception as e:
                    self.note = f'synth failed for {name}: {e}'
                    return False
        if made:
            self.note = f'synthesized {made} sound(s)'
        return True

    # -- backend selection --------------------------------------------------
    def pick_backend(self):
        probe = find_sound_file('key')
        if not probe:
            return False
        for name, builder in self.BACKENDS:
            if not _which(name):
                continue
            try:
                r = subprocess.run(builder(probe, 10), timeout=2.5,
                                   stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL)
                if r.returncode == 0:
                    self.backend, self.builder = name, builder
                    self.note = f'backend: {name}'
                    self.ready = True
                    return True
            except Exception:
                continue
        self.note = 'no working audio backend (tried pw-play/aplay/ffplay)'
        return False

    def init(self):
        if self.ensure_sounds():
            self.pick_backend()
        return self.ready

    # -- playback -----------------------------------------------------------
    def play(self, name):
        if SILENT or not (self.ready and self.state.get('sound_on', True)):
            return
        path = find_sound_file(name)
        if not path:
            return
        now = time.monotonic()
        if now - self._last_played.get(name, 0.0) < self.REPEAT_GAP:
            return
        if (len(self._recent) == self.BURST_MAX
                and now - self._recent[0] < self.BURST_WINDOW):
            return
        vol = int(self.state.get('sound_volume', 70))
        try:
            self.procs = [p for p in self.procs if p.poll() is None]
            if len(self.procs) > 6:          # don't let blips pile up
                return
            self._last_played[name] = now
            self._recent.append(now)
            self.procs.append(subprocess.Popen(
                self.builder(path, vol),
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                stdin=subprocess.DEVNULL, start_new_session=True))
        except Exception:
            pass

    def play_blocking(self, name, timeout=3):
        if SILENT:
            return
        path = find_sound_file(name)
        if not (self.ready and path):
            return
        try:
            subprocess.run(self.builder(path, int(self.state.get('sound_volume', 70))),
                           timeout=timeout, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
        except Exception:
            pass

    def shutdown(self):
        for p in self.procs:
            try:
                p.terminate()
            except Exception:
                pass
        for p in self.procs:
            try:
                p.wait(timeout=0.4)     # reap, so no zombies are left behind
            except Exception:
                pass
        self.procs = []


def _which(prog):
    for d in os.environ.get('PATH', '/usr/bin:/bin').split(':'):
        f = os.path.join(d, prog)
        if os.path.isfile(f) and os.access(f, os.X_OK):
            return f
    return None


# =============================================================================
# CELL ART  --  rendering pictures and video into character cells
# =============================================================================
# Approximate sRGB of the Linux console palette, normal and bold.
CONSOLE_RGB = [(0, 0, 0), (170, 0, 0), (0, 170, 0), (170, 85, 0),
               (0, 0, 170), (170, 0, 170), (0, 170, 170), (170, 170, 170)]
BRIGHT_RGB = [(85, 85, 85), (255, 85, 85), (85, 255, 85), (255, 255, 85),
              (85, 85, 255), (255, 85, 255), (85, 255, 255), (255, 255, 255)]

# Glyphs ordered by how much of the cell they ink in, on a typical 8x16
# console font. Plain ASCII only: ACS line-drawing cannot go in an addstr.
RAMP = ' .:;+*%#@M'
RAMP_COVER = (0.00, 0.07, 0.14, 0.20, 0.28, 0.36, 0.46, 0.60, 0.74, 0.86)

PALETTE_CACHE = os.path.join(COS_HOME, 'palette.cache')


class CellArt:
    """Maps RGB pixels onto (colour pair, glyph, bold) triples.

    Each cell blends its background and foreground colour in the proportion
    the glyph inks, so a pair of colours plus a density ramp yields far more
    tones than the eight the console actually has.
    """

    def __init__(self):
        self.tones = []          # (rgb, pair_offset, glyph_index, bold, swap)
        self.cache = {}          # (r>>4, g>>4, b>>4) -> (pair_off, gi, bold, swap)
        self._build()
        self._load_cache()

    def _build(self):
        for pi, (a, b) in enumerate(MEDIA_COMBOS):
            for bold in (False, True):
                for swap in (False, True):
                    # pair pi paints fg=b on bg=a; swap uses the ramp from the
                    # other end, which is the same thing as exchanging them.
                    fg = (BRIGHT_RGB if bold else CONSOLE_RGB)[a if swap else b]
                    bg = CONSOLE_RGB[b if swap else a]
                    for gi, cover in enumerate(RAMP_COVER):
                        rgb = (bg[0] + (fg[0] - bg[0]) * cover,
                               bg[1] + (fg[1] - bg[1]) * cover,
                               bg[2] + (fg[2] - bg[2]) * cover)
                        self.tones.append((rgb, pi, gi, bold, swap))

    # -- nearest-tone lookup, filled on demand -------------------------------
    def lookup(self, r, g, b):
        key = (r >> 4, g >> 4, b >> 4)
        hit = self.cache.get(key)
        if hit is not None:
            return hit
        tr, tg, tb = (key[0] << 4) + 8, (key[1] << 4) + 8, (key[2] << 4) + 8
        best = None
        bd = 1e18
        for rgb, pi, gi, bold, swap in self.tones:
            dr = rgb[0] - tr
            dg = rgb[1] - tg
            db = rgb[2] - tb
            # luma-weighted, so brightness errors matter more than hue
            d = dr * dr * 0.30 + dg * dg * 0.59 + db * db * 0.11
            if d < bd:
                bd = d
                best = (pi, gi, bold, swap)
        self.cache[key] = best
        return best

    @staticmethod
    def tone_rgb(pi, gi, bold, swap):
        a, b = MEDIA_COMBOS[pi]
        fg = (BRIGHT_RGB if bold else CONSOLE_RGB)[a if swap else b]
        bg = CONSOLE_RGB[b if swap else a]
        cover = RAMP_COVER[gi]
        return (bg[0] + (fg[0] - bg[0]) * cover,
                bg[1] + (fg[1] - bg[1]) * cover,
                bg[2] + (fg[2] - bg[2]) * cover)

    def to_cells(self, data, cols, rows, dither=False):
        """Convert rgb24 pixels to 3 bytes per cell: pair, glyph, flags.

        Doing the colour search once and keeping the result means a
        pre-rendered video costs nothing per frame but the drawing itself.
        With `dither` the quantisation error is diffused into the
        neighbouring cells (Floyd-Steinberg), which matters a lot when the
        palette is only eight colours wide.
        """
        need = cols * rows * 3
        if not data or len(data) < need:
            return b''
        out = bytearray(need)
        if not dither:
            look = self.lookup
            for i in range(0, need, 3):
                pi, gi, bold, swap = look(data[i], data[i + 1], data[i + 2])
                out[i] = pi
                out[i + 1] = gi
                out[i + 2] = (1 if bold else 0) | (2 if swap else 0)
            return bytes(out)
        # error-diffusing path: keep one row of forward error plus the next
        cur = [0.0] * (cols * 3 + 6)
        nxt = [0.0] * (cols * 3 + 6)
        look = self.lookup
        tone = self.tone_rgb
        for y in range(rows):
            base = y * cols * 3
            for x in range(cols):
                i = base + x * 3
                k = x * 3
                r = data[i] + cur[k]
                g = data[i + 1] + cur[k + 1]
                b = data[i + 2] + cur[k + 2]
                rc = 0 if r < 0 else (255 if r > 255 else int(r))
                gc = 0 if g < 0 else (255 if g > 255 else int(g))
                bc = 0 if b < 0 else (255 if b > 255 else int(b))
                pi, gi, bold, swap = look(rc, gc, bc)
                out[i] = pi
                out[i + 1] = gi
                out[i + 2] = (1 if bold else 0) | (2 if swap else 0)
                ar, ag, ab = tone(pi, gi, bold, swap)
                er, eg, eb = r - ar, g - ag, b - ab
                # 7/16 right, 3/16 below-left, 5/16 below, 1/16 below-right
                cur[k + 3] += er * 0.4375
                cur[k + 4] += eg * 0.4375
                cur[k + 5] += eb * 0.4375
                if x:
                    nxt[k - 3] += er * 0.1875
                    nxt[k - 2] += eg * 0.1875
                    nxt[k - 1] += eb * 0.1875
                nxt[k] += er * 0.3125
                nxt[k + 1] += eg * 0.3125
                nxt[k + 2] += eb * 0.3125
                nxt[k + 3] += er * 0.0625
                nxt[k + 4] += eg * 0.0625
                nxt[k + 5] += eb * 0.0625
            cur, nxt = nxt, cur
            for j in range(len(nxt)):
                nxt[j] = 0.0
        return bytes(out)

    def draw_cells(self, canvas, cells, cols, rows, y0=0, x0=0):
        """Blit pre-converted cell triples, grouping equal attributes."""
        if not cells:
            return
        if len(cells) < cols * rows * 3:
            rows = len(cells) // (cols * 3)
            if rows <= 0:
                return
        ramp = RAMP
        base_pair = MEDIA_PAIR_BASE
        for y in range(rows):
            base = y * cols * 3
            run_attr = None
            run = []
            run_start = 0
            for x in range(cols):
                i = base + x * 3
                flags = cells[i + 2]
                attr = curses.color_pair(base_pair + cells[i])
                if flags & 1:
                    attr |= curses.A_BOLD
                if flags & 2:
                    attr |= curses.A_REVERSE
                ch = ramp[cells[i + 1]]
                if attr != run_attr:
                    if run:
                        canvas.put(y0 + y, x0 + run_start, ''.join(run), run_attr)
                    run_attr, run, run_start = attr, [ch], x
                else:
                    run.append(ch)
            if run:
                canvas.put(y0 + y, x0 + run_start, ''.join(run), run_attr)

    def _load_cache(self):
        try:
            with open(PALETTE_CACHE, 'rb') as f:
                blob = f.read()
        except OSError:
            return
        if len(blob) % 7 != 0:
            return
        for i in range(0, len(blob), 7):
            k = (blob[i], blob[i + 1], blob[i + 2])
            self.cache[k] = (blob[i + 3], blob[i + 4],
                             bool(blob[i + 5]), bool(blob[i + 6]))

    def save_cache(self):
        if not self.cache:
            return
        try:
            os.makedirs(COS_HOME, exist_ok=True)
            out = bytearray()
            for (a, b, c), (pi, gi, bold, swap) in self.cache.items():
                out += bytes((a, b, c, pi, gi, 1 if bold else 0, 1 if swap else 0))
            with open(PALETTE_CACHE, 'wb') as f:
                f.write(bytes(out))
        except Exception:
            pass

    # -- drawing -------------------------------------------------------------
    def draw(self, canvas, data, cols, rows, y0=0, x0=0, mono=False,
             dither=False):
        """Blit rgb24 `data` (cols*rows*3 bytes) into a Canvas."""
        if not data or cols <= 0 or rows <= 0:
            return
        if not mono:
            cells = self.to_cells(data, cols, rows, dither=dither)
            self.draw_cells(canvas, cells, cols, rows, y0, x0)
            return
        need = cols * rows * 3
        if len(data) < need:
            rows = len(data) // (cols * 3)
            if rows <= 0:
                return
        for y in range(rows):
            base = y * cols * 3
            run_attr = None
            run_chars = []
            run_start = 0
            for x in range(cols):
                i = base + x * 3
                r, g, b = data[i], data[i + 1], data[i + 2]
                if mono:
                    lum = (r * 30 + g * 59 + b * 11) // 100
                    gi = min(len(RAMP) - 1, lum * len(RAMP) // 256)
                    attr = cp(CP_TEXT, bold=(lum > 170))
                    ch = RAMP[gi]
                else:
                    pi, gi, bold, swap = self.lookup(r, g, b)
                    attr = curses.color_pair(MEDIA_PAIR_BASE + pi)
                    if bold:
                        attr |= curses.A_BOLD
                    if swap:
                        attr |= curses.A_REVERSE
                    ch = RAMP[gi]
                if attr != run_attr:
                    if run_chars:
                        canvas.put(y0 + y, x0 + run_start, ''.join(run_chars),
                                   run_attr)
                    run_attr = attr
                    run_chars = [ch]
                    run_start = x
                else:
                    run_chars.append(ch)
            if run_chars:
                canvas.put(y0 + y, x0 + run_start, ''.join(run_chars), run_attr)


_CELL_ART = None


def cell_art():
    global _CELL_ART
    if _CELL_ART is None:
        _CELL_ART = CellArt()
    return _CELL_ART


# A console cell is usually twice as tall as it is wide, but that depends
# entirely on the loaded font: an 8x8 VGA font is square, Terminus 12x6 is
# 2:1, DejaVu 59x32 is nearly 2:1 the other way. Getting it wrong squashes
# or stretches every picture, so measure it when we can.
CELL_ASPECT = 2.0
CELL_ASPECT_CHOICES = ['auto', '1.0', '1.25', '1.5', '2.0', '2.5']


def screen_pixels():
    """Panel size in pixels, from sysfs (world readable), or None."""
    for path in ('/sys/class/graphics/fb0/virtual_size',):
        try:
            with open(path) as f:
                w, _, h = f.read().strip().partition(',')
            return int(w), int(h)
        except Exception:
            continue
    return None


def detect_cell_aspect(cols, rows):
    """How many times taller than wide one cell is, measured."""
    px = screen_pixels()
    if not px or cols <= 0 or rows <= 0:
        return None
    pw, ph = px
    cw = pw / cols
    ch = ph / rows
    if cw <= 0.5:
        return None
    a = ch / cw
    return a if 0.4 <= a <= 4.0 else None


def cell_aspect_value(state):
    choice = str(state.get('cell_aspect', 'auto'))
    if choice != 'auto':
        try:
            return max(0.4, min(4.0, float(choice)))
        except ValueError:
            pass
    return float(state.get('_cell_aspect_detected') or CELL_ASPECT)


def fit_cells(img_w, img_h, max_cols, max_rows, mode='fit', aspect=None):
    """Pick a cell grid that preserves the picture's aspect ratio."""
    if img_w <= 0 or img_h <= 0 or max_cols <= 0 or max_rows <= 0:
        return max(1, max_cols), max(1, max_rows)
    if mode == 'stretch':
        return max(1, max_cols), max(1, max_rows)
    cell = float(aspect or CELL_ASPECT)
    aspect = img_w / img_h
    cols = max_cols
    rows = int(round(cols / (aspect * cell)))
    if mode == 'fit' and rows > max_rows:
        rows = max_rows
        cols = int(round(rows * aspect * cell))
    elif mode == 'fill' and rows < max_rows:
        rows = max_rows
        cols = int(round(rows * aspect * cell))
    return max(1, min(cols, max_cols)), max(1, min(rows, max_rows))


# How much work AsciiPic/AsciiVid put into each frame.
#   scaler  -- ffmpeg's rescaler; lanczos keeps far more detail than bilinear
#   dither  -- diffuse quantisation error between cells
MEDIA_QUALITY = {
    'fast':   {'scaler': 'bilinear', 'dither': False,
               'label': 'fast (bilinear, no dither)'},
    'fine':   {'scaler': 'lanczos',  'dither': False,
               'label': 'fine (lanczos)'},
    'detail': {'scaler': 'lanczos',  'dither': True,
               'label': 'detail (lanczos + dithering)'},
}
MEDIA_QUALITY_ORDER = ['fast', 'fine', 'detail']


def quality_opts(state):
    name = state.get('media_quality', 'fine')
    return MEDIA_QUALITY.get(name, MEDIA_QUALITY['fine'])


IMAGE_EXT = {'.png', '.jpg', '.jpeg', '.gif', '.bmp', '.webp', '.tif',
             '.tiff', '.ppm', '.pgm', '.pnm', '.tga', '.ico', '.jfif',
             '.avif', '.heic', '.svg'}
VIDEO_EXT = {'.mp4', '.mkv', '.webm', '.avi', '.mov', '.m4v', '.mpg',
             '.mpeg', '.wmv', '.flv', '.ogv', '.3gp', '.ts', '.m2ts'}


def probe_media(path):
    """Dimensions, duration, frame rate and stream presence via ffprobe.

    Uses JSON rather than the flat key=value form: there the per-stream keys
    arrive in an order that makes it easy to attribute an audio codec to the
    video stream by mistake.
    """
    info = {'w': 0, 'h': 0, 'fps': 0.0, 'duration': 0.0, 'video': False,
            'audio': False, 'codec': '', 'acodec': '', 'frames': 0,
            'rotation': 0}
    if not _which('ffprobe'):
        return info
    try:
        r = subprocess.run(
            ['ffprobe', '-v', 'error', '-print_format', 'json',
             '-show_streams', '-show_format', path],
            capture_output=True, text=True, timeout=25)
        doc = json.loads(r.stdout or '{}')
    except Exception:
        return info
    try:
        info['duration'] = float(doc.get('format', {}).get('duration', 0) or 0)
    except (TypeError, ValueError):
        pass
    for st in doc.get('streams', []):
        kind = st.get('codec_type')
        if kind == 'video' and not info['video']:
            info['video'] = True
            info['codec'] = st.get('codec_name', '')
            info['w'] = int(st.get('width') or 0)
            info['h'] = int(st.get('height') or 0)
            try:
                info['frames'] = int(st.get('nb_frames') or 0)
            except (TypeError, ValueError):
                pass
            rate = st.get('avg_frame_rate') or st.get('r_frame_rate') or '0/0'
            if '/' in rate:
                n, _, d = rate.partition('/')
                try:
                    if float(d):
                        info['fps'] = float(n) / float(d)
                except ValueError:
                    pass
            if not info['duration']:
                try:
                    info['duration'] = float(st.get('duration') or 0)
                except (TypeError, ValueError):
                    pass
            # phone video carries its orientation in side data
            for sd in st.get('side_data_list', []) or []:
                if 'rotation' in sd:
                    try:
                        info['rotation'] = int(float(sd['rotation'])) % 360
                    except (TypeError, ValueError):
                        pass
        elif kind == 'audio' and not info['audio']:
            info['audio'] = True
            info['acodec'] = st.get('codec_name', '')
    # a still image reports one frame and no meaningful duration
    if info['video'] and info['frames'] == 1 and info['duration'] <= 0.05:
        info['fps'] = 0.0
    return info


def decode_still(path, cols, rows, seek=None, extra_vf='', scaler='lanczos'):
    """Decode one frame of anything ffmpeg can read, as rgb24 cell pixels."""
    if not _which('ffmpeg'):
        return b''
    vf = f'scale={cols}:{rows}:flags={scaler}'
    if extra_vf:
        vf = extra_vf + ',' + vf
    cmd = ['ffmpeg', '-hide_banner', '-loglevel', 'error']
    if seek:
        cmd += ['-ss', str(float(seek))]
    cmd += ['-i', path, '-frames:v', '1', '-f', 'rawvideo',
            '-pix_fmt', 'rgb24', '-vf', vf, '-']
    try:
        r = subprocess.run(cmd, capture_output=True, timeout=30)
        return r.stdout
    except Exception:
        return b''


# =============================================================================
# TRACKPAD / POINTER  --  raw Linux evdev, no X and no gpm required
# =============================================================================
EV_SYN, EV_KEY, EV_REL, EV_ABS, EV_MSC = 0x00, 0x01, 0x02, 0x03, 0x04

BTN_LEFT, BTN_RIGHT, BTN_MIDDLE = 0x110, 0x111, 0x112
BTN_TOUCH             = 0x14a
BTN_TOOL_FINGER       = 0x145
BTN_TOOL_DOUBLETAP    = 0x14d
BTN_TOOL_TRIPLETAP    = 0x14e
BTN_TOOL_QUADTAP      = 0x14f

ABS_X, ABS_Y                   = 0x00, 0x01
ABS_MT_SLOT                    = 0x2f
ABS_MT_POSITION_X              = 0x35
ABS_MT_POSITION_Y              = 0x36
ABS_MT_TRACKING_ID             = 0x39
REL_X, REL_Y, REL_HWHEEL, REL_WHEEL = 0x00, 0x01, 0x06, 0x08

EVENT_FMT  = 'llHHi'
EVENT_SIZE = struct.calcsize(EVENT_FMT)

# struct input_absinfo { __s32 value, minimum, maximum, fuzz, flat, resolution; }
ABSINFO_FMT = 'iiiiii'
ABSINFO_SIZE = struct.calcsize(ABSINFO_FMT)


def _eviocgabs(abs_code):
    """EVIOCGABS(code) -- _IOR('E', 0x40 + code, struct input_absinfo)."""
    return (2 << 30) | (ABSINFO_SIZE << 16) | (0x45 << 8) | (0x40 + abs_code)


def abs_info(path):
    """Axis ranges and physical resolution for an absolute input device.

    Returns {'x': (min, max, res), 'y': (min, max, res)} or None. The
    resolution is in units per millimetre, which is what lets COS size
    pointer motion to the actual pad instead of guessing.
    """
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        return None
    out = {}
    try:
        for key, codes in (('x', (ABS_MT_POSITION_X, ABS_X)),
                           ('y', (ABS_MT_POSITION_Y, ABS_Y))):
            for code in codes:
                try:
                    buf = fcntl.ioctl(fd, _eviocgabs(code), b'\0' * ABSINFO_SIZE)
                except OSError:
                    continue
                _v, mn, mx, _fuzz, _flat, res = struct.unpack(ABSINFO_FMT, buf)
                if mx > mn:
                    out[key] = (mn, mx, res)
                    break
    finally:
        os.close(fd)
    return out if len(out) == 2 else None


# One full-pad swipe should cover about this many screen-widths. Below ~1 you
# have to clutch to cross the screen; above ~2 the pointer feels unusable.
SWIPE_SCREENS = 1.3
SCROLL_MM_PER_STEP = 3.0    # finger travel per line of scrolling

TAP_MAX_SECONDS = 0.22      # press->release under this = a tap
TAP_SLOP        = 90        # device units of travel still counted as a tap
JUMP_REJECT     = 420       # bigger single-report jump = finger re-placed


def _bitmask(field):
    """Parse a '/proc/bus/input/devices'  B: line into an int bitmask.

    The kernel prints groups of hex words, most-significant group first:
        B: KEY=e520 10000 0 0 0 0
    """
    words = field.split()
    val = 0
    for i, w in enumerate(reversed(words)):
        try:
            val |= int(w, 16) << (64 * i)
        except ValueError:
            pass
    return val


def _has(mask, bit):
    return bool((mask >> bit) & 1)


def list_input_devices():
    """Parse /proc/bus/input/devices -> list of device dicts."""
    out = []
    try:
        with open('/proc/bus/input/devices') as f:
            blocks = f.read().split('\n\n')
    except Exception:
        return out
    for blk in blocks:
        if not blk.strip():
            continue
        d = {'name': '?', 'handlers': [], 'ev': 0, 'key': 0,
             'abs': 0, 'rel': 0, 'prop': 0, 'phys': ''}
        for line in blk.splitlines():
            line = line.strip()
            if line.startswith('N: Name='):
                d['name'] = line[8:].strip().strip('"')
            elif line.startswith('P: Phys='):
                d['phys'] = line[8:].strip()
            elif line.startswith('H: Handlers='):
                d['handlers'] = line[12:].split()
            elif line.startswith('B: EV='):
                d['ev'] = _bitmask(line[6:])
            elif line.startswith('B: KEY='):
                d['key'] = _bitmask(line[7:])
            elif line.startswith('B: ABS='):
                d['abs'] = _bitmask(line[7:])
            elif line.startswith('B: REL='):
                d['rel'] = _bitmask(line[7:])
            elif line.startswith('B: PROP='):
                d['prop'] = _bitmask(line[8:])
        ev = next((h for h in d['handlers'] if h.startswith('event')), None)
        if not ev:
            continue
        d['path'] = '/dev/input/' + ev
        # classify
        abs_xy = _has(d['abs'], ABS_X) and _has(d['abs'], ABS_Y)
        rel_xy = _has(d['rel'], REL_X) and _has(d['rel'], REL_Y)
        touch  = _has(d['key'], BTN_TOUCH)
        if abs_xy and touch:
            d['kind'] = 'touchpad'
        elif rel_xy:
            d['kind'] = 'mouse'
        elif abs_xy:
            d['kind'] = 'tablet'
        else:
            continue
        d['mt']        = _has(d['abs'], ABS_MT_POSITION_X)
        d['buttonpad'] = _has(d['prop'], 2)
        d['two_finger'] = _has(d['key'], BTN_TOOL_DOUBLETAP)
        d['has_right'] = _has(d['key'], BTN_RIGHT)
        d['readable']  = os.access(d['path'], os.R_OK)
        out.append(d)
    return out


def pick_pointer_device(prefer='auto'):
    devs = list_input_devices()
    if not devs:
        return None, devs
    if prefer and prefer != 'auto':
        for d in devs:
            if d['path'] == prefer or d['name'] == prefer:
                return d, devs

    def score(d):
        s = 0
        n = d['name'].lower()
        if d['kind'] == 'touchpad':   s += 100
        if 'touchpad' in n:           s += 60
        if d.get('mt'):               s += 25
        if d['kind'] == 'mouse':      s += 40
        if 'mouse' in n:              s += 10
        if d['readable']:             s += 15
        if d['kind'] == 'tablet':     s -= 50
        return s

    devs_sorted = sorted(devs, key=score, reverse=True)
    return devs_sorted[0], devs


def mouse_bridge(path):
    """Privileged helper: copy raw evdev packets from `path` to stdout."""
    try:
        f = open(path, 'rb', buffering=0)
    except Exception as e:
        sys.stderr.write(f'cos mouse-bridge: {e}\n')
        return 1
    out = sys.stdout.buffer
    try:
        while True:
            data = f.read(EVENT_SIZE)
            if not data:
                break
            out.write(data)
            out.flush()
    except (BrokenPipeError, KeyboardInterrupt):
        pass
    finally:
        try: f.close()
        except Exception: pass
    return 0


class Pointer:
    """Reads a trackpad (or mouse) in a background thread and turns raw
    evdev packets into COS pointer events.

    Emits into .events:
        ('move',)
        ('press',  button)   button: 1=left 2=middle 3=right
        ('release',button)
        ('click',  button)   synthesized from a tap
        ('scroll', delta)    +1 = content moves down (wheel toward user)
    """

    def __init__(self, state, sound=None):
        self.state = state
        self.sound = sound
        self.x = 10.0
        self.y = 6.0
        self.max_x = 80
        self.max_y = 24
        self.events = deque(maxlen=512)
        self.lock = threading.Lock()
        self.thread = None
        self._stop = threading.Event()
        self.src = None            # file object or pipe
        self.proc = None           # sudo bridge process
        self.device = None
        self.devices = []
        self.mode = 'off'          # off | direct | sudo-bridge | xterm
        self.status = 'disabled'
        self.hint = ''
        self.buttons = [False, False, False, False]
        self.raw = (0, 0)
        self.fingers = 0
        self.packets = 0
        self.absinfo = None
        self.speed_x = float(state.get('pointer_speed', 18) or 18)
        self.speed_y = self.speed_x * 2.0
        self.scroll_div = float(state.get('scroll_speed', 60) or 60)
        self.calib_note = 'not calibrated'
        # internal gesture state
        self._slot = 0
        self._mt = {}
        self._last = None
        self._contact = False
        self._tap_t0 = 0.0
        self._tap_travel = 0.0
        self._tap_fingers = 0
        self._scroll_acc = 0.0
        self._frac_x = 0.0
        self._frac_y = 0.0
        self._pend_rel = [0, 0, 0, 0]   # dx, dy, wheel, hwheel

    # -- lifecycle ----------------------------------------------------------
    def start(self):
        if not self.state.get('pointer_on', True):
            self.status = 'disabled in Preferences'
            return False
        dev, devs = pick_pointer_device(self.state.get('pointer_device', 'auto'))
        self.devices = devs
        self.device = dev
        if dev is None:
            self.status = 'no pointing device found'
            self.hint = 'No touchpad or mouse in /proc/bus/input/devices.'
            return False
        if not self._open_source(dev['path']):
            return False
        self._stop.clear()
        self.thread = threading.Thread(target=self._reader, daemon=True,
                                       name='cos-pointer')
        self.thread.start()
        return True

    def _open_source(self, path):
        try:
            self.src = open(path, 'rb', buffering=0)
            self.mode = 'direct'
            self.status = f'{os.path.basename(path)} (direct)'
            self.absinfo = abs_info(path)
            self.calibrate()
            return True
        except PermissionError:
            pass
        except Exception as e:
            self.status = f'open failed: {e}'
            self.hint = str(e)
            return False
        # No read permission -> try a passwordless sudo helper.
        if self._sudo_ok():
            try:
                self.proc = subprocess.Popen(
                    ['sudo', '-n', sys.executable, os.path.abspath(__file__),
                     '--mouse-bridge', path],
                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                    stdin=subprocess.DEVNULL, bufsize=0)
                self.src = self.proc.stdout
                self.mode = 'sudo-bridge'
                self.status = f'{os.path.basename(path)} (sudo bridge)'
                return True
            except Exception as e:
                self.status = f'sudo bridge failed: {e}'
        self.status = f'permission denied on {path}'
        self.hint = ('You are not in the "input" group, so COS cannot read the '
                     'trackpad.\nFix it once with:\n'
                     f'    sudo usermod -aG input {os.environ.get("USER","$USER")}\n'
                     'then log out and back in (or reboot).\n'
                     'CONTROL > Trackpad Setup can run that for you.')
        return False

    @staticmethod
    def _sudo_ok():
        try:
            return subprocess.run(['sudo', '-n', 'true'], timeout=3,
                                  stdout=subprocess.DEVNULL,
                                  stderr=subprocess.DEVNULL).returncode == 0
        except Exception:
            return False

    def stop(self):
        self._stop.set()
        if self.thread:
            self.thread.join(timeout=0.6)
        for closer in (self.src,):
            try: closer.close()
            except Exception: pass
        if self.proc:
            try: self.proc.terminate()
            except Exception: pass
        self.mode = 'off'

    def restart(self):
        self.stop()
        self._last = None
        self.status = 'restarting'
        return self.start()

    # -- geometry -----------------------------------------------------------
    def calibrate(self):
        """Size pointer motion to this pad and this screen.

        A touchpad reports in device units whose scale varies wildly between
        machines, so a fixed units-per-cell constant is always wrong
        somewhere. When the kernel tells us the axis range (and ideally the
        units/mm), derive the divisors instead. Manual tuning switches this
        off permanently.
        """
        if not self.state.get('pointer_auto_speed', True):
            self.speed_x = float(max(3, self.state.get('pointer_speed', 18)))
            self.speed_y = self.speed_x * 2.0
            self.scroll_div = float(max(8, self.state.get('scroll_speed', 60)))
            self.calib_note = 'manual'
            return
        if not self.absinfo:
            self.speed_x = float(max(3, self.state.get('pointer_speed', 18)))
            self.speed_y = self.speed_x * 2.0
            self.scroll_div = float(max(8, self.state.get('scroll_speed', 60)))
            self.calib_note = 'no axis info from kernel; using configured speed'
            return
        (xmn, xmx, xres) = self.absinfo['x']
        (ymn, ymx, yres) = self.absinfo['y']
        span_x = max(1, xmx - xmn)
        span_y = max(1, ymx - ymn)
        cols = max(20, self.max_x)
        rows = max(8, self.max_y)
        self.speed_x = max(2.0, span_x / (cols * SWIPE_SCREENS))
        self.speed_y = max(2.0, span_y / (rows * SWIPE_SCREENS))
        self.scroll_div = max(8.0, (yres or 32) * SCROLL_MM_PER_STEP)
        self.state['pointer_speed'] = int(round(self.speed_x))
        if xres and yres:
            self.calib_note = (f'auto: pad {span_x / xres:.0f}x{span_y / yres:.0f}mm '
                               f'@ {xres}/mm -> {self.speed_x:.1f}/{self.speed_y:.1f} '
                               f'units per cell on {cols}x{rows}')
        else:
            self.calib_note = (f'auto: pad {span_x}x{span_y} units -> '
                               f'{self.speed_x:.1f}/{self.speed_y:.1f} per cell')

    def set_bounds(self, w, h):
        changed = (w, h) != (self.max_x, self.max_y)
        self.max_x, self.max_y = w, h
        self.x = min(max(0.0, self.x), w - 1)
        self.y = min(max(0.0, self.y), h - 1)
        if changed:
            self.calibrate()

    @property
    def pos(self):
        return int(self.x), int(self.y)

    def warp(self, x, y):
        self.x = float(min(max(0, x), self.max_x - 1))
        self.y = float(min(max(0, y), self.max_y - 1))

    def _emit(self, ev):
        with self.lock:
            self.events.append(ev)

    def drain(self):
        with self.lock:
            evs = list(self.events)
            self.events.clear()
        return evs

    # -- the reader thread --------------------------------------------------
    def _reader(self):
        buf = b''
        src = self.src
        try:
            fd = src.fileno()
        except Exception:
            return
        while not self._stop.is_set():
            try:
                r, _, _ = select.select([fd], [], [], 0.12)
            except Exception:
                break
            if not r:
                continue
            try:
                chunk = os.read(fd, EVENT_SIZE * 64)
            except OSError as e:
                if e.errno in (errno.EAGAIN, errno.EINTR):
                    continue
                break
            if not chunk:
                break
            buf += chunk
            while len(buf) >= EVENT_SIZE:
                pkt, buf = buf[:EVENT_SIZE], buf[EVENT_SIZE:]
                try:
                    _s, _us, etype, code, value = struct.unpack(EVENT_FMT, pkt)
                except struct.error:
                    continue
                self.packets += 1
                self._handle(etype, code, value)

    def _handle(self, etype, code, value):
        if etype == EV_ABS:
            if code == ABS_MT_SLOT:
                self._slot = value
            elif code == ABS_MT_TRACKING_ID:
                if value == -1:
                    self._mt.pop(self._slot, None)
                else:
                    self._mt.setdefault(self._slot, {})
            elif code == ABS_MT_POSITION_X:
                self._mt.setdefault(self._slot, {})['x'] = value
            elif code == ABS_MT_POSITION_Y:
                self._mt.setdefault(self._slot, {})['y'] = value
            elif code == ABS_X:
                self._mt.setdefault(0, {})['x'] = value
            elif code == ABS_Y:
                self._mt.setdefault(0, {})['y'] = value

        elif etype == EV_REL:
            if   code == REL_X:      self._pend_rel[0] += value
            elif code == REL_Y:      self._pend_rel[1] += value
            elif code == REL_WHEEL:  self._pend_rel[2] += value
            elif code == REL_HWHEEL: self._pend_rel[3] += value

        elif etype == EV_KEY:
            self._key(code, value)

        elif etype == EV_SYN:
            self._sync()

    def _key(self, code, value):
        down = (value != 0)
        if code == BTN_TOUCH:
            if down and not self._contact:
                self._contact = True
                self._tap_t0 = time.monotonic()
                self._tap_travel = 0.0
                self._tap_fingers = max(1, self.fingers)
                self._last = None
            elif not down and self._contact:
                self._contact = False
                dt = time.monotonic() - self._tap_t0
                if (self.state.get('tap_to_click', True)
                        and dt <= TAP_MAX_SECONDS
                        and self._tap_travel <= TAP_SLOP):
                    btn = {1: 1, 2: 3, 3: 2}.get(self._tap_fingers, 1)
                    self._emit(('click', btn))
                self._last = None
                self._scroll_acc = 0.0
                self._mt.clear()
            return

        if code == BTN_TOOL_FINGER:
            if down: self.fingers = max(self.fingers, 1)
            elif self.fingers == 1: self.fingers = 0
        elif code == BTN_TOOL_DOUBLETAP:
            self.fingers = 2 if down else (1 if self._contact else 0)
            self._last = None
        elif code == BTN_TOOL_TRIPLETAP:
            self.fingers = 3 if down else (1 if self._contact else 0)
            self._last = None
        elif code == BTN_TOOL_QUADTAP:
            self.fingers = 4 if down else (1 if self._contact else 0)
        elif code in (BTN_LEFT, BTN_RIGHT, BTN_MIDDLE):
            btn = {BTN_LEFT: 1, BTN_MIDDLE: 2, BTN_RIGHT: 3}[code]
            # A clickpad has only BTN_LEFT: two fingers down = right click,
            # three fingers = middle click.  That is the standard behaviour.
            if btn == 1 and self.device and self.device.get('buttonpad'):
                if self.fingers >= 3:   btn = 2
                elif self.fingers == 2: btn = 3
            self.buttons[btn] = down
            self._emit(('press' if down else 'release', btn))
            if down:
                self._tap_travel = TAP_SLOP + 1   # a real click is not a tap

    def _sync(self):
        sx = self.speed_x or 18.0
        sy = self.speed_y or 36.0
        moved = False

        # ---- relative device (plain mouse / PS2 emulation) ----------------
        dx, dy, wheel, hwheel = self._pend_rel
        if dx or dy:
            # A relative device reports in mouse counts, not pad units.
            fx = dx / max(1.0, sx / 6.0)
            fy = dy / max(1.0, sy / 6.0)
            self._advance(fx, fy)
            moved = True
        if wheel:
            n = -wheel if not self.state.get('natural_scroll') else wheel
            self._emit(('scroll', n))
        if hwheel:
            self._emit(('hscroll', hwheel))
        self._pend_rel = [0, 0, 0, 0]

        # ---- absolute touchpad -------------------------------------------
        prim = self._mt.get(self._slot) or self._mt.get(0)
        if prim and 'x' in prim and 'y' in prim and self._contact:
            cx, cy = prim['x'], prim['y']
            self.raw = (cx, cy)
            if self._last is None:
                self._last = (cx, cy)
            else:
                ddx = cx - self._last[0]
                ddy = cy - self._last[1]
                if abs(ddx) > JUMP_REJECT or abs(ddy) > JUMP_REJECT:
                    self._last = (cx, cy)       # finger jumped; resync
                else:
                    self._last = (cx, cy)
                    self._tap_travel += abs(ddx) + abs(ddy)
                    if self.fingers >= 2:
                        # two-finger scroll
                        ss = self.scroll_div or 60.0
                        self._scroll_acc += ddy / ss
                        while abs(self._scroll_acc) >= 1.0:
                            step = 1 if self._scroll_acc > 0 else -1
                            self._scroll_acc -= step
                            # Traditional: fingers down == wheel down, so the
                            # view moves down (offset grows). Natural scrolling
                            # drags the content with the fingers instead.
                            n = -step if self.state.get('natural_scroll') else step
                            self._emit(('scroll', n))
                    else:
                        # sx/sy already account for the cell aspect ratio
                        fx = ddx / sx
                        fy = ddy / sy
                        if self.state.get('pointer_accel', True):
                            mag = math.hypot(ddx, ddy)
                            if mag > sx * 1.6:
                                k = min(2.0, 1.0 + (mag / (sx * 14.0)))
                                fx *= k; fy *= k
                        self._advance(fx, fy)
                        moved = True
        if moved:
            self._emit(('move',))

    def _advance(self, fx, fy):
        self._frac_x += fx
        self._frac_y += fy
        ix = int(self._frac_x)
        iy = int(self._frac_y)
        if ix:
            self.x = min(max(0.0, self.x + ix), self.max_x - 1)
            self._frac_x -= ix
        if iy:
            self.y = min(max(0.0, self.y + iy), self.max_y - 1)
            self._frac_y -= iy


# =============================================================================
# DRAW PRIMITIVES
# =============================================================================
def _safestr(scr, y, x, s, attr=0):
    try:
        scr.addstr(y, x, s, attr)
    except curses.error:
        pass


def _safech(scr, y, x, ch, attr=0):
    try:
        scr.addch(y, x, ch, attr)
    except curses.error:
        pass


class Canvas:
    """A clipped drawing region on stdscr. All coords are region-relative."""
    __slots__ = ('scr', 'y0', 'x0', 'h', 'w')

    def __init__(self, scr, y0, x0, h, w):
        self.scr, self.y0, self.x0 = scr, y0, x0
        self.h, self.w = max(0, h), max(0, w)

    def put(self, row, col, s, attr=0):
        if row < 0 or row >= self.h or self.w <= 0:
            return
        s = str(s).replace('\t', '    ')
        if col < 0:
            s = s[-col:]
            col = 0
        if col >= self.w or not s:
            return
        _safestr(self.scr, self.y0 + row, self.x0 + col, s[:self.w - col], attr)

    def ch(self, row, col, c, attr=0):
        if 0 <= row < self.h and 0 <= col < self.w:
            _safech(self.scr, self.y0 + row, self.x0 + col, c, attr)

    def fill(self, attr=0, c=' '):
        for r in range(self.h):
            self.put(r, 0, c * self.w, attr)

    def hline(self, row, col, n, c=None, attr=0):
        c = curses.ACS_HLINE if c is None else c
        for i in range(n):
            self.ch(row, col + i, c, attr)

    def vline(self, row, col, n, c=None, attr=0):
        c = curses.ACS_VLINE if c is None else c
        for i in range(n):
            self.ch(row + i, col, c, attr)

    def center(self, row, s, attr=0):
        self.put(row, max(0, (self.w - len(str(s))) // 2), s, attr)

    def sub(self, row, col, h, w):
        return Canvas(self.scr, self.y0 + row, self.x0 + col, h, w)

    def bar(self, row, col, width, frac, attr_on, attr_off, c_on=None, c_off=None):
        """Horizontal progress/meter bar."""
        c_on = curses.ACS_CKBOARD if c_on is None else c_on
        c_off = '-' if c_off is None else c_off
        filled = int(round(max(0.0, min(1.0, frac)) * width))
        for i in range(width):
            if i < filled:
                self.ch(row, col + i, c_on, attr_on)
            else:
                self.ch(row, col + i, c_off, attr_off)

    def scrollbar(self, row, col, height, total, visible, offset, attr):
        """Vertical scrollbar; returns nothing."""
        if height < 3:
            return
        self.ch(row, col, curses.ACS_UARROW, attr)
        self.ch(row + height - 1, col, curses.ACS_DARROW, attr)
        track = height - 2
        if total <= visible or total <= 0:
            for i in range(track):
                self.ch(row + 1 + i, col, curses.ACS_CKBOARD, attr | curses.A_DIM)
            return
        thumb = max(1, int(track * visible / total))
        span = track - thumb
        pos = 0 if total == visible else int(round(span * offset / max(1, total - visible)))
        for i in range(track):
            inside = pos <= i < pos + thumb
            self.ch(row + 1 + i, col,
                    curses.ACS_CKBOARD if inside else ' ',
                    attr | (curses.A_BOLD if inside else curses.A_DIM))


def draw_box(scr, y, x, h, w, attr, fillattr=None, fill=' '):
    if h < 2 or w < 2:
        return
    if fillattr is not None:
        for r in range(1, h - 1):
            _safestr(scr, y + r, x + 1, fill * (w - 2), fillattr)
    _safech(scr, y, x, curses.ACS_ULCORNER, attr)
    _safech(scr, y, x + w - 1, curses.ACS_URCORNER, attr)
    _safech(scr, y + h - 1, x, curses.ACS_LLCORNER, attr)
    _safech(scr, y + h - 1, x + w - 1, curses.ACS_LRCORNER, attr)
    for i in range(1, w - 1):
        _safech(scr, y, x + i, curses.ACS_HLINE, attr)
        _safech(scr, y + h - 1, x + i, curses.ACS_HLINE, attr)
    for i in range(1, h - 1):
        _safech(scr, y + i, x, curses.ACS_VLINE, attr)
        _safech(scr, y + i, x + w - 1, curses.ACS_VLINE, attr)


def draw_shadow(scr, y, x, h, w, attr):
    """Classic one-cell drop shadow to the lower-right."""
    for i in range(1, h):
        _safestr(scr, y + i, x + w, '  ', attr)
    _safestr(scr, y + h, x + 2, ' ' * w, attr)


def draw_outline(scr, y, x, h, w, attr):
    """Windows-2000 style dithered wireframe used while dragging."""
    if h < 2 or w < 2:
        return
    ck = curses.ACS_CKBOARD
    for i in range(w):
        _safech(scr, y, x + i, ck, attr)
        _safech(scr, y + h - 1, x + i, ck, attr)
    for i in range(1, h - 1):
        _safech(scr, y + i, x, ck, attr)
        _safech(scr, y + i, x + w - 1, ck, attr)


# =============================================================================
# WINDOW BASE CLASS
# =============================================================================
class Window:
    icon = '#'
    resizable = True
    min_w, min_h = 26, 7
    want_cursor = False          # show the terminal caret inside this window

    def __init__(self, title, w=50, h=16, x=None, y=None):
        self.title = title
        self.w, self.h = w, h
        self.x = 2 if x is None else x
        self.y = 2 if y is None else y
        self.closed = False
        self.maximized = False
        self._restore = None
        self.wm = None
        self.scroll = 0
        self.caret = None        # (row, col) client coords when want_cursor

    # -- geometry -----------------------------------------------------------
    @property
    def cw(self):
        return max(0, self.w - 2)

    @property
    def chh(self):
        return max(0, self.h - 2)

    def client_canvas(self, scr):
        return Canvas(scr, self.y + 1, self.x + 1, self.chh, self.cw)

    def clamp(self, lay):
        self.w = max(self.min_w, min(self.w, lay.ww))
        self.h = max(self.min_h, min(self.h, lay.wh))
        self.x = max(lay.wx, min(self.x, lay.wx + lay.ww - self.w))
        self.y = max(lay.wy, min(self.y, lay.wy + lay.wh - self.h))

    def title_buttons(self):
        """[(col_offset, width, name)] relative to window left edge."""
        btns = []
        col = self.w - 4
        btns.append((col, 3, 'close'))
        if self.resizable:
            col -= 3
            btns.append((col, 3, 'max'))
        return btns

    # -- framing ------------------------------------------------------------
    def draw(self, scr, active):
        attr = cp(CP_WINDOW)
        tattr = cp(CP_WIN_TITLE, bold=True) if active else cp(CP_TITLE_IDLE)
        if active:
            draw_shadow(scr, self.y, self.x, self.h, self.w, cp(CP_SHADOW))
        draw_box(scr, self.y, self.x, self.h, self.w, attr, attr)
        # title row
        _safestr(scr, self.y, self.x + 1, ' ' * (self.w - 2), tattr)
        t = f' {self.title} '
        _safestr(scr, self.y, self.x + 1, t[:max(0, self.w - 9)], tattr)
        for col, _wd, name in self.title_buttons():
            lbl = '[X]' if name == 'close' else ('[v]' if self.maximized else '[^]')
            _safestr(scr, self.y, self.x + col, lbl, tattr)
        # bottom hint
        st = self.status()
        if st:
            _safestr(scr, self.y + self.h - 1, self.x + 2,
                     f' {st} '[:max(0, self.w - 4)], cp(CP_STATUS))
        if self.resizable:
            _safech(scr, self.y + self.h - 1, self.x + self.w - 1,
                    curses.ACS_LRCORNER, cp(CP_BRIGHT, bold=True))
        self.draw_client(self.client_canvas(scr), active)

    # -- overridables -------------------------------------------------------
    def draw_client(self, c, active):
        c.put(0, 1, '(empty window)', cp(CP_TEXT))

    def status(self):
        return ''

    def on_key(self, key):
        return False

    def on_click(self, row, col, btn):
        return False

    def on_scroll(self, n):
        return False

    def tick(self):
        pass

    def on_close(self):
        pass

    def on_resize(self):
        pass

    # -- helpers ------------------------------------------------------------
    def notify(self, msg, sound='notify'):
        if self.wm:
            self.wm.notify(msg, sound)

    def toggle_max(self, lay):
        if self.maximized:
            if self._restore:
                self.x, self.y, self.w, self.h = self._restore
            self.maximized = False
        else:
            self._restore = (self.x, self.y, self.w, self.h)
            self.x, self.y = lay.wx, lay.wy
            self.w, self.h = lay.ww, lay.wh
            self.maximized = True
        self.clamp(lay)
        self.on_resize()


class ScrollListWindow(Window):
    """Window with a scrolling selectable list. Subclass supplies rows()."""

    def __init__(self, title, w=56, h=18, x=None, y=None):
        super().__init__(title, w, h, x, y)
        self.sel = 0

    def rows(self):
        return []

    def row_attr(self, i, item, selected, active):
        if selected:
            return cp(CP_SEL, bold=True) if active else cp(CP_MENU_SEL)
        return cp(CP_TEXT)

    def row_text(self, i, item):
        return str(item)

    def on_activate(self, i, item):
        pass

    def visible_rows(self):
        return self.chh - self.header_rows() - self.footer_rows()

    def header_rows(self):
        return 0

    def footer_rows(self):
        return 0

    def draw_header(self, c, active):
        pass

    def draw_footer(self, c, active, top):
        pass

    def draw_client(self, c, active):
        c.fill(cp(CP_WINDOW))
        items = self.rows()
        hr = self.header_rows()
        vis = max(1, self.visible_rows())
        self.sel = max(0, min(self.sel, max(0, len(items) - 1)))
        if self.sel < self.scroll:
            self.scroll = self.sel
        if self.sel >= self.scroll + vis:
            self.scroll = self.sel - vis + 1
        self.scroll = max(0, min(self.scroll, max(0, len(items) - vis)))
        self.draw_header(c, active)
        need_sb = len(items) > vis
        body_w = c.w - (1 if need_sb else 0)
        for i in range(vis):
            ri = self.scroll + i
            if ri >= len(items):
                break
            sel = (ri == self.sel)
            txt = self.row_text(ri, items[ri])
            a = self.row_attr(ri, items[ri], sel, active)
            line = f'{txt:<{max(0, body_w)}}'[:max(0, body_w)]
            c.put(hr + i, 0, line, a)
        if need_sb:
            c.scrollbar(hr, c.w - 1, vis, len(items), vis, self.scroll, cp(CP_SCROLL))
        self.draw_footer(c, active, hr + vis)

    def on_key(self, key):
        items = self.rows()
        vis = max(1, self.visible_rows())
        if key in (curses.KEY_UP, ord('k')):
            self.sel = max(0, self.sel - 1); return True
        if key in (curses.KEY_DOWN, ord('j')):
            self.sel = min(len(items) - 1, self.sel + 1); return True
        if key == curses.KEY_PPAGE:
            self.sel = max(0, self.sel - vis); return True
        if key == curses.KEY_NPAGE:
            self.sel = min(len(items) - 1, self.sel + vis); return True
        if key == curses.KEY_HOME:
            self.sel = 0; return True
        if key == curses.KEY_END:
            self.sel = max(0, len(items) - 1); return True
        if key in (curses.KEY_ENTER, 10, 13):
            if items:
                self.on_activate(self.sel, items[self.sel])
            return True
        return False

    def on_scroll(self, n):
        items = self.rows()
        vis = max(1, self.visible_rows())
        self.scroll = max(0, min(self.scroll + n * 2, max(0, len(items) - vis)))
        self.sel = max(self.scroll, min(self.sel, self.scroll + vis - 1))
        return True

    def on_click(self, row, col, btn):
        hr = self.header_rows()
        items = self.rows()
        idx = self.scroll + (row - hr)
        if hr <= row and 0 <= idx < len(items):
            double = (self.wm and self.wm.was_double(self, idx))
            self.sel = idx
            if double or btn == 3:
                self.on_activate(idx, items[idx])
            return True
        return False


