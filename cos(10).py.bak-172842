        ], w=76))
    elif action == 'keymap':
        wm.open(TextWindow('Keyboard Map', [
            '  GLOBAL',
            '    F10          menu bar            F1   help',
            '    Alt+F/E/A/C/S/W/P/H  jump straight to a menu',
            '    TAB          next window         Shift-TAB  previous',
            '    ^W           close window        ^Q   quit COS',
            '    F7 move   F8 resize   F9 maximize',
            '    F12          toggle keyboard cursor mode',
            '    ESC          close menu / cancel move-resize',
