            '  KEYBOARD CURSOR MODE (F12)',
            '    arrows       move the pointer    ENTER  left click',
            '    .            right click         shift+arrows  move faster',
            '    (use this when the trackpad is not available)',
            '',
            '  IN LISTS       UP/DN, PgUp/PgDn, Home/End, ENTER',
            '  IN SHELLS      UP/DN history, PgUp/PgDn scroll, ^U clear line,',
            '                 ^K clear output, "exit" to close',
        ], w=72))
    elif action == 'trackpad_help':
        wm.open(TextWindow('Trackpad Guide', [
            '  WHY THE TRACKPAD NEEDED WORK',
            '',
            '  In a graphical terminal, the mouse arrives as escape codes',
            '  (the xterm 1003 protocol). A bare Linux TTY has no such thing:',
            '  the kernel just publishes raw events on /dev/input/eventN and',
            '  nothing translates them. gpm is the usual daemon for this, and',
            '  it is not running here.',
            '',
            '  So COS reads the device itself. It parses',
            '  /proc/bus/input/devices to find your touchpad, opens the',
            '  matching event node, and decodes 24-byte input_event packets',
            '  in a background thread: absolute multitouch positions become',
            '  pointer motion, BTN_TOUCH timing becomes taps, and',
            '  BTN_TOOL_DOUBLETAP turns two-finger slides into scrolling.',
            '',
            '  PERMISSIONS',
            '',
            '  Those nodes are root:input mode 0660, so your user must be in',
            '  the "input" group:',
            '',
            f'      sudo usermod -aG input {os.environ.get("USER", "you")}',
            '',
            '  Group changes only apply to a NEW login, so log out and back',
            '  in, or reboot. CONTROL > Trackpad Setup has a button for it.',
            '',
            '  If passwordless sudo is configured, COS instead spawns itself',
            '  with --mouse-bridge under sudo and pipes the packets back, so',
            '  it works without changing any groups.',
            '',
            '  ON THIS MACHINE',
            '',
        ] + [f'    {d["path"]:<18} {"readable" if d["readable"] else "NO ACCESS":<10} '
             f'{d["kind"]:<9} {d["name"][:28]}'
             for d in list_input_devices()] + [
            '',
            f'    current: {wm.ptr.status}',
        ], w=76))
    elif action == 'credits':
        wm.open(TextWindow('Credits', [
            '',
            f'  COS -- Channel Operating System v{VERSION}',
            f'  "{CODENAME}"',
            '',
            '  Built by TCF -- The Coloradan Financial',
            '',
            '  Python + curses  //  TTY + trackpad + sound',
            '',
            '  Druman    the music player',
            '  Webinator the web browser',
            '',
            '  "Retro Outside, Modern Inside."',
            '',
        ], w=52))
    # ---- window menu -----------------------------------------------------
    elif action == 'win_next':
        wm.cycle()
    elif action == 'win_move':
        wm.begin_kbmode('move')
    elif action == 'win_resize':
        wm.begin_kbmode('resize')
    elif action == 'win_max':
        if wm.active:
            wm.active.toggle_max(wm.lay)
            snd.play('click')
    elif action == 'win_cascade':
        wm.cascade(); snd.play('drop')
    elif action == 'win_tile':
        wm.tile(); snd.play('drop')
    elif action == 'win_close':
        if wm.active:
            wm.close(wm.active)
    elif action == 'win_closeall':
        if wm.wins:
            wm.open(ConfirmWindow('Close All',
                                  [f'Close all {len(wm.wins)} window(s)?'],
                                  wm.close_all))
    else:
        wm.notify(f'[COS] unknown action: {action}', 'error')


def tty_name():
    try:
        return os.ttyname(0) if os.isatty(0) else 'not a tty'
    except OSError:
        return '?'


def group_names():
    try:
        import grp
        gids = os.getgroups()
        names = []
        for g in gids:
            try:
                names.append(grp.getgrgid(g).gr_name)
            except KeyError:
                names.append(str(g))
        return ', '.join(sorted(names))
    except Exception:
        return '?'


_CLIP = ''


def sys_copy(text):
    global _CLIP
    _CLIP = text
    for cmd in (['xclip', '-selection', 'clipboard'], ['xsel', '-bi'], ['wl-copy']):
        if not _which(cmd[0]):
            continue
        try:
            subprocess.run(cmd, input=text.encode(), timeout=2,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
        except Exception:
            continue
    return False


def sys_paste():
    for cmd in (['xclip', '-selection', 'clipboard', '-o'], ['xsel', '-bo'],
                ['wl-paste']):
        if not _which(cmd[0]):
            continue
        try:
            r = subprocess.run(cmd, capture_output=True, timeout=2, text=True)
            if r.returncode == 0:
                return r.stdout.strip()
        except Exception:
            continue
    return _CLIP


# =============================================================================
# MAIN LOOP
# =============================================================================
FRAME_MS = 28
REDRAW_EVERY = 0.25


def grab_control_keys():
    """Stop the tty line discipline from eating keys COS needs.

    A Linux console has XON/XOFF flow control on by default, so ^Q and ^S
    never reach the program -- ^Q is XON and ^S is XOFF. ^Z would suspend
    COS outright. Clear those, keep ^C working, and return the old settings
    so they can be restored on exit.
    """
    try:
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
    except Exception:
        return None
    try:
        new = termios.tcgetattr(fd)
        new[0] &= ~(termios.IXON | termios.IXOFF | termios.IXANY)
        new[6] = list(new[6])
        new[6][termios.VSUSP] = b'\x00'      # no ^Z suspend
        new[6][termios.VLNEXT] = b'\x00'     # no ^V literal-next
        new[6][termios.VQUIT] = b'\x00'      # no ^\ core dump
        termios.tcsetattr(fd, termios.TCSANOW, new)
    except Exception:
        return old
    return old


def restore_control_keys(old):
    if old is None:
        return
    try:
        termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old)
    except Exception:
        pass
_KEYLOG = (open(os.environ['COS_KEYLOG'], 'a', buffering=1)
           if os.environ.get('COS_KEYLOG') else None)


def main(stdscr):
    curses.cbreak()
    curses.noecho()
    stdscr.keypad(True)
    try:
        curses.set_escdelay(25)      # report a bare ESC in 25ms, not 1s
    except (AttributeError, curses.error):
        pass
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    try:
        curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)
    except curses.error:
        pass
    # xterm 1003: only does anything in a graphical terminal, harmless in a TTY
    sys.stdout.write('\033[?1003h')
    sys.stdout.flush()
    saved_tty = grab_control_keys()
    init_colors()

    state = {'running': True, 'messages': []}
    load_config(state)
    apply_theme(state.get('theme_idx', 0))

    sound = SoundEngine(state)
    sound.init()
    write_sound_readme()

    ptr = Pointer(state, sound)
    ptr.start()

    wm = WindowManager(stdscr, state, sound, ptr)
    wm.saved_tty = saved_tty
    wm.notify(f'[COS] Channel Operating System v{VERSION} "{CODENAME}" ready.', None)
    wm.notify('[COS] F10 = menus   TAB = next window   F1 = help   ^Q = quit', None)
    if ptr.mode in ('direct', 'sudo-bridge'):
        wm.notify(f'[COS] Trackpad: {ptr.status} -- tap to click, '
                  'two fingers to scroll.', None)
    else:
        wm.notify(f'[COS] Trackpad unavailable: {ptr.status}', None)
        wm.notify('[COS] CONTROL > Trackpad Setup to fix it; '
                  'keyboard works meanwhile (F12 = cursor keys).', None)
    if SILENT:
        wm.notify('[COS] Sound suppressed by COS_SILENT.', None)
    elif sound.ready:
        wm.notify(f'[COS] Sound: {sound.backend}. Drop your own files in '
                  f'{SOUND_DIR}', None)
    else:
        wm.notify(f'[COS] Sound off: {sound.note}', None)
    sound.play('boot')

    last_draw = 0.0
    cursor_keys = False
    state['cursor_keys'] = False

    while state['running']:
        H, W = stdscr.getmaxyx()
        if (W, H) != state.get('_grid'):
            state['_grid'] = (W, H)
            state['_cell_aspect_detected'] = detect_cell_aspect(W, H)
        lay = Layout(H, W, state)
        wm.lay = lay
        ptr.set_bounds(W, H)

        if wm.shell_request:
            run_shell_request(stdscr, wm)
            continue

        for w in list(wm.wins):
            w.clamp(lay)
            try:
                w.tick()
            except Exception as e:
                wm.notify(f'[{w.title}] tick error: {e}', 'error')
                wm.close(w, sound=None)

        now = time.monotonic()
        if wm.dirty or (now - last_draw) >= REDRAW_EVERY:
            wm.draw()
            stdscr.refresh()
            wm.dirty = False
            last_draw = now

        # ---- pointer events ------------------------------------------
        for ev in ptr.drain():
            gx, gy = ptr.pos
            kind = ev[0]
            if kind == 'move':
                wm.pointer_move(gx, gy)
            elif kind == 'press':
                wm.pointer_press(ev[1], gx, gy, lambda a: handle_action(a, wm, state))
            elif kind == 'release':
                wm.pointer_release(ev[1], gx, gy)
            elif kind == 'click':
                wm.pointer_press(ev[1], gx, gy, lambda a: handle_action(a, wm, state))
                wm.pointer_release(ev[1], gx, gy)
            elif kind == 'scroll':
                wm.pointer_scroll(ev[1], gx, gy)

        # ---- keyboard ------------------------------------------------
        stdscr.timeout(FRAME_MS)
        key = stdscr.getch()
        if key == -1:
            continue
        alt = False
        if key == 27:
            # Distinguish a bare ESC from Alt+key: with a short escdelay the
            # terminal has already delivered the second byte, so peek for it.
            stdscr.timeout(0)
            nxt = stdscr.getch()
            if nxt != -1:
                key, alt = nxt, True
        if _KEYLOG:
            _KEYLOG.write(f'key={key} alt={alt} menu={wm.menu_open} '
                          f'kb={bool(wm.kbmode)} wins={len(wm.wins)}\n')
            _KEYLOG.flush()

        wm.dirty = True

        if key == curses.KEY_RESIZE:
            try:
                curses.resizeterm(*stdscr.getmaxyx())
            except curses.error:
                pass
            continue

        if key == curses.KEY_MOUSE:
            try:
                _id, mx, my, _z, bstate = curses.getmouse()
                ptr.warp(mx, my)
                dispatch = lambda a: handle_action(a, wm, state)
                if bstate & curses.BUTTON1_PRESSED:
                    wm.pointer_press(1, mx, my, dispatch)
                elif bstate & curses.BUTTON1_RELEASED:
                    wm.pointer_release(1, mx, my)
                elif bstate & (curses.BUTTON1_CLICKED | curses.BUTTON1_DOUBLE_CLICKED):
                    wm.pointer_press(1, mx, my, dispatch)
                    wm.pointer_release(1, mx, my)
                elif bstate & curses.BUTTON3_CLICKED:
                    wm.pointer_press(3, mx, my, dispatch)
                    wm.pointer_release(3, mx, my)
                elif bstate & getattr(curses, 'BUTTON4_PRESSED', 0):
                    wm.pointer_scroll(-1, mx, my)
                elif bstate & getattr(curses, 'BUTTON5_PRESSED', 0):
                    wm.pointer_scroll(1, mx, my)
                else:
                    wm.pointer_move(mx, my)
            except curses.error:
                pass
            continue

        # keyboard move/resize mode owns everything
        if wm.kbmode:
            wm.kbmode_key(key)
            continue

        # alt+letter always opens a menu
        if alt and 32 <= key <= 126 and chr(key).lower() in MENUS:
            wm.open_menu(chr(key).lower())
            continue
        if key == 27 and not alt:
            # An open menu swallows ESC first, then the focused window gets a
            # chance to cancel itself (dialogs, search fields), and only then
            # does ESC fall through to leaving cursor-key mode.
            if wm.menu_open:
                wm.close_menu()
            elif wm.active and _safe_key(wm, wm.active, 27):
                pass
            elif cursor_keys:
                cursor_keys = False
                state['cursor_keys'] = False
                wm.notify('[COS] Cursor-key mode off.', 'click')
            continue

        # open menu navigation
        if wm.menu_open:
            items = wm.menu_items()
            if key == curses.KEY_UP:
                wm.menu_step(-1)
            elif key == curses.KEY_DOWN:
                wm.menu_step(1)
            elif key == curses.KEY_LEFT:
                wm.menu_sibling(-1)
            elif key == curses.KEY_RIGHT:
                wm.menu_sibling(1)
            elif key in (curses.KEY_ENTER, 10, 13):
                action = items[wm.menu_sel][1] if items else None
                wm.close_menu()
                sound.play('click')
                if action:
                    handle_action(action, wm, state)
            elif key in (curses.KEY_F10, 9):
                wm.close_menu()
            elif 32 <= key <= 126 and chr(key).lower() in MENUS:
                wm.open_menu(chr(key).lower())
            continue

        # global keys
        if key in (17, 24):                             # ^Q / ^X
            handle_action('exit', wm, state); continue
        if key == 23:                                   # ^W
            if wm.active:
                wm.close(wm.active)
            continue
        if key == curses.KEY_F10:
            wm.open_menu(MENU_ORDER[0]); continue
        if key == curses.KEY_F1:
            handle_action('help', wm, state); continue
        if key == curses.KEY_F7:
            wm.begin_kbmode('move'); continue
        if key == curses.KEY_F8:
            wm.begin_kbmode('resize'); continue
        if key == curses.KEY_F9:
            handle_action('win_max', wm, state); continue
        if key == curses.KEY_F12:
            cursor_keys = not cursor_keys
            state['cursor_keys'] = cursor_keys
            wm.notify(f'[COS] Cursor-key mode {"ON -- arrows move the pointer, "
                      "ENTER clicks" if cursor_keys else "off"}.', 'click')
            continue
        # cursor-key mode steals the arrows
        if cursor_keys and key in (curses.KEY_UP, curses.KEY_DOWN,
                                   curses.KEY_LEFT, curses.KEY_RIGHT,
                                   curses.KEY_ENTER, 10, 13, ord('.')):
            gx, gy = ptr.pos
            step = 1
            if key == curses.KEY_UP:    ptr.warp(gx, gy - step)
            elif key == curses.KEY_DOWN:  ptr.warp(gx, gy + step)
            elif key == curses.KEY_LEFT:  ptr.warp(gx - step, gy)
            elif key == curses.KEY_RIGHT: ptr.warp(gx + step, gy)
            else:
                btn = 3 if key == ord('.') else 1
                nx, ny = ptr.pos
                wm.pointer_press(btn, nx, ny, lambda a: handle_action(a, wm, state))
                wm.pointer_release(btn, nx, ny)
            continue

        # focused window first
        if wm.active and _safe_key(wm, wm.active, key):
            continue

        if key == 9:
            wm.cycle(); continue
        if key == curses.KEY_BTAB:
            wm.cycle(back=True); continue

        # unconsumed printable: menu hotkey, or desktop shortcuts
        if 32 <= key <= 126:
            ch = chr(key).lower()
            if ch in MENUS:
                wm.open_menu(ch); continue
            if not wm.wins:
                if ch == 'q':
                    handle_action('exit', wm, state); continue
                icons = wm.icon_rects()
                if ch.isdigit() and 1 <= int(ch) <= len(icons):
                    handle_action(icons[int(ch) - 1][4], wm, state); continue

        # desktop icon navigation with arrows
        if not wm.wins and key in (curses.KEY_UP, curses.KEY_DOWN,
                                   curses.KEY_ENTER, 10, 13):
            icons = wm.icon_rects()
            if icons:
                if key == curses.KEY_UP:
                    wm.icon_sel = (wm.icon_sel - 1) % len(icons)
                elif key == curses.KEY_DOWN:
                    wm.icon_sel = (wm.icon_sel + 1) % len(icons)
                else:
                    if 0 <= wm.icon_sel < len(icons):
                        handle_action(icons[wm.icon_sel][4], wm, state)
            continue

    # ---- shutdown -------------------------------------------------------
    save_config(state)
    sound.play_blocking('shutdown', timeout=3)
    ptr.stop()
    sound.shutdown()
    restore_control_keys(saved_tty)
    sys.stdout.write('\033[?1003l')
    sys.stdout.flush()


def _safe_key(wm, win, key):
    """Hand a key to a window; a crashing app must not take COS down."""
    try:
        return bool(win.on_key(key))
    except Exception as e:
        wm.notify(f'[{win.title}] key error: {type(e).__name__}: {e}', 'error')
        return True


def run_shell_request(stdscr, wm):
    """Leave curses, run the pending callable, come back."""
    fn, label = wm.shell_request
    wm.shell_request = None
    curses.def_prog_mode()
    curses.endwin()
    sys.stdout.write('\033[?1003l')
    sys.stdout.flush()
    had_pointer = wm.ptr.mode in ('direct', 'sudo-bridge')
    wm.ptr.stop()
    # curses.endwin() has already put the tty back in shell mode, which undoes
    # grab_control_keys() for us -- echo and line editing must work in here.
    try:
        fn()
    except Exception as e:
        print(f'\n  {label} failed: {type(e).__name__}: {e}')
        time.sleep(2)
    curses.reset_prog_mode()
    wm.saved_tty = grab_control_keys()
    sys.stdout.write('\033[?1003h')
    sys.stdout.flush()
    stdscr.clear()
    stdscr.refresh()
    if wm.state.get('pointer_on', True):
        wm.ptr.restart()
    load_config(wm.state)
    wm.dirty = True
    wm.notify(f'[COS] {label} finished.'
              + ('' if (not had_pointer or wm.ptr.mode != 'off')
                 else '  Pointer did not come back -- CONTROL > Trackpad Setup.'),
              'notify')


def write_sound_readme():
    """Tell the user which sound names COS uses, so they can drop in their own."""
    path = os.path.join(SOUND_DIR, 'README.txt')
    try:
        os.makedirs(SOUND_DIR, exist_ok=True)
        if os.path.exists(path):
            return
        with open(path, 'w') as f:
            f.write(
                'COS sound pack\n'
                '==============\n\n'
                'Drop your own sound files in THIS folder to replace the\n'
                'tones COS synthesized for itself. Name the file after the\n'
                'event you want it on, with any of these extensions:\n\n'
                '    .wav  .ogg  .opus  .flac  .mp3  .m4a  .aiff\n\n'
                'A file here ALWAYS wins over the built-in tone, which lives\n'
                'in the builtin/ subfolder. COS never writes to this folder\n'
                'except for this README, and never overwrites your files.\n\n'
                'Example -- use the Microsoft startup sound as the COS\n'
                'startup sound:\n\n'
                '    cp ~/cos/microsoftsound.mp3 ~/.cos/sounds/boot.mp3\n\n'
                'Names COS plays:\n\n')
            meaning = {
                'boot': 'COS starts up',
                'click': 'a button, menu item or icon is clicked',
                'menu': 'a menu opens / selection moves',
                'open': 'a window opens',
                'close': 'a window closes',
                'notify': 'general notification',
                'error': 'something failed',
                'warn': 'a warning',
                'drop': 'a drag is committed, a file is saved',
                'key': 'small keypress tick',
                'shutdown': 'COS exits',
                'coin': 'a sale completes in the POS shell',
            }
            for name in sorted(SOUND_SPECS):
                f.write(f'    {name + ".wav":<16} {meaning.get(name, "")}\n')
            f.write('\nShort files work best: 50-400 ms for clicks and blips.\n'
                    'A long file is fine for boot and shutdown.\n\n'
                    'Delete one of your files and the built-in tone comes\n'
                    'back. Delete a file under builtin/ and COS re-synthesizes\n'
                    'it at next start (or Preferences > Re-synthesize).\n')
    except Exception:
        pass


SOUND_SEARCH_EXT = ('.wav', '.ogg', '.opus', '.flac', '.mp3', '.m4a', '.aiff')


def find_sound_file(name):
    """Resolve a COS sound name to a file.

    Anything the user dropped in ~/.cos/sounds wins, in any supported
    format. Only if nothing is there do we fall back to the tone COS
    synthesized for itself in ~/.cos/sounds/builtin.
    """
    for ext in SOUND_SEARCH_EXT:
        p = os.path.join(SOUND_DIR, name + ext)
        if os.path.isfile(p):
            return p
    p = os.path.join(BUILTIN_DIR, name + '.wav')
    return p if os.path.isfile(p) else None


def is_custom_sound(name):
    f = find_sound_file(name)
    return bool(f) and os.path.dirname(f) == os.path.abspath(SOUND_DIR)


# =============================================================================
# COMMAND LINE
# =============================================================================
def cli_test_input():
    dev, devs = pick_pointer_device()
    print(f'COS v{VERSION} -- raw input test\n')
    if not devs:
        print('No pointing devices found in /proc/bus/input/devices.')
        return 1
    for d in devs:
        mark = '->' if dev and d['path'] == dev['path'] else '  '
        print(f'{mark} {d["path"]:<18} {d["kind"]:<9} '
              f'{"readable" if d["readable"] else "NO ACCESS":<10} {d["name"]}')
    print()
    if not dev['readable']:
        print(f'Cannot read {dev["path"]}.')
        print(f"Run:  python3 '{os.path.basename(__file__)}' --grant-input")
        return 1
    print(f'Reading {dev["path"]} -- move a finger on the pad. Ctrl-C to stop.\n')
    state = dict(DEFAULTS)
    state['messages'] = []
    p = Pointer(state)
    if not p.start():
        print('start failed:', p.status)
        return 1
    try:
        while True:
            time.sleep(0.1)
            evs = p.drain()
            if evs:
                x, y = p.pos
                kinds = ' '.join(str(e) for e in evs[-4:])
                print(f'\rpos {x:>4},{y:>4}  raw {p.raw[0]:>5},{p.raw[1]:>5}  '
                      f'fingers {p.fingers}  pkts {p.packets:>6}  {kinds:<40}',
                      end='', flush=True)
    except KeyboardInterrupt:
        print('\n')
    finally:
        p.stop()
    return 0


def cli_test_sound():
    state = dict(DEFAULTS)
    state['messages'] = []
    snd = SoundEngine(state)
    print(f'COS v{VERSION} -- sound test')
    print(f'sound folder: {SOUND_DIR}')
    ok = snd.init()
    write_sound_readme()
    print(f'backend: {snd.backend or "NONE"}   ({snd.note})')
    if not ok:
        print('\nNo audio backend worked. Tried: ' +
              ', '.join(n for n, _ in SoundEngine.BACKENDS))
        print('Check that your user can reach the sound card:  aplay -l')
        return 1
    for name in sorted(SOUND_SPECS):
        tag = 'YOURS' if is_custom_sound(name) else 'built-in'
        print(f'  playing {name:<10} ({tag})')
        snd.play_blocking(name)
        time.sleep(0.1)
    print('\nDone. Drop your own files in that folder to replace these;')
    print('see README.txt there for the names COS uses.')
    return 0


def cli_grant_input():
    grant_input_access()
    return 0


def usage():
    print(__doc__)
    return 0


def run():
    args = sys.argv[1:]
    if args:
        a = args[0]
        if a == '--mouse-bridge':
            if len(args) < 2:
                print('usage: --mouse-bridge /dev/input/eventN', file=sys.stderr)
                return 2
            return mouse_bridge(args[1])
        if a == '--test-input':
            return cli_test_input()
        if a == '--test-sound':
            return cli_test_sound()
        if a == '--grant-input':
            return cli_grant_input()
        if a in ('-h', '--help'):
            return usage()
        print(f'unknown option {a}\n')
        return usage()
    try:
        curses.wrapper(main)
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write('\033[?1003l')
        sys.stdout.flush()
        print('\nCOS channel closed.')
    return 0


if __name__ == '__main__':
    sys.exit(run() or 0)
