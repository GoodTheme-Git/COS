               'label': 'fast (bilinear, no dither)'},
    'fine':   {'scaler': 'lanczos',  'dither': False,
               'label': 'fine (lanczos)'},
    'detail': {'scaler': 'lanczos',  'dither': True,
               'label': 'detail (lanczos + dithering)'},
}
MEDIA_QUALITY_ORDER = ['fast', 'fine', 'detail']


def quality_opts(state):
