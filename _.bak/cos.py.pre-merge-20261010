def probe_media(path):
    """Dimensions, duration, frame rate and stream presence via ffprobe.

    Uses JSON rather than the flat key=value form: there the per-stream keys
    arrive in an order that makes it easy to attribute an audio codec to the
    video stream by mistake.
    """
    info = {'w': 0, 'h': 0, 'fps': 0.0, 'duration': 0.0, 'video': False,
            'audio': False, 'codec': '', 'acodec': '', 'frames': 0,
            'rotation': 0}
    if not _which('ffprobe'):
        return info
    try:
        r = subprocess.run(
            ['ffprobe', '-v', 'error', '-print_format', 'json',
             '-show_streams', '-show_format', path],
            capture_output=True, text=True, timeout=25)
        doc = json.loads(r.stdout or '{}')
    except Exception:
        return info
    try:
        info['duration'] = float(doc.get('format', {}).get('duration', 0) or 0)
    except (TypeError, ValueError):
        pass
    for st in doc.get('streams', []):
        kind = st.get('codec_type')
        if kind == 'video' and not info['video']:
            info['video'] = True
            info['codec'] = st.get('codec_name', '')
            info['w'] = int(st.get('width') or 0)
            info['h'] = int(st.get('height') or 0)
            try:
                info['frames'] = int(st.get('nb_frames') or 0)
            except (TypeError, ValueError):
                pass
            rate = st.get('avg_frame_rate') or st.get('r_frame_rate') or '0/0'
            if '/' in rate:
                n, _, d = rate.partition('/')
                try:
                    if float(d):
                        info['fps'] = float(n) / float(d)
                except ValueError:
                    pass
            if not info['duration']:
                try:
                    info['duration'] = float(st.get('duration') or 0)
                except (TypeError, ValueError):
                    pass
            # phone video carries its orientation in side data
            for sd in st.get('side_data_list', []) or []:
                if 'rotation' in sd:
                    try:
                        info['rotation'] = int(float(sd['rotation'])) % 360
                    except (TypeError, ValueError):
                        pass
        elif kind == 'audio' and not info['audio']:
            info['audio'] = True
            info['acodec'] = st.get('codec_name', '')
    # a still image reports one frame and no meaningful duration
    if info['video'] and info['frames'] == 1 and info['duration'] <= 0.05:
        info['fps'] = 0.0
    return info


def decode_still(path, cols, rows, seek=None, extra_vf='', scaler='lanczos'):
    """Decode one frame of anything ffmpeg can read, as rgb24 cell pixels."""
    if not _which('ffmpeg'):
        return b''
    vf = f'scale={cols}:{rows}:flags={scaler}'
    if extra_vf:
        vf = extra_vf + ',' + vf
    cmd = ['ffmpeg', '-hide_banner', '-loglevel', 'error']
    if seek:
        cmd += ['-ss', str(float(seek))]
    cmd += ['-i', path, '-frames:v', '1', '-f', 'rawvideo',
            '-pix_fmt', 'rgb24', '-vf', vf, '-']
    try:
        r = subprocess.run(cmd, capture_output=True, timeout=30)
        return r.stdout
    except Exception:
        return b''


# =============================================================================
# TRACKPAD / POINTER  --  raw Linux evdev, no X and no gpm required
# =============================================================================
EV_SYN, EV_KEY, EV_REL, EV_ABS, EV_MSC = 0x00, 0x01, 0x02, 0x03, 0x04

BTN_LEFT, BTN_RIGHT, BTN_MIDDLE = 0x110, 0x111, 0x112
BTN_TOUCH             = 0x14a
BTN_TOOL_FINGER       = 0x145
BTN_TOOL_DOUBLETAP    = 0x14d
BTN_TOOL_TRIPLETAP    = 0x14e
BTN_TOOL_QUADTAP      = 0x14f

ABS_X, ABS_Y                   = 0x00, 0x01
ABS_MT_SLOT                    = 0x2f
ABS_MT_POSITION_X              = 0x35
ABS_MT_POSITION_Y              = 0x36
ABS_MT_TRACKING_ID             = 0x39
REL_X, REL_Y, REL_HWHEEL, REL_WHEEL = 0x00, 0x01, 0x06, 0x08

EVENT_FMT  = 'llHHi'
EVENT_SIZE = struct.calcsize(EVENT_FMT)

# struct input_absinfo { __s32 value, minimum, maximum, fuzz, flat, resolution; }
ABSINFO_FMT = 'iiiiii'
ABSINFO_SIZE = struct.calcsize(ABSINFO_FMT)


def _eviocgabs(abs_code):
    """EVIOCGABS(code) -- _IOR('E', 0x40 + code, struct input_absinfo)."""
    return (2 << 30) | (ABSINFO_SIZE << 16) | (0x45 << 8) | (0x40 + abs_code)


def abs_info(path):
    """Axis ranges and physical resolution for an absolute input device.

    Returns {'x': (min, max, res), 'y': (min, max, res)} or None. The
    resolution is in units per millimetre, which is what lets COS size
    pointer motion to the actual pad instead of guessing.
    """
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        return None
    out = {}
    try:
        for key, codes in (('x', (ABS_MT_POSITION_X, ABS_X)),
                           ('y', (ABS_MT_POSITION_Y, ABS_Y))):
            for code in codes:
                try:
                    buf = fcntl.ioctl(fd, _eviocgabs(code), b'\0' * ABSINFO_SIZE)
                except OSError:
                    continue
                _v, mn, mx, _fuzz, _flat, res = struct.unpack(ABSINFO_FMT, buf)
                if mx > mn:
                    out[key] = (mn, mx, res)
                    break
    finally:
        os.close(fd)
    return out if len(out) == 2 else None


# One full-pad swipe should cover about this many screen-widths. Below ~1 you
# have to clutch to cross the screen; above ~2 the pointer feels unusable.
SWIPE_SCREENS = 1.3
SCROLL_MM_PER_STEP = 3.0    # finger travel per line of scrolling

TAP_MAX_SECONDS = 0.22      # press->release under this = a tap
TAP_SLOP        = 90        # device units of travel still counted as a tap
JUMP_REJECT     = 420       # bigger single-report jump = finger re-placed


def _bitmask(field):
    """Parse a '/proc/bus/input/devices'  B: line into an int bitmask.

    The kernel prints groups of hex words, most-significant group first:
        B: KEY=e520 10000 0 0 0 0
    """
    words = field.split()
    val = 0
    for i, w in enumerate(reversed(words)):
        try:
            val |= int(w, 16) << (64 * i)
        except ValueError:
            pass
    return val


def _has(mask, bit):
    return bool((mask >> bit) & 1)


def list_input_devices():
    """Parse /proc/bus/input/devices -> list of device dicts."""
    out = []
    try:
        with open('/proc/bus/input/devices') as f:
            blocks = f.read().split('\n\n')
    except Exception:
        return out
    for blk in blocks:
        if not blk.strip():
            continue
        d = {'name': '?', 'handlers': [], 'ev': 0, 'key': 0,
             'abs': 0, 'rel': 0, 'prop': 0, 'phys': ''}
        for line in blk.splitlines():
            line = line.strip()
            if line.startswith('N: Name='):
                d['name'] = line[8:].strip().strip('"')
            elif line.startswith('P: Phys='):
                d['phys'] = line[8:].strip()
            elif line.startswith('H: Handlers='):
                d['handlers'] = line[12:].split()
            elif line.startswith('B: EV='):
                d['ev'] = _bitmask(line[6:])
            elif line.startswith('B: KEY='):
                d['key'] = _bitmask(line[7:])
            elif line.startswith('B: ABS='):
                d['abs'] = _bitmask(line[7:])
            elif line.startswith('B: REL='):
                d['rel'] = _bitmask(line[7:])
            elif line.startswith('B: PROP='):
                d['prop'] = _bitmask(line[8:])
        ev = next((h for h in d['handlers'] if h.startswith('event')), None)
        if not ev:
            continue
        d['path'] = '/dev/input/' + ev
        # classify
        abs_xy = _has(d['abs'], ABS_X) and _has(d['abs'], ABS_Y)
        rel_xy = _has(d['rel'], REL_X) and _has(d['rel'], REL_Y)
        touch  = _has(d['key'], BTN_TOUCH)
        if abs_xy and touch:
            d['kind'] = 'touchpad'
        elif rel_xy:
            d['kind'] = 'mouse'
        elif abs_xy:
            d['kind'] = 'tablet'
        else:
            continue
        d['mt']        = _has(d['abs'], ABS_MT_POSITION_X)
        d['buttonpad'] = _has(d['prop'], 2)
        d['two_finger'] = _has(d['key'], BTN_TOOL_DOUBLETAP)
        d['has_right'] = _has(d['key'], BTN_RIGHT)
        d['readable']  = os.access(d['path'], os.R_OK)
        out.append(d)
    return out


def mouse_bridge(path):
    """Privileged helper: copy raw evdev packets from `path` to stdout."""
    try:
        f = open(path, 'rb', buffering=0)
    except Exception as e:
        sys.stderr.write(f'cos mouse-bridge: {e}\n')
        return 1
    out = sys.stdout.buffer
    try:
        while True:
            data = f.read(EVENT_SIZE)
            if not data:
                break
            out.write(data)
            out.flush()
    except (BrokenPipeError, KeyboardInterrupt):
        pass
    finally:
        try: f.close()
        except Exception: pass
    return 0


class PointerSource:
    """One physical pointing device, with its own decoding state.

    A touchpad and a mouse speak quite differently -- absolute multitouch
    with tap timing versus relative counts and a wheel -- and the gesture
    state cannot be shared between them. Each device therefore gets its own
    decoder, and they all drive the one shared cursor.
    """

    def __init__(self, parent, device):
        self.p = parent
        self.device = device
        self.path = device['path']
        self.kind = device.get('kind', 'mouse')
        self.src = None
        self.proc = None
        self.thread = None
        self.mode = 'off'
        self.error = ''
        self.absinfo = None
        self.packets = 0
        self.fingers = 0
        self.raw = (0, 0)
        # decoder state
        self._slot = 0
        self._mt = {}
        self._last = None
        self._contact = False
        self._tap_t0 = 0.0
        self._tap_travel = 0.0
        self._tap_fingers = 0
        self._scroll_acc = 0.0
        self._pend_rel = [0, 0, 0, 0]

    @property
    def is_touchpad(self):
        return self.kind == 'touchpad'

    def open(self):
        try:
            self.src = open(self.path, 'rb', buffering=0)
            self.mode = 'direct'
            if self.is_touchpad:
                self.absinfo = abs_info(self.path)
            return True
        except PermissionError:
            pass
        except Exception as e:
            self.error = str(e)
            return False
        if Pointer._sudo_ok():
            try:
                self.proc = subprocess.Popen(
                    ['sudo', '-n', sys.executable, os.path.abspath(__file__),
                     '--mouse-bridge', self.path],
                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                    stdin=subprocess.DEVNULL, bufsize=0)
                self.src = self.proc.stdout
                self.mode = 'sudo-bridge'
                return True
            except Exception as e:
                self.error = 'sudo bridge failed: %s' % e
                return False
        self.error = 'permission denied'
        return False

    def start(self):
        if not self.open():
            return False
        self.thread = threading.Thread(target=self._reader, daemon=True,
                                       name='cos-ptr-' + os.path.basename(self.path))
        self.thread.start()
        return True

    def stop(self):
        try:
            if self.src:
                self.src.close()
        except Exception:
            pass
        if self.proc:
            try:
                self.proc.terminate()
            except Exception:
                pass
        self.src = None
        self.proc = None
        self.mode = 'off'

    # -- reading -----------------------------------------------------------
    def _reader(self):
        try:
            fd = self.src.fileno()
        except Exception:
            return
        buf = b''
        stop = self.p._stop
        while not stop.is_set():
            try:
                r, _, _ = select.select([fd], [], [], 0.12)
            except Exception:
                break
            if not r:
                continue
            try:
                chunk = os.read(fd, EVENT_SIZE * 64)
            except OSError as e:
                if e.errno in (errno.EAGAIN, errno.EINTR):
                    continue
                break
            if not chunk:
                break
            buf += chunk
            while len(buf) >= EVENT_SIZE:
                pkt, buf = buf[:EVENT_SIZE], buf[EVENT_SIZE:]
                try:
                    _s, _us, etype, code, value = struct.unpack(EVENT_FMT, pkt)
                except struct.error:
                    continue
                self.packets += 1
                self.p.packets += 1
                self._handle(etype, code, value)

    def _handle(self, etype, code, value):
        if etype == EV_ABS:
            if code == ABS_MT_SLOT:
                self._slot = value
            elif code == ABS_MT_TRACKING_ID:
                if value == -1:
                    self._mt.pop(self._slot, None)
                else:
                    self._mt.setdefault(self._slot, {})
            elif code == ABS_MT_POSITION_X:
                self._mt.setdefault(self._slot, {})['x'] = value
            elif code == ABS_MT_POSITION_Y:
                self._mt.setdefault(self._slot, {})['y'] = value
            elif code == ABS_X:
                self._mt.setdefault(0, {})['x'] = value
            elif code == ABS_Y:
                self._mt.setdefault(0, {})['y'] = value
        elif etype == EV_REL:
            if code == REL_X:
                self._pend_rel[0] += value
            elif code == REL_Y:
                self._pend_rel[1] += value
            elif code == REL_WHEEL:
                self._pend_rel[2] += value
            elif code == REL_HWHEEL:
                self._pend_rel[3] += value
        elif etype == EV_KEY:
            self._key(code, value)
        elif etype == EV_SYN:
            self._sync()

    def _key(self, code, value):
        p = self.p
        down = (value != 0)
        if code == BTN_TOUCH:
            if down and not self._contact:
                self._contact = True
                self._tap_t0 = time.monotonic()
                self._tap_travel = 0.0
                self._tap_fingers = max(1, self.fingers)
                self._last = None
            elif not down and self._contact:
                self._contact = False
                dt = time.monotonic() - self._tap_t0
                if (p.state.get('tap_to_click', True)
                        and dt <= TAP_MAX_SECONDS
                        and self._tap_travel <= TAP_SLOP):
                    btn = {1: 1, 2: 3, 3: 2}.get(self._tap_fingers, 1)
                    p._emit(('click', btn))
                self._last = None
                self._scroll_acc = 0.0
                self._mt.clear()
            return
        if code == BTN_TOOL_FINGER:
            if down:
                self.fingers = max(self.fingers, 1)
            elif self.fingers == 1:
                self.fingers = 0
        elif code == BTN_TOOL_DOUBLETAP:
            self.fingers = 2 if down else (1 if self._contact else 0)
            self._last = None
        elif code == BTN_TOOL_TRIPLETAP:
            self.fingers = 3 if down else (1 if self._contact else 0)
            self._last = None
        elif code == BTN_TOOL_QUADTAP:
            self.fingers = 4 if down else (1 if self._contact else 0)
        elif code in (BTN_LEFT, BTN_RIGHT, BTN_MIDDLE):
            btn = {BTN_LEFT: 1, BTN_MIDDLE: 2, BTN_RIGHT: 3}[code]
            # A clickpad only reports BTN_LEFT, so two fingers down means a
            # right click and three a middle click. A real mouse has its own
            # buttons and must not be remapped like that.
            if btn == 1 and self.device.get('buttonpad'):
                if self.fingers >= 3:
                    btn = 2
                elif self.fingers == 2:
                    btn = 3
            p.buttons[btn] = down
            p._emit(('press' if down else 'release', btn))
            if down:
                self._tap_travel = TAP_SLOP + 1   # a real click is not a tap
        p.fingers = self.fingers

    def _sync(self):
        p = self.p
        moved = False
        dx, dy, wheel, _hwheel = self._pend_rel
        if dx or dy:
            # Relative counts: a mouse, a trackpoint, or a touchpad's
            # emulated node. Scaled by its own setting, not the pad geometry,
            # which does not exist for a relative device. Vertical motion is
            # divided again by the cell aspect so a diagonal on the desk
            # stays a diagonal on screen -- a character cell is about twice
            # as tall as it is wide.
            ms = max(0.5, float(p.state.get('mouse_speed', 3.0) or 3.0))
            p._advance(dx / ms, dy / (ms * cell_aspect_value(p.state)))
            moved = True
        if wheel:
            # REL_WHEEL is +1 for a push away from you, which normally moves
            # the view up -- the opposite sign from COS scroll deltas.
            n = 1 if (wheel > 0) == bool(p.state.get('natural_scroll')) else -1
            for _ in range(min(5, abs(int(wheel)))):
                p._emit(('scroll', n))
        self._pend_rel = [0, 0, 0, 0]

        prim = self._mt.get(self._slot) or self._mt.get(0)
        if prim and 'x' in prim and 'y' in prim and self._contact:
            cx, cy = prim['x'], prim['y']
            self.raw = (cx, cy)
            p.raw = (cx, cy)
            if self._last is None:
                self._last = (cx, cy)
            else:
                ddx = cx - self._last[0]
                ddy = cy - self._last[1]
                self._last = (cx, cy)
                if abs(ddx) <= JUMP_REJECT and abs(ddy) <= JUMP_REJECT:
                    self._tap_travel += abs(ddx) + abs(ddy)
                    if self.fingers >= 2:
                        ss = p.scroll_div or 60.0
                        self._scroll_acc += ddy / ss
                        while abs(self._scroll_acc) >= 1.0:
                            step = 1 if self._scroll_acc > 0 else -1
                            self._scroll_acc -= step
                            n = -step if p.state.get('natural_scroll') else step
                            p._emit(('scroll', n))
                    else:
                        sx = p.speed_x or 18.0
                        sy = p.speed_y or 36.0
                        fx = ddx / sx
                        fy = ddy / sy
                        if p.state.get('pointer_accel', True):
                            mag = math.hypot(ddx, ddy)
                            if mag > sx * 1.6:
                                k = min(2.0, 1.0 + (mag / (sx * 14.0)))
                                fx *= k
                                fy *= k
                        p._advance(fx, fy)
                        moved = True
        if moved:
            p._emit(('move',))


class Pointer:
    """The cursor, driven by every pointing device COS can read.

    Opening all of them at once means a plugged-in mouse works next to the
    built-in touchpad with nothing to configure, and unplugging one does not
    take the cursor with it.

    Emits into .events:
        ('move',)
        ('press',  button)   button: 1=left 2=middle 3=right
        ('release',button)
        ('click',  button)   synthesized from a tap
        ('scroll', delta)    +1 = the view moves down
    """

    def __init__(self, state, sound=None):
        self.state = state
        self.sound = sound
        self.x = 10.0
        self.y = 6.0
        self.max_x = 80
        self.max_y = 24
        self.events = deque(maxlen=512)
        self.lock = threading.Lock()
        self._stop = threading.Event()
        self.sources = []
        self.devices = []
        self.shadowed = []          # duplicate nodes of a device already open
        self.failed = []            # [(device, reason)] -- could not be read
        self.device = None          # the touchpad, when there is one
        self.status = 'disabled'
        self.hint = ''
        self.buttons = [False, False, False, False]
        self.raw = (0, 0)
        self.fingers = 0
        self.packets = 0
        self.absinfo = None
        self.speed_x = float(state.get('pointer_speed', 18) or 18)
        self.speed_y = self.speed_x * 2.0
        self.scroll_div = float(state.get('scroll_speed', 60) or 60)
        self.calib_note = 'not calibrated'
        self._frac_x = 0.0
        self._frac_y = 0.0

    # -- lifecycle ----------------------------------------------------------
    @property
    def mode(self):
        for s in self.sources:
            if s.mode == 'direct':
                return 'direct'
        for s in self.sources:
            if s.mode == 'sudo-bridge':
                return 'sudo-bridge'
        return 'off'

    def start(self):
        if not self.state.get('pointer_on', True):
            self.status = 'disabled in Preferences'
            return False
        devs = list_input_devices()
        self.devices = devs
        if not devs:
            self.status = 'no pointing device found'
            self.hint = 'No touchpad or mouse in /proc/bus/input/devices.'
            return False
        prefer = self.state.get('pointer_device', 'auto')
        if prefer and prefer != 'auto':
            devs = [d for d in devs if prefer in (d['path'], d['name'])] or devs
        else:
            # A graphics tablet reports absolute screen coordinates and would
            # fight the cursor, so it is only used when asked for by name.
            devs = [d for d in devs if d['kind'] != 'tablet'] or devs
        # Touchpads first: a pad usually also publishes a plain mouse node
        # carrying the same motion, and the pad has to win so the duplicate
        # can be recognised and dropped below.
        devs.sort(key=lambda d: (d['kind'] != 'touchpad', d['path']))
        self._stop.clear()
        self.shadowed = []
        self.failed = []
        opened = []
        for d in devs:
            if (d['kind'] == 'mouse' and d.get('phys')
                    and any(o.device.get('phys') == d['phys']
                            and o.is_touchpad for o in opened)):
                self.shadowed.append(d)
                continue
            src = PointerSource(self, d)
            if src.start():
                opened.append(src)
            else:
                self.failed.append((d, src.error))
        self.sources = opened
        if not opened:
            self.status = 'permission denied on %s' % devs[0]['path']
            self.hint = (
                'You are not in the "input" group, so COS cannot read the\n'
                'pointer. Fix it once with:\n'
                '    sudo usermod -aG input %s\n'
                'then log out and back in (or reboot).\n'
                'CONTROL > Pointer Setup can run that for you.'
                % os.environ.get('USER', '$USER'))
            return False
        pads = [s for s in opened if s.is_touchpad]
        self.device = pads[0].device if pads else opened[0].device
        self.absinfo = pads[0].absinfo if pads else None
        names = ', '.join(os.path.basename(s.path) for s in opened)
        kinds = ', '.join(sorted({s.kind for s in opened}))
        self.status = '%s (%s, %s)' % (names, kinds, self.mode)
        self.calibrate()
        return True

    @staticmethod
    def _sudo_ok():
        try:
            return subprocess.run(['sudo', '-n', 'true'], timeout=3,
                                  stdout=subprocess.DEVNULL,
                                  stderr=subprocess.DEVNULL).returncode == 0
        except Exception:
            return False

    def stop(self):
        self._stop.set()
        for s in self.sources:
            s.stop()
        for s in self.sources:
            if s.thread:
                s.thread.join(timeout=0.4)
        self.sources = []

    def restart(self):
        self.stop()
        self.status = 'restarting'
        return self.start()

    # -- geometry -----------------------------------------------------------
    def calibrate(self):
        """Size touchpad motion to this pad and this screen."""
        manual = not self.state.get('pointer_auto_speed', True)
        if manual or not self.absinfo:
            self.speed_x = float(max(3, self.state.get('pointer_speed', 18)))
            self.speed_y = self.speed_x * 2.0
            self.scroll_div = float(max(8, self.state.get('scroll_speed', 60)))
            self.calib_note = ('manual' if manual else
                               'no axis info; using the configured speed')
            return
        (xmn, xmx, xres) = self.absinfo['x']
        (ymn, ymx, yres) = self.absinfo['y']
        span_x = max(1, xmx - xmn)
        span_y = max(1, ymx - ymn)
        cols = max(20, self.max_x)
        rows = max(8, self.max_y)
        self.speed_x = max(2.0, span_x / (cols * SWIPE_SCREENS))
        self.speed_y = max(2.0, span_y / (rows * SWIPE_SCREENS))
        self.scroll_div = max(8.0, (yres or 32) * SCROLL_MM_PER_STEP)
        self.state['pointer_speed'] = int(round(self.speed_x))
        if xres and yres:
            self.calib_note = ('auto: pad %.0fx%.0fmm @ %d/mm -> %.1f/%.1f '
                               'units per cell on %dx%d'
                               % (span_x / xres, span_y / yres, xres,
                                  self.speed_x, self.speed_y, cols, rows))
        else:
            self.calib_note = ('auto: pad %dx%d units -> %.1f/%.1f per cell'
                               % (span_x, span_y, self.speed_x, self.speed_y))

    def set_bounds(self, w, h):
        changed = (w, h) != (self.max_x, self.max_y)
        self.max_x, self.max_y = w, h
        self.x = min(max(0.0, self.x), w - 1)
        self.y = min(max(0.0, self.y), h - 1)
        if changed:
            self.calibrate()

    @property
    def pos(self):
        return int(self.x), int(self.y)

    def warp(self, x, y):
        self.x = float(min(max(0, x), self.max_x - 1))
        self.y = float(min(max(0, y), self.max_y - 1))

    def _emit(self, ev):
        with self.lock:
            self.events.append(ev)

    def drain(self):
        with self.lock:
            evs = list(self.events)
            self.events.clear()
        return evs

    def _advance(self, fx, fy):
        # Several devices can push the cursor at once, each from its own
        # thread, so the sub-cell remainder has to be touched under the lock
        # or a fraction of a step can be lost between them.
        with self.lock:
            self._frac_x += fx
            self._frac_y += fy
            ix = int(self._frac_x)
            iy = int(self._frac_y)
            if ix:
                self.x = min(max(0.0, self.x + ix), self.max_x - 1)
                self._frac_x -= ix
            if iy:
                self.y = min(max(0.0, self.y + iy), self.max_y - 1)
                self._frac_y -= iy


# =============================================================================
# KEYBOARD MODIFIERS  --  reading Ctrl/Alt/Shift/Super straight from the kernel
# =============================================================================
# A console hands an application bytes, not key events: Ctrl+F arrives as 0x06
# and Super+Q arrives as a bare 'q', indistinguishable from pressing q. So
# chords involving Super cannot be detected from the byte stream at all.
# Reading the keyboard's evdev node alongside it gives the real modifier
# state, which is then paired with the character curses reports. curses still
# decides *which* key -- keymaps and layouts are its job, not ours.
KEY_LEFTCTRL, KEY_RIGHTCTRL = 29, 97
KEY_LEFTSHIFT, KEY_RIGHTSHIFT = 42, 54
KEY_LEFTALT, KEY_RIGHTALT = 56, 100
KEY_LEFTMETA, KEY_RIGHTMETA = 125, 126

MOD_CTRL, MOD_SHIFT, MOD_ALT, MOD_SUPER = 1, 2, 4, 8

MOD_KEYCODES = {
    KEY_LEFTCTRL: MOD_CTRL, KEY_RIGHTCTRL: MOD_CTRL,
    KEY_LEFTSHIFT: MOD_SHIFT, KEY_RIGHTSHIFT: MOD_SHIFT,
    KEY_LEFTALT: MOD_ALT, KEY_RIGHTALT: MOD_ALT,
    KEY_LEFTMETA: MOD_SUPER, KEY_RIGHTMETA: MOD_SUPER,
}

MOD_NAMES = [(MOD_CTRL, 'Ctrl'), (MOD_ALT, 'Alt'),
             (MOD_SUPER, 'Super'), (MOD_SHIFT, 'Shift')]

# How long after letting a modifier go it still counts. Without this, a quick
# Super+Q can report the modifier as already released by the time curses
# delivers the q.
MOD_GRACE = 0.25


def mod_string(mask):
    return '+'.join(n for bit, n in MOD_NAMES if mask & bit) or 'none'


def keyboard_devices():
    """Event nodes that look like a real keyboard."""
    out = []
    for d in list_input_devices_raw():
        if 'kbd' not in d['handlers']:
            continue
        # KEY_A (30) through KEY_Z: a keyboard, not a lid switch or a mouse
        if _has(d['key'], 30) and _has(d['key'], 44):
            out.append(d)
    return out


def list_input_devices_raw():
    """Every input device, without the pointer-only filtering."""
    out = []
    try:
        with open('/proc/bus/input/devices') as f:
            blocks = f.read().split('\n\n')
    except Exception:
        return out
    for blk in blocks:
        if not blk.strip():
            continue
        d = {'name': '?', 'handlers': [], 'key': 0, 'ev': 0}
        for line in blk.splitlines():
            line = line.strip()
            if line.startswith('N: Name='):
                d['name'] = line[8:].strip().strip('"')
            elif line.startswith('H: Handlers='):
                d['handlers'] = line[12:].split()
            elif line.startswith('B: KEY='):
                d['key'] = _bitmask(line[7:])
            elif line.startswith('B: EV='):
                d['ev'] = _bitmask(line[6:])
        ev = next((h for h in d['handlers'] if h.startswith('event')), None)
        if not ev:
            continue
        d['path'] = '/dev/input/' + ev
        d['readable'] = os.access(d['path'], os.R_OK)
        out.append(d)
    return out


class KeyModifiers:
    """Tracks which modifier keys are held, from the keyboard's evdev node."""

    def __init__(self, state):
        self.state = state
        self.mask = 0
        self.released_at = {}      # modifier bit -> when it went up
        self.device = None
        self.status = 'off'
        self.packets = 0
        self.src = None
        self._stop = threading.Event()
        self.thread = None
        self.lock = threading.Lock()

    def start(self):
        if not self.state.get('keyboard_modifiers', True):
            self.status = 'disabled in Preferences'
            return False
        cands = [d for d in keyboard_devices() if d['readable']]
        if not cands:
            any_kbd = keyboard_devices()
            self.status = ('keyboard found but not readable (join the "input" '
                           'group)' if any_kbd else 'no keyboard device found')
            return False
        dev = cands[0]
        try:
            self.src = open(dev['path'], 'rb', buffering=0)
        except OSError as e:
            self.status = 'cannot open %s: %s' % (dev['path'], e)
            return False
        self.device = dev
        self.status = '%s (%s)' % (os.path.basename(dev['path']),
                                   dev['name'][:28])
        self._stop.clear()
        self.thread = threading.Thread(target=self._reader, daemon=True,
                                       name='cos-modifiers')
        self.thread.start()
        return True

    def stop(self):
        self._stop.set()
        if self.thread:
            self.thread.join(timeout=0.5)
        try:
            if self.src:
                self.src.close()
        except Exception:
            pass
        self.src = None
        self.status = 'off'
        with self.lock:
            self.mask = 0

    @property
    def running(self):
        return self.src is not None and self.thread is not None

    def _reader(self):
        try:
            fd = self.src.fileno()
        except Exception:
            return
        buf = b''
        while not self._stop.is_set():
            try:
                r, _, _ = select.select([fd], [], [], 0.15)
            except Exception:
                break
            if not r:
                continue
            try:
                chunk = os.read(fd, EVENT_SIZE * 64)
            except OSError as e:
                if e.errno in (errno.EAGAIN, errno.EINTR):
                    continue
                break
            if not chunk:
                break
            buf += chunk
            while len(buf) >= EVENT_SIZE:
                pkt, buf = buf[:EVENT_SIZE], buf[EVENT_SIZE:]
                try:
                    _s, _us, etype, code, value = struct.unpack(EVENT_FMT, pkt)
                except struct.error:
                    continue
                self.packets += 1
                if etype != EV_KEY:
                    continue
                bit = MOD_KEYCODES.get(code)
                if bit is None:
                    continue
                with self.lock:
                    if value:                      # press or autorepeat
                        self.mask |= bit
                        self.released_at.pop(bit, None)
                    else:
                        self.mask &= ~bit
                        self.released_at[bit] = time.monotonic()

    def current(self):
        """Modifiers held now, plus any released within the grace window."""
        with self.lock:
            mask = self.mask
            now = time.monotonic()
            for bit, when in list(self.released_at.items()):
                if now - when <= MOD_GRACE:
                    mask |= bit
                else:
                    del self.released_at[bit]
            return mask

    def consume(self):
        """Read the modifiers and forget the grace period.

        Called once a chord has been acted on, so one Super press cannot
        silently apply to the next keystroke as well.
        """
        mask = self.current()
        with self.lock:
            self.released_at.clear()
        return mask


