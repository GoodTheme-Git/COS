def blit_art(scr, art, y0, x0, top=None, bottom=None):
    """Draw parsed ANSI art, grouping runs of equal attribute."""
    for ry, row in enumerate(art):
        y = y0 + ry
        if top is not None and y < top:
            continue
        if bottom is not None and y > bottom:
            break
        run_attr = None
        run = []
        run_x = 0
        for rx, (ch, fg, bg, bold) in enumerate(row):
            a = media_attr(fg, bg, bold)
            if a != run_attr:
                if run:
                    _safestr(scr, y, x0 + run_x, ''.join(run), run_attr)
                run_attr, run, run_x = a, [ch], rx
            else:
                run.append(ch)
        if run:
            _safestr(scr, y, x0 + run_x, ''.join(run), run_attr)


BUILTIN_SPLASH = [
    '  +=============================+',
    '  |   C O S                     |',
    '  |   Channel Operating System  |',
    '  +=============================+',
]


def splash_art(state):
    """The art for the splash: the configured banner, else the built-in."""
    path = state.get('logo_file') or ''
    if state.get('logo_mode') == 'art' and path:
        art = load_ansi_art(path)
        if art:
            return art
    lines = list(BUILTIN_SPLASH)
    return [[(ch, 7, 0, True) for ch in line] for line in lines]


# The boot animation: PNG frames next to cos.py, played as true pixels on
# the DRM framebuffer in place of the progress bar when the desktop renders
# in graphics mode. A different still greets the very first start.
START_SEQ_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                             'cosStartSeq')
START_SEQ_PREFIX = 'cos_start_sequence_'
START_FIRST_TIME = 'cos_start_first_time.png'
START_SEQ_FPS = 10
START_SEQ_DECODERS = 4           # ffmpeg processes decoding frames at once


def start_sequence_files(first_time=False):
    """The frames to play, in numeric order (frame 10 after frame 9)."""
    if first_time:
        p = os.path.join(START_SEQ_DIR, START_FIRST_TIME)
        if os.path.isfile(p):
            return [p]
    try:
        names = os.listdir(START_SEQ_DIR)
    except OSError:
        return []
    frames = []
    for n in names:
        if n.startswith(START_SEQ_PREFIX) and n.lower().endswith('.png'):
            num = n[len(START_SEQ_PREFIX):-4]
            if num.isdigit():
                frames.append((int(num), os.path.join(START_SEQ_DIR, n)))
    return [p for _n, p in sorted(frames)]


def decode_screen_bgrx(path, width, height):
    """One image scaled to fit the panel, letterboxed, as BGRX scanout bytes.

    ffmpeg writes bgr0 directly, which is the framebuffer's own layout, so
    a frame goes to the screen as one copy with no conversion.
    """
    vf = ('scale=%d:%d:force_original_aspect_ratio=decrease:flags=lanczos,'
          'pad=%d:%d:(ow-iw)/2:(oh-ih)/2:black'
          % (width, height, width, height))
    try:
        r = subprocess.run(['ffmpeg', '-hide_banner', '-loglevel', 'error',
                            '-i', path, '-frames:v', '1', '-f', 'rawvideo',
                            '-pix_fmt', 'bgr0', '-vf', vf, '-'],
                           capture_output=True, timeout=30)
    except Exception:
        return None
    need = width * height * 4
    return r.stdout[:need] if len(r.stdout) >= need else None


class BootSplash:
    """What COS shows while it starts up.

    Start-up is not instant -- probing an audio backend alone can take a
    couple of seconds -- so the splash reports what it is waiting on rather
    than leaving a blank console.

    In graphics mode, once main() has the framebuffer, take_display() swaps
    the progress bar for the cosStartSeq/ animation, Win9x style: it loops
    for as long as start-up takes and stops the moment COS is ready. A few
    threads decode the PNGs at the panel's resolution in parallel (one at a
    time made the first loop crawl) and a player thread writes them straight
    into the scanout buffer. Nothing else may present to the framebuffer
    while it runs.
    """

    def __init__(self, stdscr, state):
        self.scr = stdscr
        self.state = state
        self.enabled = bool(state.get('boot_splash', True))
        self.art = splash_art(state) if self.enabled else []
        self.steps = []
        self.total = 7
        self.started = time.monotonic()
        self.first_time = not state.get('boot_seen', True)
        self.gfx = None
        self.seq = []
        self.frames = []            # BGRX bytes per frame, None if undecodable
        self.ready = []             # one Event per frame, set once decoded
        self.shown = 0              # frames put on screen so far
        self.halt = threading.Event()
        self.anim = None

    # -- animation -----------------------------------------------------------
    def take_display(self, gfx):
        """Graphics mode is up: from here on the splash is pixels."""
        if not (gfx and gfx.active):
            return
        self.gfx = gfx
        if not self.enabled:
            return
        if _which('ffmpeg'):
            self.seq = start_sequence_files(self.first_time)
        if not self.seq:
            self.draw(len(self.steps))
            return
        self.halt.clear()
        n = len(self.seq)
        self.frames = [None] * n
        self.ready = [threading.Event() for _ in range(n)]
        todo = iter(range(n))           # shared: frame 0 is decoded first
        lock = threading.Lock()
        size = (gfx.drm.width, gfx.drm.height)

        def decoder():
            while not self.halt.is_set():
                with lock:
                    i = next(todo, None)
                if i is None:
                    return
                self.frames[i] = decode_screen_bgrx(self.seq[i], *size)
                self.ready[i].set()

        for k in range(min(n, START_SEQ_DECODERS, os.cpu_count() or 1)):
            threading.Thread(target=decoder, daemon=True,
                             name='cos-splash-decode-%d' % k).start()
        self.anim = threading.Thread(target=self._play, daemon=True,
                                     name='cos-splash')
        self.anim.start()

    def playing(self):
        return bool(self.anim and self.anim.is_alive())

    def pause(self):
        """Stop drawing so the caller can have the screen."""
        if self.anim:
            self.halt.set()
            self.anim.join(timeout=2.0)
            self.anim = None

    stop = pause

    def _blit(self, data):
        drm = self.gfx.drm
        mm, pitch, row = drm.mm, drm.pitch, drm.width * 4
        if pitch == row:
            mm[0:len(data)] = data
            return
        for y in range(drm.height):
            o = y * pitch
            mm[o:o + row] = data[y * row:(y + 1) * row]

    def _play(self):
        i = 0
        try:
            while True:
                if self.halt.is_set():
                    return
                drm = self.gfx.drm
                if not (self.gfx.active and drm and drm.mm):
                    return              # the framebuffer was given back
                k = i % len(self.seq)
                if not self.ready[k].is_set():
                    self.halt.wait(0.01)    # still decoding; hold this frame
                    continue
                data = self.frames[k]
                t0 = time.monotonic()
                if data is not None:
                    self._blit(data)
                    self.shown += 1
                elif (all(e.is_set() for e in self.ready)
                        and not any(self.frames)):
                    break               # nothing decodes: back to the bar
                i += 1
                if data is not None:
                    self.halt.wait(max(0.0, 1.0 / START_SEQ_FPS
                                       - (time.monotonic() - t0)))
        except (ValueError, OSError, AttributeError):
            return                      # framebuffer went away under us
        self.seq = []
        self.draw(len(self.steps))

    # -- progress ------------------------------------------------------------
    def step(self, label, done=None):
        if not self.enabled:
            return
        self.steps.append(str(label))
        if self.playing():
            return
        self.draw(done if done is not None else len(self.steps))

    def draw(self, done):
        scr = self.scr
        try:
            H, W = scr.getmaxyx()
            scr.erase()
            art_h = len(self.art)
            art_w = max((len(r) for r in self.art), default=0)
            y0 = max(0, H // 2 - art_h // 2 - 3)
            x0 = max(0, (W - art_w) // 2)
            blit_art(scr, self.art, y0, x0, 0, H - 1)
            sub = 'v%s  "%s"' % (VERSION, CODENAME)
            _safestr(scr, y0 + art_h + 1, max(0, (W - len(sub)) // 2), sub,
                     cp(CP_BRIGHT, bold=True))
            bar_y = y0 + art_h + 3
            bw = max(10, min(W - 10, 44))
            bx = max(0, (W - bw) // 2)
            frac = max(0.0, min(1.0, done / float(max(1, self.total))))
            filled = int(round(frac * bw))
            for i in range(bw):
                _safech(scr, bar_y, bx + i,
                        curses.ACS_CKBOARD if i < filled else ord('-'),
                        cp(CP_METER, bold=True) if i < filled
                        else cp(CP_SHADOW))
            if self.steps:
                msg = self.steps[-1]
                _safestr(scr, bar_y + 2, max(0, (W - len(msg)) // 2),
                         msg[:max(0, W - 2)], cp(CP_TEXT))
            scr.refresh()
        except curses.error:
            pass
        if self.gfx and self.gfx.active:
            # the console is in KD_GRAPHICS; curses alone shows nothing
            self.gfx.present(scr)

    def finish(self):
        if not self.enabled:
            return
        if self.playing():
            # The animation runs only as long as start-up does; it is not
            # finished off afterwards. Just make sure it got on screen at all
            # when start-up beat the first decode.
            deadline = time.monotonic() + 1.5
            while (self.playing() and not self.shown
                   and time.monotonic() < deadline):
                time.sleep(0.02)
        else:
            self.draw(self.total)
        hold = float(self.state.get('boot_splash_hold', 0.6) or 0)
        if hold > 0:
            # a splash nobody can read is just a flicker
            elapsed = time.monotonic() - self.started
            if elapsed < hold:
                time.sleep(hold - elapsed)
        self.pause()
        if self.first_time and self.shown:
            # the first-start picture only counts once someone has seen it
            self.state['boot_seen'] = True
            save_config(self.state)


# -- login -------------------------------------------------------------------
def hash_password(password, salt=None):
    """PBKDF2 so the config never holds the password itself."""
    salt = salt or secrets.token_hex(8)
    digest = hashlib.pbkdf2_hmac('sha256', password.encode('utf-8'),
                                 salt.encode('ascii'), 120000).hex()
    return salt, digest


def check_password(state, password):
    salt = state.get('login_salt') or ''
    want = state.get('login_hash') or ''
    if not (salt and want):
        return True
    _s, got = hash_password(password, salt)
    return secrets.compare_digest(got, want)


def login_screen(stdscr, state):
    """Ask for the password before the desktop appears.

    This is a screen lock for the look of the thing, not security: anyone
    who can read ~/.cos_config can turn it off, and anyone who can run
    python can skip it. It is here because a login screen is part of the
    furniture, not because it protects anything.
    """
    if not state.get('login_enabled'):
        return True
    art = splash_art(state)
    user = str(state.get('login_user') or os.environ.get('USER') or 'operator')
    has_pw = bool(state.get('login_hash'))
    buf = ''
    message = ''
    attempts = 0
    curses.curs_set(1)
    try:
        while True:
            H, W = stdscr.getmaxyx()
            try:
                stdscr.bkgdset(' ', cp(CP_DESKTOP))
            except curses.error:
                pass
            stdscr.erase()
            art_h = len(art)
            art_w = max((len(r) for r in art), default=0)
            y0 = max(0, H // 2 - art_h // 2 - 4)
            blit_art(stdscr, art, y0, max(0, (W - art_w) // 2), 0, H - 1)
            sub = 'v%s  "%s"' % (VERSION, CODENAME)
            _safestr(stdscr, y0 + art_h + 1, max(0, (W - len(sub)) // 2), sub,
                     cp(CP_BRIGHT, bold=True))
            box_w = min(max(40, len(user) + 24), W - 4)
            box_x = max(0, (W - box_w) // 2)
            box_y = y0 + art_h + 3
            draw_box(stdscr, box_y, box_x, 7, box_w, cp(CP_WINDOW),
                     cp(CP_WINDOW))
            t = ' Sign in '
            _safestr(stdscr, box_y, box_x + max(0, (box_w - len(t)) // 2), t,
                     cp(CP_WIN_TITLE, bold=True))
            _safestr(stdscr, box_y + 2, box_x + 3, 'User     : ' + user,
                     cp(CP_TEXT))
            field_w = max(8, box_w - 18)
            _safestr(stdscr, box_y + 3, box_x + 3, 'Password : ', cp(CP_TEXT))
            _safestr(stdscr, box_y + 3, box_x + 14, ' ' * field_w,
                     cp(CP_INPUT))
            _safestr(stdscr, box_y + 3, box_x + 14,
                     ('*' * len(buf))[-field_w:], cp(CP_INPUT, bold=True))
            if not has_pw:
                _safestr(stdscr, box_y + 5, box_x + 3,
                         'No password set -- just press ENTER.'[:box_w - 4],
                         cp(CP_SHADOW))
            elif message:
                _safestr(stdscr, box_y + 5, box_x + 3, message[:box_w - 4],
                         cp(CP_WARN, bold=True))
            foot = 'ENTER signs in     ESC leaves COS'
            _safestr(stdscr, box_y + 8, max(0, (W - len(foot)) // 2), foot,
                     cp(CP_STATUS))
            try:
                stdscr.move(box_y + 3, box_x + 14 + min(field_w - 1, len(buf)))
            except curses.error:
                pass
            stdscr.refresh()
            key = stdscr.getch()
            if key == 27:
                return False
            if key in (curses.KEY_ENTER, 10, 13):
                if check_password(state, buf):
                    return True
                attempts += 1
                buf = ''
                message = 'Wrong password. Try again.'
                if attempts >= 3:
                    message = ('Wrong password. ESC leaves; '
                               'see the Help menu to reset it.')
            elif key in (curses.KEY_BACKSPACE, 127, 8):
                buf = buf[:-1]
            elif key == 21:
                buf = ''
            elif key == curses.KEY_RESIZE:
                try:
                    curses.resizeterm(*stdscr.getmaxyx())
                except curses.error:
                    pass
            elif 32 <= key <= 126:
                buf += chr(key)
    finally:
        try:
            curses.curs_set(0)
        except curses.error:
            pass


# =============================================================================
# MAIN LOOP
# =============================================================================
FRAME_MS = 28
REDRAW_EVERY = 0.25


def grab_control_keys():
    """Stop the tty line discipline from eating keys COS needs.

    A Linux console has XON/XOFF flow control on by default, so ^Q and ^S
    never reach the program -- ^Q is XON and ^S is XOFF. ^Z would suspend
    COS outright, and ^C would interrupt. Clear them and return the old
    so they can be restored on exit.
    """
    try:
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
    except Exception:
        return None
    try:
        new = termios.tcgetattr(fd)
        new[0] &= ~(termios.IXON | termios.IXOFF | termios.IXANY)
        new[6] = list(new[6])
        new[6][termios.VSUSP] = b'\x00'      # no ^Z suspend
        new[6][termios.VLNEXT] = b'\x00'     # no ^V literal-next
        new[6][termios.VQUIT] = b'\x00'      # no ^\ core dump
        # ^C becomes an ordinary byte so it can open the CONTROL menu.
        # COS is full-screen and has its own ways out (^Q, ^X,
        # Ctrl+Alt+Q), and a crash still lands on the error screen
        # rather than a dead terminal.
        new[6][termios.VINTR] = b'\x00'
        termios.tcsetattr(fd, termios.TCSANOW, new)
    except Exception:
        return old
    return old


def restore_control_keys(old):
    if old is None:
        return
    try:
        termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old)
    except Exception:
        pass
_KEYLOG = (open(os.environ['COS_KEYLOG'], 'a', buffering=1)
           if os.environ.get('COS_KEYLOG') else None)


def main(stdscr):
    curses.cbreak()
    curses.noecho()
    stdscr.keypad(True)
    try:
        curses.set_escdelay(25)      # report a bare ESC in 25ms, not 1s
    except (AttributeError, curses.error):
        pass
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    try:
        curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)
    except curses.error:
        pass
    # xterm 1003: only does anything in a graphical terminal, harmless in a TTY
    sys.stdout.write('\033[?1003h')
    sys.stdout.flush()
    saved_tty = grab_control_keys()
    init_colors()

    global _LAST_STATE
    state = {'running': True, 'messages': []}
    load_config(state)
    _LAST_STATE = state
    apply_theme(state.get('theme_idx', 0))

    splash = BootSplash(stdscr, state)
    splash.step('starting up...', 1)
    try:
        if not login_screen(stdscr, state):
            restore_control_keys(saved_tty)
            sys.stdout.write('\033[?1003l')
            sys.stdout.flush()
            return

        # BETA: graphics mode is set up here, once, straight after the login,
        # so the boot animation can play as real pixels while sound, the
        # pointer and the apps start. A failure here tears itself down and
        # leaves the text splash and a working console to complain on.
        gfx = None
        gdr_note = ''
        want_render = state.get('desktop_render', 'text')
        stale = gdr_marker_read()
        if want_render == 'graphics' and stale:
            gdr_marker_clear()
            state['desktop_render'] = 'text'
            want_render = 'text'
            save_config(state)
            gdr_note = ('Graphics mode did not come back last time (%s), so COS '
                        'started in text mode.' % stale.replace('\n', ' -- '))
        elif want_render == 'graphics':
            splash.step('taking the screen...', 2)
            gdr_marker_write('tty %s, pid %d' % (tty_number() or '?', os.getpid()))
            gfx = GraphicsDesktop(state)
            if not gfx.start():
                gdr_marker_clear()
                gdr_note = 'Graphics mode could not start: %s' % gfx.error
                gfx = None
                state['desktop_render'] = 'text'
                want_render = 'text'
        os.environ[COS_RENDER_ENV] = want_render
        splash.take_display(gfx)

        splash.step('preparing sound...', 3)
        sound = SoundEngine(state)
        sound.init()
        write_sound_readme()

        splash.step('looking for a pointer...', 4)
        ptr = Pointer(state, sound)
        ptr.start()
        mods = KeyModifiers(state)
        mods.start()

        splash.step('building the desktop...', 5)
        wm = WindowManager(stdscr, state, sound, ptr)
        wm.mods = mods
        wm.saved_tty = saved_tty
        wm.gfx = gfx
        splash.step('loading apps...', 6)
        wm.registry = AppRegistry(state)
        wm.registry.scan()

        splash.step('ready', 7)
        splash.finish()
        # armed only now, so the time to confirm the screen is not spent on
        # start-up -- which the animation already shows is getting through
        watchdog = None
        if gfx:
            watchdog = GdrWatchdog(GDR_WATCHDOG_SECONDS, gfx.stop)
            watchdog.start()
    except BaseException:
        splash.stop()           # its thread must not draw over the error
        raise
    wm.notify(f'[COS] Channel Operating System v{VERSION} "{CODENAME}" ready.', None)
    wm.notify('[COS] ^F ^E ^A ^C ^S ^W ^P = menus   TAB = next window   '
              'F1 = help   Ctrl+Alt+Q = quit', None)
    if mods.running:
        wm.notify(f'[COS] Keyboard: {mods.status} -- Super and Ctrl+Alt '
                  'chords available.', None)
    else:
        wm.notify(f'[COS] Modifier keys unavailable: {mods.status}. '
                  'Ctrl and Alt shortcuts still work.', None)
    if ptr.mode in ('direct', 'sudo-bridge'):
        pads = sum(1 for x in ptr.sources if x.is_touchpad)
        mice = len(ptr.sources) - pads
        what = ' and '.join(
            p for p in ('%d touchpad%s' % (pads, '' if pads == 1 else 's') if pads else '',
                        '%d mouse' % mice if mice == 1 else
                        '%d mice' % mice if mice else '') if p)
        wm.notify(f'[COS] Pointer: {what} -- {ptr.status}', None)
        wm.notify('[COS] Tap or click to click, two fingers or the wheel '
                  'to scroll.', None)
    else:
        wm.notify(f'[COS] No pointer available: {ptr.status}', None)
        wm.notify('[COS] CONTROL > Pointer Setup to fix it; '
                  'keyboard works meanwhile (F12 = cursor keys).', None)
    if gdr_note:
        wm.notify('[COS] ' + gdr_note, 'warn')
    elif gfx and gfx.active:
        wm.notify('[COS] Desktop rendering: GRAPHICS (BETA) -- press any key '
                  'to confirm you can see this.', None)
    if wm.registry.safe_mode:
        wm.notify('[COS] Apps disabled (COS_NO_APPS). APPS > App Manager is '
                  'still available.', None)
    elif wm.registry.apps:
        _ok, _bad = len(wm.registry.working), len(wm.registry.broken)
        wm.notify(f'[COS] Apps: {_ok} loaded'
                  + (f', {_bad} broken -- APPS > App Manager' if _bad else ''),
                  None)
    if SILENT:
        wm.notify('[COS] Sound suppressed by COS_SILENT.', None)
    elif sound.ready:
        wm.notify(f'[COS] Sound: {sound.backend}. Drop your own files in '
                  f'{SOUND_DIR}', None)
    else:
        wm.notify(f'[COS] Sound off: {sound.note}', None)
    sound.play('boot')
    if os.environ.get('COS_CRASH_TEST') or '--crash-test' in sys.argv:
        raise CosFatal('COS_CRASH_TEST was set, so this is a deliberate '
                       'crash to exercise the error screen.',
                       'Crash test')

    last_draw = 0.0
    cursor_keys = False
    state['cursor_keys'] = False

    while state['running']:
        H, W = stdscr.getmaxyx()
        if (W, H) != state.get('_grid'):
            state['_grid'] = (W, H)
            state['_cell_aspect_detected'] = detect_cell_aspect(W, H)
        lay = Layout(H, W, state)
        wm.lay = lay
        ptr.set_bounds(W, H)

        if wm.shell_request:
            run_shell_request(stdscr, wm)
            continue

        for w in list(wm.wins):
            w.clamp(lay)
            try:
                w.tick()
            except CosFatal:
                raise
            except Exception as e:
                wm.notify(f'[{w.title}] tick error: {e}', 'error')
                wm.close(w, sound=None)

        now = time.monotonic()
        if (not state.get('_update_seen')
                and now - state.get('_mtime_checked', 0.0) > 4.0):
            state['_mtime_checked'] = now
            if self_mtime() != _SELF_MTIME:
                state['_update_seen'] = True
                wm.notify('[COS] cos.py has changed on disk. Apps reload by '
                          'themselves, but COS does not -- press ^R to '
                          'restart it.', 'notify')
        if wm.dirty or (now - last_draw) >= REDRAW_EVERY:
            wm.draw()
            stdscr.refresh()
            if gfx and gfx.active:
                try:
                    # Only the focused window is offered the pixel path: it
                    # is the one on top, so it is the only one whose pixels
                    # cannot land over something that should cover them.
                    if (state.get('gdr_pixel_windows', True) and wm.active
                            and not wm.menu_open and not wm.kbmode):
                        try:
                            rect = wm.active.pixel_rect(gfx.font['w'],
                                                        gfx.font['h'])
                        except Exception:
                            rect = None
                        if rect:
                            gfx.blit_pixels(*rect)
                    gfx.present(stdscr)
                except Exception as e:
                    # Never take the desktop down over a presentation bug:
                    # put text mode back and carry on in it.
                    gfx.stop()
                    gfx = None
                    wm.gfx = None
                    state['desktop_render'] = 'text'
                    wm.notify('[COS] Graphics mode stopped: %s' % e, 'error')
            wm.dirty = False
            last_draw = now

        # ---- pointer events ------------------------------------------
        for ev in ptr.drain():
            gx, gy = ptr.pos
            kind = ev[0]
            if kind == 'move':
                wm.pointer_move(gx, gy)
            elif kind == 'press':
                wm.pointer_press(ev[1], gx, gy, lambda a: handle_action(a, wm, state))
            elif kind == 'release':
                wm.pointer_release(ev[1], gx, gy)
            elif kind == 'click':
                wm.pointer_press(ev[1], gx, gy, lambda a: handle_action(a, wm, state))
                wm.pointer_release(ev[1], gx, gy)
            elif kind == 'scroll':
                wm.pointer_scroll(ev[1], gx, gy)

        # ---- keyboard ------------------------------------------------
        stdscr.timeout(FRAME_MS)
        key = stdscr.getch()
        if key == -1:
            continue
        alt = False
        if key == 27:
            # Distinguish a bare ESC from Alt+key: with a short escdelay the
            # terminal has already delivered the second byte, so peek for it.
            stdscr.timeout(0)
            nxt = stdscr.getch()
            if nxt != -1:
                key, alt = nxt, True
        if _KEYLOG:
            _KEYLOG.write(f'key={key} alt={alt} menu={wm.menu_open} '
                          f'kb={bool(wm.kbmode)} wins={len(wm.wins)}\n')
            _KEYLOG.flush()

        wm.dirty = True
        if watchdog and not watchdog.pet.is_set():
            # A frame was presented and a key arrived, so the desktop is
            # genuinely up and someone can see it. Stand the watchdog down
            # and drop the marker that says the attempt is still in doubt.
            watchdog.alive()
            gdr_marker_clear()
            if gfx:
                wm.notify('[COS] Graphics mode: ' + gfx.status, None)

        # Modifier state comes from the keyboard device, because a console
        # cannot express Super+Q in its byte stream at all.
        mask = mods.consume() if mods.running else 0
        letter = chr(key).lower() if 32 <= key <= 126 else ''

        # Ctrl+Alt+Q quits COS -- from the real modifier state, or from the
        # ESC-prefixed ^Q the console sends for the same chord.
        if ((mask & MOD_CTRL and mask & MOD_ALT and letter == 'q')
                or (alt and key == 17)):
            handle_action('exit', wm, state); continue
        # Super+Q closes the focused window. No byte sequence exists for
        # this, so it needs the modifier reader.
        if mask & MOD_SUPER and letter == 'q':
            if wm.active:
                wm.close(wm.active)
            else:
                wm.notify('[COS] No window to close.', 'warn')
            continue

        if key == curses.KEY_RESIZE:
            try:
                curses.resizeterm(*stdscr.getmaxyx())
            except curses.error:
                pass
            continue

        if key == curses.KEY_MOUSE:
            try:
                _id, mx, my, _z, bstate = curses.getmouse()
                ptr.warp(mx, my)
                dispatch = lambda a: handle_action(a, wm, state)
                if bstate & curses.BUTTON1_PRESSED:
                    wm.pointer_press(1, mx, my, dispatch)
                elif bstate & curses.BUTTON1_RELEASED:
                    wm.pointer_release(1, mx, my)
                elif bstate & (curses.BUTTON1_CLICKED | curses.BUTTON1_DOUBLE_CLICKED):
                    wm.pointer_press(1, mx, my, dispatch)
                    wm.pointer_release(1, mx, my)
                elif bstate & curses.BUTTON3_CLICKED:
                    wm.pointer_press(3, mx, my, dispatch)
                    wm.pointer_release(3, mx, my)
                elif bstate & getattr(curses, 'BUTTON4_PRESSED', 0):
                    wm.pointer_scroll(-1, mx, my)
                elif bstate & getattr(curses, 'BUTTON5_PRESSED', 0):
                    wm.pointer_scroll(1, mx, my)
                else:
                    wm.pointer_move(mx, my)
            except curses.error:
                pass
            continue

        # keyboard move/resize mode owns everything
        if wm.kbmode:
            wm.kbmode_key(key)
            continue

        # Alt+W closes the focused window, and unlike Super+Q it works with
        # no access to the keyboard device.
        if alt and letter == 'w':
            if wm.active:
                wm.close(wm.active)
            continue
        # alt+letter always opens a menu
        if alt and 32 <= key <= 126 and chr(key).lower() in MENUS:
            wm.open_menu(chr(key).lower())
            continue
        if key == 27 and not alt:
            # An open menu swallows ESC first, then the focused window gets a
            # chance to cancel itself (dialogs, search fields), and only then
            # does ESC fall through to leaving cursor-key mode.
            if wm.menu_open:
                wm.close_menu()
            elif wm.active and _safe_key(wm, wm.active, 27):
                pass
            elif cursor_keys:
                cursor_keys = False
                state['cursor_keys'] = False
                wm.notify('[COS] Cursor-key mode off.', 'click')
            continue

        # open menu navigation
        if wm.menu_open:
            items = wm.menu_items()
            if key == curses.KEY_UP:
                wm.menu_step(-1)
            elif key == curses.KEY_DOWN:
                wm.menu_step(1)
            elif key == curses.KEY_LEFT:
                wm.menu_sibling(-1)
            elif key == curses.KEY_RIGHT:
                wm.menu_sibling(1)
            elif key in (curses.KEY_ENTER, 10, 13):
                action = items[wm.menu_sel][1] if items else None
                wm.close_menu()
                sound.play('click')
                if action:
                    handle_action(action, wm, state)
            elif key in (curses.KEY_F10, 9):
                wm.close_menu()
            elif 32 <= key <= 126 and chr(key).lower() in MENUS:
                wm.open_menu(chr(key).lower())
            continue

        # global keys
        if key in (17, 24):                             # ^Q / ^X
            handle_action('exit', wm, state); continue
        if key == 18:                                   # ^R
            handle_action('restart_cos', wm, state); continue
        if key == 23:                                   # ^W
            if wm.active:
                wm.close(wm.active)
            continue
        if key == curses.KEY_F10:
            wm.open_menu(MENU_ORDER[0]); continue
        if (state.get('ctrl_opens_menus', True) and key in CTRL_MENU
                and not (wm.active and key in wm.active.claims_ctrl)):
            wm.open_menu(CTRL_MENU[key]); continue
        if key == curses.KEY_F1:
            handle_action('help', wm, state); continue
        if key == curses.KEY_F7:
            wm.begin_kbmode('move'); continue
        if key == curses.KEY_F8:
            wm.begin_kbmode('resize'); continue
        if key == curses.KEY_F9:
            handle_action('win_max', wm, state); continue
        if key == curses.KEY_F5 and not wm.active:
            if wm.registry:
                wm.registry.scan()
                wm.registry.reload_all()
                _ok, _bad = len(wm.registry.working), len(wm.registry.broken)
                wm.notify(f'[COS] Rescanned apps: {_ok} loaded, {_bad} broken',
                          'drop')
            continue
        if key == curses.KEY_F12:
            cursor_keys = not cursor_keys
            state['cursor_keys'] = cursor_keys
            wm.notify(f'[COS] Cursor-key mode {"ON -- arrows move the pointer, "
                      "ENTER clicks" if cursor_keys else "off"}.', 'click')
            continue
        # cursor-key mode steals the arrows
        if cursor_keys and key in (curses.KEY_UP, curses.KEY_DOWN,
                                   curses.KEY_LEFT, curses.KEY_RIGHT,
                                   curses.KEY_ENTER, 10, 13, ord('.')):
            gx, gy = ptr.pos
            step = 1
            if key == curses.KEY_UP:    ptr.warp(gx, gy - step)
            elif key == curses.KEY_DOWN:  ptr.warp(gx, gy + step)
            elif key == curses.KEY_LEFT:  ptr.warp(gx - step, gy)
            elif key == curses.KEY_RIGHT: ptr.warp(gx + step, gy)
            else:
                btn = 3 if key == ord('.') else 1
                nx, ny = ptr.pos
                wm.pointer_press(btn, nx, ny, lambda a: handle_action(a, wm, state))
                wm.pointer_release(btn, nx, ny)
            continue

        # focused window first
        if wm.active and _safe_key(wm, wm.active, key):
            continue

        if key == 9:
            wm.cycle(); continue
        if key == curses.KEY_BTAB:
            wm.cycle(back=True); continue

        # unconsumed printable: menu hotkey, or desktop shortcuts
        if 32 <= key <= 126:
            ch = chr(key).lower()
            if ch in MENUS:
                wm.open_menu(ch); continue
            if not wm.wins:
                if ch == 'q':
                    handle_action('exit', wm, state); continue
                icons = wm.icon_rects()
                if ch.isdigit() and 1 <= int(ch) <= len(icons):
                    handle_action(icons[int(ch) - 1][4], wm, state); continue

        # desktop icon navigation with arrows
        if not wm.wins and key in (curses.KEY_UP, curses.KEY_DOWN,
                                   curses.KEY_ENTER, 10, 13):
            icons = wm.icon_rects()
            if icons:
                if key == curses.KEY_UP:
                    wm.icon_sel = (wm.icon_sel - 1) % len(icons)
                elif key == curses.KEY_DOWN:
                    wm.icon_sel = (wm.icon_sel + 1) % len(icons)
                else:
                    if 0 <= wm.icon_sel < len(icons):
                        handle_action(icons[wm.icon_sel][4], wm, state)
            continue

    # ---- shutdown -------------------------------------------------------
    # The screen goes back first. Everything after this can be seen.
    if watchdog:
        watchdog.cancel()
    if gfx:
        gfx.stop()
    gdr_marker_clear()
    save_config(state)
    sound.play_blocking('shutdown', timeout=3)
    mods.stop()
    ptr.stop()
    sound.shutdown()
    restore_control_keys(saved_tty)
    sys.stdout.write('\033[?1003l')
    sys.stdout.flush()


def _safe_key(wm, win, key):
    """Hand a key to a window; a crashing app must not take COS down."""
    try:
        return bool(win.on_key(key))
    except CosFatal:
        raise                      # deliberate: let it reach the top
    except SystemExit:
        wm.notify(f'[{win.title}] called sys.exit(); ignored', 'warn')
        return True
    except Exception as e:
        wm.notify(f'[{win.title}] key error: {type(e).__name__}: {e}', 'error')
        return True


def run_shell_request(stdscr, wm):
    """Leave curses, run the pending callable, come back."""
    fn, label = wm.shell_request
    wm.shell_request = None
    # Whatever this is about to run prints on the bare console, and in
    # graphics mode the console is blanked and the CRTC is ours. Give both
    # back for the duration; a restart never comes back from fn() at all,
    # and would otherwise leave the screen dark.
    resume_gfx = bool(wm.gfx and wm.gfx.active)
    if resume_gfx:
        wm.gfx.stop()
    curses.def_prog_mode()
    curses.endwin()
    sys.stdout.write('\033[?1003l')
    sys.stdout.flush()
    had_pointer = wm.ptr.mode in ('direct', 'sudo-bridge')
    wm.ptr.stop()
    # curses.endwin() has already put the tty back in shell mode, which undoes
    # grab_control_keys() for us -- echo and line editing must work in here.
    try:
        fn()
    except Exception as e:
        print(f'\n  {label} failed: {type(e).__name__}: {e}')
        time.sleep(2)
    curses.reset_prog_mode()
    wm.saved_tty = grab_control_keys()
    sys.stdout.write('\033[?1003h')
    sys.stdout.flush()
    stdscr.clear()
    stdscr.refresh()
    if resume_gfx and wm.gfx:
        if wm.gfx.start():
            wm.gfx.present(stdscr, force=True)
        else:
            wm.notify('[COS] Graphics mode did not come back: %s'
                      % wm.gfx.error, 'error')
            wm.gfx = None
    if wm.state.get('pointer_on', True):
        wm.ptr.restart()
    load_config(wm.state)
    wm.dirty = True
    wm.notify(f'[COS] {label} finished.'
              + ('' if (not had_pointer or wm.ptr.mode != 'off')
                 else '  Pointer did not come back -- CONTROL > Trackpad Setup.'),
              'notify')


def write_sound_readme():
    """Tell the user which sound names COS uses, so they can drop in their own."""
    path = os.path.join(SOUND_DIR, 'README.txt')
    try:
        os.makedirs(SOUND_DIR, exist_ok=True)
        if os.path.exists(path):
            return
        with open(path, 'w') as f:
            f.write(
                'COS sound pack\n'
                '==============\n\n'
                'Drop your own sound files in THIS folder to replace the\n'
                'tones COS synthesized for itself. Name the file after the\n'
                'event you want it on, with any of these extensions:\n\n'
                '    .wav  .ogg  .opus  .flac  .mp3  .m4a  .aiff\n\n'
                'A file here ALWAYS wins over the built-in tone, which lives\n'
                'in the builtin/ subfolder. COS never writes to this folder\n'
                'except for this README, and never overwrites your files.\n\n'
                'Example -- use the Microsoft startup sound as the COS\n'
                'startup sound:\n\n'
                '    cp ~/cos/microsoftsound.mp3 ~/.cos/sounds/boot.mp3\n\n'
                'Names COS plays:\n\n')
            meaning = {
                'boot': 'COS starts up',
                'click': 'a button, menu item or icon is clicked',
                'menu': 'a menu opens / selection moves',
                'open': 'a window opens',
                'close': 'a window closes',
                'notify': 'general notification',
                'error': 'something failed',
                'warn': 'a warning',
                'drop': 'a drag is committed, a file is saved',
                'key': 'small keypress tick',
                'shutdown': 'COS exits',
                'coin': 'a sale completes in the POS shell',
            }
            for name in sorted(SOUND_SPECS):
                f.write(f'    {name + ".wav":<16} {meaning.get(name, "")}\n')
            f.write('\nShort files work best: 50-400 ms for clicks and blips.\n'
                    'A long file is fine for boot and shutdown.\n\n'
                    'Delete one of your files and the built-in tone comes\n'
                    'back. Delete a file under builtin/ and COS re-synthesizes\n'
                    'it at next start (or Preferences > Re-synthesize).\n')
    except Exception:
        pass


SOUND_SEARCH_EXT = ('.wav', '.ogg', '.opus', '.flac', '.mp3', '.m4a', '.aiff')


def find_sound_file(name):
    """Resolve a COS sound name to a file.

    Anything the user dropped in ~/.cos/sounds wins, in any supported
    format. Only if nothing is there do we fall back to the tone COS
    synthesized for itself in ~/.cos/sounds/builtin.
    """
    for ext in SOUND_SEARCH_EXT:
        p = os.path.join(SOUND_DIR, name + ext)
        if os.path.isfile(p):
            return p
    p = os.path.join(BUILTIN_DIR, name + '.wav')
    return p if os.path.isfile(p) else None


def is_custom_sound(name):
    f = find_sound_file(name)
    return bool(f) and os.path.dirname(f) == os.path.abspath(SOUND_DIR)


