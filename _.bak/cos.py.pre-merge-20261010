class TrackpadSetup(Window):
    icon = '+'
    min_w, min_h = 56, 16

    def __init__(self, state, pointer):
        super().__init__('Pointer Setup', w=74, h=24)
        self.state = state
        self.ptr = pointer
        self.devs = list_input_devices()
        # Start on the device actually in use, so a stray ENTER cannot
        # downgrade a multitouch pad to a bare relative node.
        self.sel = 0
        if pointer.device:
            for i, d in enumerate(self.devs):
                if d['path'] == pointer.device['path']:
                    self.sel = i
                    break
        self.msg = ''
        self.trail = deque(maxlen=120)
        self._lastpk = 0

    def status(self):
        return self.msg or ('UP/DN pick  ENTER use only it  0 use all  '
                            'G=grant  R=rescan  +/- pad  < > mouse  '
                            'C=recalibrate  [ ] scroll  T=tap  N=natural')

    def tick(self):
        if self.ptr.packets != self._lastpk:
            self._lastpk = self.ptr.packets
            self.trail.append(self.ptr.pos)

    def draw_client(self, c, active):
        c.fill(cp(CP_WINDOW))
        W = c.w
        p = self.ptr
        ok = p.mode in ('direct', 'sudo-bridge')
        c.put(0, 1, 'STATUS: ', cp(CP_BRIGHT, bold=True))
        c.put(0, 9, ('ACTIVE -- ' if ok else 'INACTIVE -- ') + p.status,
              cp(CP_GREEN, bold=True) if ok else cp(CP_WARN, bold=True))
        c.put(1, 1, f'mode {p.mode}   packets {p.packets}   '
                    f'raw {p.raw[0]:>5},{p.raw[1]:>5}   fingers {p.fingers}   '
                    f'btn {"".join("LMR"[i - 1] if p.buttons[i] else "-" for i in (1, 2, 3))}',
              cp(CP_TEXT))
        c.put(2, 1, ('open: ' + ('  '.join(
            '%s %d' % (os.path.basename(x.path), x.packets) for x in p.sources)
            or 'none'))[:W - 2], cp(CP_SHADOW))
        row = 4
        self._row0 = row
        c.put(row, 1, 'DEVICES  (green = in use, "dup" = same device as a pad)',
              cp(CP_MENU_SEL)); row += 1
        live = {x.path for x in p.sources}
        dupe = {d['path'] for d in p.shadowed}
        for i, d in enumerate(self.devs):
            if row >= c.h - 9:
                break
            cur = d['path'] in live
            mark = '>' if i == self.sel else ' '
            flag = '*' if cur else ('+' if d['path'] in dupe
                                    else ' ' if d['readable'] else '!')
            tags = []
            if d.get('mt'): tags.append('multitouch')
            if d.get('buttonpad'): tags.append('clickpad')
            if d.get('two_finger'): tags.append('2-finger')
            if d.get('has_right'): tags.append('buttons')
            if d['path'] in dupe: tags.append('dup')
            line = (f'{mark}{flag} {d["path"]:<18} {d["kind"]:<9} '
                    f'{d["name"][:22]:<22} {",".join(tags)}')
            a = (cp(CP_SEL, bold=True) if i == self.sel else
                 cp(CP_GREEN, bold=True) if cur else
                 cp(CP_TEXT) if d['readable'] else cp(CP_SHADOW))
            c.put(row, 1, line[:W - 2], a)
            row += 1
        if not any(d['readable'] for d in self.devs):
            c.put(row, 1, '! No input device is readable by your user.',
                  cp(CP_WARN, bold=True)); row += 1
            c.put(row, 3, f'Press G to run:  sudo usermod -aG input '
                          f'{os.environ.get("USER", "you")}', cp(CP_BRIGHT)); row += 1
            c.put(row, 3, 'Then log out and back in (or reboot) and restart COS.',
                  cp(CP_TEXT)); row += 1
        row = max(row + 1, c.h - 7)
        c.put(row, 1, 'TUNING', cp(CP_MENU_SEL)); row += 1
        s = self.state
        auto = s.get('pointer_auto_speed', True)
        c.put(row, 1, f'speed {p.speed_x:>5.1f} x {p.speed_y:>5.1f} units/cell '
                      f'(+/-)  {"AUTO" if auto else "manual"} (C=recalibrate)'[:W - 2],
              cp(CP_TEXT)); row += 1
        c.put(row, 1, f'scroll {p.scroll_div:>5.1f} ([ ])  '
                      f'accel {"ON " if s.get("pointer_accel") else "off"} (A)  '
                      f'tap {"ON " if s.get("tap_to_click") else "off"} (T)  '
                      f'natural {"ON " if s.get("natural_scroll") else "off"} (N)'[:W - 2],
              cp(CP_TEXT)); row += 1
        c.put(row, 1, f'mouse {float(s.get("mouse_speed", 3.0)):>5.1f} counts/cell '
                      f'(< >)  -- applies to a mouse or trackpoint, not the pad'[:W - 2],
              cp(CP_TEXT)); row += 1
        if row < c.h - 1:
            c.put(row, 1, p.calib_note[:W - 2], cp(CP_GREEN)); row += 1
        # live test strip
        if row < c.h - 1:
            c.put(row, 1, 'TEST: move a finger on the pad; tap to click here ->',
                  cp(CP_SHADOW))
            c.put(row, 54, '[ TAP ME ]', cp(CP_MENU_SEL, bold=True))
            self._tap_row = row

    def on_click(self, row, col, btn):
        if row == getattr(self, '_tap_row', -1) and 54 <= col < 64:
            self.msg = f'Got button {btn} at client ({row},{col}) -- it works!'
            if self.wm: self.wm.sound.play('coin')
            return True
        r0 = getattr(self, '_row0', 4) + 1
        i = row - r0
        if 0 <= i < len(self.devs):
            self.sel = i
            if self.wm and self.wm.double:
                self.use_selected()
            return True
        return False

    def use_selected(self):
        if not self.devs:
            return
        d = self.devs[self.sel]
        self.state['pointer_device'] = d['path']
        self.state['pointer_on'] = True
        save_config(self.state)
        okay = self.ptr.restart()
        self.msg = (f'Using only {d["path"]}' if okay
                    else f'Could not open {d["path"]}: {self.ptr.status}')
        if self.wm:
            self.wm.sound.play('drop' if okay else 'error')

    def use_all(self):
        """Back to reading every pointer at once, which is the default."""
        self.state['pointer_device'] = 'auto'
        self.state['pointer_on'] = True
        save_config(self.state)
        okay = self.ptr.restart()
        self.msg = ('Using every pointer: ' + self.ptr.status if okay
                    else 'No pointer could be opened: ' + self.ptr.status)
        if self.wm:
            self.wm.sound.play('drop' if okay else 'error')

    def _manual(self):
        """Any hand tuning disables auto-calibration for good."""
        if self.state.get('pointer_auto_speed', True):
            self.state['pointer_auto_speed'] = False
            self.msg = 'Auto-calibration off (C re-enables it)'

    def grant(self):
        if self.wm:
            self.wm.request_shell(grant_input_access, 'Grant trackpad access')

    def on_key(self, key):
        s = self.state
        if key == curses.KEY_UP:
            self.sel = max(0, self.sel - 1); return True
        if key == curses.KEY_DOWN:
            self.sel = min(len(self.devs) - 1, self.sel + 1); return True
        if key in (curses.KEY_ENTER, 10, 13):
            self.use_selected(); return True
        if key == ord('0'):
            self.use_all(); return True
        if key == ord('>') or key == ord('.'):
            s['mouse_speed'] = round(min(20.0,
                float(s.get('mouse_speed', 3.0)) + 0.5), 1)
            self.msg = 'mouse %.1f counts/cell (bigger = slower)' % s['mouse_speed']
            return True
        if key == ord('<') or key == ord(','):
            s['mouse_speed'] = round(max(0.5,
                float(s.get('mouse_speed', 3.0)) - 0.5), 1)
            self.msg = 'mouse %.1f counts/cell (smaller = faster)' % s['mouse_speed']
            return True
        if key in (ord('g'), ord('G')):
            self.grant(); return True
        if key in (ord('r'), ord('R')):
            self.devs = list_input_devices()
            ok = self.ptr.restart()
            self.msg = f'Pointer restarted: {self.ptr.status}'
            if self.wm: self.wm.sound.play('drop' if ok else 'error')
            return True
        if key in (ord('+'), ord('=')):
            self._manual(); s['pointer_speed'] = min(80, s.get('pointer_speed', 18) + 1)
            self.ptr.calibrate(); return True
        if key in (ord('-'), ord('_')):
            self._manual(); s['pointer_speed'] = max(4, s.get('pointer_speed', 18) - 1)
            self.ptr.calibrate(); return True
        if key == ord(']'):
            self._manual(); s['scroll_speed'] = min(200, s.get('scroll_speed', 60) + 5)
            self.ptr.calibrate(); return True
        if key == ord('['):
            self._manual(); s['scroll_speed'] = max(10, s.get('scroll_speed', 60) - 5)
            self.ptr.calibrate(); return True
        if key in (ord('c'), ord('C')):
            s['pointer_auto_speed'] = True
            self.ptr.calibrate()
            self.msg = 'Re-calibrated to the pad: ' + self.ptr.calib_note
            return True
        if key in (ord('a'), ord('A')):
            s['pointer_accel'] = not s.get('pointer_accel', True); return True
        if key in (ord('t'), ord('T')):
            s['tap_to_click'] = not s.get('tap_to_click', True); return True
        if key in (ord('n'), ord('N')):
            s['natural_scroll'] = not s.get('natural_scroll', False); return True
        if key in (ord('o'), ord('O')):
            s['outline_drag'] = not s.get('outline_drag', True); return True
        if key in (ord('s'), ord('S')):
            self.msg = 'Saved.' if save_config(s) else 'Save failed.'
            return True
        return False

    def on_close(self):
        save_config(self.state)


def grant_input_access():
    """Run outside curses: add the user to the 'input' group."""
    user = os.environ.get('USER') or os.environ.get('LOGNAME') or 'root'
    print()
    print('=' * 68)
    print('  COS -- Trackpad Access')
    print('=' * 68)
    print()
    print('  COS reads your trackpad directly from /dev/input/eventN.')
    print('  Only members of the "input" group may do that, so we will run:')
    print()
    print(f'      sudo usermod -aG input {user}')
    print()
    print('  sudo will ask for your password. Ctrl-C to cancel.')
    print()
    try:
        r = subprocess.run(['sudo', 'usermod', '-aG', 'input', user])
    except KeyboardInterrupt:
        print('\n  Cancelled.')
        time.sleep(1.2)
        return
    except Exception as e:
        print(f'  Failed to run usermod: {e}')
        time.sleep(2.5)
        return
    print()
    if r.returncode == 0:
        print('  Done. Group membership only takes effect on a NEW login,')
        print('  so do ONE of these:')
        print()
        print('    * log out of this TTY and log back in, then start COS, or')
        print('    * reboot, or')
        print(f"    * run COS through:   sg input -c \"python3 '{os.path.abspath(__file__)}'\"")
        print()
        print('  Until then COS falls back to keyboard navigation (F10 menu,')
        print('  TAB, F7 move, F8 resize) and to passwordless-sudo bridging.')
    else:
        print(f'  usermod exited {r.returncode}. You may not have sudo rights.')
        print('  Ask an administrator to run:')
        print(f'      sudo usermod -aG input {user}')
    print()
    input('  Press ENTER to return to COS... ')


