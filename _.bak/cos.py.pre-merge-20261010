# FATAL ERROR SCREEN  --  what COS shows instead of dying quietly
# =============================================================================
class CosFatal(Exception):
    """Raised to stop COS on purpose and show the error screen.

    Window callbacks are wrapped so a buggy app cannot take COS down, which
    means an ordinary exception never reaches the top. This one is re-raised
    by every guard, so an app that decides things are unrecoverable can say
    so and get the blue screen.
    """

    def __init__(self, reason='', title='Fatal error'):
        super().__init__(reason or title)
        self.reason = str(reason or '')
        self.title = str(title or 'Fatal error')


def self_mtime():
    try:
        return os.path.getmtime(os.path.abspath(__file__))
    except OSError:
        return 0.0


# When COS is edited while it is running, apps hot-reload but COS itself does
# not -- so a new app can call a helper the running process has never heard
# of. Noticing the file changed turns a baffling AttributeError into an
# obvious "restart me".
_SELF_MTIME = self_mtime()


def restart_cos(extra_args=(), keep_crash_count=False):
    """Replace this process with a fresh COS."""
    argv = [a for a in sys.argv[1:] if a != '--crash-test']
    for a in extra_args:
        if a not in argv:
            argv.insert(0, a)
    env = dict(os.environ)
    env.pop('COS_CRASH_TEST', None)
    if not keep_crash_count:
        env.pop(CRASH_ENV, None)
    sys.stdout.write('\033[?1003l\033[2J\033[H')
    sys.stdout.flush()
    os.execve(sys.executable, [sys.executable, os.path.abspath(__file__)]
              + argv, env)


CRASH_LOG = os.path.join(COS_HOME, 'crash.log')
CRASH_ENV = 'COS_CRASH_COUNT'

FATAL_HEAD = 'A fatal error has occurred. COS has been stopped to prevent'
FATAL_HEAD2 = 'further damage.'

# The running state, so a crash can still save the user's settings. A crash
# losing an afternoon of preference tweaking would add insult to injury.
_LAST_STATE = None
_LAST_GFX = None


def write_crash_log(text):
    """Append the report to ~/.cos/crash.log and return its path."""
    try:
        os.makedirs(COS_HOME, exist_ok=True)
        with open(CRASH_LOG, 'a', encoding='utf-8') as f:
            f.write('=' * 70 + '\n')
            f.write('COS %s  %s\n' % (VERSION,
                                      datetime.now().isoformat(timespec='seconds')))
            f.write('python %s on %s\n' % (platform.python_version(),
                                           platform.platform()))
            f.write('argv: %r\n' % (sys.argv,))
            f.write('=' * 70 + '\n')
            f.write(text.rstrip() + '\n\n')
        return CRASH_LOG
    except Exception:
        return ''


def crash_count():
    try:
        return int(os.environ.get(CRASH_ENV, '0'))
    except ValueError:
        return 0


def _fatal_body(exc_text, log_path, repeats):
    """The lines of the error screen, in order."""
    lines = ['', FATAL_HEAD, FATAL_HEAD2, '']
    if repeats >= 2:
        lines += ['This is crash %d in a row. Something is wrong at startup --'
                  % (repeats + 1),
                  'try restarting without apps (R), or quit and run:',
                  '    python3 %r --no-apps' % os.path.basename(
                      os.path.abspath(__file__)),
                  '']
    for raw in exc_text.rstrip().split('\n'):
        lines.append(raw.rstrip())
    lines.append('')
    if log_path:
        lines.append('The full report was saved to %s' % log_path)
        lines.append('')
    return lines


def fatal_screen_curses(exc_text, log_path, repeats):
    """Draw the error screen with curses. Returns 'restart', 'noapps' or 'quit'."""
    choice = ['quit']

    def _draw(stdscr):
        curses.curs_set(0)
        try:
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(1, curses.COLOR_WHITE, curses.COLOR_BLUE)
            curses.init_pair(2, curses.COLOR_BLUE, curses.COLOR_WHITE)
            plain = curses.color_pair(1)
            flip = curses.color_pair(2)
        except curses.error:
            plain = flip = curses.A_NORMAL
        body = _fatal_body(exc_text, log_path, repeats)
        scroll = 0
        while True:
            H, W = stdscr.getmaxyx()
            try:
                stdscr.bkgd(' ', plain)
            except curses.error:
                pass
            stdscr.erase()
            title = ' COS '
            _safestr(stdscr, 1, max(0, (W - len(title)) // 2), title,
                     flip | curses.A_BOLD)
            foot1 = 'Press ENTER to restart COS . . .'
            foot2 = ('R restarts without apps      ESC returns to the shell')
            top = 3
            avail = max(1, H - top - 4)
            wrapped = []
            for line in body:
                if len(line) <= W - 6:
                    wrapped.append(line)
                else:
                    wrapped.extend(wrap_text(line, W - 6))
            scroll = max(0, min(scroll, max(0, len(wrapped) - avail)))
            for i in range(avail):
                ri = scroll + i
                if ri >= len(wrapped):
                    break
                a = plain
                if wrapped[ri] in (FATAL_HEAD, FATAL_HEAD2):
                    a = plain | curses.A_BOLD
                _safestr(stdscr, top + i, 3, wrapped[ri][:max(0, W - 4)], a)
            if len(wrapped) > avail:
                note = '-- more (arrows / PgUp / PgDn) --'
                _safestr(stdscr, H - 4, max(0, (W - len(note)) // 2), note,
                         plain | curses.A_DIM)
            _safestr(stdscr, H - 3, 3, foot1[:max(0, W - 4)],
                     plain | curses.A_BOLD)
            _safestr(stdscr, H - 2, 3, foot2[:max(0, W - 4)], plain)
            stdscr.refresh()
            try:
                key = stdscr.getch()
            except KeyboardInterrupt:
                choice[0] = 'quit'
                return
            if key in (curses.KEY_ENTER, 10, 13):
                choice[0] = 'restart'
                return
            if key == 27:
                choice[0] = 'quit'
                return
            if key in (ord('r'), ord('R')):
                choice[0] = 'noapps'
                return
            if key in (ord('q'), ord('Q')):
                choice[0] = 'quit'
                return
            if key == curses.KEY_UP:
                scroll -= 1
            elif key == curses.KEY_DOWN:
                scroll += 1
            elif key == curses.KEY_PPAGE:
                scroll -= avail
            elif key == curses.KEY_NPAGE:
                scroll += avail
            elif key == curses.KEY_HOME:
                scroll = 0
            elif key == curses.KEY_END:
                scroll = len(wrapped)

    curses.wrapper(_draw)
    return choice[0]


def fatal_screen_plain(exc_text, log_path, repeats):
    """No-curses fallback: raw ANSI, in case curses is what broke."""
    out = sys.stdout
    out.write('\033[?25l\033[44;37m\033[2J\033[H')
    body = _fatal_body(exc_text, log_path, repeats)
    out.write('\033[2;1H')
    for line in body:
        out.write('   ' + line + '\033[K\n')
    out.write('\n   Press ENTER to restart COS . . .\033[K\n')
    out.write('   Type R then ENTER to restart without apps, '
              'or Q then ENTER to quit.\033[K\n')
    out.flush()
    try:
        answer = sys.stdin.readline().strip().lower()
    except (EOFError, KeyboardInterrupt):
        answer = 'q'
    out.write('\033[0m\033[?25h\033[2J\033[H')
    out.flush()
    if answer.startswith('r'):
        return 'noapps'
    if answer.startswith('q'):
        return 'quit'
    return 'restart'


def handle_fatal(exc_text):
    """Show the error screen, then restart or leave.

    Called after curses has already put the terminal back, so both the
    curses and the plain renderer are safe to try here.
    """
    # Nothing below can be read through a DRM framebuffer we are no longer
    # drawing into, so the screen goes back before the report is shown.
    if _LAST_GFX is not None:
        try:
            _LAST_GFX.stop()
        except Exception:
            pass
    gdr_marker_clear()
    # the settings are worth more than this session
    if _LAST_STATE is not None:
        try:
            save_config(_LAST_STATE)
        except Exception:
            pass
    log_path = write_crash_log(exc_text)
    repeats = crash_count()
    try:
        choice = fatal_screen_curses(exc_text, log_path, repeats)
    except Exception:
        try:
            choice = fatal_screen_plain(exc_text, log_path, repeats)
        except Exception:
            choice = 'quit'
    if choice == 'quit':
        print('COS stopped. The report is in %s' % (log_path or 'no log'))
        return 1
    # restart in place, remembering how many times this has happened
    argv = [a for a in sys.argv[1:] if a not in ('--crash-test',)]
    if choice == 'noapps' and '--no-apps' not in argv:
        argv.insert(0, '--no-apps')
    env = dict(os.environ)
    env.pop('COS_CRASH_TEST', None)      # never restart straight into a crash
    env[CRASH_ENV] = str(repeats + 1)
    script = os.path.abspath(__file__)
    sys.stdout.write('\033[2J\033[H')
    sys.stdout.flush()
    try:
        os.execve(sys.executable, [sys.executable, script] + argv, env)
    except Exception as e:
        print('Could not restart COS: %s' % e)
        return 1
    return 0


