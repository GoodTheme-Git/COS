# SYSTEM MONITOR
# =============================================================================
class SysMon(Window):
    icon = '~'
    min_w, min_h = 48, 14

    def __init__(self, state):
        super().__init__('System Monitor', w=70, h=21)
        self.state = state
        self._next = 0.0
        self._prev_cpu = cpu_times()
        self._prev_cores = self._core_times()
        self.cpu = 0.0
        self.cores = []
        self.hist = deque([0.0] * 60, maxlen=60)
        self.net_prev = self._net()
        self.net_rate = (0.0, 0.0)
        self.top = []
        self.disks = []
        self.interval = 1.0

    @staticmethod
    def _core_times():
        out = []
        try:
            with open('/proc/stat') as f:
                for line in f:
                    if line.startswith('cpu') and line[3].isdigit():
                        vals = [int(x) for x in line.split()[1:9]]
                        out.append((sum(vals), vals[3] + vals[4]))
        except Exception:
            pass
        return out

    @staticmethod
    def _net():
        rx = tx = 0
        try:
            with open('/proc/net/dev') as f:
                for line in f.readlines()[2:]:
                    name, _, rest = line.partition(':')
                    if name.strip() == 'lo':
                        continue
                    parts = rest.split()
                    rx += int(parts[0]); tx += int(parts[8])
        except Exception:
            pass
        return rx, tx, time.monotonic()

    def status(self):
        return f'refresh {self.interval:.0f}s  +/- interval  K=kill list  R=now'

    def tick(self):
        now = time.monotonic()
        if now < self._next:
            return
        self._next = now + self.interval
        tot, idle = cpu_times()
        ptot, pidle = self._prev_cpu
        dt, di = tot - ptot, idle - pidle
        self.cpu = max(0.0, min(1.0, 1.0 - di / dt)) if dt > 0 else 0.0
        self._prev_cpu = (tot, idle)
        self.hist.append(self.cpu)
        cur = self._core_times()
        self.cores = []
        for i, (t, idl) in enumerate(cur):
            if i < len(self._prev_cores):
                pt, pi = self._prev_cores[i]
                d = t - pt
                self.cores.append(max(0.0, min(1.0, 1.0 - (idl - pi) / d)) if d > 0 else 0.0)
        self._prev_cores = cur
        rx, tx, t = self._net()
        prx, ptx, pt = self.net_prev
        span = max(0.001, t - pt)
        self.net_rate = ((rx - prx) / span, (tx - ptx) / span)
        self.net_prev = (rx, tx, t)
        try:
            out = subprocess.run(['ps', '-eo', 'pid,%cpu,%mem,comm',
                                  '--sort=-%cpu'], capture_output=True,
                                 text=True, timeout=4).stdout
            self.top = out.strip().split('\n')[1:7]
        except Exception:
            self.top = []
        self.disks = []
        try:
            out = subprocess.run(['df', '-h', '--output=target,size,used,pcent',
                                  '-x', 'tmpfs', '-x', 'devtmpfs'],
                                 capture_output=True, text=True, timeout=4).stdout
            self.disks = out.strip().split('\n')[1:7]
        except Exception:
            pass

    def draw_client(self, c, active):
        c.fill(cp(CP_WINDOW))
        W = c.w
        row = 0
        # CPU
        c.put(row, 1, 'CPU', cp(CP_BRIGHT, bold=True))
        barw = max(10, W - 22)
        c.bar(row, 5, barw, self.cpu, cp(CP_METER, bold=True), cp(CP_SHADOW))
        c.put(row, 6 + barw, f'{self.cpu * 100:5.1f}%', cp(CP_TEXT, bold=True))
        row += 1
        # sparkline history
        spark = ''
        for v in list(self.hist)[-(W - 6):]:
            spark += ' .:|#'[min(4, int(v * 5))]
        c.put(row, 5, spark, cp(CP_GREEN))
        row += 1
        for i, v in enumerate(self.cores[:8]):
            if row >= c.h - 1:
                break
            c.put(row, 1, f'c{i}', cp(CP_SHADOW))
            c.bar(row, 5, max(6, barw // 2), v, cp(CP_METER), cp(CP_SHADOW))
            c.put(row, 6 + max(6, barw // 2), f'{v * 100:5.1f}%', cp(CP_TEXT))
            row += 1
        # memory
        mi = meminfo()
        if mi['total'] and row < c.h - 1:
            frac = mi['used'] / mi['total']
            c.put(row, 1, 'MEM', cp(CP_BRIGHT, bold=True))
            c.bar(row, 5, barw, frac, cp(CP_METER, bold=True), cp(CP_SHADOW))
            c.put(row, 6 + barw, f'{frac * 100:5.1f}%', cp(CP_TEXT, bold=True))
            row += 1
            c.put(row, 5, f'{mi["used"] // 1024} MB used / {mi["total"] // 1024} MB  '
                          f'({mi["avail"] // 1024} MB available)', cp(CP_SHADOW))
            row += 1
            if mi['swap_total'] and row < c.h - 1:
                sf = (mi['swap_total'] - mi['swap_free']) / mi['swap_total']
                c.put(row, 1, 'SWP', cp(CP_BRIGHT))
                c.bar(row, 5, barw, sf, cp(CP_METER), cp(CP_SHADOW))
                c.put(row, 6 + barw, f'{sf * 100:5.1f}%', cp(CP_TEXT))
                row += 1
        # load / uptime / battery / net
        if row < c.h - 1:
            la = loadavg()
            up = uptime_seconds()
            pct, st = battery_info()
            bat = f'  bat {pct}% {st}' if pct is not None else ''
            c.put(row, 1, f'load {la[0]:.2f} {la[1]:.2f} {la[2]:.2f}   '
                          f'up {int(up // 3600)}h{int(up % 3600 // 60):02d}m{bat}'[:W - 2],
                  cp(CP_TEXT))
            row += 1
        if row < c.h - 1:
            rx, tx = self.net_rate
            c.put(row, 1, f'net  down {human_size(rx)}/s   up {human_size(tx)}/s',
                  cp(CP_GREEN))
            row += 1
        if row < c.h - 1 and self.disks:
            c.put(row, 1, '-- filesystems --', cp(CP_MENU_SEL)); row += 1
            for line in self.disks:
                if row >= c.h - 1:
                    break
                c.put(row, 1, line[:W - 2], cp(CP_TEXT)); row += 1
        if row < c.h - 1 and self.top:
            c.put(row, 1, '-- top processes --', cp(CP_MENU_SEL)); row += 1
            for line in self.top:
                if row >= c.h:
                    break
                c.put(row, 1, line.strip()[:W - 2], cp(CP_TEXT)); row += 1

    def on_key(self, key):
        if key in (ord('+'), ord('=')):
            self.interval = min(10.0, self.interval + 1); return True
        if key in (ord('-'), ord('_')):
            self.interval = max(1.0, self.interval - 1); return True
        if key in (ord('r'), ord('R')):
            self._next = 0; return True
        if key in (ord('k'), ord('K')):
            if self.wm:
                self.wm.open(ProcessManager(self.state))
            return True
        return False


