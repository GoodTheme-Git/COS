    ('Dots fine', _wp_fine),
    ('Dots wide', _wp_dots),
    ('Grid',      _wp_grid),
    ('Weave',     _wp_weave),
    ('Diagonal',  _wp_diag),
    ('Backslash', _wp_back),
    ('Crosses',   _wp_cross),
    ('Stars',     _wp_stars),
    ('Tilde',     _wp_tilde),
    ('Stipple',   _wp_stipple),
    ('Checker',   _wp_checker),
    ('Bricks',    _wp_bricks),
    ('Waves',     _wp_waves),
]


def wallpaper_rows(idx, scale, cols, rows):
    """Render one screenful of wallpaper: [(text, [acs column indexes])]."""
    _name, fn = WALLPAPERS[idx % len(WALLPAPERS)]
    scale = max(2, int(scale))
    out = []
    for y in range(rows):
        chars = []
        acs = []
        for x in range(cols):
            ch = fn(x, y, scale)
            if ch is None:
                acs.append(x)
                chars.append(' ')
            else:
                chars.append(ch)
        out.append((''.join(chars), acs))
    return out


# -- ANSI art -------------------------------------------------------------
def parse_ansi_art(text, max_w=240, max_h=80):
    """Parse SGR-coloured text art into rows of (char, fg, bg, bold).

    COS already ships its logo this way (cos.txt), so the desktop can use
    any such file as its banner.
    """
    import re as _re
    rows = []
    fg, bg, bold = 7, 0, False
    for line in text.split('\n')[:max_h]:
        cells = []
        i = 0
        while i < len(line) and len(cells) < max_w:
            mm = _re.match(r'\x1b\[([0-9;]*)m', line[i:])
            if mm:
                for part in (mm.group(1) or '0').split(';'):
                    if part in ('', '0'):
                        fg, bg, bold = 7, 0, False
                    elif part == '1':
                        bold = True
                    elif part == '22':
                        bold = False
                    elif part.isdigit():
                        n = int(part)
                        if 30 <= n <= 37:     fg = n - 30
                        elif 40 <= n <= 47:   bg = n - 40
                        elif 90 <= n <= 97:   fg, bold = n - 90, True
                        elif 100 <= n <= 107: bg = n - 100
                        elif n == 39:         fg = 7
                        elif n == 49:         bg = 0
                i += mm.end()
                continue
            ch = line[i]
            i += 1
            if ch in '\r\x1b':
                continue
            cells.append((ch, fg, bg, bold))
        rows.append(cells)
    while rows and not any(c[0].strip() for c in rows[-1]):
        rows.pop()
    while rows and not any(c[0].strip() for c in rows[0]):
        rows.pop(0)
    return rows


def load_ansi_art(path):
    try:
        with open(os.path.expanduser(path), 'r', errors='replace') as f:
            return parse_ansi_art(f.read())
    except OSError:
        return []


