class App(cos.Window):
    """Anything a built-in COS window can do, an app can do too.

    Handy attributes: self.state (COS settings), self.wm (window manager).
    Handy methods:    self.notice / warn / error / success, self.ask,
                      self.prompt, self.progress, self.text, self.play,
                      self.notify, self.bsod.
    """

    def __init__(self, state):
        super().__init__(COSAPP['name'], COSAPP['width'], COSAPP['height'])
        self.state = state
        self.count = 0
        self.last = 'nothing yet'

    def status(self):
        return 'SPACE count  N notice  W warn  A ask  P bar  B blue screen  Q close'

    def draw_client(self, c, active):
        c.fill(cos.cp(cos.CP_WINDOW))
        c.put(1, 2, 'Hello from %(name)s!', cos.cp(cos.CP_BRIGHT, bold=True))
        c.put(3, 2, 'You have pressed SPACE ' + str(self.count) + ' time(s).',
              cos.cp(cos.CP_TEXT))
        c.put(4, 2, 'Last answer: ' + self.last, cos.cp(cos.CP_GREEN))
        c.put(6, 2, 'meter', cos.cp(cos.CP_TEXT))
        c.bar(6, 9, max(8, c.w - 14), (self.count %% 10) / 9.0,
              cos.cp(cos.CP_METER, bold=True), cos.cp(cos.CP_SHADOW))
        c.put(8, 2,  'N  a notice               A  a question',
              cos.cp(cos.CP_SHADOW))
        c.put(9, 2,  'W  a warning              P  a loading bar',
              cos.cp(cos.CP_SHADOW))
        c.put(10, 2, 'B  stop COS on purpose (asks first)',
              cos.cp(cos.CP_SHADOW))

    def on_key(self, key):
        if key == ord(' '):
            self.count += 1
            self.play('key')
            return True
        if key in (ord('n'), ord('N')):
            self.notice('A notice',
                        'This is what a notice looks like.\\n'
                        'It has an icon, an accent bar and an OK button.')
            return True
        if key in (ord('w'), ord('W')):
            self.warn('Careful', 'And this is a warning.')
            return True
        if key in (ord('a'), ord('A')):
            # A question box. The answer arrives through the callbacks --
            # nothing is returned, because the dialog outlives this call.
            self.ask('A question',
                     'Questions come back through callbacks, not a\\n'
                     'return value -- the dialog is still open when\\n'
                     'this handler has finished.\\n'
                     '\\n'
                     'Did that make sense?',
                     on_yes=lambda: self._answered('yes'),
                     on_no=lambda: self._answered('no'),
                     yes='Yes', no='No')
            return True
        if key in (ord('p'), ord('P')):
            self.progress('Counting to 40', 'starting...', total=40,
                          worker=self._work)
            return True
        if key in (ord('b'), ord('B')):
            # Ask before doing something irreversible. danger=True puts the
            # highlight on the safe answer, so ENTER cannot fire it by
            # accident.
            self.ask('Stop COS?',
                     'This raises a fatal error on purpose, so COS\\n'
                     'shows the blue screen and offers to restart.\\n'
                     '\\n'
                     'Nothing is damaged -- your settings are saved\\n'
                     'first and the report goes to ~/.cos/crash.log.\\n'
                     '\\n'
                     'Do it?',
                     on_yes=self._stop_cos,
                     yes='Stop COS', no='Back', danger=True)
            return True
        if key in (ord('q'), ord('Q')):
            if self.wm:
                self.wm.close(self)
            return True
        return False

    def _answered(self, what):
        self.last = what
        self.notice('You said ' + what, 'That is how an answer comes back.',
                    'ok')

    def _stop_cos(self):
        """Raise a fatal error. COS catches it and shows the blue screen."""
        self.bsod('%(name)s asked COS to stop, from its B key.\\n'
                  'This is what an app looks like when it decides it\\n'
                  'cannot safely carry on.',
                  '%(name)s')

    def _work(self, p):
        """Runs on its own thread. p.cancelled says when to stop."""
        import time
        for i in range(40):
            if p.cancelled:
                return 'cancelled'
            time.sleep(0.05)
            p.advance(1, 'step ' + str(i + 1) + ' of 40')
        return 'done'

    def on_click(self, row, col, btn):
        self.count += 1
        return True
