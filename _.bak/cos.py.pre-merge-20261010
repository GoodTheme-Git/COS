import urllib.request, urllib.parse, urllib.error, ssl, html as _html
from html.parser import HTMLParser

WEB_UA = (f'Mozilla/5.0 (Linux; TTY) COS/{VERSION} Webinator '
          '(text-mode; +https://example.invalid/cos)')
BOOKMARK_FILE = os.path.join(COS_HOME, 'bookmarks.txt')

BLOCK_TAGS = {'p', 'div', 'section', 'article', 'header', 'footer', 'nav',
              'main', 'aside', 'ul', 'ol', 'table', 'form', 'blockquote',
              'figure', 'figcaption', 'dl', 'details', 'hr', 'pre'}
HEAD_TAGS = {'h1', 'h2', 'h3', 'h4', 'h5', 'h6'}
SKIP_TAGS = {'script', 'style', 'noscript', 'svg', 'template', 'iframe'}


class HTMLToText(HTMLParser):
    """Turns HTML into (blocks, links, title).

    blocks: list of (kind, text) where kind is 'h1'..'h6', 'p', 'li',
            'pre', 'hr' or 'tr'.
    links:  list of {'n', 'href', 'text'}
    """

    def __init__(self, base_url=''):
        super().__init__(convert_charrefs=True)
        self.base = base_url
        self.blocks = []
        self.links = []
        self.title = ''
        self._skip = 0
        self._buf = []
        self._kind = 'p'
        self._in_title = False
        self._in_pre = 0
        self._href = None
        self._link_start = 0
        self._list_depth = 0

    # -- helpers ------------------------------------------------------------
    def _flush(self, kind=None):
        text = ''.join(self._buf)
        if not self._in_pre:
            text = ' '.join(text.split())
        else:
            text = text.strip('\n')
        if text.strip():
            self.blocks.append((kind or self._kind, text))
        self._buf = []
        self._kind = 'p'

    def _emit(self, s):
        if self._skip:
            return
        self._buf.append(s)

    # -- parser hooks -------------------------------------------------------
    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if tag in SKIP_TAGS:
            self._skip += 1
            return
        if self._skip:
            return
        if tag == 'title':
            self._in_title = True
        elif tag == 'br':
            self._flush()
        elif tag == 'hr':
            self._flush()
            self.blocks.append(('hr', ''))
        elif tag == 'pre':
            self._flush()
            self._in_pre += 1
            self._kind = 'pre'
        elif tag in HEAD_TAGS:
            self._flush()
            self._kind = tag
        elif tag == 'li':
            self._flush()
            self._kind = 'li'
        elif tag in ('tr',):
            self._flush()
            self._kind = 'tr'
        elif tag in ('td', 'th'):
            self._emit('  ')
        elif tag in BLOCK_TAGS:
            self._flush()
        elif tag == 'a':
            href = (a.get('href') or '').strip()
            if href and not href.startswith(('javascript:', '#')):
                self._href = urllib.parse.urljoin(self.base, href)
                self._emit(f'[{len(self.links) + 1}]')
                self._link_start = len(self._buf)
        elif tag == 'img':
            alt = (a.get('alt') or '').strip()
            if alt:
                self._emit(f'(image: {alt}) ')
        elif tag in ('input', 'button'):
            t = a.get('type', 'text')
            val = a.get('value') or a.get('placeholder') or t
            self._emit(f'<{val}> ')

    def handle_endtag(self, tag):
        if tag in SKIP_TAGS:
            self._skip = max(0, self._skip - 1)
            return
        if self._skip:
            return
        if tag == 'title':
            self._in_title = False
        elif tag == 'pre':
            self._flush('pre')
            self._in_pre = max(0, self._in_pre - 1)
        elif tag == 'a' and self._href:
            text = ' '.join(''.join(self._buf[self._link_start:]).split())
            self.links.append({'n': len(self.links) + 1, 'href': self._href,
                               'text': text[:80] or self._href})
            self._href = None
        elif tag in HEAD_TAGS or tag == 'li' or tag in BLOCK_TAGS or tag == 'tr':
            self._flush(tag if tag in HEAD_TAGS else None)

    def handle_data(self, data):
        if self._in_title:
            self.title += data.strip() + ' '
            return
        self._emit(data)

    def close(self):
        super().close()
        self._flush()


def wrap_text(text, width, indent=''):
    if width < 8:
        width = 8
    words = text.split()
    lines, cur = [], indent
    for w in words:
        if len(cur) + len(w) + (1 if cur.strip() else 0) <= width:
            cur += ('' if not cur.strip() else ' ') + w
        else:
            if cur.strip():
                lines.append(cur)
            cur = indent + w
            while len(cur) > width:
                lines.append(cur[:width])
                cur = indent + cur[width:]
    if cur.strip():
        lines.append(cur)
    return lines or ['']


START_PAGE = """<html><head><title>Webinator</title></head><body>
