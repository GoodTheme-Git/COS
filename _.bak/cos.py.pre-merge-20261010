# TEXT EDITOR
# =============================================================================
class Editor(Window):
    icon = '='
    want_cursor = True
    min_w, min_h = 40, 10
    claims_ctrl = frozenset({19, 15, 7, 11})   # ^S save ^O open ^G goto ^K kill

    def __init__(self, state, path=None):
        super().__init__('Editor', w=76, h=22)
        self.state = state
        self.path = path
        self.lines = ['']
        self.cy = self.cx = 0
        self.sy = self.sx = 0
        self.dirty_flag = False
        self.msg = '^S save   ^O open   ^G goto line   ^W close'
        self.tabw = 4
        if path:
            self.load(path)

    def load(self, path):
        try:
            with open(path, errors='replace') as f:
                self.lines = f.read().split('\n') or ['']
            self.path = path
            self.title = f'Editor - {os.path.basename(path)}'
            self.dirty_flag = False
            self.cy = self.cx = self.sy = self.sx = 0
            self.msg = f'Loaded {len(self.lines)} lines'
        except Exception as e:
            self.msg = f'Open failed: {e}'
            self.lines = ['']

    def save(self, path=None):
        path = path or self.path
        if not path:
            if self.wm:
                self.wm.open(PromptWindow('Save As', 'File path:',
                                          os.path.expanduser('~/untitled.txt'),
                                          self.save))
            return
        try:
            with open(path, 'w') as f:
                f.write('\n'.join(self.lines))
            self.path = path
            self.title = f'Editor - {os.path.basename(path)}'
            self.dirty_flag = False
            self.msg = f'Saved {path}'
            if self.wm: self.wm.sound.play('drop')
        except Exception as e:
            self.msg = f'Save failed: {e}'
            if self.wm: self.wm.sound.play('error')

    def status(self):
        flag = '*' if self.dirty_flag else ' '
        return (f'{flag} ln {self.cy + 1}/{len(self.lines)}  col {self.cx + 1}  '
                f'{self.msg}')

    def draw_client(self, c, active):
        c.fill(cp(CP_WINDOW))
        gutter = max(3, len(str(len(self.lines))) + 1)
        textw = max(4, c.w - gutter - 1)
        vis = c.h
        # keep the caret on screen
        if self.cy < self.sy: self.sy = self.cy
        if self.cy >= self.sy + vis: self.sy = self.cy - vis + 1
        if self.cx < self.sx: self.sx = self.cx
        if self.cx >= self.sx + textw: self.sx = self.cx - textw + 1
        for i in range(vis):
            ri = self.sy + i
            if ri >= len(self.lines):
                c.put(i, 0, '~'.ljust(gutter), cp(CP_SHADOW))
                continue
            c.put(i, 0, f'{ri + 1:>{gutter - 1}} ',
                  cp(CP_BRIGHT, bold=True) if ri == self.cy else cp(CP_SHADOW))
            line = self.lines[ri].replace('\t', ' ' * self.tabw)
            c.put(i, gutter, line[self.sx:self.sx + textw], cp(CP_TEXT))
        self.caret = (self.cy - self.sy, gutter + (self.cx - self.sx))

    def _cur(self):
        return self.lines[self.cy] if 0 <= self.cy < len(self.lines) else ''

    def on_key(self, key):
        self.msg = ''
        line = self._cur()
        if key == 19:                               # ^S
            self.save(); return True
        if key == 15:                               # ^O
            if self.wm:
                self.wm.open(PromptWindow('Open File', 'File path:',
                                          self.path or os.path.expanduser('~/'),
                                          self.load))
            return True
        if key == 7:                                # ^G
            if self.wm:
                self.wm.open(PromptWindow('Go To Line', 'Line number:', '1',
                                          self._goto))
            return True
        if key == curses.KEY_UP:
            self.cy = max(0, self.cy - 1)
            self.cx = min(self.cx, len(self._cur())); return True
        if key == curses.KEY_DOWN:
            self.cy = min(len(self.lines) - 1, self.cy + 1)
            self.cx = min(self.cx, len(self._cur())); return True
        if key == curses.KEY_LEFT:
            if self.cx > 0:
                self.cx -= 1
            elif self.cy > 0:
                self.cy -= 1; self.cx = len(self._cur())
            return True
        if key == curses.KEY_RIGHT:
            if self.cx < len(line):
                self.cx += 1
            elif self.cy < len(self.lines) - 1:
                self.cy += 1; self.cx = 0
            return True
        if key == curses.KEY_HOME:
            self.cx = 0; return True
        if key == curses.KEY_END:
            self.cx = len(line); return True
        if key == curses.KEY_PPAGE:
            self.cy = max(0, self.cy - self.chh)
            self.cx = min(self.cx, len(self._cur())); return True
        if key == curses.KEY_NPAGE:
            self.cy = min(len(self.lines) - 1, self.cy + self.chh)
            self.cx = min(self.cx, len(self._cur())); return True
        if key in (curses.KEY_ENTER, 10, 13):
            indent = len(line) - len(line.lstrip(' '))
            self.lines[self.cy] = line[:self.cx]
            self.lines.insert(self.cy + 1, ' ' * indent + line[self.cx:])
            self.cy += 1; self.cx = indent
            self.dirty_flag = True; return True
        if key in (curses.KEY_BACKSPACE, 127, 8):
            if self.cx > 0:
                self.lines[self.cy] = line[:self.cx - 1] + line[self.cx:]
                self.cx -= 1
            elif self.cy > 0:
                prev = self.lines[self.cy - 1]
                self.cx = len(prev)
                self.lines[self.cy - 1] = prev + line
                del self.lines[self.cy]
                self.cy -= 1
            self.dirty_flag = True; return True
        if key == curses.KEY_DC:
            if self.cx < len(line):
                self.lines[self.cy] = line[:self.cx] + line[self.cx + 1:]
            elif self.cy < len(self.lines) - 1:
                self.lines[self.cy] = line + self.lines[self.cy + 1]
                del self.lines[self.cy + 1]
            self.dirty_flag = True; return True
        if key == 11:                               # ^K kill line
            if len(self.lines) > 1:
                del self.lines[self.cy]
                self.cy = min(self.cy, len(self.lines) - 1)
            else:
                self.lines = ['']
            self.cx = 0; self.dirty_flag = True; return True
        if key == 9:                                # TAB
            self.lines[self.cy] = line[:self.cx] + ' ' * self.tabw + line[self.cx:]
            self.cx += self.tabw; self.dirty_flag = True; return True
        if 32 <= key <= 126:
            self.lines[self.cy] = line[:self.cx] + chr(key) + line[self.cx:]
            self.cx += 1
            self.dirty_flag = True
            return True
        return False

    def _goto(self, s):
        try:
            n = int(s.strip())
            self.cy = max(0, min(len(self.lines) - 1, n - 1))
            self.cx = 0
        except ValueError:
            self.msg = 'Not a number'

    def on_click(self, row, col, btn):
        gutter = max(3, len(str(len(self.lines))) + 1)
        self.cy = max(0, min(len(self.lines) - 1, self.sy + row))
        self.cx = max(0, min(len(self._cur()), self.sx + max(0, col - gutter)))
        return True

    def on_scroll(self, n):
        self.cy = max(0, min(len(self.lines) - 1, self.cy + n * 3))
        self.cx = min(self.cx, len(self._cur()))
        return True

    def on_close(self):
        if self.dirty_flag and self.wm:
            self.wm.notify(f'[Editor] closed with unsaved changes'
                           f'{" in " + os.path.basename(self.path) if self.path else ""}',
                           'warn')


