# PIGEON WINDOW  --  the file-sharing app
# =============================================================================
class PigeonWindow(Window):
    """Share a folder over the LAN so files can be pulled, not carried."""

    icon = '^'
    min_w, min_h = 54, 14

    def __init__(self, state):
        super().__init__('Pigeon  --  COS File Server', w=76, h=22)
        self.state = state
        self.server = None
        self.msg = 'S starts the server'
        self.fw = ''
        self._fw_checked = 0.0

    # -- lifecycle ----------------------------------------------------------
    def root(self):
        return os.path.abspath(os.path.expanduser(
            self.state.get('share_dir')
            or os.path.dirname(os.path.abspath(__file__))))

    def port(self):
        return int(self.state.get('share_port', SHARE_DEFAULT_PORT))

    def start(self):
        if self.server and self.server.running:
            return
        self.server = Pigeon(self.root(), self.port(),
                             bool(self.state.get('share_token', True)))
        if self.server.start():
            self.msg = 'Serving. Run the command below on the other machine.'
            if self.wm:
                self.wm.sound.play('notify')
            self._fw_checked = 0.0
        else:
            self.msg = self.server.error
            if self.wm:
                self.wm.sound.play('error')

    def stop(self):
        if self.server:
            self.server.stop()
        self.msg = 'Stopped.'
        if self.wm:
            self.wm.sound.play('close')

    def on_close(self):
        self.stop()

    def tick(self):
        if (self.server and self.server.running
                and time.monotonic() - self._fw_checked > 20):
            self._fw_checked = time.monotonic()
            self.fw = firewall_blocking(self.port())

    # -- drawing ------------------------------------------------------------
    def status(self):
        if self.server and self.server.running:
            up = time.monotonic() - self.server.started
            return (f'serving  {self.server.hits[0]} request(s)  up '
                    f'{human_time(up)}   S=stop  D=folder  P=port  T=token  '
                    f'F=firewall')
        return 'stopped   S=start  D=folder  P=port  T=token'

    def draw_client(self, c, active):
        c.fill(cp(CP_WINDOW))
        W = c.w
        running = bool(self.server and self.server.running)
        c.put(0, 1, 'STATUS: ', cp(CP_BRIGHT, bold=True))
        c.put(0, 9, 'SERVING' if running else 'STOPPED',
              cp(CP_GREEN, bold=True) if running else cp(CP_WARN, bold=True))
        c.put(1, 1, f'Folder : {self.root()}'[:W - 2], cp(CP_TEXT))
        c.put(2, 1, f'Port   : {self.port()}'
                    f'   token {"on" if self.state.get("share_token", True) else "off"}'
                    f'   files {len(file_manifest(self.root(), max_files=400))}'[:W - 2],
              cp(CP_TEXT))
        row = 4
        if running:
            c.put(row, 1, 'OPEN THIS ON THE OTHER MACHINE', cp(CP_MENU_SEL)); row += 1
            for u in self.server.urls()[:2]:
                c.put(row, 3, u[:W - 4], cp(CP_BRIGHT, bold=True)); row += 1
            row += 1
            c.put(row, 1, 'OR SYNC FROM A SHELL THERE (only changes transfer)',
                  cp(CP_MENU_SEL)); row += 1
            cmd = self.server.pull_command(self.state.get('share_dest', '~/cos'))
            for part in wrap_text(cmd, max(10, W - 6)):
                c.put(row, 3, part, cp(CP_GREEN, bold=True)); row += 1
            row += 1
            if self.fw == 'blocked':
                c.put(row, 1, '! ufw is active and this port is NOT allowed --',
                      cp(CP_WARN, bold=True)); row += 1
                c.put(row, 3, f'press F to run: sudo ufw allow {self.port()}/tcp',
                      cp(CP_WARN)); row += 1
            elif self.fw == 'maybe':
                c.put(row, 1, '! ufw is running; its rules need root to read.',
                      cp(CP_WARN, bold=True)); row += 1
                c.put(row, 3, f'If the other machine cannot connect, press F '
                              f'to allow {self.port()}/tcp', cp(CP_WARN)); row += 1
            elif self.fw == 'open':
                c.put(row, 1, 'firewall: port is allowed', cp(CP_GREEN)); row += 1
            if row < c.h - 1:
                c.put(row, 1, 'REQUESTS', cp(CP_MENU_SEL)); row += 1
            for line in list(self.server.log)[-(max(1, c.h - row - 1)):]:
                if row >= c.h:
                    break
                c.put(row, 2, line[:W - 3], cp(CP_SHADOW)); row += 1
        else:
            c.put(row, 1, 'Press S to start serving that folder read-only',
                  cp(CP_TEXT)); row += 1
            c.put(row, 1, 'over HTTP, so the other machine can pull from it.',
                  cp(CP_TEXT)); row += 2
            c.put(row, 1, 'Anyone on this network who knows the address can',
                  cp(CP_SHADOW)); row += 1
            c.put(row, 1, 'read those files. The random token in the URL is',
                  cp(CP_SHADOW)); row += 1
            c.put(row, 1, 'the only thing keeping them out, and it is plain',
                  cp(CP_SHADOW)); row += 1
            c.put(row, 1, 'HTTP -- so share source, not secrets.',
                  cp(CP_SHADOW)); row += 2
            if self.msg:
                c.put(row, 1, self.msg[:W - 2], cp(CP_BRIGHT))

    # -- input --------------------------------------------------------------
    def on_key(self, key):
        if key in (ord('s'), ord('S')):
            if self.server and self.server.running:
                self.stop()
            else:
                self.start()
            return True
        if key in (ord('d'), ord('D')):
            if self.wm:
                self.wm.open(PromptWindow('Share which folder?', 'Path:',
                                          self.root(), self._set_dir))
            return True
        if key in (ord('p'), ord('P')):
            if self.wm:
                self.wm.open(PromptWindow('Port', 'TCP port (1024-65535):',
                                          str(self.port()), self._set_port))
            return True
        if key in (ord('e'), ord('E')):
            if self.wm:
                self.wm.open(PromptWindow(
                    'Destination on the other machine',
                    'Used in the printed command:',
                    self.state.get('share_dest', '~/cos'), self._set_dest))
            return True
        if key in (ord('t'), ord('T')):
            self.state['share_token'] = not self.state.get('share_token', True)
            self.msg = (f'URL token '
                        f'{"on" if self.state["share_token"] else "off"}'
                        f' -- restart the server to apply')
            return True
        if key in (ord('f'), ord('F')):
            if self.wm:
                self.wm.request_shell(allow_through_firewall(self.port()),
                                      'ufw allow')
            self._fw_checked = 0.0
            return True
        if key in (ord('r'), ord('R')):
            _HASH_CACHE.clear()
            self.msg = 'Re-hashed; the manifest will be rebuilt'
            return True
        if key in (ord('i'), ord('I')):
            self.show_info()
            return True
        return False

    def _set_dir(self, path):
        path = os.path.abspath(os.path.expanduser(path.strip()))
        if not os.path.isdir(path):
            self.msg = f'Not a folder: {path}'
            if self.wm:
                self.wm.sound.play('error')
            return
        self.state['share_dir'] = path
        save_config(self.state)
        if self.server and self.server.running:
            self.stop()
            self.start()
        self.msg = f'Sharing {path}'

    def _set_port(self, text):
        try:
            n = int(text.strip())
            if not (1024 <= n <= 65535):
                raise ValueError
        except ValueError:
            self.msg = 'Port must be a number from 1024 to 65535'
            return
        self.state['share_port'] = n
        save_config(self.state)
        if self.server and self.server.running:
            self.stop()
            self.start()
        self.msg = f'Port {n}'

    def _set_dest(self, text):
        self.state['share_dest'] = text.strip() or '~/cos'
        save_config(self.state)
        self.msg = 'Destination updated in the printed command'

    def show_info(self):
        man = file_manifest(self.root())
        total = sum(f[1] for f in man)
        lines = [f'  Folder : {self.root()}',
                 f'  Files  : {len(man)}  ({human_size(total)})',
                 f'  Port   : {self.port()}',
                 f'  Token  : {self.server.token if self.server else "(not started)"}',
                 f'  Host   : {platform.node()}',
                 f'  Addrs  : {", ".join(local_addresses())}',
                 '']
        if self.server and self.server.running:
            lines += ['  Endpoints:',
                      f'    {self.server.urls()[0]}/            index',
                      f'    {self.server.urls()[0]}/manifest.json  hashes',
                      f'    {self.server.urls()[0]}/pull         sync client',
                      '']
        lines += ['  WHAT IS SERVED', '']
        for rel, size, mtime, digest in man[:40]:
            lines.append(f'    {rel:<44} {size:>10,}  {digest[:10]}')
        if len(man) > 40:
            lines.append(f'    ... and {len(man) - 40} more')
        lines += ['',
                  '  Dotfiles and dot-directories are never served, and the',
                  '  server answers GET and HEAD only -- nothing can be',
                  '  written to this machine through it.', '']
        if self.wm:
            self.wm.open(TextWindow('Pigeon', lines, w=78))


