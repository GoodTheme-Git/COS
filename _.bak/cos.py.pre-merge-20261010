class ProcessManager(ScrollListWindow):
    icon = 'P'
    min_w, min_h = 54, 12
    SORTS = [('cpu', '-%cpu'), ('mem', '-%mem'), ('pid', 'pid'), ('name', 'comm')]

    def __init__(self, state):
        super().__init__('Process Manager', w=78, h=22)
        self.state = state
        self.procs = []
        self.sort = 0
        self.filter = ''
        self.filtering = False
        self.msg = ''
        self._next = 0.0
        self.refresh()

    def refresh(self):
        key = self.SORTS[self.sort][1]
        try:
            out = subprocess.run(
                ['ps', '-eo', 'pid,user:12,%cpu,%mem,rss,stat,etime,comm',
                 f'--sort={key}'], capture_output=True, text=True, timeout=5).stdout
            lines = out.strip().split('\n')
            self.header = lines[0] if lines else ''
            rows = lines[1:]
            if self.filter:
                q = self.filter.lower()
                rows = [r for r in rows if q in r.lower()]
            self.procs = rows
        except Exception as e:
            self.procs = [f'ps failed: {e}']
            self.header = ''
        self.sel = min(self.sel, max(0, len(self.procs) - 1))

    def tick(self):
        now = time.monotonic()
        if now >= self._next:
            self._next = now + 2.0
            self.refresh()

    def rows(self):
        return self.procs

    def header_rows(self):
        return 2

    def visible_rows(self):
        return max(1, self.chh - 2)

    def status(self):
        if self.msg:
            return self.msg
        return (f'{len(self.procs)} procs  S=sort[{self.SORTS[self.sort][0]}]  '
                f'K=kill  9=SIGKILL  /=filter  R=refresh')

    def draw_header(self, c, active):
        f = f'  filter: {self.filter}' + ('_' if self.filtering else '')
        c.put(0, 1, (f'Sorted by {self.SORTS[self.sort][0]}'
                     + (f if (self.filter or self.filtering) else ''))[:c.w - 2],
              cp(CP_BRIGHT, bold=True))
        c.put(1, 1, self.header[:c.w - 2], cp(CP_MENU_SEL))

    def row_text(self, i, item):
        return ' ' + item

    def pid_of(self, item):
        try:
            return int(str(item).split()[0])
        except (ValueError, IndexError):
            return None

    def _kill(self, pid, sig):
        try:
            os.kill(pid, sig)
            self.msg = f'Sent {signal.Signals(sig).name} to pid {pid}'
            if self.wm: self.wm.sound.play('drop')
        except Exception as e:
            self.msg = f'kill {pid} failed: {e}'
            if self.wm: self.wm.sound.play('error')
        self._next = 0

    def ask_kill(self, sig):
        if not self.procs:
            return
        item = self.procs[self.sel]
        pid = self.pid_of(item)
        if pid is None:
            return
        if pid == os.getpid():
            self.msg = 'Refusing to kill COS itself.'
            if self.wm: self.wm.sound.play('error')
            return
        name = signal.Signals(sig).name
        if self.wm:
            self.wm.open(ConfirmWindow(
                f'Send {name}',
                [f'Send {name} to this process?', '', '  ' + item.strip()],
                lambda: self._kill(pid, sig), danger=(sig == signal.SIGKILL)))

    def on_key(self, key):
        if self.filtering:
            if key in (curses.KEY_ENTER, 10, 13):
                self.filtering = False; self.refresh(); return True
            if key == 27:
                self.filtering = False; self.filter = ''; self.refresh(); return True
            if key in (curses.KEY_BACKSPACE, 127, 8):
                self.filter = self.filter[:-1]; self.refresh(); return True
            if 32 <= key <= 126:
                self.filter += chr(key); self.refresh(); return True
            return True
        if key in (ord('s'), ord('S')):
            self.sort = (self.sort + 1) % len(self.SORTS)
            self.refresh(); return True
        if key in (ord('k'), ord('K'), curses.KEY_DC):
            self.ask_kill(signal.SIGTERM); return True
        if key == ord('9'):
            self.ask_kill(signal.SIGKILL); return True
        if key in (ord('r'), ord('R')):
            self._next = 0; self.msg = ''; return True
        if key == ord('/'):
            self.filtering = True; return True
        return super().on_key(key)

    def on_activate(self, i, item):
        pid = self.pid_of(item)
        if pid is None:
            return
        lines = [f'  PID {pid}', '']
        for fn, label in (('cmdline', 'Command line'), ('status', 'Status')):
            p = f'/proc/{pid}/{fn}'
            try:
                with open(p, errors='replace') as f:
                    data = f.read()
                lines.append(f'  -- {label} --')
                if fn == 'cmdline':
                    lines.append('  ' + data.replace('\0', ' ').strip())
                else:
                    lines += ['  ' + l for l in data.split('\n')[:30]]
                lines.append('')
            except OSError as e:
                lines.append(f'  {label}: {e}')
        if self.wm:
            self.wm.open(TextWindow(f'Process {pid}', lines))


