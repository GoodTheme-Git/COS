class WindowManager:
    def __init__(self, stdscr, state, sound, pointer):
        self.scr = stdscr
        self.state = state
        self.sound = sound
        self.ptr = pointer
        self.wins = []                  # bottom -> top
        self.messages = state['messages']
        self.drag = None
        self.kbmode = None              # ('move'|'resize', win, ghost)
        self.menu_open = None
        self.menu_sel = 0
        self.menu_cols = {}
        self.double = False
        self._last_click = (0.0, -9, -9)
        self.lay = None
        self.dirty = True
        self.gfx = None                 # GraphicsDesktop, in BETA graphics mode
        self.cascade_n = 0
        self.icons = []
        self.icon_sel = -1
        self.shell_request = None     # (callable, label) run outside curses
        self.registry = None          # AppRegistry, set up in main()
        self.mods = None              # KeyModifiers, set up in main()

    def request_shell(self, fn, label):
        """Ask the main loop to leave curses and run `fn` on the bare TTY."""
        self.shell_request = (fn, label)
        self.dirty = True

    # -- log ----------------------------------------------------------------
    def notice(self, title, body, kind='info', on_ok=None):
        return self.open(NoticeWindow(title, body, kind, on_ok))

    def ask(self, title, body, on_yes=None, kind=None, yes='Yes',
            no='No', danger=False, on_no=None):
        return self.open(ConfirmWindow(title, body, on_yes, danger, kind,
                                       yes, no, on_no))

    def progress(self, title, label='Working...', total=0, worker=None,
                 cancellable=True, on_done=None):
        return self.open(ProgressWindow(title, label, total, worker,
                                        cancellable, on_done))

    def notify(self, msg, sound='notify'):
        self.messages.append(str(msg))
        del self.messages[:-200]
        if sound:
            self.sound.play(sound)
        self.dirty = True

    # -- window list --------------------------------------------------------
    @property
    def active(self):
        return self.wins[-1] if self.wins else None

    def open(self, win, sound='open'):
        win.wm = self
        if self.lay:
            if win.x is None or win.x < self.lay.wx:
                win.x = self.lay.wx + 2
            self.cascade_n = (self.cascade_n + 1) % 7
            win.x = min(self.lay.wx + 2 + self.cascade_n * 3,
                        max(self.lay.wx, self.lay.wx + self.lay.ww - win.w))
            win.y = min(self.lay.wy + self.cascade_n,
                        max(self.lay.wy, self.lay.wy + self.lay.wh - win.h))
            win.clamp(self.lay)
        self.wins.append(win)
        if sound:
            self.sound.play(sound)
        self.dirty = True
        return win

    def open_single(self, cls, *a, **kw):
        """Focus an existing window of this class instead of opening a second."""
        for w in self.wins:
            if isinstance(w, cls):
                self.focus(w)
                return w
        return self.open(cls(*a, **kw))

    def close(self, win, sound='close'):
        if win in self.wins:
            try:
                win.on_close()
            except Exception:
                pass
            self.wins.remove(win)
            if sound:
                self.sound.play(sound)
            self.dirty = True

    def close_all(self):
        for w in list(self.wins):
            self.close(w, sound=None)
        self.sound.play('close')

    def focus(self, win):
        if win in self.wins and self.wins[-1] is not win:
            self.wins.remove(win)
            self.wins.append(win)
            self.dirty = True

    def cycle(self, back=False):
        if len(self.wins) > 1:
            if back:
                self.wins.insert(0, self.wins.pop())
            else:
                self.wins.append(self.wins.pop(0))
            self.sound.play('menu')
            self.dirty = True

    def cascade(self):
        lay = self.lay
        for i, w in enumerate(self.wins):
            w.maximized = False
            w.w = min(max(w.min_w, int(lay.ww * 0.62)), lay.ww - 2)
            w.h = min(max(w.min_h, int(lay.wh * 0.70)), lay.wh - 1)
            w.x = lay.wx + 1 + (i % 8) * 2
            w.y = lay.wy + (i % 8)
            w.clamp(lay)
            w.on_resize()
        self.dirty = True

    def tile(self):
        lay = self.lay
        n = len(self.wins)
        if not n:
            return
        cols = int(math.ceil(math.sqrt(n)))
        rows = int(math.ceil(n / cols))
        cw = lay.ww // cols
        chh = lay.wh // rows
        for i, w in enumerate(self.wins):
            r, c = divmod(i, cols)
            w.maximized = False
            w.x = lay.wx + c * cw
            w.y = lay.wy + r * chh
            w.w = max(w.min_w, cw if c < cols - 1 else lay.ww - c * cw)
            w.h = max(w.min_h, chh if r < rows - 1 else lay.wh - r * chh)
            w.clamp(lay)
            w.on_resize()
        self.dirty = True

    def was_double(self, win, token):
        return self.double

    # -- hit testing --------------------------------------------------------
    def window_at(self, gx, gy):
        for w in reversed(self.wins):
            if w.y <= gy < w.y + w.h and w.x <= gx < w.x + w.w:
                return w
        return None

    def zone_of(self, w, gx, gy):
        ry, rx = gy - w.y, gx - w.x
        if ry == 0:
            for col, wd, name in w.title_buttons():
                if col <= rx < col + wd:
                    return name
            return 'title'
        if w.resizable and ry == w.h - 1 and rx >= w.w - 3:
            return 'resize'
        if ry == w.h - 1 or rx == 0 or rx == w.w - 1:
            return 'edge'
        return 'client'

    # -- ghost / drag -------------------------------------------------------
    def begin_move(self, w, gx, gy):
        self.drag = {'win': w, 'mode': 'move', 'gx': gx, 'gy': gy,
                     'ox': w.x, 'oy': w.y, 'ghost': (w.x, w.y, w.w, w.h)}

    def begin_resize(self, w, gx, gy):
        self.drag = {'win': w, 'mode': 'resize', 'gx': gx, 'gy': gy,
                     'ow': w.w, 'oh': w.h, 'ghost': (w.x, w.y, w.w, w.h)}

    def update_drag(self, gx, gy):
        d = self.drag
        if not d:
            return
        w = d['win']
        lay = self.lay
        if d['mode'] == 'move':
            nx = d['ox'] + (gx - d['gx'])
            ny = d['oy'] + (gy - d['gy'])
            nx = max(lay.wx, min(nx, lay.wx + lay.ww - w.w))
            ny = max(lay.wy, min(ny, lay.wy + lay.wh - w.h))
            d['ghost'] = (nx, ny, w.w, w.h)
        else:
            nw = max(w.min_w, d['ow'] + (gx - d['gx']))
            nh = max(w.min_h, d['oh'] + (gy - d['gy']))
            nw = min(nw, lay.wx + lay.ww - w.x)
            nh = min(nh, lay.wy + lay.wh - w.y)
            d['ghost'] = (w.x, w.y, nw, nh)
        if not self.state.get('outline_drag', True):
            self.commit_drag(keep=True)
        self.dirty = True

    def commit_drag(self, keep=False):
        d = self.drag
        if not d:
            return
        w = d['win']
        gx, gy, gw, gh = d['ghost']
        if d['mode'] == 'move':
            w.x, w.y = gx, gy
        else:
            w.w, w.h = gw, gh
            w.on_resize()
        w.maximized = False
        w.clamp(self.lay)
        if not keep:
            self.drag = None
            self.sound.play('drop')
        self.dirty = True

    # -- keyboard move/resize mode -----------------------------------------
    def begin_kbmode(self, mode):
        w = self.active
        if not w:
            return
        if mode == 'resize' and not w.resizable:
            return
        self.kbmode = [mode, w, [w.x, w.y, w.w, w.h]]
        self.notify(f'[WM] {mode.title()} mode: arrows adjust, '
                    'ENTER applies, ESC cancels.', 'menu')

    def kbmode_key(self, key):
        mode, w, g = self.kbmode
        lay = self.lay
        step = 1
        if key in (curses.KEY_LEFT, ord('h')):
            if mode == 'move': g[0] -= step
            else: g[2] -= step
        elif key in (curses.KEY_RIGHT, ord('l')):
            if mode == 'move': g[0] += step
            else: g[2] += step
        elif key in (curses.KEY_UP, ord('k')):
            if mode == 'move': g[1] -= step
            else: g[3] -= step
        elif key in (curses.KEY_DOWN, ord('j')):
            if mode == 'move': g[1] += step
            else: g[3] += step
        elif key in (curses.KEY_ENTER, 10, 13):
            if mode == 'move':
                w.x, w.y = g[0], g[1]
            else:
                w.w, w.h = g[2], g[3]
                w.on_resize()
            w.maximized = False
            w.clamp(lay)
            self.kbmode = None
            self.sound.play('drop')
            self.dirty = True
            return True
        elif key == 27:
            self.kbmode = None
            self.sound.play('close')
            self.dirty = True
            return True
        else:
            return True
        g[2] = max(w.min_w, min(g[2], lay.ww))
        g[3] = max(w.min_h, min(g[3], lay.wh))
        g[0] = max(lay.wx, min(g[0], lay.wx + lay.ww - g[2]))
        g[1] = max(lay.wy, min(g[1], lay.wy + lay.wh - g[3]))
        self.dirty = True
        return True

    # -- desktop icons ------------------------------------------------------
    ICON_DEFS = [
        ('Druman',    'druman',    '\\'),
        ('Webinator', 'webinator', 'W'),
        ('Pictures',  'imageviewer', 'P'),
        ('Pigeon',    'pigeon',     '^'),
        ('Apps',      'appmgr',     '&'),
        ('Files',     'files',     '/'),
        ('Terminal',  'open_term', '>'),
        ('Editor',    'editor',    '='),
        ('Calc',      'calc',      '+'),
        ('Monitor',   'sysmon',    '~'),
        ('Shell',     'shell_cos', '$'),
        ('Setup',     'prefs',     '*'),
    ]

    def app_icons(self):
        """Desktop icons contributed by .cosapp files that ask for one."""
        if not self.registry:
            return []
        out = []
        for a in self.registry.working:
            if a.manifest.get('desktop'):
                glyph = str(a.manifest.get('icon', '*'))[:1] or '*'
                out.append((a.title[:11], 'app:' + a.name, glyph))
        return out

    def icon_defs(self):
        return self.ICON_DEFS + self.app_icons()

    def icon_rects(self):
        """[(y, x, w, label, action, glyph)] for the desktop icons."""
        if not self.state.get('show_icons', True):
            return []
        lay = self.lay
        out = []
        cell = 16
        gap = max(1, min(4, int(self.state.get('icon_gap', 2))))
        layout = self.state.get('icon_layout', 'column')
        if layout == 'row':
            per_row = max(1, (lay.ww - 2) // cell)
            for i, (label, action, glyph) in enumerate(self.icon_defs()):
                row, col = divmod(i, per_row)
                x = lay.wx + 1 + col * cell
                y = lay.wy + 1 + row * gap
                if y >= lay.wy + lay.wh - 1 or x + cell - 2 > lay.wx + lay.ww:
                    continue
                out.append((y, x, cell - 2, label, action, glyph))
        elif layout == 'grid':
            per_col = max(1, (lay.wh - 2) // gap)
            per_row = max(1, (lay.ww - 2) // cell)
            for i, (label, action, glyph) in enumerate(self.icon_defs()):
                if i >= per_col * per_row:
                    break
                row, col = divmod(i, per_row)
                x = lay.wx + 1 + col * cell
                y = lay.wy + 1 + row * gap
                if y >= lay.wy + lay.wh - 1:
                    continue
                out.append((y, x, cell - 2, label, action, glyph))
        else:
            per_col = max(1, (lay.wh - 1) // gap)
            for i, (label, action, glyph) in enumerate(self.icon_defs()):
                col, row = divmod(i, per_col)
                x = lay.wx + 1 + col * cell
                y = lay.wy + 1 + row * gap
                if y >= lay.wy + lay.wh - 1 or x + cell - 2 > lay.wx + lay.ww:
                    continue
                out.append((y, x, cell - 2, label, action, glyph))
        return out

    def desk_attr(self):
        fg = int(self.state.get('desk_fg', -1))
        bg = int(self.state.get('desk_bg', -1))
        if fg < 0 or bg < 0:
            return cp(CP_DESKTOP)
        return media_attr(fg, bg)

    def wallpaper(self, cols, rows):
        """Pattern rows for this geometry, cached -- it is per-cell work."""
        idx = int(self.state.get('wallpaper_idx', 1))
        scale = int(self.state.get('wallpaper_scale', 6))
        key = (idx, scale, cols, rows)
        if getattr(self, '_wp_key', None) != key:
            self._wp_key = key
            self._wp_rows = wallpaper_rows(idx, scale, cols, rows)
        return self._wp_rows

    def logo_art(self):
        path = self.state.get('logo_file', '')
        if not path:
            return []
        key = os.path.expanduser(path)
        if getattr(self, '_art_key', None) != key:
            self._art_key = key
            self._art = load_ansi_art(key)
        return self._art

    def draw_desktop(self):
        lay = self.lay
        attr = self.desk_attr()
        try:
            self.scr.bkgdset(' ', attr)
        except curses.error:
            pass
        self.scr.erase()
        for i, (text, acs) in enumerate(self.wallpaper(lay.ww, lay.wh)):
            y = lay.wy + i
            if text.strip() or acs:
                _safestr(self.scr, y, lay.wx, text[:lay.ww], attr)
            for x in acs:
                if x < lay.ww:
                    _safech(self.scr, y, lay.wx + x, curses.ACS_CKBOARD, attr)
        if not self.wins:
            self.draw_logo()
        for i, (y, x, w, label, action, glyph) in enumerate(self.icon_rects()):
            sel = (i == self.icon_sel)
            a = cp(CP_SEL, bold=True) if sel else cp(CP_ICON, bold=True)
            _safestr(self.scr, y, x, f'[{glyph}]', a)
            _safestr(self.scr, y, x + 4, label[:max(0, w - 4)], a)

    def draw_logo(self):
        lay = self.lay
        mode = self.state.get('logo_mode', 'builtin')
        if mode == 'none':
            return
        if mode == 'art':
            art = self.logo_art()
            if art:
                h = len(art)
                w = max(len(r) for r in art)
                y0 = lay.wy + max(0, (lay.wh - h) // 2)
                x0 = lay.wx + max(0, (lay.ww - w) // 2)
                for ry, row in enumerate(art):
                    y = y0 + ry
                    if not (lay.wy <= y < lay.wy + lay.wh):
                        continue
                    run_attr = None
                    run = []
                    run_x = 0
                    for rx, (ch, fg, bg, bold) in enumerate(row):
                        a = media_attr(fg, bg, bold)
                        if a != run_attr:
                            if run:
                                _safestr(self.scr, y, x0 + run_x,
                                         ''.join(run), run_attr)
                            run_attr, run, run_x = a, [ch], rx
                        else:
                            run.append(ch)
                    if run:
                        _safestr(self.scr, y, x0 + run_x, ''.join(run), run_attr)
                return
            mode = 'builtin'        # nothing loaded; fall back
        if mode == 'text':
            lines = [l for l in
                     str(self.state.get('logo_text', '')).split('\n')]
            lines = lines or ['']
        else:
            lines = [
                '  +=============================+',
                '  |   C O S   ' + f'v{VERSION}'.center(8) + '   T C F   |',
                '  |   ' + f'"{CODENAME}"'.center(23) + '   |',
                '  +=============================+',
            ]
        ly = lay.wy + lay.wh // 2 - len(lines) // 2
        for i, line in enumerate(lines):
            if lay.wy <= ly + i < lay.wy + lay.wh:
                _safestr(self.scr, ly + i,
                         max(0, (lay.ww - len(line)) // 2), line,
                         cp(CP_BRIGHT, bold=True))

    def draw_log(self):
        """Desktop message log, bottom-left, under everything."""
        if self.wins or not self.state.get('show_log', True):
            return
        lay = self.lay
        n = max(1, min(20, int(self.state.get('log_lines', 6))))
        shown = self.messages[-n:]
        base = lay.wy + lay.wh - len(shown) - 1
        for i, msg in enumerate(shown):
            # pad so the text stays legible on top of a busy wallpaper
            text = ' ' + str(msg)[:max(0, lay.ww - 6)] + ' '
            _safestr(self.scr, base + i, 1, text, cp(CP_DESKTOP, dim=True))

    def draw_menubar(self):
        lay = self.lay
        row = lay.menu_row
        attr = cp(CP_MENUBAR, bold=True)
        _safestr(self.scr, row, 0, ' ' * lay.W, cp(CP_MENUBAR))
        _safestr(self.scr, row, 1, 'COS', attr)
        col = 5
        self.menu_cols = {}
        for k in MENU_ORDER:
            label = MENUS[k][0]
            seg = f' {label} '
            on = (self.menu_open == k)
            a = cp(CP_MENU_SEL, bold=True) if on else attr
            _safestr(self.scr, row, col, seg, a)
            hi = label.lower().find(k)
            if hi >= 0:
                _safech(self.scr, row, col + 1 + hi, ord(label[hi]),
                        a | curses.A_UNDERLINE)
            self.menu_cols[k] = (col, len(seg))
            col += len(seg)
        # right-hand indicators
        ind = []
        ind.append('SND' if (self.sound.ready and self.state.get('sound_on')) else 'snd')
        ind.append('PAD' if self.ptr.mode in ('direct', 'sudo-bridge') else 'pad')
        s = ' ' + ' '.join(ind) + ' '
        _safestr(self.scr, row, max(col + 1, lay.W - len(s) - 1), s, attr)

    def draw_dropdown(self):
        k = self.menu_open
        if not k:
            return
        items = self.menu_items()
        col0, _ = self.menu_cols.get(k, (1, 4))
        w = max(len(i[0]) for i in items) + 4
        h = len(items) + 2
        x = min(col0, max(0, self.lay.W - w - 1))
        top = self.lay.menu_row
        y = top + 1 if top == 0 else max(0, top - h)
        draw_shadow(self.scr, y, x, h, w, cp(CP_SHADOW))
        draw_box(self.scr, y, x, h, w, cp(CP_WINDOW), cp(CP_WINDOW))
        for i, (text, action) in enumerate(items):
            if action is None:
                for cx in range(1, w - 1):
                    _safech(self.scr, y + 1 + i, x + cx, curses.ACS_HLINE,
                            cp(CP_SHADOW))
                continue
            a = (cp(CP_MENU_SEL, bold=True) if i == self.menu_sel
                 else cp(CP_TEXT))
            _safestr(self.scr, y + 1 + i, x + 1, f' {text:<{w - 4}} ', a)
        self._menu_rect = (y, x, h, w)

    def menu_items(self):
        if not self.menu_open:
            return []
        items = list(MENUS[self.menu_open][1])
        if self.menu_open == 'a' and self.registry:
            apps = self.registry.working
            if apps:
                items.append(('-', None))
                for a in apps[:12]:
                    items.append((a.title[:18], 'app:' + a.name))
        return items

    def open_menu(self, k):
        if k not in MENUS:
            return
        self.menu_open = k
        self.menu_sel = 0
        items = self.menu_items()
        while self.menu_sel < len(items) and items[self.menu_sel][1] is None:
            self.menu_sel += 1
        self.sound.play('menu')
        self.dirty = True

    def close_menu(self):
        if self.menu_open:
            self.menu_open = None
            self.dirty = True

    def menu_step(self, d):
        items = self.menu_items()
        if not items:
            return
        i = self.menu_sel
        for _ in range(len(items)):
            i = (i + d) % len(items)
            if items[i][1] is not None:
                break
        self.menu_sel = i
        self.dirty = True

    def menu_sibling(self, d):
        i = MENU_ORDER.index(self.menu_open)
        self.open_menu(MENU_ORDER[(i + d) % len(MENU_ORDER)])

    def draw_taskbar(self):
        lay = self.lay
        if lay.task_row is None:
            return
        row = lay.task_row
        _safestr(self.scr, row, 0, ' ' * lay.W, cp(CP_TASKBAR))
        col = 1
        self._task_rects = []
        for i, w in enumerate(self.wins):
            on = (w is self.active)
            label = f' {i + 1}:{w.title[:14]} '
            a = cp(CP_TASK_ON, bold=True) if on else cp(CP_TASKBAR)
            if col + len(label) >= lay.W - 12:
                _safestr(self.scr, row, col, '>>', cp(CP_TASKBAR, bold=True))
                break
            _safestr(self.scr, row, col, label, a)
            self._task_rects.append((col, len(label), w))
            col += len(label) + 1
        if not self.wins:
            _safestr(self.scr, row, 1, ' no windows -- APPS menu or desktop icons ',
                     cp(CP_TASKBAR, dim=True))
        cnt = f' {len(self.wins)} win '
        _safestr(self.scr, row, max(0, lay.W - len(cnt)), cnt,
                 cp(CP_TASKBAR, bold=True))

    def draw_statusbar(self):
        lay = self.lay
        row = lay.status_row
        px, py = self.ptr.pos
        bits = [f' COS v{VERSION}']
        if self.state.get('pref_mouse', True):
            bits.append(f'({px:>3},{py:>3})')
        if self.state.get('role'):
            bits.append(self.state['role'].upper() +
                        (f"/{self.state['conn_type']}" if self.state.get('conn_type') else ''))
        if self.kbmode:
            bits.append(f'** {self.kbmode[0].upper()} MODE: arrows, ENTER=ok, ESC=cancel **')
        elif self.drag:
            bits.append(f'** dragging ({self.drag["mode"]}) **')
        else:
            bits.append('^C=menu  TAB=next  F7=move  F8=size  '
                        'Super+Q=close  Ctrl+Alt+Q=quit')
        left = '  '.join(bits)
        right = (datetime.now().strftime(' %a %H:%M:%S ')
                 if self.state.get('pref_clock', True) else ' ')
        pad = lay.W - len(left) - len(right)
        _safestr(self.scr, row, 0, (left + ' ' * max(0, pad) + right)[:lay.W],
                 cp(CP_STATUS, bold=True))

    ACS_CURSORS = {
        'block':   lambda: curses.ACS_BLOCK,
        'arrow':   lambda: curses.ACS_LARROW,
        'diamond': lambda: curses.ACS_DIAMOND,
        'bullet':  lambda: curses.ACS_BULLET,
        'stipple': lambda: curses.ACS_CKBOARD,
    }

    def draw_cursor(self):
        px, py = self.ptr.pos
        attr = cp(CP_CURSOR, bold=True)
        # what the pointer is doing outranks the configured shape
        if self.drag:
            glyph = '#' if self.drag['mode'] == 'move' else '\\'
        elif self.ptr.fingers >= 2:
            glyph = '='
        elif any(self.ptr.buttons[1:]):
            glyph = 'o'
        else:
            shape = self.state.get('cursor_shape', 'plus')
            spec = dict(CURSOR_SHAPES).get(shape, '+')
            if spec is None:
                # invert whatever is under the pointer, like the console does
                try:
                    cell = self.scr.inch(py, px)
                    ch = cell & 0xFF
                    old = cell & ~0xFF
                    _safech(self.scr, py, px, ch,
                            old ^ curses.A_REVERSE | curses.A_BOLD)
                    return
                except curses.error:
                    glyph = '+'
            elif spec in self.ACS_CURSORS:
                try:
                    _safech(self.scr, py, px, self.ACS_CURSORS[spec](), attr)
                    return
                except curses.error:
                    glyph = '+'
            else:
                glyph = spec
        _safech(self.scr, py, px, ord(glyph), attr)

    def draw(self):
        self.draw_desktop()
        self.draw_log()
        for w in self.wins:
            try:
                w.draw(self.scr, w is self.active and not self.menu_open)
            except CosFatal:
                raise
            except Exception as e:
                _safestr(self.scr, w.y, w.x, f'[{w.title}: draw error {e}]'[:w.w],
                         cp(CP_WARN, bold=True))
        if self.drag and self.state.get('outline_drag', True):
            gx, gy, gw, gh = self.drag['ghost']
            draw_outline(self.scr, gy, gx, gh, gw, cp(CP_OUTLINE, bold=True))
        if self.kbmode:
            gx, gy, gw, gh = self.kbmode[2]
            draw_outline(self.scr, gy, gx, gh, gw, cp(CP_OUTLINE, bold=True))
        self.draw_menubar()
        self.draw_taskbar()
        self.draw_statusbar()
        self.draw_dropdown()
        self.draw_cursor()
        # caret for text-entry windows
        a = self.active
        if (a and not self.menu_open and not self.drag and not self.kbmode
                and a.want_cursor and a.caret):
            cy, cx = a.caret
            if 0 <= cy < a.chh and 0 <= cx < a.cw:
                try:
                    curses.curs_set(1)
                    self.scr.move(a.y + 1 + cy, a.x + 1 + cx)
                except curses.error:
                    pass
            else:
                try: curses.curs_set(0)
                except curses.error: pass
        else:
            try: curses.curs_set(0)
            except curses.error: pass

    # -- pointer dispatch ---------------------------------------------------
    def pointer_press(self, btn, gx, gy, dispatch):
        now = time.monotonic()
        lt, lx, ly = self._last_click
        self.double = (now - lt < DOUBLE_CLICK and abs(gx - lx) <= 2
                       and abs(gy - ly) <= 1)
        self._last_click = (now, gx, gy)
        lay = self.lay

        # dropdown has priority
        if self.menu_open:
            y, x, h, w = getattr(self, '_menu_rect', (0, 0, 0, 0))
            if y <= gy < y + h and x <= gx < x + w:
                i = gy - y - 1
                items = self.menu_items()
                if 0 <= i < len(items) and items[i][1]:
                    action = items[i][1]
                    self.close_menu()
                    self.sound.play('click')
                    dispatch(action)
                return
            if gy == lay.menu_row:
                pass        # fall through to the bar
            else:
                self.close_menu()
                return

        # menu bar
        if gy == lay.menu_row:
            for k, (col, wd) in self.menu_cols.items():
                if col <= gx < col + wd:
                    if self.menu_open == k:
                        self.close_menu()
                    else:
                        self.open_menu(k)
                    return
            self.close_menu()
            return

        # taskbar
        if lay.task_row is not None and gy == lay.task_row:
            for col, wd, w in getattr(self, '_task_rects', []):
                if col <= gx < col + wd:
                    if w is self.active:
                        self.wins.remove(w)
                        self.wins.insert(0, w)
                    else:
                        self.focus(w)
                    self.sound.play('click')
                    return
            return

        if gy == lay.status_row:
            return

        # windows
        w = self.window_at(gx, gy)
        if w:
            self.focus(w)
            zone = self.zone_of(w, gx, gy)
            if zone == 'close' and btn == 1:
                self.close(w)
            elif zone == 'max' and btn == 1:
                w.toggle_max(lay)
                self.sound.play('click')
            elif zone == 'title' and btn == 1:
                if self.double:
                    w.toggle_max(lay)
                    self.sound.play('click')
                else:
                    self.begin_move(w, gx, gy)
            elif zone == 'resize' and btn == 1:
                self.begin_resize(w, gx, gy)
            elif zone == 'client':
                try:
                    w.on_click(gy - w.y - 1, gx - w.x - 1, btn)
                except CosFatal:
                    raise
                except Exception as e:
                    self.notify(f'[{w.title}] click error: {e}', 'error')
            self.dirty = True
            return

        # desktop
        self.icon_sel = -1
        for i, (iy, ix, iw, label, action, glyph) in enumerate(self.icon_rects()):
            if gy == iy and ix <= gx < ix + iw:
                self.icon_sel = i
                self.sound.play('click')
                if self.double or btn == 3:
                    dispatch(action)
                self.dirty = True
                return
        self.dirty = True

    def pointer_release(self, btn, gx, gy):
        if self.drag:
            self.commit_drag()
        self.dirty = True

    def pointer_move(self, gx, gy):
        if self.drag:
            self.update_drag(gx, gy)
        elif self.menu_open:
            y, x, h, w = getattr(self, '_menu_rect', (0, 0, 0, 0))
            if y < gy < y + h - 1 and x <= gx < x + w:
                i = gy - y - 1
                items = self.menu_items()
                if 0 <= i < len(items) and items[i][1] and i != self.menu_sel:
                    self.menu_sel = i
                    self.sound.play('key')
        self.dirty = True

    def pointer_scroll(self, n, gx, gy):
        if self.menu_open:
            self.menu_step(1 if n > 0 else -1)
            return
        w = self.window_at(gx, gy) or self.active
        if w:
            self.focus(w)
            try:
                w.on_scroll(n)
            except CosFatal:
                raise
            except Exception:
                pass
        self.dirty = True


