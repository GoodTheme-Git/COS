class Clock(Window):
    icon = 'o'
    min_w, min_h = 34, 12

    def __init__(self, state):
        super().__init__('COS Clock', w=46, h=14)
        self.state = state
        self.seconds = True
        self.chime = False
        self._last_hour = -1

    def status(self):
        return f'S=seconds   C=hourly chime [{"on" if self.chime else "off"}]'

    def tick(self):
        if self.chime:
            h = datetime.now().hour
            if self._last_hour not in (-1, h) and self.wm:
                self.wm.sound.play('notify')
            self._last_hour = h

    def draw_client(self, c, active):
        c.fill(cp(CP_WINDOW))
        now = datetime.now()
        text = now.strftime('%H:%M:%S' if self.seconds else '%H:%M')
        gw = 4
        total = len(text) * gw
        x0 = max(0, (c.w - total) // 2)
        y0 = max(0, (c.h - 5) // 2 - 1)
        for i, ch in enumerate(text):
            glyph = BIG_DIGITS.get(ch, BIG_DIGITS[' '])
            for r, line in enumerate(glyph):
                for q, cc in enumerate(line):
                    if cc == '#':
                        c.ch(y0 + r, x0 + i * gw + q, curses.ACS_CKBOARD,
                             cp(CP_BRIGHT, bold=True))
        c.center(y0 + 6, now.strftime('%A, %B %d, %Y'), cp(CP_TEXT, bold=True))
        up = uptime_seconds()
        c.center(y0 + 7, f'up {int(up // 86400)}d {int(up % 86400 // 3600)}h '
                         f'{int(up % 3600 // 60)}m', cp(CP_SHADOW))

    def on_key(self, key):
        if key in (ord('s'), ord('S')):
            self.seconds = not self.seconds; return True
        if key in (ord('c'), ord('C')):
            self.chime = not self.chime
            if self.wm:
                self.wm.notify(f'[Clock] hourly chime '
                               f'{"enabled" if self.chime else "disabled"}', 'click')
            return True
        return False


