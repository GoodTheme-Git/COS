# DRUMAN  --  the COS music and video player   (drum + man = druman)
# =============================================================================
DRUMAN_BANNER = [
    ' ____                                 ',
    '|  _ \\ _ __ _   _ _ __ ___   __ _ _ _  ',
    '| | | | \'__| | | | \'_ ` _ \\ / _` | \'_\\ ',
    '| |_| | |  | |_| | | | | | | (_| | | | ',
    '|____/|_|   \\__,_|_| |_| |_|\\__,_|_| |_|',
]


class Druman(Window):
    icon = '\\'
    min_w, min_h = 52, 15

    REPEAT_MODES = ['off', 'all', 'one']

    def __init__(self, state):
        super().__init__('Druman  --  COS Music and Video Player', w=78, h=24)
        self.state = state
        self.tracks = []
        self.view_idx = []          # indices into tracks, after search filter
        self.sel = 0
        self.scroll = 0
        self.cur = -1
        self.proc = None
        self.paused = False
        self.start_t = 0.0
        self.pause_t = 0.0
        self.paused_total = 0.0
        self.seek_off = 0.0
        self.duration = None
        self.meta = ('', '', '')
        self.shuffle = False
        self.repeat = 'off'
        self.search = ''
        self.searching = False
        self.vu = [0.2] * 18
        self.msg = 'F5 rescan   A add folder   ENTER play   SPACE pause'
        self.backend = None
        self.fails = 0            # consecutive tracks that would not start
        self.history = []
        self.video = None         # VideoStream while a picture is playing
        self.media = {}           # probe_media for the current track
        self.view = 'auto'        # auto | split | list
        self.is_video = False
        self._list_rect = None
        self.vgrid = (0, 0)
        self.cover = None         # decoded album art for an audio track
        self._vgeom = None
        self._pending_audio = None   # audio held back until frame one lands
        self.prejob = None           # PrerenderJob when pre-rendering
        self._prestarted = False     # True once pre-rendered playback begins
        self.scan(initial=True)

    # -- library ------------------------------------------------------------
    MEDIA_EXT = None     # set below: audio + video

    def search_dirs(self):
        dirs = [os.path.expanduser(p) for p in (
            '~/Music', '~/music', '~/Musik', '~/Videos', '~/videos',
            '~/Downloads', '~/media')]
        # the folder COS itself lives in -- handy for dropping a track beside it
        dirs.append(os.path.dirname(os.path.abspath(__file__)))
        dirs += [d for d in self.state.get('druman_dirs', [])]
        seen, out = set(), []
        for d in dirs:
            d = os.path.abspath(os.path.expanduser(d))
            if d not in seen and os.path.isdir(d):
                seen.add(d)
                out.append(d)
        return out

    SKIP_DIRS = {'boot', 'grub', 'node_modules', '__pycache__', 'proc',
                 'sys', 'dev', '.git', 'venv', 'site-packages'}

    def scan(self, initial=False):
        found = []
        for base in self.search_dirs():
            for root, dirs, files in os.walk(base):
                dirs[:] = [d for d in dirs
                           if not d.startswith('.')
                           and d.lower() not in self.SKIP_DIRS][:40]
                if root[len(base):].count(os.sep) > 4:
                    dirs[:] = []
                    continue
                for fn in files:
                    if os.path.splitext(fn)[1].lower() in (AUDIO_EXT | VIDEO_EXT):
                        found.append(os.path.join(root, fn))
                if len(found) > 4000:
                    break
        found.sort(key=lambda p: (os.path.dirname(p).lower(),
                                  os.path.basename(p).lower()))
        self.tracks = found
        self.refilter()
        probe = media_cmd(found[0], 80) if found else None
        self.backend = probe[0] if probe else (
            'ffplay' if _which('ffplay') else None)
        if not initial:
            self.msg = f'Rescanned: {len(found)} track(s) in {len(self.search_dirs())} folder(s)'
            if self.wm:
                self.wm.sound.play('notify')

    def refilter(self):
        if self.search:
            q = self.search.lower()
            self.view_idx = [i for i, p in enumerate(self.tracks)
                             if q in os.path.basename(p).lower()
                             or q in os.path.dirname(p).lower()]
        else:
            self.view_idx = list(range(len(self.tracks)))
        self.sel = min(self.sel, max(0, len(self.view_idx) - 1))

    # -- playback -----------------------------------------------------------
    def elapsed(self):
        if self.cur < 0 or (self.proc is None and self.video is None
                            and self.prejob is None):
            return 0.0
        if self.prejob is not None and not self._prestarted:
            return self.seek_off          # still pre-rendering
        if self._pending_audio is not None and self.proc is None:
            return self.seek_off          # still waiting on the first frame
        now = self.pause_t if self.paused else time.monotonic()
        return max(0.0, self.seek_off + (now - self.start_t - self.paused_total))

    def _kill_video(self):
        if self.video:
            self.video.stop()
            self.video = None
        if self.prejob:
            self.prejob.stop()
            self.prejob = None
        self._prestarted = False
        self._vgeom = None

    def _kill(self):
        self._kill_video()
        if self.proc:
            try:
                if self.paused:
                    os.killpg(os.getpgid(self.proc.pid), signal.SIGCONT)
            except Exception:
                pass
            try:
                self.proc.terminate()
                self.proc.wait(timeout=1)
            except Exception:
                try: self.proc.kill()
                except Exception: pass
        self.proc = None
        self.paused = False

    def play_index(self, idx, seek=0.0, user=True):
        """idx indexes self.tracks."""
        if not (0 <= idx < len(self.tracks)):
            return
        if user:
            self.fails = 0          # an explicit pick resets the failure count
        path = self.tracks[idx]
        self.media = probe_media(path)
        is_video = (os.path.splitext(path)[1].lower() in VIDEO_EXT
                    and self.media.get('video'))
        if (is_video and user
                and self.state.get('media_backend') == 'ffplay'
                and ffplay_available()):
            # ffplay owns playback, so nothing here should keep decoding:
            # leaving is_video set would start AsciiVid in the window too.
            self.cur = idx
            self.meta = probe_tags(path)
            self.title = f'Druman  --  {self.meta[0][:34]}'
            self.is_video = False
            self.cover = None
            self.duration = self.media.get('duration') or 0.0
            self.play_external()
            return
        cmd = media_cmd(path, self.state.get('druman_volume', 80), int(seek))
        if is_video and _which('ffplay') and not SILENT:
            # play only the audio track here; the picture comes from ffmpeg
            cmd = ['ffplay', '-nodisp', '-autoexit', '-loglevel', 'quiet',
                   '-vn', '-volume',
                   str(int(max(0, min(100, self.state.get('druman_volume', 80)))))]
            if seek:
                cmd += ['-ss', str(int(seek))]
            cmd += [path]
            if not self.media.get('audio'):
                cmd = None       # silent video: nothing to play
        if SILENT and not is_video:
            self.msg = 'COS_SILENT is set: audio playback is suppressed'
            return
        if not is_video and not cmd:
            self.msg = 'No audio player found (install ffmpeg or mpv)'
            if self.wm:
                self.wm.notify('[Druman] no playback backend; install ffmpeg', 'error')
            return
        self._kill()
        self._pending_audio = None
        if is_video:
            # Decoders differ wildly in start-up cost (AV1 can take seconds),
            # so hold the audio back and fire it when the first frame lands.
            # Otherwise the picture trails the sound for the whole track.
            self._pending_audio = None if SILENT else cmd
            self.proc = None
            self.backend = (cmd[0] if cmd else 'ffmpeg') + ' (video)'
        elif cmd:
            try:
                self.proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                                             stderr=subprocess.DEVNULL,
                                             stdin=subprocess.DEVNULL,
                                             start_new_session=True)
            except Exception as e:
                self.msg = f'play failed: {e}'
                return
            self.backend = cmd[0]
        else:
            self.proc = None
            self.backend = 'none'
        self.is_video = is_video
        self.cur = idx
        self.seek_off = float(seek)
        self.start_t = time.monotonic()
        self.paused_total = 0.0
        self.paused = False
        self.duration = self.media.get('duration') or probe_duration(path)
        self.meta = probe_tags(path)
        self.cover = None
        if not seek:
            self.history.append(idx)
            del self.history[:-100]
        self.msg = (f'Playing {"video" if is_video else "audio"} '
                    f'via {self.backend}')
        self.title = f'Druman  --  {self.meta[0][:34]}'

    def stop(self):
        self._kill()
        self._pending_audio = None
        self.cur = -1
        self.seek_off = 0.0
        self.duration = None
        self.cover = None
        self.media = {}
        self.is_video = False
        self.title = 'Druman  --  COS Music and Video Player'
        self.msg = 'Stopped.'

    def toggle_pause(self):
        if not self.proc and self.prejob is not None and self._prestarted:
            if self.paused:
                self.paused_total += time.monotonic() - self.pause_t
                self.paused = False
                self.msg = 'Resumed.'
            else:
                self.pause_t = time.monotonic()
                self.paused = True
                self.msg = 'Paused.'
            return
        if not self.proc and not self.video:
            if self.view_idx:
                self.play_index(self.view_idx[self.sel])
            return
        if not self.proc:
            # silent video: only the picture needs pausing
            if self.paused:
                self.video.pause(False)
                self.paused_total += time.monotonic() - self.pause_t
                self.paused = False
                self.msg = 'Resumed.'
            else:
                self.video.pause(True)
                self.pause_t = time.monotonic()
                self.paused = True
                self.msg = 'Paused.'
            return
        try:
            pgid = os.getpgid(self.proc.pid)
            if self.paused:
                os.killpg(pgid, signal.SIGCONT)
                if self.video:
                    self.video.pause(False)
                self.paused_total += time.monotonic() - self.pause_t
                self.paused = False
                self.msg = 'Resumed.'
            else:
                os.killpg(pgid, signal.SIGSTOP)
                if self.video:
                    self.video.pause(True)
                self.pause_t = time.monotonic()
                self.paused = True
                self.msg = 'Paused.'
        except Exception as e:
            self.msg = f'pause unsupported: {e}'

    def next_track(self, user=True):
        if not self.tracks:
            return
        if self.shuffle:
            nxt = random.randrange(len(self.tracks))
        elif self.cur >= 0:
            nxt = self.cur + 1
            if nxt >= len(self.tracks):
                if self.repeat == 'all' or user:
                    nxt = 0
                else:
                    self.stop(); return
        else:
            nxt = self.view_idx[self.sel] if self.view_idx else 0
        self.play_index(nxt, user=user)
        self.reveal(nxt)

    def prev_track(self):
        if not self.tracks:
            return
        if len(self.history) >= 2:
            self.history.pop()
            idx = self.history.pop()
        else:
            idx = max(0, self.cur - 1)
        self.play_index(idx)
        self.reveal(idx)

    def seek(self, delta):
        if self.cur < 0:
            return
        pos = self.elapsed() + delta
        if self.duration:
            pos = min(pos, max(0.0, self.duration - 1))
        pos = max(0.0, pos)
        job = self.prejob
        if job is not None and job.done and job.count and self._prestarted:
            # every frame is already in memory, so only the clock moves; the
            # audio still has to restart because ffplay cannot be seeked
            limit = (job.count - 1) / max(1.0, getattr(self, 'vfps', 15.0))
            pos = min(pos, limit)
            held = None if SILENT else media_cmd(
                self.tracks[self.cur], self.state.get('druman_volume', 80),
                int(pos))
            if self.proc:
                try:
                    os.killpg(os.getpgid(self.proc.pid), signal.SIGCONT)
                    self.proc.terminate()
                except Exception:
                    pass
                self.proc = None
            self.seek_off = pos
            self.start_t = time.monotonic()
            self.paused_total = 0.0
            self.paused = False
            if held:
                try:
                    self.proc = subprocess.Popen(
                        held, stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
                        start_new_session=True)
                except Exception as e:
                    self.msg = f'audio restart failed: {e}'
            self.msg = f'Seek to {human_time(pos)} (instant, pre-rendered)'
            return
        self.play_index(self.cur, pos)

    def reveal(self, track_idx):
        if track_idx in self.view_idx:
            self.sel = self.view_idx.index(track_idx)

    def set_volume(self, delta=None, absolute=None):
        """Druman's own playback volume.

        This deliberately does NOT touch the system mixer: a slider in an app
        has no business changing the volume of the whole machine.
        """
        v = self.state.get('druman_volume', 80)
        v = max(0, min(100, absolute if absolute is not None else v + delta))
        self.state['druman_volume'] = v
        self.msg = f'Volume {v}%' + ('  (press ENTER to re-apply to the '
                                     'current track)' if self.proc else '')

    def on_close(self):
        self._kill()

    MIN_PLAY_SECONDS = 1.2       # shorter than this and it never really played
    MAX_CONSECUTIVE_FAILS = 3

    def tick(self):
        # Advance when the player process exits on its own. A file the backend
        # cannot decode exits instantly, so without a guard Druman would rip
        # through the whole library at frame rate, firing a burst of sound and
        # an error blip per track. Treat an instant exit as a failed start.
        done = False
        if self._pending_audio is not None:
            done = False                # still starting up
        elif self.proc is not None:
            done = self.proc.poll() is not None
        elif self.is_video and self.prejob is not None and self.prejob.done:
            idx = int(self.elapsed() * max(1.0, getattr(self, 'vfps', 15.0)))
            done = bool(self.prejob.count) and idx >= self.prejob.count
        elif self.is_video and self.video is not None:
            # a video with no audio track ends when its decoder exits
            done = not self.video.alive and self.video.frames > 0
        if done and not self.paused:
            ended = self.cur
            played = self.elapsed()
            self.proc = None
            self._kill_video()
            if played < self.MIN_PLAY_SECONDS and not self.seek_off:
                self.fails += 1
                name = (os.path.basename(self.tracks[ended])
                        if 0 <= ended < len(self.tracks) else '?')
                if self.fails >= self.MAX_CONSECUTIVE_FAILS:
                    self.stop()
                    self.fails = 0
                    self.msg = (f'Stopped: {self.MAX_CONSECUTIVE_FAILS} tracks in '
                                f'a row would not play (last: {name}). '
                                f'Backend: {self.backend or "none"}')
                    if self.wm:
                        self.wm.notify(f'[Druman] giving up after '
                                       f'{self.MAX_CONSECUTIVE_FAILS} unplayable '
                                       f'tracks ({name})', 'warn')
                    return
                self.msg = f'Skipped (will not play): {name}'
            else:
                self.fails = 0
            if self.repeat == 'one' and ended >= 0:
                self.play_index(ended, user=False)
            elif self.repeat == 'all' or self.shuffle:
                self.next_track(user=False)
            else:
                nxt = ended + 1
                if 0 <= nxt < len(self.tracks):
                    self.play_index(nxt, user=False)
                    self.reveal(nxt)
                else:
                    self.stop()
        # level animation
        if self.proc and not self.paused:
            for i in range(len(self.vu)):
                target = random.random() ** 1.6
                self.vu[i] += (target - self.vu[i]) * 0.45
        else:
            for i in range(len(self.vu)):
                self.vu[i] *= 0.80

    # -- drawing ------------------------------------------------------------
    HEADER = 6

    def status(self):
        n = len(self.view_idx)
        live = bool(self.proc or (self.video and self.video.alive))
        if self._pending_audio is not None:
            st = 'STARTING'
        else:
            st = 'PAUSED' if self.paused else ('PLAYING' if live else 'STOPPED')
        extra = ''
        if self.is_video and self.vgrid[0]:
            extra = f'  {self.vgrid[0]}x{self.vgrid[1]} cells'
            if self.video:
                extra += f' @{self.video.fps:.0f}fps'
        be = ('ffplay' if self.state.get('media_backend') == 'ffplay'
              else 'AsciiVid')
        return (f'{st}  {n}/{len(self.tracks)}  '
                f'vol {self.state.get("druman_volume", 80)}%  '
                f'{"SHUF " if self.shuffle else ""}RPT:{self.repeat.upper()}'
                f'  view:{self.view}{extra}  {be}  O=ffplay')

    def draw_client(self, c, active):
        c.fill(cp(CP_WINDOW))
        W = c.w
        # ---- now playing ------------------------------------------------
        title, artist, album = self.meta
        if self.cur < 0:
            c.put(0, 1, 'DRUMAN', cp(CP_BRIGHT, bold=True))
            c.put(0, 9, '-- nothing playing --', cp(CP_SHADOW))
        else:
            c.put(0, 1, '>', cp(CP_GREEN, bold=True) if not self.paused
                  else cp(CP_WARN, bold=True))
            c.put(0, 3, title[:W - 5], cp(CP_BRIGHT, bold=True))
            sub = '  --  '.join(x for x in (artist, album) if x)
            c.put(1, 3, sub[:W - 5] if sub else os.path.basename(
                os.path.dirname(self.tracks[self.cur]))[:W - 5], cp(CP_TEXT))
        # ---- progress ----------------------------------------------------
        el = self.elapsed()
        dur = self.duration or 0
        frac = (el / dur) if dur else 0.0
        lt = human_time(el)
        rt = human_time(dur) if dur else '--:--'
        barw = max(8, W - len(lt) - len(rt) - 8)
        c.put(2, 1, lt, cp(CP_TEXT, bold=True))
        c.put(2, 2 + len(lt), '[', cp(CP_SHADOW))
        c.bar(2, 3 + len(lt), barw, frac,
              cp(CP_METER, bold=True), cp(CP_SHADOW), None, '-')
        c.put(2, 3 + len(lt) + barw, ']', cp(CP_SHADOW))
        c.put(2, 5 + len(lt) + barw, rt, cp(CP_TEXT, bold=True))
        self._barspan = (3 + len(lt), barw)
        # ---- level meter + transport -------------------------------------
        meter = ''
        for v in self.vu:
            meter += ' .:|#'[min(4, int(max(0.0, v) * 5))]
        c.put(3, 1, meter, cp(CP_GREEN, bold=True))
        vol = self.state.get('druman_volume', 80)
        volbar_x = len(meter) + 3
        if volbar_x + 14 < W:
            c.put(3, volbar_x, 'VOL', cp(CP_TEXT))
            c.bar(3, volbar_x + 4, 10, vol / 100.0,
                  cp(CP_METER, bold=True), cp(CP_SHADOW), None, '-')
            c.put(3, volbar_x + 15, f'{vol:>3}%', cp(CP_TEXT))
        btns = [('|<<', 'prev'), ('>||' if not self.paused else '|> ', 'pause'),
                ('>>|', 'next'), ('[X]', 'stop'),
                ('SHF', 'shuffle'), (f'R:{self.repeat[:1].upper()}', 'repeat')]
        col = 1
        self._btns = []
        for lbl, name in btns:
            on = ((name == 'shuffle' and self.shuffle)
                  or (name == 'repeat' and self.repeat != 'off'))
            a = cp(CP_SEL, bold=True) if on else cp(CP_MENU_SEL)
            c.put(4, col, f' {lbl} ', a)
            self._btns.append((col, len(lbl) + 2, name))
            col += len(lbl) + 3
        if self.searching or self.search:
            q = f' /{self.search}' + ('_' if self.searching else '')
            c.put(4, max(col, W - len(q) - 1), q[:W - 2],
                  cp(CP_INPUT, bold=True))
        for i in range(W):
            c.ch(5, i, curses.ACS_HLINE, cp(CP_SHADOW))
        # ---- body: picture, playlist, or both ----------------------------
        top = self.HEADER
        height = max(1, c.h - top)
        showing_pic = (self.view != 'list'
                       and (self.is_video or self.cover is not None
                            or self._wants_cover()))
        if showing_pic and self.view == 'split':
            pic_w = max(16, int(W * 0.58))
            self._draw_picture(c, top, 0, pic_w, height)
            for r in range(height):
                c.ch(top + r, pic_w, curses.ACS_VLINE, cp(CP_SHADOW))
            self._draw_playlist(c, top, pic_w + 1, W - pic_w - 1, height)
        elif showing_pic:
            self._draw_picture(c, top, 0, W, height)
            self._list_rect = None
        else:
            self._draw_playlist(c, top, 0, W, height)

    # -- picture pane -------------------------------------------------------
    def _wants_cover(self):
        """True when the current audio track carries embedded artwork."""
        return bool(self.cur >= 0 and not self.is_video
                    and self.media.get('video')
                    and self.media.get('codec') in ('mjpeg', 'png', 'bmp', 'gif'))

    def _draw_picture(self, c, top, left, width, height):
        if self.cur < 0:
            return
        iw = self.media.get('w') or 16
        ih = self.media.get('h') or 9
        cols, rows = fit_cells(iw, ih, width, height, 'fit',
                               cell_aspect_value(self.state))
        x0 = left + max(0, (width - cols) // 2)
        y0 = top + max(0, (height - rows) // 2)
        if self.is_video:
            opts = quality_opts(self.state)
            cap = float(self.state.get('media_fps_cap', 15) or 15)
            pre = bool(self.state.get('media_prerender'))
            # A pre-render always covers the clip from zero, so seeking must
            # NOT appear in the key -- otherwise every seek would throw the
            # finished frames away and start decoding again, which defeats
            # the whole point. The live stream does start at the seek point,
            # so there it has to stay part of the key.
            geom = ((cols, rows, self.cur, opts['scaler'], opts['dither'],
                     cap, True) if pre else
                    (cols, rows, self.cur, round(self.seek_off, 1),
                     opts['scaler'], opts['dither'], cap, False))
            if geom != self._vgeom:
                self._kill_video()
                self._vgeom = geom
                src_fps = self.media.get('fps', 0.0)
                self.vfps = min(cap, src_fps if src_fps > 0 else cap)
                if pre:
                    # pre-render always starts at zero so seeking is just an
                    # index change afterwards
                    self.prejob = PrerenderJob(
                        self.tracks[self.cur], cols, rows, self.vfps,
                        opts['scaler'], opts['dither'],
                        int(self.state.get('media_prerender_mb', 256)), 0.0)
                else:
                    self.video = VideoStream(
                        self.tracks[self.cur], cols, rows, src_fps,
                        self.elapsed(), cap=cap, scaler=opts['scaler'])
                    if self.video.error:
                        self.msg = f'video: {self.video.error}'
                    if self.paused:
                        self.video.pause(True)
            self.vgrid = (cols, rows)
            if self.prejob is not None:
                self._draw_prerender(c, top, left, width, height,
                                     cols, rows, x0, y0)
                return
            frame = self.video.get() if self.video else None
            if frame and self._pending_audio is not None:
                self._start_held_audio()
            if frame:
                cell_art().draw(c, frame, cols, rows, y0, x0,
                                mono=self.state.get('media_mono', False),
                                dither=opts['dither'])
            else:
                msg = ('decoding...' if (self.video and self.video.alive)
                       else (self.video.error if self.video else 'no picture'))
                c.put(top + height // 2, left + max(0, (width - len(msg)) // 2),
                      msg, cp(CP_SHADOW))
        else:
            if self.cover is None:
                self.cover = decode_still(
                    self.tracks[self.cur], cols, rows,
                    scaler=quality_opts(self.state)['scaler']) or b''
                self.vgrid = (cols, rows)
            if self.cover and self.vgrid == (cols, rows):
                cell_art().draw(c, self.cover, cols, rows, y0, x0,
                                mono=self.state.get('media_mono', False),
                                dither=quality_opts(self.state)['dither'])
            elif self.cover:
                self.cover = None        # pane resized; decode again next frame

    def play_external(self):
        """Play the selected track with ffplay, which owns the whole screen."""
        if not self.view_idx:
            return
        idx = self.cur if self.cur >= 0 else self.view_idx[self.sel]
        if not (0 <= idx < len(self.tracks)):
            return
        if not ffplay_available():
            self.msg = 'ffplay is not installed'
            if self.wm:
                self.wm.sound.play('error')
            return
        path = self.tracks[idx]
        self._kill()                    # never play it twice at once
        self.paused = False
        if self.wm:
            self.wm.request_shell(
                ffplay_session(path, self.state,
                               note=os.path.basename(path)[:40]), 'ffplay')
        self.msg = f'Handed to ffplay: {os.path.basename(path)}'

    def _start_held_audio(self):
        """Release the audio now that the picture is actually producing."""
        cmd = None if SILENT else self._pending_audio
        self._pending_audio = None
        if not self._prestarted:
            self.start_t = time.monotonic()
            self.paused_total = 0.0
        if not cmd:
            return                     # silent video: the clock is enough
        try:
            self.proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                                         stderr=subprocess.DEVNULL,
                                         stdin=subprocess.DEVNULL,
                                         start_new_session=True)
            self.backend = cmd[0] + ' (video)'
        except Exception as e:
            self.msg = f'audio failed: {e}'

    def _draw_prerender(self, c, top, left, width, height, cols, rows, x0, y0):
        """Show pre-render progress, then play the finished frames."""
        job = self.prejob
        if job.error:
            msg = f'pre-render failed: {job.error}'
            c.put(top + height // 2, left + 1, msg[:width - 2],
                  cp(CP_WARN, bold=True))
            return
        if not job.done:
            # hold the audio until every frame exists, so playback is exact
            total = job.expected(self.duration or 0) or 0
            have = job.count
            frac = (have / total) if total else 0.0
            ry = top + height // 2 - 1
            label = (f'Pre-rendering {cols}x{rows}'
                     f'{" dithered" if job.dither else ""} ...')
            c.put(ry - 1, left + max(0, (width - len(label)) // 2), label,
                  cp(CP_BRIGHT, bold=True))
            bw = max(10, min(width - 4, 46))
            bx = left + max(0, (width - bw) // 2)
            c.bar(ry + 1, bx, bw, frac, cp(CP_METER, bold=True), cp(CP_SHADOW))
            el = time.monotonic() - job.started
            rate = have / el if el > 0.2 else 0.0
            eta = ((total - have) / rate) if (rate > 0 and total > have) else 0
            det = (f'{have}/{total or "?"} frames   {rate:.0f} fps'
                   + (f'   ETA {human_time(eta)}' if eta else ''))
            c.put(ry + 3, left + max(0, (width - len(det)) // 2), det,
                  cp(CP_TEXT))
            hint = 'P cancels pre-render and plays live instead'
            c.put(ry + 5, left + max(0, (width - len(hint)) // 2), hint,
                  cp(CP_SHADOW))
            return
        if not job.count:
            c.put(top + height // 2, left + 1, 'pre-render produced no frames',
                  cp(CP_WARN, bold=True))
            return
        if not self._prestarted:
            # the pre-render took real time; the playback clock starts now
            self._prestarted = True
            self.start_t = time.monotonic()
            self.paused_total = 0.0
            self.pause_t = self.start_t
            if self._pending_audio is not None:
                self._start_held_audio()
            took = job.finished - job.started if job.finished else 0.0
            self.msg = (f'Pre-rendered {job.count} frames in '
                        f'{human_time(took)} -- seeking is instant now')
        idx = int(self.elapsed() * max(1.0, getattr(self, 'vfps', 15.0)))
        cells = job.get(idx)
        if cells:
            cell_art().draw_cells(c, cells, cols, rows, y0, x0)
        if job.truncated and idx >= job.count - 1:
            note = f'(pre-render stopped at the {job.count}-frame memory cap)'
            c.put(top + height - 1, left + 1, note[:width - 2], cp(CP_SHADOW))

    # -- playlist pane ------------------------------------------------------
    def _draw_playlist(self, c, top, left, width, height):
        vis = max(1, height)
        self._list_rect = (top, left, width, height)
        if self.sel < self.scroll:
            self.scroll = self.sel
        if self.sel >= self.scroll + vis:
            self.scroll = self.sel - vis + 1
        self.scroll = max(0, min(self.scroll, max(0, len(self.view_idx) - vis)))
        need_sb = len(self.view_idx) > vis
        bodyw = width - (1 if need_sb else 0)
        if not self.view_idx:
            c.put(top, left + 2, 'No media found.', cp(CP_WARN, bold=True))
            c.put(top + 1, left + 2, 'Press A to add a folder, F5 to rescan.',
                  cp(CP_TEXT))
            for i, d in enumerate(self.search_dirs()[:max(0, vis - 3)]):
                c.put(top + 3 + i, left + 4, 'searched: ' + d, cp(CP_SHADOW))
            return
        numw = len(str(len(self.tracks)))
        for i in range(vis):
            ri = self.scroll + i
            if ri >= len(self.view_idx):
                break
            ti = self.view_idx[ri]
            path = self.tracks[ti]
            playing = (ti == self.cur)
            sel = (ri == self.sel)
            mark = ('>' if not self.paused else '=') if playing else ' '
            vid = os.path.splitext(path)[1].lower() in VIDEO_EXT
            name = os.path.basename(path)
            folder = os.path.basename(os.path.dirname(path))
            lead = f'{mark}{"V" if vid else " "}{ti + 1:>{numw}} {name}'
            right = f'{folder[:12]} '
            pad = max(1, bodyw - len(lead) - len(right))
            line = (lead + ' ' * pad + right)[:bodyw]
            if sel and self.wm and self is self.wm.active:
                a = cp(CP_SEL, bold=True)
            elif sel:
                a = cp(CP_MENU_SEL)
            elif playing:
                a = cp(CP_GREEN, bold=True)
            else:
                a = cp(CP_TEXT)
            c.put(top + i, left, f'{line:<{bodyw}}', a)
        if need_sb:
            c.scrollbar(top, left + width - 1, vis, len(self.view_idx), vis,
                        self.scroll, cp(CP_SCROLL))

    # -- input --------------------------------------------------------------
    def on_key(self, key):
        if self.searching:
            if key in (curses.KEY_ENTER, 10, 13):
                self.searching = False; return True
            if key == 27:
                self.searching = False; self.search = ''; self.refilter(); return True
            if key in (curses.KEY_BACKSPACE, 127, 8):
                self.search = self.search[:-1]; self.refilter(); return True
            if 32 <= key <= 126:
                self.search += chr(key); self.refilter(); return True
            return True

        vis = max(1, self.chh - self.HEADER)
        if key in (curses.KEY_UP,):
            self.sel = max(0, self.sel - 1); return True
        if key in (curses.KEY_DOWN,):
            self.sel = min(max(0, len(self.view_idx) - 1), self.sel + 1); return True
        if key == curses.KEY_PPAGE:
            self.sel = max(0, self.sel - vis); return True
        if key == curses.KEY_NPAGE:
            self.sel = min(max(0, len(self.view_idx) - 1), self.sel + vis); return True
        if key == curses.KEY_HOME:
            self.sel = 0; return True
        if key == curses.KEY_END:
            self.sel = max(0, len(self.view_idx) - 1); return True
        if key in (curses.KEY_ENTER, 10, 13):
            if self.view_idx:
                self.play_index(self.view_idx[self.sel])
            return True
        if key == ord(' '):
            self.toggle_pause(); return True
        if key in (ord('n'), curses.KEY_RIGHT):
            self.next_track(); return True
        if key in (ord('p'), curses.KEY_LEFT):
            self.prev_track(); return True
        if key in (ord('x'), ord('X')):
            self.stop(); return True
        if key in (ord('+'), ord('=')):
            self.set_volume(delta=5); return True
        if key in (ord('-'), ord('_')):
            self.set_volume(delta=-5); return True
        if key in (ord('m'), ord('M')):
            self.set_volume(absolute=0 if self.state.get('druman_volume', 80) else 80)
            return True
        if key == ord(']'):
            self.seek(+10); return True
        if key == ord('['):
            self.seek(-10); return True
        if key in (ord('}'),):
            self.seek(+60); return True
        if key in (ord('{'),):
            self.seek(-60); return True
        if key in (ord('s'), ord('S')):
            self.shuffle = not self.shuffle
            self.msg = f'Shuffle {"on" if self.shuffle else "off"}'; return True
        if key in (ord('r'), ord('R')):
            i = self.REPEAT_MODES.index(self.repeat)
            self.repeat = self.REPEAT_MODES[(i + 1) % 3]
            self.msg = f'Repeat: {self.repeat}'; return True
        if key == ord('/'):
            self.searching = True; return True
        if key in (curses.KEY_F5,):
            self.scan(); return True
        if key in (ord('a'), ord('A')):
            if self.wm:
                self.wm.open(PromptWindow(
                    'Druman: Add Folder', 'Path to a folder of music:',
                    os.path.expanduser('~/Music'), self._add_dir))
            return True
        if key in (ord('i'), ord('I')):
            self.show_info(); return True
        if key in (ord('o'), ord('O')):
            self.play_external(); return True
        if key == ord('P'):
            on = not self.state.get('media_prerender', False)
            self.state['media_prerender'] = on
            self._vgeom = None
            self.msg = f'pre-render {"on" if on else "off"}'
            return True
        if key == ord('Q'):
            i = MEDIA_QUALITY_ORDER.index(
                self.state.get('media_quality', 'fine')
                if self.state.get('media_quality') in MEDIA_QUALITY_ORDER
                else 'fine')
            q = MEDIA_QUALITY_ORDER[(i + 1) % len(MEDIA_QUALITY_ORDER)]
            self.state['media_quality'] = q
            self._vgeom = None
            self.cover = None
            self.msg = f'quality: {MEDIA_QUALITY[q]["label"]}'
            return True
        if key in (ord('v'), ord('V')):
            order = ['auto', 'split', 'list']
            self.view = order[(order.index(self.view) + 1) % len(order)]
            self.cover = None
            self._vgeom = None
            self.msg = f'view: {self.view}'
            return True
        if key == ord('M'):
            self.state['media_mono'] = not self.state.get('media_mono', False)
            self.msg = f'mono {"on" if self.state["media_mono"] else "off"}'
            return True
        if key in (ord('g'), ord('G')):
            if self.cur >= 0:
                self.reveal(self.cur)
            return True
        return False

    def _add_dir(self, path):
        path = os.path.abspath(os.path.expanduser(path.strip()))
        if not os.path.isdir(path):
            self.msg = f'Not a folder: {path}'
            if self.wm:
                self.wm.sound.play('error')
            return
        dirs = list(self.state.get('druman_dirs', []))
        if path not in dirs:
            dirs.append(path)
            self.state['druman_dirs'] = dirs
            save_config(self.state)
        self.scan()
        self.msg = f'Added {path}'

    def show_info(self):
        if self.cur < 0:
            return
        path = self.tracks[self.cur]
        i = self.media
        lines = [f'  File    : {os.path.basename(path)}',
                 f'  Folder  : {os.path.dirname(path)}',
                 f'  Size    : {human_size(os.path.getsize(path))}',
                 f'  Title   : {self.meta[0]}',
                 f'  Artist  : {self.meta[1] or "(unknown)"}',
                 f'  Album   : {self.meta[2] or "(unknown)"}',
                 f'  Length  : {human_time(self.duration) if self.duration else "unknown"}',
                 f'  Backend : {self.backend}']
        if i.get('video'):
            lines += [f'  Picture : {i.get("w")}x{i.get("h")} {i.get("codec")} '
                      f'@ {i.get("fps", 0):.2f} fps'
                      + ('' if self.is_video else '   (cover art)'),
                      f'  Cells   : {self.vgrid[0]}x{self.vgrid[1]}']
        if i.get('audio'):
            lines.append(f'  Audio   : {i.get("acodec")}')
        lines.append('')
        if _which('ffprobe'):
            lines.append('  -- ffprobe streams --')
            lines += ['  ' + l for l in run_cmd(
                ['ffprobe', '-v', 'error', '-show_entries',
                 'stream=codec_name,sample_rate,channels,bit_rate',
                 '-of', 'default=noprint_wrappers=1', path]).split('\n')]
        if self.wm:
            self.wm.open(TextWindow('Track Info', lines))

    def on_click(self, row, col, btn):
        if row == 2:
            bx, bw = getattr(self, '_barspan', (0, 1))
            if bx <= col < bx + bw and self.duration and self.cur >= 0:
                frac = (col - bx) / max(1, bw - 1)
                self.play_index(self.cur, frac * self.duration)
                return True
        if row == 3:
            # volume bar
            meterlen = len(self.vu) + 3
            if meterlen + 4 <= col < meterlen + 14:
                self.set_volume(absolute=int((col - meterlen - 4) / 9 * 100))
                return True
        if row == 4:
            for bc, bw, name in getattr(self, '_btns', []):
                if bc <= col < bc + bw:
                    if name == 'prev': self.prev_track()
                    elif name == 'pause': self.toggle_pause()
                    elif name == 'next': self.next_track()
                    elif name == 'stop': self.stop()
                    elif name == 'shuffle': self.shuffle = not self.shuffle
                    elif name == 'repeat':
                        i = self.REPEAT_MODES.index(self.repeat)
                        self.repeat = self.REPEAT_MODES[(i + 1) % 3]
                    if self.wm: self.wm.sound.play('click')
                    return True
        rect = self._list_rect
        if rect:
            top, left, width, height = rect
            if row >= top and left <= col < left + width:
                ri = self.scroll + (row - top)
                if 0 <= ri < len(self.view_idx):
                    self.sel = ri
                    if (self.wm and self.wm.double) or btn == 3:
                        self.play_index(self.view_idx[ri])
                    return True
        return False

    def on_scroll(self, n):
        vis = max(1, (self._list_rect[3] if self._list_rect
                      else self.chh - self.HEADER))
        self.scroll = max(0, min(self.scroll + n * 2,
                                 max(0, len(self.view_idx) - vis)))
        self.sel = max(self.scroll, min(self.sel, self.scroll + vis - 1))
        return True

    def on_resize(self):
        self._vgeom = None
        self.cover = None


