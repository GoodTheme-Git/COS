COLOUR_NAMES = ['black', 'red', 'green', 'yellow',
                'blue', 'magenta', 'cyan', 'white']

# Choice settings whose value is the string itself rather than an index.
STRING_CHOICES = {'bar_position', 'cursor_shape', 'logo_mode', 'icon_layout',
                  'media_backend', 'media_quality', 'cell_aspect',
                  'console_font', 'desktop_render'}

RENDER_LABELS = {
    'text':     'Text mode (regular COS rendering)',
    'graphics': 'Graphics mode (render desktop live)  [BETA]',
}
RENDER_CHOICES = ['text', 'graphics']


def choice_label(key, value):
    if key == 'desktop_render':
        return RENDER_LABELS.get(value, value)
    if key == 'media_backend':
        return BACKEND_LABELS.get(value, value)
    if key == 'media_quality':
        return MEDIA_QUALITY.get(value, {}).get('label', value)
    if key == 'console_font':
        return value or '(leave the console font alone)'
    if key == 'cell_aspect':
        if value == 'auto':
            return 'auto (measured)'
        return f'{value} : 1'
    return str(value)


class DesktopSettings(ScrollListWindow):
    """Everything about how the desktop itself looks.

    Kept separate from Preferences because the desktop is visible behind the
    window, so every change previews itself immediately.
    """

    icon = '*'
    min_w, min_h = 52, 12

    def __init__(self, state, wmref=None):
        super().__init__('Desktop Settings', w=64, h=22)
        self.state = state
        self.msg = ''
        self.defs = [
            ('head', 'WALLPAPER', None, None),
            ('choice', 'Pattern', 'wallpaper_idx', [w[0] for w in WALLPAPERS]),
            ('int', 'Pattern scale', 'wallpaper_scale', (2, 24, 1)),
            ('colour', 'Pattern colour', 'desk_fg', None),
            ('colour', 'Background colour', 'desk_bg', None),
            ('head', 'BANNER', None, None),
            ('choice', 'Banner', 'logo_mode',
             ['builtin', 'art', 'text', 'none']),
            ('action', 'Pick an ANSI art file...', 'pick_art', None),
            ('action', 'Set banner text...', 'set_text', None),
            ('head', 'ICONS', None, None),
            ('bool', 'Show desktop icons', 'show_icons', None),
            ('choice', 'Arrangement', 'icon_layout',
             ['column', 'row', 'grid']),
            ('int', 'Icon spacing (rows)', 'icon_gap', (1, 4, 1)),
            ('head', 'MESSAGE LOG', None, None),
            ('bool', 'Show the log on the desktop', 'show_log', None),
            ('int', 'Log lines', 'log_lines', (1, 20, 1)),
            ('head', 'POINTER', None, None),
            ('choice', 'Cursor shape', 'cursor_shape', CURSOR_NAMES),
            ('head', 'BARS', None, None),
            ('bool', 'Show taskbar', 'show_taskbar', None),
            ('choice', 'Bar position', 'bar_position', ['top', 'bottom']),
            ('head', '', None, None),
            ('action', 'Save settings now', 'save', None),
            ('action', 'Reset desktop to defaults', 'reset', None),
        ]

    def rows(self):
        return self.defs

    def status(self):
        return self.msg or ('LEFT/RIGHT change   ENTER toggle/run   '
                            'changes preview live behind this window')

    def row_text(self, i, item):
        kind, label, key, extra = item
        if kind == 'head':
            return (f' -- {label} ' + '-' * 40) if label else ' '
        if kind == 'action':
            return f'   [ {label} ]'
        val = self.state.get(key)
        if kind == 'bool':
            return f'   {"[X]" if val else "[ ]"} {label}'
        if kind == 'choice':
            if key in STRING_CHOICES:
                cur = choice_label(key, val if val in extra else extra[0])
            else:
                cur = extra[int(val) % len(extra)]
            return f'   {label:<26} < {cur} >'
        if kind == 'int':
            return f'   {label:<26} < {val} >'
        if kind == 'colour':
            n = int(val if val is not None else -1)
            cur = 'theme' if n < 0 else f'{n} {COLOUR_NAMES[n & 7]}'
            return f'   {label:<26} < {cur} >'
        return f'   {label}'

    def row_attr(self, i, item, selected, active):
        if item[0] == 'head':
            return cp(CP_BRIGHT, bold=True)
        if selected:
            return cp(CP_SEL, bold=True) if active else cp(CP_MENU_SEL)
        if item[0] == 'action':
            return cp(CP_GREEN)
        return cp(CP_TEXT)

    def _skip(self, d):
        n = len(self.defs)
        for _ in range(n):
            if 0 <= self.sel < n and self.defs[self.sel][0] != 'head':
                return
            self.sel = (self.sel + d) % n

    def adjust(self, delta):
        kind, label, key, extra = self.defs[self.sel]
        if kind == 'bool':
            self.state[key] = not self.state.get(key)
        elif kind == 'choice':
            if key in STRING_CHOICES:
                cur = self.state.get(key, extra[0])
                i = extra.index(cur) if cur in extra else 0
                self.state[key] = extra[(i + delta) % len(extra)]
            else:
                self.state[key] = (int(self.state.get(key, 0)) + delta) % len(extra)
        elif kind == 'int':
            lo, hi, step = extra
            self.state[key] = max(lo, min(hi, int(self.state.get(key, lo))
                                          + delta * step))
        elif kind == 'colour':
            n = int(self.state.get(key, -1))
            n = n + delta
            if n > 7:
                n = -1
            elif n < -1:
                n = 7
            self.state[key] = n
        else:
            return
        if self.wm:
            self.wm._wp_key = None      # drop the cached wallpaper
            self.wm.dirty = True
        self.msg = ''

    def run_action(self, key):
        if key == 'pick_art':
            here = os.path.dirname(os.path.abspath(__file__))
            default = (self.state.get('logo_file')
                       or os.path.join(here, 'cos.txt'))
            if self.wm:
                self.wm.open(PromptWindow(
                    'Banner art', 'ANSI art file (as made by figlet/toilet):',
                    default, self._set_art))
        elif key == 'set_text':
            if self.wm:
                self.wm.open(PromptWindow(
                    'Banner text', 'Text (use \\n for a line break):',
                    self.state.get('logo_text', '') or f'COS v{VERSION}',
                    self._set_text))
        elif key == 'save':
            self.msg = (f'Saved to {COS_CONFIG}' if save_config(self.state)
                        else 'Save failed')
            if self.wm:
                self.wm.sound.play('drop')
        elif key == 'reset':
            if self.wm:
                self.wm.open(ConfirmWindow(
                    'Reset Desktop',
                    ['Put every desktop setting back to its default?'],
                    self._reset))

    def _set_art(self, path):
        path = os.path.expanduser(path.strip())
        art = load_ansi_art(path)
        if not art:
            self.msg = f'No art could be read from {path}'
            if self.wm:
                self.wm.sound.play('error')
            return
        self.state['logo_file'] = path
        self.state['logo_mode'] = 'art'
        if self.wm:
            self.wm._art_key = None
            self.wm.dirty = True
        self.msg = f'Banner: {len(art)} rows from {os.path.basename(path)}'

    def _set_text(self, text):
        self.state['logo_text'] = text.replace('\\n', '\n')
        self.state['logo_mode'] = 'text'
        self.msg = 'Banner text set'
        if self.wm:
            self.wm.dirty = True

    def _reset(self):
        for k in ('wallpaper_idx', 'wallpaper_scale', 'desk_fg', 'desk_bg',
                  'logo_mode', 'logo_file', 'logo_text', 'icon_layout',
                  'icon_gap', 'show_log', 'log_lines', 'cursor_shape',
                  'show_icons', 'show_taskbar', 'bar_position'):
            self.state[k] = DEFAULTS[k]
        if self.wm:
            self.wm._wp_key = None
            self.wm._art_key = None
            self.wm.dirty = True
        self.msg = 'Desktop reset'

    def on_key(self, key):
        if key == curses.KEY_UP:
            self.sel = max(0, self.sel - 1); self._skip(-1); return True
        if key == curses.KEY_DOWN:
            self.sel = min(len(self.defs) - 1, self.sel + 1)
            self._skip(1); return True
        if key == curses.KEY_LEFT:
            self.adjust(-1); return True
        if key == curses.KEY_RIGHT:
            self.adjust(1); return True
        if key in (curses.KEY_ENTER, 10, 13, ord(' ')):
            kind, label, k, extra = self.defs[self.sel]
            if kind == 'action':
                self.run_action(k)
            elif kind != 'head':
                self.adjust(1)
            return True
        return super().on_key(key)

    def on_click(self, row, col, btn):
        idx = self.scroll + row
        if 0 <= idx < len(self.defs) and self.defs[idx][0] != 'head':
            self.sel = idx
            if self.defs[idx][0] == 'action':
                self.run_action(self.defs[idx][2])
            else:
                self.adjust(1 if col > self.cw // 2 else -1)
            return True
        return False

    def on_close(self):
        save_config(self.state)


