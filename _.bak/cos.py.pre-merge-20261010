def run_cmd(args, prefix='', timeout=10, limit=400):
    """Run a command and return its combined output as text."""
    try:
        r = subprocess.run(args, capture_output=True, text=True,
                           timeout=timeout, errors='replace')
        out = (r.stdout or '') + (r.stderr or '')
        lines = out.rstrip().split('\n')[:limit]
        if r.returncode != 0 and not out.strip():
            lines = [f'(exit {r.returncode})']
        return '\n'.join(prefix + l for l in lines)
    except FileNotFoundError:
        return f'{prefix}command not found: {args[0]}'
    except subprocess.TimeoutExpired:
        return f'{prefix}timed out after {timeout}s'
    except Exception as e:
        return f'{prefix}{type(e).__name__}: {e}'


def human_size(n):
    n = float(n)
    for unit in ('B', 'K', 'M', 'G', 'T'):
        if abs(n) < 1024.0 or unit == 'T':
            return f'{n:.0f}{unit}' if unit == 'B' else f'{n:.1f}{unit}'
        n /= 1024.0


def human_time(seconds):
    try:
        s = int(max(0, seconds))
    except (TypeError, ValueError):
        return '--:--'
    h, rem = divmod(s, 3600)
    m, s = divmod(rem, 60)
    return f'{h}:{m:02d}:{s:02d}' if h else f'{m}:{s:02d}'


_MATH_NS = {k: getattr(math, k) for k in dir(math) if not k.startswith('_')}
_MATH_NS.update({'abs': abs, 'round': round, 'min': min, 'max': max,
                 'int': int, 'float': float, 'pow': pow, 'ans': 0.0})


def eval_math(expr, extra=None):
    ns = dict(_MATH_NS)
    if extra:
        ns.update(extra)
    return eval(expr, {'__builtins__': {}}, ns)


def meminfo():
    info = {'total': 0, 'free': 0, 'used': 0, 'avail': 0,
            'swap_total': 0, 'swap_free': 0}
    try:
        with open('/proc/meminfo') as f:
            vals = {}
            for line in f:
                k, _, v = line.partition(':')
                vals[k.strip()] = int(v.strip().split()[0])   # kB
        info['total'] = vals.get('MemTotal', 0)
        info['free'] = vals.get('MemFree', 0)
        info['avail'] = vals.get('MemAvailable', info['free'])
        info['used'] = info['total'] - info['avail']
        info['swap_total'] = vals.get('SwapTotal', 0)
        info['swap_free'] = vals.get('SwapFree', 0)
    except Exception:
        pass
    return info


def cpu_times():
    try:
        with open('/proc/stat') as f:
            parts = f.readline().split()[1:]
        vals = [int(p) for p in parts[:8]]
        idle = vals[3] + (vals[4] if len(vals) > 4 else 0)
        return sum(vals), idle
    except Exception:
        return 0, 0


def loadavg():
    try:
        return os.getloadavg()
    except Exception:
        return (0.0, 0.0, 0.0)


def uptime_seconds():
    try:
        with open('/proc/uptime') as f:
            return float(f.read().split()[0])
    except Exception:
        return 0.0


def battery_info():
    base = '/sys/class/power_supply'
    try:
        for name in sorted(os.listdir(base)):
            d = os.path.join(base, name)
            if not os.path.exists(os.path.join(d, 'capacity')):
                continue
            with open(os.path.join(d, 'capacity')) as f:
                pct = int(f.read().strip())
            st = 'Unknown'
            try:
                with open(os.path.join(d, 'status')) as f:
                    st = f.read().strip()
            except OSError:
                pass
            return pct, st
    except Exception:
        pass
    return None, None


