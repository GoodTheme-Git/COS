class AppTimeout(Exception):
    pass


def _app_timeout(_sig, _frm):
    raise AppTimeout()


class CosApp:
    """One .cosapp file: its manifest, its App class, and why it failed.

    The manifest is read by *parsing* the file, never by running it. That
    distinction matters: a standalone script often does real work at module
    level -- opening a display, grabbing audio -- and executing it merely to
    discover its name would hang or hijack the console. Code only runs when
    the user actually launches the app.
    """

    LOAD_TIMEOUT = 15

    def __init__(self, path):
        self.path = os.path.abspath(path)
        self.name = os.path.basename(path)[:-len(APP_EXT)]
        self.manifest = {}
        self.cls = None
        self.error = ''
        self.mtime = 0.0
        self.loaded_at = 0.0
        self.has_app_class = False
        self.app_bases = []
        self.peeked = False

    @property
    def title(self):
        return str(self.manifest.get('name') or self.name)

    @property
    def kind(self):
        k = str(self.manifest.get('kind', 'window')).lower()
        return k if k in ('window', 'external') else 'window'

    @property
    def ok(self):
        """Does this look like a usable app? (without having run it)"""
        if self.error:
            return False
        if not self.manifest:
            return False
        if self.kind == 'external':
            return bool(self.manifest.get('command'))
        return self.has_app_class

    @property
    def loaded(self):
        return self.cls is not None

    def stale(self):
        try:
            return os.path.getmtime(self.path) != self.mtime
        except OSError:
            return False

    # -- inspection, no execution ------------------------------------------
    def peek(self):
        """Parse the file for COSAPP and class App. Runs nothing."""
        self.manifest = {}
        self.cls = None
        self.error = ''
        self.has_app_class = False
        self.app_bases = []
        self.peeked = True
        try:
            self.mtime = os.path.getmtime(self.path)
            with open(self.path, encoding='utf-8', errors='replace') as f:
                src = f.read()
        except OSError as e:
            self.error = 'cannot read: %s' % e
            return False
        try:
            tree = ast.parse(src, filename=self.path)
        except SyntaxError as e:
            self.error = 'syntax error on line %s: %s' % (e.lineno, e.msg)
            return False
        except Exception as e:
            self.error = 'cannot parse: %s: %s' % (type(e).__name__, e)
            return False
        for node in tree.body:
            if isinstance(node, ast.ClassDef) and node.name == 'App':
                self.has_app_class = True
                # Record what it derives from. A class with no bases at all
                # provably is not a Window, and saying so now -- before any
                # code runs -- is the whole point of peeking.
                for b in node.bases:
                    if isinstance(b, ast.Name):
                        self.app_bases.append(b.id)
                    elif isinstance(b, ast.Attribute):
                        self.app_bases.append(b.attr)
                    else:
                        self.app_bases.append('<expression>')
            elif isinstance(node, ast.Assign):
                names = [t.id for t in node.targets if isinstance(t, ast.Name)]
                if 'COSAPP' in names:
                    try:
                        self.manifest = ast.literal_eval(node.value)
                    except Exception:
                        self.error = ('COSAPP must be a plain dict of '
                                      'literals (no expressions)')
                        return False
        if not isinstance(self.manifest, dict) or not self.manifest:
            self.manifest = {}
            self.error = ('not a COS app: no COSAPP = {...} manifest. '
                          'Plain Python scripts belong outside ~/.cos/apps.')
            return False
        if self.kind == 'external':
            if not self.manifest.get('command'):
                self.error = "kind 'external' needs a command"
                return False
            return True
        if not self.has_app_class:
            self.error = 'no class App in the file'
            return False
        if not self.app_bases:
            self.error = ('class App must derive from cos.Window '
                          '(it has no base class)')
            return False
        return True

    # -- execution, only on demand -----------------------------------------
    def load(self, api, timeout=None):
        """Compile and run the file. Only call this to launch the app.

        A .cosapp is ordinary Python executed with the user's own
        privileges; there is no sandbox and there cannot usefully be one
        in-process. An alarm bounds how long module-level code may take so
        one bad file cannot wedge COS forever.
        """
        if not self.peeked or self.stale():
            if not self.peek():
                return False
        if self.kind == 'external':
            return True
        try:
            with open(self.path, encoding='utf-8', errors='replace') as f:
                src = f.read()
        except OSError as e:
            self.error = 'cannot read: %s' % e
            return False
        ns = {'__name__': 'cosapp_' + self.name, '__file__': self.path,
              'cos': api, 'curses': curses}
        limit = int(timeout or self.LOAD_TIMEOUT)
        armed = False
        old = None
        try:
            old = signal.signal(signal.SIGALRM, _app_timeout)
            signal.alarm(limit)
            armed = True
        except (ValueError, OSError, AttributeError):
            armed = False          # not the main thread; run without a net
        try:
            exec(compile(src, self.path, 'exec'), ns)
        except AppTimeout:
            self.error = ('still running after %ds at import time -- module '
                          'level code should not block' % limit)
            return False
        except SystemExit:
            self.error = 'the file called sys.exit() while loading'
            return False
        except SyntaxError as e:
            self.error = 'syntax error on line %s: %s' % (e.lineno, e.msg)
            return False
        except BaseException as e:
            self.error = '%s while loading: %s' % (type(e).__name__, e)
            return False
        finally:
            if armed:
                try:
                    signal.alarm(0)
                    if old is not None:
                        signal.signal(signal.SIGALRM, old)
                except (ValueError, OSError):
                    pass
        cls = ns.get('App')
        if not (isinstance(cls, type) and issubclass(cls, Window)):
            self.error = 'App must be a class deriving from cos.Window'
            return False
        man = ns.get('COSAPP')
        if isinstance(man, dict) and man:
            self.manifest = man
        self.cls = cls
        self.error = ''
        self.loaded_at = time.monotonic()
        return True

    def make(self, state):
        """Build an instance, reporting rather than raising on failure."""
        if self.cls is None:
            self.error = self.error or 'not loaded'
            return None
        try:
            win = self.cls(state)
        except TypeError:
            try:
                win = self.cls()
            except BaseException as e:
                self.error = '%s in App(): %s' % (type(e).__name__, e)
                return None
        except BaseException as e:
            self.error = '%s in App(): %s' % (type(e).__name__, e)
            return None
        if not isinstance(win, Window):
            self.error = 'App() did not return a window'
            return None
        if not win.title:
            win.title = self.title
        return win

    # -- external apps -----------------------------------------------------
    def command_list(self):
        cmd = self.manifest.get('command')
        if isinstance(cmd, str):
            try:
                return shlex.split(cmd)
            except ValueError:
                return [cmd]
        if isinstance(cmd, (list, tuple)):
            return [str(x) for x in cmd]
        return []


def external_session(app, state):
    """Run an 'external' app on the bare console, then come back.

    Anything that drives SDL, OpenGL or the framebuffer needs the console
    out of text mode, exactly like ffplay does, or it draws nothing until
    the VT is switched away and back.
    """
    cmd = app.command_list()
    graphics = bool(app.manifest.get('graphics', False))
    cwd = app.manifest.get('cwd') or os.path.dirname(app.path)

    def _run():
        print()
        print('=' * 68)
        print('  COS -- %s' % app.title)
        print('=' * 68)
        print()
        print('  running: %s' % ' '.join(cmd))
        if graphics:
            print('  console: graphics mode (so SDL/OpenGL can draw)')
        print()
        time.sleep(0.5)
        env = sdl_env() if graphics else dict(os.environ)
        with ConsoleGraphics(graphics):
            try:
                r = subprocess.run(cmd, cwd=cwd if os.path.isdir(cwd) else None,
                                   env=env)
                code = r.returncode
            except FileNotFoundError:
                code = -1
                print('  not found: %s' % (cmd[0] if cmd else '?'))
            except Exception as e:
                code = -1
                print('  failed: %s' % e)
        if console_mode() == KD_GRAPHICS:
            set_console_graphics(False)
        sys.stdout.write('\033[H\033[2J')
        sys.stdout.flush()
        if code not in (0, None):
            print()
            print('  %s exited with %s' % (app.title, code))
            input('  Press ENTER to return to COS... ')
    return _run


def cosapp_api(state):
    """The `cos` namespace a .cosapp sees.

    Deliberately explicit: an app gets the window classes, the colour
    helpers and the dialogs, and nothing it would have to guess at.
    """
    import types
    api = types.SimpleNamespace(
        VERSION=VERSION, CODENAME=CODENAME,
        HOME=COS_HOME, APP_DIR=APP_DIR, SOUND_DIR=SOUND_DIR,
        state=state,
        Window=Window, ScrollListWindow=ScrollListWindow, Canvas=Canvas,
        NoticeWindow=NoticeWindow, ProgressWindow=ProgressWindow,
        ConfirmWindow=ConfirmWindow, PromptWindow=PromptWindow,
        TextWindow=TextWindow,
        cp=cp, media_attr=media_attr,
        draw_box=draw_box, draw_outline=draw_outline,
        cell_art=cell_art, fit_cells=fit_cells, decode_still=decode_still,
        RAMP=RAMP,
        human_size=human_size, human_time=human_time, run_cmd=run_cmd,
        wrap_text=wrap_text, which=_which, eval_math=eval_math,
        meminfo=meminfo, loadavg=loadavg, uptime_seconds=uptime_seconds,
        battery_info=battery_info, local_addresses=local_addresses,
        probe_media=probe_media, file_manifest=file_manifest,
        curses=curses,
    )
    for _name in list(globals()):
        if _name.startswith('CP_'):
            setattr(api, _name, globals()[_name])
    return api


class AppRegistry:
    """Finds .cosapp files and loads them only when they are launched."""

    def __init__(self, state):
        self.state = state
        self.apps = []
        self.api = cosapp_api(state)
        self.safe_mode = bool(os.environ.get('COS_NO_APPS')) \
            or bool(state.get('apps_off'))

    def disabled_names(self):
        return list(self.state.get('apps_disabled') or [])

    def is_disabled(self, app):
        return app.name in self.disabled_names()

    def set_disabled(self, app, off):
        names = self.disabled_names()
        if off and app.name not in names:
            names.append(app.name)
        elif not off and app.name in names:
            names.remove(app.name)
        self.state['apps_disabled'] = names
        save_config(self.state)

    def scan(self):
        """Re-read the folder. Parses manifests; runs nothing."""
        if self.safe_mode:
            self.apps = []
            return self.apps
        try:
            os.makedirs(APP_DIR, exist_ok=True)
            names = sorted(n for n in os.listdir(APP_DIR)
                           if n.endswith(APP_EXT))
        except OSError:
            names = []
        by_path = {a.path: a for a in self.apps}
        out = []
        for n in names:
            path = os.path.abspath(os.path.join(APP_DIR, n))
            app = by_path.get(path)
            if app is None:
                app = CosApp(path)
                app.peek()
            elif app.stale():
                app.cls = None
                app.peek()
            out.append(app)
        self.apps = out
        return out

    def reload(self, app):
        """Re-read from disk; load the code too if it was already running."""
        was_loaded = app.loaded
        app.cls = None
        ok = app.peek()
        if ok and was_loaded and app.kind == 'window':
            ok = app.load(self.api)
        return ok

    def reload_all(self):
        for a in list(self.apps):
            self.reload(a)

    def launch(self, app, wm, confirmed=False):
        """Open a window app, or hand an external one to the console.

        An app may ask to be confirmed first by putting a 'confirm'
        message in its manifest; useful for anything that takes over the
        console or is known to be fragile.
        """
        if self.is_disabled(app):
            wm.notice('Disabled', '%s is switched off in the App Manager.'
                      % app.title, 'warn')
            return None
        if not app.ok:
            wm.notice('Cannot run ' + app.title,
                      app.error or 'unknown problem', 'error')
            return None
        msg = app.manifest.get('confirm')
        if msg and not confirmed:
            title = str(app.manifest.get('confirm_title') or app.title)
            wm.open(ConfirmWindow(
                title, str(msg),
                on_yes=lambda a=app: self.launch(a, wm, confirmed=True),
                danger=bool(app.manifest.get('danger', True)),
                yes=str(app.manifest.get('confirm_yes', 'Continue')),
                no=str(app.manifest.get('confirm_no', 'Cancel'))))
            return 'asked'
        if app.kind == 'external':
            cmd = app.command_list()
            if not cmd:
                wm.notice('Cannot run ' + app.title,
                          'the manifest has no usable command', 'error')
                return None
            target = cmd[0]
            if not (os.path.exists(target) or _which(target)):
                wm.notice('Cannot run ' + app.title,
                          'not found: %s' % target, 'error')
                return None
            wm.request_shell(external_session(app, self.state), app.title)
            return 'external'
        if not app.loaded:
            if not app.load(self.api):
                wm.notice('Cannot load ' + app.title,
                          app.error or 'unknown problem', 'error')
                return None
        win = app.make(self.state)
        if win is None:
            wm.notice('Cannot start ' + app.title,
                      app.error or 'unknown problem', 'error')
            return None
        wm.open(win)
        return win

    def find(self, key):
        for a in self.apps:
            if key in (a.name, a.title, a.path):
                return a
        return None

    @property
    def working(self):
        return [a for a in self.apps
                if a.ok and not self.is_disabled(a)]

    @property
    def broken(self):
        return [a for a in self.apps if not a.ok]

    def write_template(self, name, author=''):
        """Create a starter app; returns (path, error)."""
        safe = ''.join(ch for ch in name if ch.isalnum() or ch in '-_ ').strip()
        safe = (safe or 'MyApp').replace(' ', '')
        path = os.path.join(APP_DIR, safe + APP_EXT)
        if os.path.exists(path):
            return None, safe + APP_EXT + ' already exists'
        try:
            os.makedirs(APP_DIR, exist_ok=True)
            with open(path, 'w', encoding='utf-8') as f:
                f.write(APP_TEMPLATE % {
                    'name': safe,
                    'author': author or os.environ.get('USER', '')})
        except OSError as e:
            return None, str(e)
        return path, ''

    def write_launcher(self, name, command, graphics=True, author=''):
        """Create an 'external' app that runs something on the console."""
        safe = ''.join(ch for ch in name if ch.isalnum() or ch in '-_ ').strip()
        safe = (safe or 'Launcher').replace(' ', '')
        path = os.path.join(APP_DIR, safe + APP_EXT)
        if os.path.exists(path):
            return None, safe + APP_EXT + ' already exists'
        cmd = command if isinstance(command, (list, tuple)) else [command]
        body = LAUNCHER_TEMPLATE % {
            'name': name, 'author': author or os.environ.get('USER', ''),
            'command': repr([str(c) for c in cmd]),
            'graphics': 'True' if graphics else 'False',
            'icon': (name.strip()[:1] or '*').upper(),
        }
        try:
            os.makedirs(APP_DIR, exist_ok=True)
            with open(path, 'w', encoding='utf-8') as f:
                f.write(body)
        except OSError as e:
            return None, str(e)
        return path, ''


class AppManager(ScrollListWindow):
    """Install, inspect, reload and launch .cosapp files."""

    icon = '&'
    min_w, min_h = 54, 12

    def __init__(self, state, registry):
        super().__init__('App Manager', w=74, h=20)
        self.state = state
        self.reg = registry
        self.msg = ''
        self.reg.scan()
        self._next = 0.0

    def tick(self):
        # pick up edits made in another window without being asked
        now = time.monotonic()
        if now >= self._next:
            self._next = now + 2.0
            before = [(a.path, a.mtime, a.ok) for a in self.reg.apps]
            self.reg.scan()
            after = [(a.path, a.mtime, a.ok) for a in self.reg.apps]
            if before != after and before:
                self.msg = 'reloaded changed app(s)'

    def rows(self):
        return self.reg.apps

    def header_rows(self):
        return 2

    def visible_rows(self):
        return max(1, self.chh - 3)

    def footer_rows(self):
        return 1

    def status(self):
        if self.msg:
            return self.msg
        n = len(self.reg.working)
        b = len(self.reg.broken)
        return (str(n) + ' ok, ' + str(b) + ' broken   ENTER run  R reload  '
                'N new  L launcher  O on/off  E edit  D details  X delete')

    def draw_header(self, c, active):
        c.put(0, 1, 'Apps in ' + APP_DIR, cp(CP_BRIGHT, bold=True))
        c.put(1, 1, ('%-20s %-8s %-9s %s' % ('name', 'version', 'status',
                                             'description'))[:c.w - 2],
              cp(CP_MENU_SEL))

    def row_text(self, i, item):
        man = item.manifest
        if self.reg.is_disabled(item):
            state = 'off'
        elif not item.ok:
            state = 'BROKEN'
        elif item.kind == 'external':
            state = 'launcher'
        elif item.loaded:
            state = 'running'
        else:
            state = 'ok'
        desc = (item.error if not item.ok
                else str(man.get('description', '')))
        return ' %-20s %-8s %-9s %s' % (item.title[:20],
                                        str(man.get('version', '?'))[:8],
                                        state, desc)

    def row_attr(self, i, item, selected, active):
        if selected:
            return cp(CP_SEL, bold=True) if active else cp(CP_MENU_SEL)
        if self.reg.is_disabled(item):
            return cp(CP_SHADOW)
        return cp(CP_TEXT) if item.ok else cp(CP_WARN)

    def draw_footer(self, c, active, top):
        if not self.reg.apps:
            c.put(top - self.visible_rows() + 1, 2,
                  'No apps yet. Press N to write a starter app.',
                  cp(CP_BRIGHT, bold=True))
            c.put(top - self.visible_rows() + 3, 2,
                  'A .cosapp is plain Python with a COSAPP dict and an App',
                  cp(CP_TEXT))
            c.put(top - self.visible_rows() + 4, 2,
                  'class deriving from cos.Window. It runs with your own',
                  cp(CP_TEXT))
            c.put(top - self.visible_rows() + 5, 2,
                  'privileges -- there is no sandbox, so only run apps you',
                  cp(CP_SHADOW))
            c.put(top - self.visible_rows() + 6, 2,
                  'trust, exactly like any other script.', cp(CP_SHADOW))
            return
        if top < c.h:
            c.put(top, 1, ('Apps run with your privileges; there is no '
                           'sandbox.')[:c.w - 2], cp(CP_SHADOW))

    def selected(self):
        apps = self.reg.apps
        if apps and 0 <= self.sel < len(apps):
            return apps[self.sel]
        return None

    def on_activate(self, i, item):
        self.launch(item)

    def launch(self, app):
        if not self.wm:
            return
        res = self.reg.launch(app, self.wm)
        if res == 'asked':
            self.msg = 'waiting for you to confirm ' + app.title
        elif res is not None:
            self.msg = ('handed %s to the console' % app.title
                        if res == 'external' else 'started ' + app.title)

    def on_key(self, key):
        app = self.selected()
        if key in (ord('r'), ord('R')):
            if app:
                ok = self.reg.reload(app)
                self.msg = (('reloaded ' + app.title) if ok
                            else ('reload failed: ' + app.error))
                self.play('drop' if ok else 'error')
            return True
        if key == curses.KEY_F5:
            self.reg.reload_all()
            self.msg = 'reloaded all'
            return True
        if key in (ord('n'), ord('N')):
            self.prompt('New app', 'Name for the new .cosapp:', 'MyApp',
                        self._new)
            return True
        if key in (ord('l'), ord('L')):
            self.prompt('New launcher',
                        'Command to run on the console:',
                        'python3 ~/cos/game.py', self._new_launcher)
            return True
        if key in (ord('o'), ord('O')):
            if app:
                off = not self.reg.is_disabled(app)
                self.reg.set_disabled(app, off)
                self.msg = '%s is now %s' % (app.title, 'off' if off else 'on')
                self.play('click')
            return True
        if key in (ord('e'), ord('E')):
            if app and self.wm:
                self.wm.open(Editor(self.state, app.path))
            return True
        if key in (ord('d'), ord('D')):
            if app:
                lines = ['  file    : ' + app.path,
                         '  name    : ' + app.title,
                         '  kind    : ' + app.kind,
                         '  status  : ' + ('ok' if app.ok else 'BROKEN')
                         + ('  (switched off)' if self.reg.is_disabled(app)
                            else ''),
                         '  code run: ' + ('yes' if app.loaded else
                                           'no -- manifest was only parsed'),
                         '']
                if app.kind == 'window':
                    lines.insert(3, '  App base: '
                                 + (', '.join(app.app_bases) or '(none)'))
                if app.kind == 'external':
                    lines += ['  command : ' + ' '.join(app.command_list()),
                              '  graphics: %s' % app.manifest.get('graphics'),
                              '']
                if app.error:
                    lines += ['  error:', '    ' + app.error, '']
                if app.manifest:
                    lines.append('  manifest:')
                    for k in sorted(app.manifest):
                        lines.append('    %-12s %r' % (k, app.manifest[k]))
                self.text('App: ' + app.title, lines, w=74)
            return True
        if key in (ord('x'), ord('X'), curses.KEY_DC):
            if app:
                self.confirm('Delete app',
                             ['Delete this .cosapp file?', '', '  ' + app.path],
                             lambda a=app: self._delete(a), danger=True)
            return True
        if key in (ord('f'), ord('F')):
            if self.wm:
                self.wm.open(FileManager(self.state, APP_DIR))
            return True
        return super().on_key(key)

    def _new_launcher(self, cmdline):
        cmdline = cmdline.strip()
        if not cmdline:
            return
        try:
            parts = shlex.split(cmdline)
        except ValueError:
            parts = [cmdline]
        parts = [os.path.expanduser(x) for x in parts]
        target = parts[0] if parts else ''
        # a bare script path is nicer to run through the interpreter
        if target.endswith('.py') and os.path.exists(target):
            parts = [sys.executable] + parts
        probe = parts[0]
        if not (os.path.exists(probe) or _which(probe)):
            self.error('Not found', 'Could not find: ' + probe)
            return
        guess = os.path.basename(parts[-1]) or 'Launcher'
        guess = os.path.splitext(guess)[0]
        self._pending_cmd = parts
        self.prompt('Launcher name', 'Name to show in COS:', guess,
                    self._finish_launcher)

    def _finish_launcher(self, name):
        parts = getattr(self, '_pending_cmd', None)
        if not parts:
            return
        self._pending_cmd = None
        path, err = self.reg.write_launcher(name, parts, True,
                                            os.environ.get('USER', ''))
        if not path:
            self.error('Could not create the launcher', err)
            return
        self.reg.scan()
        self.success('Launcher created',
                     ['Wrote ' + path, '',
                      'It runs:', '  ' + ' '.join(parts), '',
                      'COS will drop to the console, put it in graphics',
                      'mode so SDL or OpenGL can draw, and come back when',
                      'the program exits. ENTER runs it.'])

    def _new(self, name):
        path, err = self.reg.write_template(name,
                                            os.environ.get('USER', ''))
        if not path:
            self.error('Could not create the app', err)
            return
        self.reg.scan()
        app = self.reg.find(os.path.basename(path)[:-len(APP_EXT)])
        if app and self.wm:
            self.sel = self.reg.apps.index(app)
        self.success('App created',
                     ['Wrote ' + path, '',
                      'ENTER runs it, E opens it in the editor,',
                      'R reloads it after you save.'])

    def _delete(self, app):
        try:
            os.remove(app.path)
            self.reg.scan()
            self.msg = 'deleted ' + app.title
            self.play('drop')
        except OSError as e:
            self.error('Delete failed', str(e))


