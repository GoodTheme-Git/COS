# Linux console fonts carry only 256 glyphs, so wallpapers stay ASCII (or use
# a curses ACS glyph, signalled by returning None). Each entry is
# (name, cell function); the function takes the cell position plus a scale
# and returns the character for that cell.
def _wp_solid(x, y, s):   return ' '
def _wp_fine(x, y, s):    return '.'
def _wp_dots(x, y, s):    return '.' if (x % s == 0 and y % max(1, s // 2) == 0) else ' '
def _wp_grid(x, y, s):    return '+' if (x % s == 0 or y % max(1, s // 2) == 0) else ' '
def _wp_weave(x, y, s):   return ':' if ((x + y) % s == 0) else ' '
def _wp_diag(x, y, s):    return '/' if ((x + y) % s == 0) else ' '
def _wp_back(x, y, s):    return '\\' if ((x - y) % s == 0) else ' '
def _wp_cross(x, y, s):   return 'x' if ((x + y) % s == 0 or (x - y) % s == 0) else ' '
def _wp_stars(x, y, s):   return '*' if ((x * 7 + y * 13) % (s * 3) == 0) else ' '
def _wp_tilde(x, y, s):   return '~'
def _wp_stipple(x, y, s): return None
def _wp_checker(x, y, s): return None if (((x // s) + (y // max(1, s // 2))) % 2 == 0) else ' '

def _wp_bricks(x, y, s):
    h = max(2, s // 2)
    if y % h == 0:
        return '-'
    return '|' if ((x + (y // h) * (s // 2)) % s == 0) else ' '

def _wp_waves(x, y, s):
    return '~' if int(2.0 * math.sin(x / max(2.0, s / 2.0))) == (y % 5) - 2 else ' '

WALLPAPERS = [
