def init_media_pairs():
    for i, (a, b) in enumerate(MEDIA_COMBOS):
        try:
            curses.init_pair(MEDIA_PAIR_BASE + i, b, a)
        except curses.error:
            return i
    return len(MEDIA_COMBOS)


def media_attr(fg, bg, bold=False):
    """An attribute for an arbitrary fg/bg pair, out of the media pair block.

    The 28 media pairs cover every unordered pair of the eight colours, so
    any combination is reachable -- reversed when the pair happens to hold
    the two colours the other way round.
    """
    fg &= 7
    bg &= 7
    extra = curses.A_BOLD if bold else 0
    if fg == bg:
        # a flat field of one colour: draw a space over that background
        if bg < 7:
            i = MEDIA_COMBOS.index((bg, bg + 1))
            return curses.color_pair(MEDIA_PAIR_BASE + i) | extra
        i = MEDIA_COMBOS.index((6, 7))
        return curses.color_pair(MEDIA_PAIR_BASE + i) | curses.A_REVERSE | extra
    lo, hi = (fg, bg) if fg < bg else (bg, fg)
    i = MEDIA_COMBOS.index((lo, hi))
    attr = curses.color_pair(MEDIA_PAIR_BASE + i) | extra
    if fg == lo:                    # pair renders hi on lo; we want the swap
        attr |= curses.A_REVERSE
    return attr


def cp(n, bold=False, dim=False, rev=False):
    a = curses.color_pair(n)
    if bold: a |= curses.A_BOLD
    if dim:  a |= curses.A_DIM
    if rev:  a |= curses.A_REVERSE
    return a


