class ServerWizard(Window):
    icon = 'S'
    min_w, min_h = 54, 16

    def __init__(self, state):
        super().__init__('Server Wizard  1/3: Choose Type', w=68, h=20)
        self.state = state
        self.step = 0
        self.sel = 0
        self.stype = None
        self.sname = ''
        self.fields = []
        self.fsel = 0
        self.editing = False
        self.buf = ''
        self.cmds = []
        self.msg = ''

    def status(self):
        if self.msg:
            return self.msg
        return [
            'UP/DN choose   ENTER next   ^W cancel',
            'ENTER edit field   TAB next   F=finish   ESC back',
            'S=save script   X=save+show run line   ESC=back',
        ][self.step]

    def draw_client(self, c, active):
        c.fill(cp(CP_WINDOW))
        if self.step == 0:
            c.put(0, 2, 'Select the server you want to configure:',
                  cp(CP_BRIGHT, bold=True))
            for i, (name, _k) in enumerate(_SRV_TYPES):
                if 2 + i >= c.h:
                    break
                a = cp(CP_SEL, bold=True) if i == self.sel else cp(CP_TEXT)
                c.put(2 + i, 2, f'{">" if i == self.sel else " "} [{i + 1:>2}] {name}'
                      [:c.w - 3], a)
        elif self.step == 1:
            c.put(0, 2, f'Configure: {self.sname}'[:c.w - 3], cp(CP_BRIGHT, bold=True))
            c.put(1, 2, 'ENTER=edit   TAB=next field   F=finish   ESC=back',
                  cp(CP_SHADOW))
            for i, (name, val) in enumerate(self.fields):
                if 3 + i >= c.h:
                    break
                show = self.buf if (self.editing and i == self.fsel) else val
                cur = '_' if (self.editing and i == self.fsel) else ''
                la = cp(CP_BRIGHT, bold=True) if i == self.fsel else cp(CP_TEXT)
                va = (cp(CP_INPUT, bold=True) if (self.editing and i == self.fsel)
                      else cp(CP_MENU_SEL) if i == self.fsel else cp(CP_TEXT))
                lbl = f'  {name:<16}: '
                c.put(3 + i, 2, lbl, la)
                c.put(3 + i, 2 + len(lbl), f'{show}{cur}'[:c.w - 4 - len(lbl)], va)
        else:
            c.put(0, 2, f'Install script: {self.sname}'[:c.w - 3],
                  cp(CP_BRIGHT, bold=True))
            vis = c.h - 2
            self.scroll = max(0, min(self.scroll, max(0, len(self.cmds) - vis)))
            for i in range(vis):
                ri = self.scroll + i
                if ri >= len(self.cmds):
                    break
                line = self.cmds[ri]
                c.put(2 + i, 2, line[:c.w - 3],
                      cp(CP_SHADOW) if line.startswith('#') else cp(CP_GREEN))

    def on_key(self, key):
        if self.step == 0:
            if key == curses.KEY_UP:
                self.sel = (self.sel - 1) % len(_SRV_TYPES); return True
            if key == curses.KEY_DOWN:
                self.sel = (self.sel + 1) % len(_SRV_TYPES); return True
            if key in (curses.KEY_ENTER, 10, 13):
                self.sname, self.stype = _SRV_TYPES[self.sel]
                self.fields = [list(t) for t in _SRV_FIELDS.get(
                    self.stype, [('Option', 'value')])]
                self.step = 1
                self.title = 'Server Wizard  2/3: Configure'
                return True
            return False
        if self.step == 1:
            if self.editing:
                if key in (curses.KEY_ENTER, 10, 13, 9):
                    self.fields[self.fsel][1] = self.buf
                    self.editing = False
                    self.fsel = (self.fsel + 1) % len(self.fields)
                elif key == 27:
                    self.editing = False
                elif key in (curses.KEY_BACKSPACE, 127, 8):
                    self.buf = self.buf[:-1]
                elif 32 <= key <= 126:
                    self.buf += chr(key)
                return True
            if key == 27:
                self.step = 0
                self.title = 'Server Wizard  1/3: Choose Type'; return True
            if key == curses.KEY_UP:
                self.fsel = (self.fsel - 1) % len(self.fields); return True
            if key in (curses.KEY_DOWN, 9):
                self.fsel = (self.fsel + 1) % len(self.fields); return True
            if key in (curses.KEY_ENTER, 10, 13):
                self.editing = True
                self.buf = self.fields[self.fsel][1]; return True
            if key in (ord('f'), ord('F')):
                self.cmds = _gen_cmds(self.stype, dict(self.fields))
                self.step = 2
                self.scroll = 0
                self.title = 'Server Wizard  3/3: Install Script'
                return True
            return False
        # step 2
        if key == 27:
            self.step = 1
            self.title = 'Server Wizard  2/3: Configure'; return True
        if key == curses.KEY_UP:
            self.scroll = max(0, self.scroll - 1); return True
        if key == curses.KEY_DOWN:
            self.scroll = min(max(0, len(self.cmds) - 1), self.scroll + 1); return True
        if key in (ord('s'), ord('S'), ord('x'), ord('X')):
            fname = os.path.join(COS_HOME, f'{self.stype}_setup.sh')
            try:
                os.makedirs(COS_HOME, exist_ok=True)
                with open(fname, 'w') as fh:
                    fh.write('#!/bin/bash\n')
                    fh.write(f'# COS Server Wizard: {self.sname}\n')
                    fh.write(f'# generated {datetime.now()}\n')
                    fh.write('set -e\n\n')
                    for cmd in self.cmds:
                        fh.write(cmd + '\n')
                os.chmod(fname, 0o755)
                self.msg = f'Saved {fname}'
                if self.wm:
                    self.wm.notify(f'[Wizard] saved {fname}', 'drop')
                    if key in (ord('x'), ord('X')):
                        self.wm.notify(f'[Wizard] review it, then run: bash {fname}')
            except Exception as e:
                self.msg = f'Save failed: {e}'
                if self.wm: self.wm.sound.play('error')
            return True
        return False

    def on_scroll(self, n):
        self.scroll = max(0, min(self.scroll + n * 2, max(0, len(self.cmds) - 1)))
        return True


