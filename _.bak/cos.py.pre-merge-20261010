def resolution_report(state, wm=None):
    """Explain, in numbers, what is limiting picture resolution right now."""
    H, W = (wm.lay.H, wm.lay.W) if (wm and wm.lay) else (0, 0)
    px = screen_pixels()
    det = detect_cell_aspect(W, H)
    aspect = cell_aspect_value(state)
    opts = quality_opts(state)
    lines = [
        '  WHERE THE RESOLUTION COMES FROM', '',
        f'  Console grid   : {W} x {H} cells',
        f'  Panel          : {px[0]} x {px[1]} pixels' if px
        else '  Panel          : unknown (sysfs not readable)',
    ]
    if px and W and H:
        lines += [f'  Cell size      : {px[0] / W:.1f} x {px[1] / H:.1f} pixels',
                  f'  Cell aspect    : measured {det:.2f}, using {aspect:.2f}'
                  if det else f'  Cell aspect    : using {aspect:.2f}']
    lines += [
        '',
        f'  Renderer       : {BACKEND_LABELS.get(state.get("media_backend"), "?")}',
        f'  Quality        : {opts["label"]}',
        f'  Frame cap      : {state.get("media_fps_cap")} fps',
        f'  Pre-render     : {"on" if state.get("media_prerender") else "off"}'
        f'  (cap {state.get("media_prerender_mb")} MB)',
        f'  Palette        : {len(cell_art().tones)} tones from '
        f'{len(MEDIA_COMBOS)} pairs x {len(RAMP)} glyphs',
        '',
        '  TO GET MORE RESOLUTION', '',
        '  1. Maximise the window (F9). The picture can only use the cells',
        '     the window actually has.',
        '  2. Load a smaller console font. That is the real lever: it',
        '     changes how many cells the whole screen has.',
    ]
    fonts = console_fonts(8)
    if px:
        for stem, fw, fh in fonts[:6]:
            lines.append(f'       {stem:<24} {fw}x{fh}px -> '
                         f'{px[0] // fw} x {px[1] // fh} cells '
                         f'({(px[0] // fw) * (px[1] // fh):,})')
    lines += [
        '',
        '  3. Quality "detail" dithers between cells, which is worth more',
        '     than extra cells for photographs. It costs about 15x the CPU',
        '     per frame, so pair it with pre-render for video.',
        '  4. An 8x8 font has square cells; COS measures that and stops',
        '     squashing the picture automatically.',
        '',
    ]
    return lines


