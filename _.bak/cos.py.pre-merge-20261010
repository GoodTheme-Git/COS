def _do_restart(state):
    def _run():
        try:
            save_config(state)
        except Exception:
            pass
        print()
        print('  Restarting COS...')
        time.sleep(0.4)
        restart_cos()
    return _run


def tty_name():
    try:
        return os.ttyname(0) if os.isatty(0) else 'not a tty'
    except OSError:
        return '?'


def group_names():
    try:
        import grp
        gids = os.getgroups()
        names = []
        for g in gids:
            try:
                names.append(grp.getgrgid(g).gr_name)
            except KeyError:
                names.append(str(g))
        return ', '.join(sorted(names))
    except Exception:
        return '?'


_CLIP = ''


def sys_copy(text):
    global _CLIP
    _CLIP = text
    for cmd in (['xclip', '-selection', 'clipboard'], ['xsel', '-bi'], ['wl-copy']):
        if not _which(cmd[0]):
            continue
        try:
            subprocess.run(cmd, input=text.encode(), timeout=2,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
        except Exception:
            continue
    return False


def sys_paste():
    for cmd in (['xclip', '-selection', 'clipboard', '-o'], ['xsel', '-bo'],
                ['wl-paste']):
        if not _which(cmd[0]):
            continue
        try:
            r = subprocess.run(cmd, capture_output=True, timeout=2, text=True)
            if r.returncode == 0:
                return r.stdout.strip()
        except Exception:
            continue
    return _CLIP


