# CALCULATOR
# =============================================================================
class Calculator(Window):
    icon = '+'
    min_w, min_h = 40, 17
    BTN_W = 6

    BTNS = [
        [('CLR', 'CLR'), ('DEL', 'DEL'), ('(', '('), (')', ')'),
         ('M+', 'M+'), ('MR', 'MR')],
        [('sin', 'sin('), ('cos', 'cos('), ('tan', 'tan('),
         ('log', 'log10('), ('ln', 'log('), ('pi', 'pi')],
        [('sqrt', 'sqrt('), ('^', '**'), ('abs', 'abs('),
         ('%', '%'), ('e', 'e'), ('ans', 'ans')],
        [('7', '7'), ('8', '8'), ('9', '9'), ('/', '/'),
         ('fac', 'factorial('), ('HEX', 'HEX')],
        [('4', '4'), ('5', '5'), ('6', '6'), ('*', '*'),
         ('rad', 'radians('), ('deg', 'degrees(')],
        [('1', '1'), ('2', '2'), ('3', '3'), ('-', '-'),
         ('exp', 'exp('), ('HIST', 'HIST')],
        [('0', '0'), ('.', '.'), ('=', '='), ('+', '+'),
         ('1/x', '1/('), (',', ',')],
    ]

    def __init__(self, state):
        super().__init__('COS Calculator', w=42, h=20)
        self.state = state
        self.expr = ''
        self.disp = '0'
        self.mem = 0.0
        self.ans = 0.0
        self.hist = []
        self.base_view = False

    def status(self):
        return f'mem={fmt_num(self.mem)}  ans={fmt_num(self.ans)}  type or click'

    def press(self, tok):
        if tok == 'CLR':
            self.expr, self.disp = '', '0'
        elif tok == 'DEL':
            self.expr = self.expr[:-1]
            self.disp = self.expr or '0'
        elif tok == 'M+':
            self.mem += self.ans
        elif tok == 'MR':
            self.expr += fmt_num(self.mem)
            self.disp = self.expr
        elif tok == 'HEX':
            self.base_view = not self.base_view
        elif tok == 'HIST':
            if self.wm:
                self.wm.open(TextWindow('Calculator History',
                                        self.hist[-200:] or ['  (empty)']))
        elif tok == '=':
            self.evaluate()
        else:
            if self.disp in ('0', 'ERROR', 'DIV/0') and tok not in '.+-*/%)':
                self.expr = tok
            else:
                self.expr += tok
            self.disp = self.expr

    def evaluate(self):
        if not self.expr.strip():
            return
        try:
            result = eval_math(self.expr, {'ans': self.ans, 'mem': self.mem})
            self.ans = float(result)
            self.disp = fmt_num(result)
            self.hist.append(f'  {self.expr} = {self.disp}')
            self.expr = self.disp
            if self.wm: self.wm.sound.play('key')
        except ZeroDivisionError:
            self.disp, self.expr = 'DIV/0', ''
            if self.wm: self.wm.sound.play('error')
        except Exception:
            self.disp, self.expr = 'ERROR', ''
            if self.wm: self.wm.sound.play('error')

    def draw_client(self, c, active):
        c.fill(cp(CP_WINDOW))
        c.put(0, 1, ' ' * (c.w - 2), cp(CP_INPUT))
        c.put(0, 1, f'{self.disp[-(c.w - 4):]:>{c.w - 4}} ', cp(CP_INPUT, bold=True))
        c.put(1, 1, f'{self.expr[-(c.w - 4):]:>{c.w - 4}} ', cp(CP_SHADOW))
        if self.base_view:
            try:
                iv = int(self.ans)
                c.put(2, 1, f'hex {iv:#x}   oct {iv:#o}   bin {iv:#b}'[:c.w - 2],
                      cp(CP_GREEN))
            except (ValueError, OverflowError):
                c.put(2, 1, 'not an integer', cp(CP_WARN))
        self._rects = []
        top = 3
        for r, row in enumerate(self.BTNS):
            for q, (label, tok) in enumerate(row):
                bx = 1 + q * self.BTN_W
                by = top + r
                if by >= c.h or bx + self.BTN_W > c.w:
                    continue
                if label == '=':
                    a = cp(CP_BRIGHT, bold=True)
                elif label in ('CLR', 'DEL'):
                    a = cp(CP_WARN, bold=True)
                elif label.isdigit() or label == '.':
                    a = cp(CP_MENU_SEL, bold=True)
                else:
                    a = cp(CP_MENU_SEL)
                c.put(by, bx, f'[{label:^4}]', a)
                self._rects.append((by, bx, self.BTN_W, tok))

    def on_click(self, row, col, btn):
        for by, bx, bw, tok in getattr(self, '_rects', []):
            if row == by and bx <= col < bx + bw:
                self.press(tok)
                if self.wm: self.wm.sound.play('click')
                return True
        return False

    def on_key(self, key):
        if key in (curses.KEY_ENTER, 10, 13):
            self.press('='); return True
        if key in (curses.KEY_BACKSPACE, 127, 8):
            self.press('DEL'); return True
        if 32 <= key <= 126:
            ch = chr(key)
            if ch in '0123456789.+-*/()%^,':
                self.press('**' if ch == '^' else ch)
            elif ch in 'cC':
                self.press('CLR')
            elif ch in 'sS':
                self.press('sqrt(')
            elif ch in 'hH':
                self.press('HEX')
            elif ch == '!':
                self.press('factorial(')
            elif ch in 'aA':
                self.press('ans')
            elif ch in 'pP':
                self.press('pi')
            return True
        return False


def fmt_num(v):
    try:
        f = float(v)
    except (TypeError, ValueError):
        return str(v)
    if f == int(f) and abs(f) < 1e15:
        return str(int(f))
    return f'{f:.10g}'


