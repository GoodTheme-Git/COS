class ShellWindow(Window):
    icon = '$'
    want_cursor = True
    min_w, min_h = 34, 8
    claims_ctrl = frozenset({21, 11})          # ^U clear line  ^K clear output

    def __init__(self, title, prompt_text, w=66, h=19):
        super().__init__(title, w, h)
        self._pt = prompt_text
        self.output = []
        self.history = []
        self.hist_idx = 0
        self.buf = ''
        self.view = 0          # lines scrolled up from the bottom

    @property
    def prompt(self):
        return self._pt

    def write(self, text='', attr=None):
        for line in str(text).split('\n'):
            self.output.append((line, attr))
        del self.output[:-4000]
        self.view = 0

    def status(self):
        n = len(self.output)
        tail = '' if self.view == 0 else f'  [scrolled {self.view}]'
        return f'{n} lines  ENTER=run  UP/DN=history  PgUp/PgDn=scroll{tail}'

    def draw_client(self, c, active):
        c.fill(cp(CP_WINDOW))
        body = max(1, c.h - 1)
        end = len(self.output) - self.view
        start = max(0, end - body)
        shown = self.output[start:end]
        for i, (line, attr) in enumerate(shown):
            c.put(i, 1, str(line)[:c.w - 2],
                  attr if attr is not None else cp(CP_TEXT))
        # input line
        row = c.h - 1
        c.put(row, 0, ' ' * c.w, cp(CP_INPUT))
        pre = f' {self.prompt} ' if self.prompt else ' '
        avail = max(4, c.w - len(pre) - 1)
        shownbuf = self.buf[-avail:]
        c.put(row, 0, pre, cp(CP_INPUT, bold=True))
        c.put(row, len(pre), shownbuf, cp(CP_INPUT))
        self.caret = (row, min(c.w - 1, len(pre) + len(shownbuf)))

    def submit(self):
        cmd = self.buf
        self.buf = ''
        if not cmd.strip():
            self.write(self.prompt)
            return
        self.history.append(cmd)
        self.hist_idx = len(self.history)
        self.write(f'{self.prompt} {cmd}'.strip(), cp(CP_BRIGHT, bold=True))
        if cmd.strip().lower() in ('exit', 'quit', 'bye', 'logout'):
            self.write('Goodbye.')
            if self.wm:
                self.wm.close(self)
            return
        try:
            self.process_command(cmd.strip())
        except Exception as e:
            self.write(f'  !! {type(e).__name__}: {e}', cp(CP_WARN))
            if self.wm:
                self.wm.sound.play('error')

    def process_command(self, cmd):
        self.write(f'Unknown: {cmd}', cp(CP_WARN))

    def on_key(self, key):
        if key in (curses.KEY_ENTER, 10, 13):
            self.submit(); return True
        if key in (curses.KEY_BACKSPACE, 127, 8):
            self.buf = self.buf[:-1]; return True
        if key == curses.KEY_UP:
            if self.history and self.hist_idx > 0:
                self.hist_idx -= 1
                self.buf = self.history[self.hist_idx]
            return True
        if key == curses.KEY_DOWN:
            if self.hist_idx < len(self.history) - 1:
                self.hist_idx += 1
                self.buf = self.history[self.hist_idx]
            else:
                self.hist_idx = len(self.history)
                self.buf = ''
            return True
        if key == curses.KEY_PPAGE:
            self.view = min(max(0, len(self.output) - 1), self.view + max(1, self.chh // 2))
            return True
        if key == curses.KEY_NPAGE:
            self.view = max(0, self.view - max(1, self.chh // 2))
            return True
        if key == 21:                       # ^U clear line
            self.buf = ''; return True
        if key == 11:                       # ^K clear output
            self.output.clear(); return True
        if 32 <= key <= 126:
            self.buf += chr(key); return True
        return False

    def on_scroll(self, n):
        self.view = max(0, min(len(self.output), self.view + n * 3))
        return True


class COSShell(ShellWindow):
    def __init__(self):
        super().__init__('COS Shell', 'COS>')
        self.write('COS Shell v2.0 -- type "help" for commands, "exit" to close.')
        self.write('')

    def process_command(self, cmd):
        try: parts = shlex.split(cmd)
        except ValueError: parts = cmd.split()
        if not parts:
            return
        verb, args = parts[0].lower(), parts[1:]
        W = cp(CP_WARN)
        if verb == 'help':
            for l in ['  ls [path]    list dir', '  cd <path>    change dir',
                      '  pwd          working dir', '  echo <text>  print',
                      '  cat <file>   show file', '  head/tail <f> first/last lines',
                      '  mkdir <dir>  make dir', '  rm <file>    remove file',
                      '  cp <a> <b>   copy', '  mv <a> <b>   move/rename',
                      '  find <pat>   find files', '  grep <pat> <f>  search',
                      '  du [path]    dir size', '  env          environment',
                      '  ps           processes', '  free         memory',
                      '  run <cmd>    run system cmd', '  play <file>  play audio',
                      '  say <sound>  COS sound effect', '  date / uname / clear',
                      '  exit         close window']:
                self.write(l)
        elif verb == 'ls':
            path = os.path.expanduser(args[0] if args else '.')
            try:
                entries = sorted(os.listdir(path))
                row = ''
                for e in entries:
                    m = '/' if os.path.isdir(os.path.join(path, e)) else ''
                    row += f'{e}{m}  '
                    if len(row) > self.cw - 8:
                        self.write('  ' + row); row = ''
                if row: self.write('  ' + row)
                self.write(f'  {len(entries)} entries')
            except Exception as e: self.write(f'  Error: {e}', W)
        elif verb == 'cd':
            try: os.chdir(os.path.expanduser(args[0] if args else '~'))
            except Exception as e: self.write(f'  {e}', W)
            else: self.write(f'  {os.getcwd()}')
        elif verb == 'pwd':
            self.write(f'  {os.getcwd()}')
        elif verb == 'echo':
            self.write('  ' + ' '.join(args))
        elif verb in ('cat', 'head', 'tail'):
            if not args:
                self.write(f'  Usage: {verb} <file>', W); return
            try:
                with open(os.path.expanduser(args[0]), errors='replace') as f:
                    lines = f.readlines()
                sel = lines[:20] if verb == 'head' else (lines[-20:] if verb == 'tail'
                                                         else lines[:200])
                for line in sel: self.write('  ' + line.rstrip())
                self.write(f'  ({len(lines)} lines total)', cp(CP_SHADOW))
            except Exception as e: self.write(f'  {e}', W)
        elif verb == 'mkdir':
            if not args: self.write('  Usage: mkdir <dir>', W); return
            os.makedirs(os.path.expanduser(args[0]), exist_ok=True)
            self.write(f'  Created: {args[0]}', cp(CP_GREEN))
        elif verb == 'rm':
            if not args: self.write('  Usage: rm <file>', W); return
            os.remove(os.path.expanduser(args[0]))
            self.write(f'  Removed: {args[0]}', cp(CP_GREEN))
        elif verb in ('cp', 'mv'):
            if len(args) < 2: self.write(f'  Usage: {verb} <src> <dst>', W); return
            import shutil
            (shutil.copy2 if verb == 'cp' else shutil.move)(
                os.path.expanduser(args[0]), os.path.expanduser(args[1]))
            self.write(f'  {verb}: {args[0]} -> {args[1]}', cp(CP_GREEN))
        elif verb == 'find':
            if not args: self.write('  Usage: find <pattern>', W); return
            import fnmatch
            n = 0
            for root, dirs, files in os.walk('.'):
                for name in files + dirs:
                    if fnmatch.fnmatch(name, args[0]):
                        self.write('  ' + os.path.join(root, name)); n += 1
                        if n >= 60:
                            self.write('  ... (truncated)', cp(CP_SHADOW)); return
            self.write(f'  {n} match(es)')
        elif verb == 'grep':
            if len(args) < 2: self.write('  Usage: grep <pat> <file>', W); return
            pat = args[0]
            with open(os.path.expanduser(args[1]), errors='replace') as f:
                hits = 0
                for i, line in enumerate(f, 1):
                    if pat in line:
                        self.write(f'  {i}: {line.rstrip()}'); hits += 1
                        if hits >= 50: break
                self.write(f'  {hits} hit(s)')
        elif verb == 'du':
            path = os.path.expanduser(args[0] if args else '.')
            total = 0
            for root, _d, files in os.walk(path):
                for fn in files:
                    try: total += os.path.getsize(os.path.join(root, fn))
                    except OSError: pass
            self.write(f'  {human_size(total)}  {path}')
        elif verb == 'env':
            for k, v in sorted(os.environ.items()): self.write(f'  {k}={v}')
        elif verb == 'ps':
            self.write(run_cmd(['ps', '-eo', 'pid,comm,%cpu,%mem', '--sort=-%cpu']))
        elif verb == 'free':
            self.write(run_cmd(['free', '-h']))
        elif verb == 'run':
            if not args: self.write('  Usage: run <cmd>', W); return
            self.write(run_cmd(args, prefix='  '))
        elif verb == 'play':
            if not args: self.write('  Usage: play <audiofile>', W); return
            p = os.path.expanduser(args[0])
            if self.wm and os.path.exists(p):
                play_media_detached(p, self.wm.state.get('druman_volume', 80))
                self.write(f'  playing {p}', cp(CP_GREEN))
            else: self.write('  not found', W)
        elif verb == 'say':
            name = args[0] if args else 'notify'
            if self.wm:
                self.wm.sound.play(name)
                self.write(f'  [sound] {name}  (have: {", ".join(sorted(SOUND_SPECS))})')
        elif verb == 'date':
            self.write('  ' + datetime.now().strftime('%A, %B %d %Y  %H:%M:%S'))
        elif verb == 'uname':
            u = platform.uname()
            self.write(f'  {u.system} {u.node} {u.release} {u.machine}')
        elif verb == 'clear':
            self.output.clear()
        else:
            try:
                self.write(run_cmd(shlex.split(cmd), prefix='  '))
            except FileNotFoundError:
                self.write(f'  Command not found: {verb}', W)


class BatchShell(ShellWindow):
    icon = 'B'

    def __init__(self):
        self._drive = 'C'
        super().__init__('COS Batch Shell (DOS Emulation)', '')
        self._vars = {}
        self.write('COS Batch Shell v1.0')
        self.write('(C) TCF Channel Operating System')
        self.write('')

    @property
    def prompt(self):
        return f'{self._drive}:\\COS>'

    def process_command(self, cmd):
        parts = cmd.strip().split(None, 1)
        verb = parts[0].upper()
        rest = parts[1] if len(parts) > 1 else ''
        W = cp(CP_WARN)
        if verb in ('HELP', '/?'):
            for l in ['  DIR           list directory', '  CD <path>     change dir',
                      '  MD <path>     make directory', '  DEL <file>    delete file',
                      '  COPY <s> <d>  copy file', '  MOVE <s> <d>  move file',
                      '  TYPE <file>   show file', '  ECHO <msg>    print message',
                      '  SET x=val     set variable', '  CLS           clear screen',
                      '  VER           version info', '  DATE / TIME   date and time',
                      '  MEM           memory status', '  TREE          dir tree',
                      '  WHERE <f>     locate program', '  EXIT          close']:
                self.write(l)
        elif verb == 'DIR':
            try:
                path = os.path.expanduser(rest.strip() or '.')
                entries = sorted(os.listdir(path))
                self.write(f' Directory of {os.path.abspath(path)}')
                self.write('')
                nd = 0
                for e in entries:
                    full = os.path.join(path, e)
                    try:
                        st = os.stat(full)
                        dt = datetime.fromtimestamp(st.st_mtime).strftime('%m/%d/%Y  %I:%M %p')
                        if os.path.isdir(full):
                            self.write(f' {dt}    <DIR>          {e}'); nd += 1
                        else:
                            self.write(f' {dt}    {st.st_size:>12,}  {e}')
                    except OSError:
                        self.write(f'             {e}')
                self.write(f'   {len(entries) - nd} File(s)   {nd} Dir(s)')
            except Exception as e:
                self.write(f' Cannot find path: {e}', W)
        elif verb == 'CD':
            if not rest.strip():
                self.write(f' {os.getcwd()}')
            else:
                try: os.chdir(os.path.expanduser(rest.strip()))
                except OSError: self.write(' The system cannot find the path specified.', W)
        elif verb in ('MD', 'MKDIR'):
            os.makedirs(os.path.expanduser(rest.strip()), exist_ok=True)
        elif verb in ('DEL', 'ERASE'):
            try: os.remove(os.path.expanduser(rest.strip()))
            except OSError as e: self.write(f' {e}', W)
        elif verb in ('COPY', 'MOVE'):
            import shutil
            p2 = rest.split()
            if len(p2) < 2:
                self.write(f' Usage: {verb} <src> <dst>', W)
            else:
                (shutil.copy2 if verb == 'COPY' else shutil.move)(p2[0], p2[1])
                self.write('        1 file(s) copied.')
        elif verb == 'TYPE':
            try:
                with open(os.path.expanduser(rest.strip()), errors='replace') as f:
                    for line in f.readlines()[:120]: self.write(line.rstrip())
            except OSError:
                self.write(' The system cannot find the file specified.', W)
        elif verb == 'TREE':
            base = os.path.expanduser(rest.strip() or '.')
            n = 0
            for root, dirs, _f in os.walk(base):
                depth = root[len(base):].count(os.sep)
                if depth > 3: dirs[:] = []; continue
                self.write('  ' * depth + '+---' + os.path.basename(root or base))
                n += 1
                if n > 80: self.write(' ...'); break
        elif verb == 'WHERE':
            p = _which(rest.strip())
            self.write(f' {p}' if p else ' INFO: Could not find files.')
        elif verb == 'ECHO':
            self.write(rest if rest else 'ECHO is on.')
        elif verb == 'SET':
            if '=' in rest:
                k, _, v = rest.partition('='); self._vars[k.strip()] = v.strip()
            elif rest.strip():
                k = rest.strip(); v = self._vars.get(k, os.environ.get(k, ''))
                self.write(f' {k}={v}' if v else f' {k} not defined')
            else:
                for k, v in sorted({**dict(os.environ), **self._vars}.items()):
                    self.write(f' {k}={v}')
        elif verb == 'CLS':
            self.output.clear()
        elif verb == 'VER':
            self.write(''); self.write(' COS Batch Emulation Layer v1.0')
            self.write(f' Channel Operating System {VERSION} "{CODENAME}"'); self.write('')
        elif verb == 'DATE':
            self.write(f' The current date is: {datetime.now().strftime("%a %m/%d/%Y")}')
        elif verb == 'TIME':
            self.write(f' The current time is: {datetime.now().strftime("%H:%M:%S.%f")[:12]}')
        elif verb == 'MEM':
            mi = meminfo()
            self.write(' Memory Type         Total       Used       Free')
            self.write(' ----------------    --------    -------    -------')
            self.write(f' Conventional          640 KB      412 KB    228 KB')
            self.write(f' Extended (XMS)   {mi["total"]//1024:>9} KB '
                       f'{mi["used"]//1024:>9} KB {mi["free"]//1024:>8} KB')
        else:
            self.write(f" '{verb}' is not recognized as an internal or external command,")
            self.write('  operable program or batch file.', W)


class POSShell(ShellWindow):
    icon = 'P'

    def __init__(self):
        super().__init__('COS POS Shell - Point of Sale', 'POS>', w=68, h=20)
        self.inv = {
            'COLA':     {'price': 1.50, 'stock': 24, 'name': 'Cola 12oz'},
            'CHIPS':    {'price': 2.00, 'stock': 18, 'name': 'Chips Bag'},
            'WATER':    {'price': 1.00, 'stock': 30, 'name': 'Water Bottle'},
            'COFFEE':   {'price': 2.50, 'stock': 10, 'name': 'Coffee 16oz'},
            'SANDWICH': {'price': 5.99, 'stock': 6,  'name': 'Deli Sandwich'},
            'CANDY':    {'price': 0.99, 'stock': 40, 'name': 'Candy Bar'},
            'JUICE':    {'price': 1.75, 'stock': 15, 'name': 'Orange Juice'},
            'HOTDOG':   {'price': 3.50, 'stock': 8,  'name': 'Hot Dog'},
        }
        self.cart = []
        self.total = 0.0
        self.txn = 0
        self.last_cart = []
        self.last_total = 0.0
        self.tax_rate = 0.08
        self.write('== COS POINT OF SALE SYSTEM ==', cp(CP_GREEN, bold=True))
        self.write('Type HELP for commands.')
        self.write('')

    def status(self):
        sub = sum(c['qty'] * c['price'] for c in self.cart)
        return (f'cart {len(self.cart)} item(s)  subtotal ${sub:.2f}  '
                f'txn #{self.txn}  sales ${self.total:.2f}')

    def process_command(self, cmd):
        parts = cmd.strip().split()
        verb = parts[0].upper() if parts else ''
        args = parts[1:]
        W, G, B = cp(CP_WARN), cp(CP_GREEN), cp(CP_BRIGHT, bold=True)
        if verb == 'HELP':
            for l in ['  INV              show inventory', '  ADD <SKU> [qty]  add to cart',
                      '  CART             show cart', '  REMOVE <SKU>     remove from cart',
                      '  TOTAL            subtotal + tax', '  CHECKOUT [cash]  complete sale',
                      '  RECEIPT          print last receipt', '  VOID             void cart',
                      '  SALES            daily summary', '  STOCK <SKU> <n>  restock',
                      '  PRICE <SKU> <$>  update price', '  TAX <pct>        set tax rate',
                      '  NEWITEM <S> <$> <name>', '  LOW              low-stock report',
                      '  CLEAR            clear screen', '  EXIT             close']:
                self.write(l, G)
        elif verb == 'INV':
            self.write('  SKU        PRICE   STOCK  NAME', B)
            self.write('  ---------  ------  -----  ------------------')
            for sku, item in self.inv.items():
                a = W if item['stock'] < 5 else G
                self.write(f"  {sku:<10} ${item['price']:>5.2f}  {item['stock']:>4}   "
                           f"{item['name']}", a)
            val = sum(i['price'] * i['stock'] for i in self.inv.values())
            self.write(f'  Inventory value: ${val:.2f}', B)
        elif verb == 'LOW':
            low = [(s, i) for s, i in self.inv.items() if i['stock'] < 10]
            if not low:
                self.write('  All stock levels OK.', G)
            for s, i in low:
                self.write(f"  {s:<10} {i['stock']:>3} left   {i['name']}", W)
        elif verb == 'ADD':
            if not args:
                self.write('  Usage: ADD <SKU> [qty]', W); return
            sku = args[0].upper()
            try: qty = max(1, int(args[1])) if len(args) > 1 else 1
            except ValueError: qty = 1
            if sku not in self.inv:
                self.write(f'  Unknown SKU: {sku}', W)
            elif self.inv[sku]['stock'] < qty:
                self.write(f"  Low stock: {self.inv[sku]['stock']} left", W)
            else:
                self.cart.append({'sku': sku, 'qty': qty,
                                  'price': self.inv[sku]['price'],
                                  'name': self.inv[sku]['name']})
                self.write(f"  Added: {qty}x {self.inv[sku]['name']} = "
                           f"${qty * self.inv[sku]['price']:.2f}", G)
                if self.wm: self.wm.sound.play('key')
        elif verb == 'CART':
            if not self.cart:
                self.write('  Cart is empty.'); return
            self.write('  QTY  SKU        UNIT    SUBTOTAL')
            total = 0.0
            for item in self.cart:
                sub = item['qty'] * item['price']; total += sub
                self.write(f"  {item['qty']:>3}  {item['sku']:<10} "
                           f"${item['price']:>5.2f}  ${sub:>7.2f}")
            self.write(f'  {"SUBTOTAL":>26} ${total:.2f}', B)
        elif verb == 'REMOVE':
            if not args:
                self.write('  Usage: REMOVE <SKU>', W); return
            sku = args[0].upper(); before = len(self.cart)
            self.cart = [c for c in self.cart if c['sku'] != sku]
            self.write(f'  Removed {sku}.' if len(self.cart) < before
                       else f'  {sku} not in cart.')
        elif verb == 'TOTAL':
            sub = sum(c['qty'] * c['price'] for c in self.cart)
            tax = sub * self.tax_rate
            self.write(f'  Subtotal: ${sub:.2f}')
            self.write(f'  Tax ({self.tax_rate * 100:.0f}%): ${tax:.2f}')
            self.write(f'  TOTAL:    ${sub + tax:.2f}', B)
        elif verb == 'TAX':
            if not args: self.write(f'  Tax rate: {self.tax_rate * 100:.2f}%'); return
            try:
                self.tax_rate = float(args[0].rstrip('%')) / 100.0
                self.write(f'  Tax rate now {self.tax_rate * 100:.2f}%', G)
            except ValueError: self.write('  Invalid rate', W)
        elif verb == 'CHECKOUT':
            if not self.cart:
                self.write('  Cart is empty.', W); return
            sub = sum(c['qty'] * c['price'] for c in self.cart)
            grand = sub * (1 + self.tax_rate)
            for item in self.cart:
                self.inv[item['sku']]['stock'] -= item['qty']
            self.total += grand
            self.txn += 1
            self.last_cart = self.cart.copy()
            self.last_total = grand
            self.cart = []
            self.write(f'  ** SALE COMPLETE  Txn #{self.txn} **', B)
            self.write(f'  Total: ${grand:.2f}')
            if args:
                try:
                    cash = float(args[0].lstrip('$'))
                    self.write(f'  Cash:   ${cash:.2f}')
                    self.write(f'  Change: ${cash - grand:.2f}',
                               G if cash >= grand else W)
                except ValueError: pass
            self.write('  (type RECEIPT to print)')
            if self.wm: self.wm.sound.play('coin')
        elif verb == 'VOID':
            self.cart = []; self.write('  Cart voided.', W)
            if self.wm: self.wm.sound.play('warn')
        elif verb == 'RECEIPT':
            if not self.last_cart:
                self.write('  No previous transaction.'); return
            self.write('  ================================')
            self.write(f'  COS POS  {datetime.now().strftime("%Y-%m-%d %H:%M")}')
            self.write(f'  Txn #{self.txn}')
            self.write('  ================================')
            for item in self.last_cart:
                self.write(f"  {item['qty']}x {item['name']:<18} "
                           f"${item['qty'] * item['price']:.2f}")
            self.write('  --------------------------------')
            pre = self.last_total / (1 + self.tax_rate)
            self.write(f'  Subtotal:              ${pre:.2f}')
            self.write(f'  Tax ({self.tax_rate * 100:.0f}%):'.ljust(25)
                       + f'${self.last_total - pre:.2f}')
            self.write(f'  TOTAL:                 ${self.last_total:.2f}', B)
            self.write('  ================================')
            self.write('  ** THANK YOU **', G)
        elif verb == 'SALES':
            avg = self.total / self.txn if self.txn else 0
            self.write(f'  Transactions: {self.txn}')
            self.write(f'  Total Sales : ${self.total:.2f}')
            self.write(f'  Average Sale: ${avg:.2f}')
        elif verb == 'STOCK':
            if len(args) < 2: self.write('  Usage: STOCK <SKU> <n>', W); return
            sku = args[0].upper()
            try: qty = int(args[1])
            except ValueError: self.write('  Qty must be integer', W); return
            if sku not in self.inv: self.write(f'  Unknown: {sku}', W)
            else:
                self.inv[sku]['stock'] += qty
                self.write(f"  {sku}: stock now {self.inv[sku]['stock']}", G)
        elif verb == 'PRICE':
            if len(args) < 2: self.write('  Usage: PRICE <SKU> <$>', W); return
            sku = args[0].upper()
            try: price = float(args[1].lstrip('$'))
            except ValueError: self.write('  Invalid price', W); return
            if sku not in self.inv: self.write(f'  Unknown: {sku}', W)
            else:
                old = self.inv[sku]['price']; self.inv[sku]['price'] = price
                self.write(f'  {sku}: ${old:.2f} -> ${price:.2f}', G)
        elif verb == 'NEWITEM':
            if len(args) < 3: self.write('  Usage: NEWITEM <SKU> <$> <name>', W); return
            sku = args[0].upper()
            try: price = float(args[1].lstrip('$'))
            except ValueError: self.write('  Invalid price', W); return
            self.inv[sku] = {'price': price, 'stock': 0, 'name': ' '.join(args[2:])}
            self.write(f"  Created {sku}: {self.inv[sku]['name']} @ ${price:.2f}", G)
        elif verb == 'CLEAR':
            self.output.clear()
        else:
            self.write(f'  Unknown: {verb}  (type HELP)', W)


class COMShell(ShellWindow):
    icon = 'C'

    def __init__(self):
        super().__init__('COS COM Shell - Serial Port Manager', 'COM>')
        self.port = None
        self.baud = 9600
        self.ser = None
        self._avail = []
        self.write('COS COM Shell v1.0 -- Serial Port Manager')
        self.write('Type HELP for commands.')
        self.write('')
        self._scan()

    def status(self):
        st = 'open' if self.ser else ('simulated' if self.port else 'closed')
        return f'port {self.port or "none"}  {self.baud} baud  {st}'

    def _scan(self):
        found = []
        for prefix in ('/dev/ttyS', '/dev/ttyUSB', '/dev/ttyACM', '/dev/ttyAMA'):
            for i in range(8):
                p = f'{prefix}{i}'
                if os.path.exists(p):
                    found.append(p + ('' if os.access(p, os.R_OK | os.W_OK) else ' (no access)'))
        self._avail = found
        self.write(f'  Found {len(found)} port(s): '
                   f'{", ".join(found) if found else "none"}')

    def process_command(self, cmd):
        parts = cmd.strip().split()
        verb = parts[0].upper() if parts else ''
        args = parts[1:]
        W, G, B = cp(CP_WARN), cp(CP_GREEN), cp(CP_BRIGHT)
        if verb == 'HELP':
            for l in ['  SCAN             scan for ports', '  LIST             list ports',
                      '  OPEN <p> [baud]  open port', '  CLOSE            close port',
                      '  SEND <data>      send data', '  READ             read data',
                      '  BAUD <rate>      set baud rate', '  STATUS           info',
                      '  PING             send ATZ ping', '  HAYES            AT reference',
                      '  TTY              list all tty devices', '  EXIT             close']:
                self.write(l)
        elif verb == 'SCAN':
            self._scan()
        elif verb == 'LIST':
            if not self._avail: self.write('  No ports. Try SCAN.'); return
            for p in self._avail:
                self.write(f'  {p}{" [OPEN]" if p == self.port else ""}')
        elif verb == 'TTY':
            try:
                for e in sorted(os.listdir('/dev')):
                    if e.startswith('tty') and len(e) > 3:
                        self.write(f'  /dev/{e}')
            except OSError as e: self.write(f'  {e}', W)
        elif verb == 'OPEN':
            if not args: self.write('  Usage: OPEN <port> [baud]', W); return
            port = args[0]
            try: baud = int(args[1]) if len(args) > 1 else self.baud
            except ValueError: baud = self.baud
            try:
                import serial
                if self.ser: self.ser.close()
                self.ser = serial.Serial(port, baud, timeout=1)
                self.port, self.baud = port, baud
                self.write(f'  Opened {port} @ {baud} baud.', G)
            except ImportError:
                self.port, self.baud, self.ser = port, baud, None
                self.write(f'  pyserial not installed -- simulating {port} @ {baud}', B)
                self.write('  (pip install pyserial for real I/O)', cp(CP_SHADOW))
            except Exception as e:
                self.write(f'  Error: {e}', W)
        elif verb == 'CLOSE':
            if self.ser: self.ser.close(); self.ser = None
            self.write(f'  Closed {self.port}.' if self.port else '  No port open.')
            self.port = None
        elif verb == 'SEND':
            data = (' '.join(args) if args else '') + '\r\n'
            if self.ser:
                self.ser.write(data.encode('ascii', errors='replace'))
                self.write(f'  >> {data.strip()}', B)
            elif self.port: self.write(f'  [SIM] >> {data.strip()}', cp(CP_SHADOW))
            else: self.write('  No port open.', W)
        elif verb == 'READ':
            if self.ser:
                data = self.ser.read(self.ser.in_waiting or 1)
                self.write(f'  << {data.decode("ascii", errors="replace")}', G
                           ) if data else self.write('  (no data)')
            elif self.port: self.write('  [SIM] << OK', cp(CP_SHADOW))
            else: self.write('  No port open.', W)
        elif verb == 'BAUD':
            if not args: self.write(f'  Current baud: {self.baud}'); return
            try:
                self.baud = int(args[0])
                if self.ser: self.ser.baudrate = self.baud
                self.write(f'  Baud set to {self.baud}', G)
            except ValueError: self.write('  Invalid baud rate', W)
        elif verb == 'STATUS':
            self.write(f'  Port : {self.port or "none"}')
            self.write(f'  Baud : {self.baud}')
            self.write(f'  State: {"open" if self.ser else ("simulated" if self.port else "closed")}')
        elif verb == 'PING':
            if not self.port: self.write('  No port open.', W); return
            self.write('  >> ATZ', B)
            if self.ser:
                self.ser.write(b'ATZ\r\n'); time.sleep(0.4)
                resp = self.ser.read(self.ser.in_waiting or 1)
                self.write(f'  << {resp.decode("ascii", errors="replace").strip()}', G)
            else:
                self.write('  << OK  (simulated)', G)
        elif verb == 'HAYES':
            for l in ['  ATZ         reset modem', '  AT          test',
                      '  ATA         answer', '  ATH         hang up',
                      '  ATDT<n>     dial tone', '  ATDP<n>     dial pulse',
                      '  ATI         modem ID', '  ATL<0-3>    volume',
                      '  ATM<0-2>    speaker mode', '  ATS0=1      auto-answer',
                      '  AT&V        view profile', '  AT&W        save to NVRAM']:
                self.write(l)
        else:
            self.write(f'  Unknown: {verb}  (type HELP)', W)


class RetroShell(ShellWindow):
    icon = 'R'

    def __init__(self):
        super().__init__('>>> COS RETRO TERMINAL <<<', 'READY.')
        self.program = {}
        self.vars = {}
        self.write('*** CHANNEL OPERATING SYSTEM - RETRO TERMINAL ***', cp(CP_GREEN, bold=True))
        self.write('*** 64K RAM SYSTEM   38911 BASIC BYTES FREE  ***', cp(CP_GREEN))
        self.write('')
        self.write('READY.')
        self.write('')

    def status(self):
        return f'{len(self.program)} program line(s)  LIST / RUN / NEW'

    def process_command(self, cmd):
        up = cmd.strip().upper()
        G = cp(CP_GREEN)
        if up and up[0].isdigit():
            num_str, _, code = cmd.partition(' ')
            try:
                n = int(num_str)
                if code.strip(): self.program[n] = code
                else: self.program.pop(n, None)
            except ValueError: self.write('?SYNTAX ERROR')
            return
        if up in ('HELP', '?HELP'):
            for l in ['COMMANDS:', '  PRINT <txt>  print text', '  ? <txt>      print text',
                      '  LET A=<exp>  assign variable', '  LIST         list program',
                      '  RUN          run program', '  NEW          clear program',
                      '  DIR          directory', '  MEM          memory status',
                      '  TIME / DATE  clock', '  PEEK <addr>  memory peek',
                      '  POKE <a> <v> memory poke', '  SOUND <n>    make noise',
                      '  BYE / EXIT   sign off']:
                self.write(l, G)
        elif up.startswith('PRINT ') or up.startswith('? '):
            text = cmd[6:] if up.startswith('PRINT ') else cmd[2:]
            self.write(self._expand(text.strip()))
        elif up.startswith('LET '):
            body = cmd[4:]
            if '=' in body:
                k, _, v = body.partition('=')
                try:
                    self.vars[k.strip().upper()] = eval_math(v)
                    self.write('OK')
                except Exception: self.write('?SYNTAX ERROR')
            else: self.write('?SYNTAX ERROR')
        elif up == 'LIST':
            if not self.program:
                self.write('NO PROGRAM IN MEMORY.')
            else:
                for num in sorted(self.program):
                    self.write(f'{num} {self.program[num]}', G)
            self.write('READY.')
        elif up == 'RUN':
            if not self.program:
                self.write('NO PROGRAM IN MEMORY.')
            else:
                self.write('RUNNING...')
                for num in sorted(self.program):
                    code = self.program[num].strip()
                    cu = code.upper()
                    if cu.startswith('PRINT '):
                        self.write(self._expand(code[6:].strip()))
                    elif cu.startswith('? '):
                        self.write(self._expand(code[2:].strip()))
                    elif cu.startswith('LET '):
                        k, _, v = code[4:].partition('=')
                        try: self.vars[k.strip().upper()] = eval_math(v)
                        except Exception: self.write(f'?SYNTAX ERROR IN {num}')
                    elif cu.startswith('REM'):
                        pass
                    elif cu == 'END':
                        break
                    else:
                        self.write(f'?SYNTAX ERROR IN {num}')
                self.write('READY.')
        elif up == 'NEW':
            self.program = {}; self.vars = {}; self.write('OK')
        elif up == 'DIR':
            try: entries = sorted(os.listdir('.'))[:30]
            except OSError: entries = []
            self.write('DISK DIRECTORY:')
            for e in entries: self.write(f'  {e.upper():<24}', G)
            self.write(f'{len(entries)} FILES'); self.write('READY.')
        elif up in ('TIME', 'DATE'):
            self.write(datetime.now().strftime('%H:%M:%S  %A %B %d %Y').upper())
            self.write('READY.')
        elif up == 'MEM':
            mi = meminfo()
            self.write('MEMORY STATUS:')
            self.write('  38911 BASIC BYTES FREE')
            self.write(f'  HOST: {mi["total"] // 1024} KB TOTAL, {mi["free"] // 1024} KB FREE')
            self.write('READY.')
        elif up.startswith('PEEK'):
            self.write(str(random.randint(0, 255))); self.write('READY.')
        elif up.startswith('POKE'):
            self.write('OK')
        elif up.startswith('SOUND'):
            if self.wm: self.wm.sound.play(random.choice(['coin', 'notify', 'drop', 'key']))
            self.write('OK')
        elif up == 'SYS':
            self.write('MONITOR NOT AVAILABLE.'); self.write('READY.')
        elif up.startswith('LOAD'):
            self.write('?FILE NOT FOUND  ERROR'); self.write('READY.')
        elif up.startswith('SAVE'):
            self.write('?DEVICE NOT READY ERROR'); self.write('READY.')
        elif up in ('BYE', 'LOGOUT', 'SIGNOFF'):
            self.write('GOODBYE.')
            if self.wm: self.wm.close(self)
        else:
            self.write('?SYNTAX ERROR'); self.write('READY.')

    def _expand(self, text):
        t = text.strip()
        if t.startswith('"') and t.endswith('"') and len(t) > 1:
            return t[1:-1]
        key = t.upper()
        if key in self.vars:
            v = self.vars[key]
            return str(int(v)) if float(v) == int(v) else str(v)
        try:
            v = eval_math(t)
            return str(int(v)) if float(v) == int(v) else str(v)
        except Exception:
            return t.strip('"\'')


