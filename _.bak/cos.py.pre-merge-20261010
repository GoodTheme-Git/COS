            self.wy = 2 if show_task else 1
            self.wh = max(3, H - self.wy - 1)
        else:
            self.menu_row = 0
            self.status_row = H - 1
            self.task_row = H - 2 if show_task else None
            self.wy = 1
            self.wh = max(3, (H - 2 if show_task else H - 1) - 1)
        self.wx = 0
        self.ww = W


