class ImageViewer(Window):
    icon = 'P'
    min_w, min_h = 30, 9
    FITS = ['fit', 'fill', 'stretch']

    def __init__(self, state, path=None):
        super().__init__('Image Viewer', w=76, h=24)
        self.state = state
        self.path = None
        self.info = {}
        self.frame = b''
        self.grid = (0, 0)
        self.fit = 0
        self.mono = False
        self.zoom = 1.0
        self.cx = 0.5          # pan centre, normalised
        self.cy = 0.5
        self.rotate = 0
        self.siblings = []
        self.index = -1
        self.msg = 'n/p browse  f fit  +/- zoom  arrows pan  m mono  O ffplay'
        self.dirty_img = True
        self._last_geom = None
        if path:
            self.open(path)

    # -- loading ------------------------------------------------------------
    def open(self, path):
        path = os.path.abspath(os.path.expanduser(str(path).strip()))
        if os.path.isdir(path):
            imgs = self._scan(path)
            if not imgs:
                self.msg = f'No images in {path}'
                return
            path = imgs[0]
        if not os.path.isfile(path):
            self.msg = f'Not found: {path}'
            if self.wm:
                self.wm.sound.play('error')
            return
        self.path = path
        self.info = probe_media(path)
        self.rotate = self.info.get('rotation', 0) or 0
        self.zoom = 1.0
        self.cx = self.cy = 0.5
        self.title = f'Image - {os.path.basename(path)}'[:58]
        folder = os.path.dirname(path)
        self.siblings = self._scan(folder)
        self.index = (self.siblings.index(path) if path in self.siblings else -1)
        self.dirty_img = True
        if not self.info.get('video'):
            self.msg = 'ffmpeg could not read this as an image'
            if self.wm:
                self.wm.sound.play('error')
        else:
            self.msg = (f'{self.info["w"]}x{self.info["h"]} '
                        f'{self.info["codec"]}  '
                        f'{human_size(os.path.getsize(path))}')

    @staticmethod
    def _scan(folder):
        try:
            names = sorted(os.listdir(folder), key=str.lower)
        except OSError:
            return []
        return [os.path.join(folder, n) for n in names
                if os.path.splitext(n)[1].lower() in IMAGE_EXT]

    def step(self, d):
        if not self.siblings:
            self.msg = 'No other images in this folder'
            return
        self.index = (self.index + d) % len(self.siblings)
        self.open(self.siblings[self.index])
        if self.wm:
            self.wm.sound.play('click')

    # -- rendering ----------------------------------------------------------
    def _vf(self):
        """Build the ffmpeg filter chain for the current zoom/rotation."""
        parts = []
        rot = self.rotate % 360
        if rot == 90:
            parts.append('transpose=1')
        elif rot == 180:
            parts.append('transpose=1,transpose=1')
        elif rot == 270:
            parts.append('transpose=2')
        if self.zoom > 1.001:
            # crop a window of the source, then let scale fill the cells
            parts.append(
                f'crop=iw/{self.zoom:.4f}:ih/{self.zoom:.4f}:'
                f"'(iw-ow)*{self.cx:.4f}':'(ih-oh)*{self.cy:.4f}'")
        return ','.join(parts)

    def refresh_image(self, c):
        iw, ih = self.info.get('w', 0), self.info.get('h', 0)
        if self.rotate % 180 == 90:
            iw, ih = ih, iw
        avail_w, avail_h = max(1, c.w), max(1, c.h - 1)
        cols, rows = fit_cells(iw, ih, avail_w, avail_h, self.FITS[self.fit],
                               cell_aspect_value(self.state))
        opts = quality_opts(self.state)
        geom = (cols, rows, self.zoom, round(self.cx, 3), round(self.cy, 3),
                self.rotate, self.path, opts['scaler'], opts['dither'])
        if not self.dirty_img and geom == self._last_geom:
            return cols, rows
        self._last_geom = geom
        self.dirty_img = False
        self.frame = decode_still(self.path, cols, rows,
                                  extra_vf=self._vf(),
                                  scaler=opts['scaler'])
        self.grid = (cols, rows)
        if not self.frame:
            self.msg = 'decode failed'
        return cols, rows

    def status(self):
        be = ('ffplay' if self.state.get('media_backend') == 'ffplay'
              else 'AsciiPic')
        z = f'  zoom {self.zoom:.1f}x' if self.zoom > 1.001 else ''
        rot = f'  rot {self.rotate}' if self.rotate else ''
        pos = (f'  [{self.index + 1}/{len(self.siblings)}]'
               if self.index >= 0 else '')
        return (f'{be}  {self.FITS[self.fit]}{z}{rot}{pos}'
                f'{"  mono" if self.mono else ""}  O=ffplay  {self.msg}')

    def draw_client(self, c, active):
        c.fill(cp(CP_WINDOW))
        if not self.path:
            c.put(1, 2, 'No image loaded.', cp(CP_WARN, bold=True))
            c.put(3, 2, 'Press G to open a file or folder, or open an image',
                  cp(CP_TEXT))
            c.put(4, 2, 'from the File Manager.', cp(CP_TEXT))
            return
        if not _which('ffmpeg'):
            c.put(1, 2, 'ffmpeg is not installed -- cannot decode images.',
                  cp(CP_WARN, bold=True))
            return
        cols, rows = self.refresh_image(c)
        if not self.frame:
            c.put(1, 2, f'Could not decode {os.path.basename(self.path)}',
                  cp(CP_WARN, bold=True))
            return
        # centre the picture in the client area
        x0 = max(0, (c.w - cols) // 2)
        y0 = max(0, (c.h - 1 - rows) // 2)
        cell_art().draw(c, self.frame, cols, rows, y0, x0, mono=self.mono,
                        dither=quality_opts(self.state)['dither'])
        label = f' {os.path.basename(self.path)}  {cols}x{rows} cells '
        c.put(c.h - 1, 0, label[:c.w], cp(CP_SHADOW))

    def pixel_rect(self, fw, fh):
        """The picture at the panel's resolution instead of in cells.

        The cell version is still drawn underneath, so if this decode fails
        or graphics mode is off nothing is lost -- the window simply looks
        the way it always has.
        """
        if not (self.path and self.frame and _which('ffmpeg')):
            return None
        cols, rows = self.grid
        if cols <= 0 or rows <= 0:
            return None
        pw, ph = cols * fw, rows * fh
        if pw * ph > 4 * 1024 * 1024:          # not worth the decode
            return None
        key = (self.path, cols, rows, fw, fh, self.zoom, self.rotate,
               round(self.cx, 3), round(self.cy, 3), self.mono)
        if key != getattr(self, '_px_key', None):
            self._px_key = key
            vf = self._vf()
            if self.mono:
                vf = (vf + ',' if vf else '') + 'format=gray'
            self._px = decode_still(self.path, pw, ph, extra_vf=vf,
                                    scaler=quality_opts(self.state)['scaler'])
        rgb = getattr(self, '_px', b'')
        if not rgb or len(rgb) < pw * ph * 3:
            return None
        # the same centring draw_client uses, in cells
        x0 = self.x + 1 + max(0, (self.cw - cols) // 2)
        y0 = self.y + 1 + max(0, (self.chh - 1 - rows) // 2)
        return (x0, y0, pw, ph, rgb)

    # -- input --------------------------------------------------------------
    def on_key(self, key):
        if key in (ord('n'), ord('N'), curses.KEY_NPAGE):
            self.step(1); return True
        if key in (ord('p'), ord('P'), curses.KEY_PPAGE):
            self.step(-1); return True
        if key in (ord('f'), ord('F')):
            self.fit = (self.fit + 1) % len(self.FITS)
            self.dirty_img = True
            self.msg = f'fit mode: {self.FITS[self.fit]}'; return True
        if key in (ord('m'), ord('M')):
            self.mono = not self.mono
            self.msg = f'mono {"on" if self.mono else "off"}'; return True
        if key in (ord('+'), ord('=')):
            self.zoom = min(16.0, self.zoom * 1.4)
            self.dirty_img = True; return True
        if key in (ord('-'), ord('_')):
            self.zoom = max(1.0, self.zoom / 1.4)
            if self.zoom <= 1.001:
                self.cx = self.cy = 0.5
            self.dirty_img = True; return True
        if key == ord('0'):
            self.zoom = 1.0; self.cx = self.cy = 0.5; self.rotate = 0
            self.dirty_img = True; self.msg = 'reset'; return True
        if key in (curses.KEY_LEFT, curses.KEY_RIGHT,
                   curses.KEY_UP, curses.KEY_DOWN):
            if self.zoom <= 1.001:
                self.step(1 if key in (curses.KEY_RIGHT, curses.KEY_DOWN) else -1)
                return True
            d = 0.12 / self.zoom
            if key == curses.KEY_LEFT:  self.cx = max(0.0, self.cx - d)
            if key == curses.KEY_RIGHT: self.cx = min(1.0, self.cx + d)
            if key == curses.KEY_UP:    self.cy = max(0.0, self.cy - d)
            if key == curses.KEY_DOWN:  self.cy = min(1.0, self.cy + d)
            self.dirty_img = True; return True
        if key == ord('r'):
            self.dirty_img = True; self.msg = 'reloaded'; return True
        if key == ord('R'):
            self.rotate = (self.rotate + 90) % 360
            self.dirty_img = True; return True
        if key in (ord('g'), ord('G')):
            if self.wm:
                self.wm.open(PromptWindow('Open Image', 'File or folder:',
                                          self.path or os.path.expanduser('~'),
                                          self.open))
            return True
        if key in (ord('o'), ord('O')):
            self.open_external(); return True
        if key in (curses.KEY_ENTER, 10, 13):
            if self.state.get('media_backend') == 'ffplay':
                self.open_external()
            return True
        if key in (ord('i'), ord('I')):
            self.show_info(); return True
        if key in (ord('w'), ord('W')):
            if self.wm and self.path:
                self.wm.open(PromptWindow(
                    'Export as text art', 'Save to:',
                    os.path.expanduser('~/' + os.path.splitext(
                        os.path.basename(self.path))[0] + '.txt'),
                    self.export_text))
            return True
        return False

    def open_external(self):
        """Hand this picture (and its folder) to ffplay on the bare console."""
        if not self.path:
            return
        if not ffplay_available():
            self.msg = 'ffplay is not installed'
            if self.wm:
                self.wm.sound.play('error')
            return
        if not self.wm:
            return
        order = self.siblings or [self.path]
        if self.path in order:
            i = order.index(self.path)
            order = order[i:] + order[:i]
        self.wm.request_shell(
            ffplay_session(order, self.state, still=True,
                           note=f'{len(order)} image(s), q for next'),
            'ffplay images')

    def export_text(self, dest):
        cols, rows = self.grid
        if not (self.frame and cols and rows):
            self.msg = 'nothing to export'
            return
        try:
            with open(os.path.expanduser(dest.strip()), 'w') as f:
                for y in range(rows):
                    line = []
                    for x in range(cols):
                        i = (y * cols + x) * 3
                        r, g, b = self.frame[i], self.frame[i+1], self.frame[i+2]
                        lum = (r * 30 + g * 59 + b * 11) // 100
                        line.append(RAMP[min(len(RAMP) - 1,
                                             lum * len(RAMP) // 256)])
                    f.write(''.join(line).rstrip() + '\n')
            self.msg = f'exported to {dest}'
            if self.wm:
                self.wm.sound.play('drop')
        except Exception as e:
            self.msg = f'export failed: {e}'

    def show_info(self):
        if not self.path:
            return
        i = self.info
        lines = [f'  File     : {os.path.basename(self.path)}',
                 f'  Folder   : {os.path.dirname(self.path)}',
                 f'  Size     : {human_size(os.path.getsize(self.path))}',
                 f'  Pixels   : {i.get("w")}x{i.get("h")}',
                 f'  Codec    : {i.get("codec")}',
                 f'  Rotation : {i.get("rotation")} (showing {self.rotate})',
                 f'  Cells    : {self.grid[0]}x{self.grid[1]}',
                 f'  Fit      : {self.FITS[self.fit]}   zoom {self.zoom:.2f}x',
                 '',
                 f'  Rendered with {len(cell_art().tones)} tones built from '
                 f'{len(MEDIA_COMBOS)} colour pairs',
                 f'  and the {len(RAMP)}-step ramp "{RAMP}"',
                 '']
        if self.wm:
            self.wm.open(TextWindow('Image Info', lines, w=70))

    def on_click(self, row, col, btn):
        if btn == 3:
            self.step(1)
        elif self.zoom > 1.001:
            self.cx = min(1.0, max(0.0, col / max(1, self.cw)))
            self.cy = min(1.0, max(0.0, row / max(1, self.chh)))
            self.dirty_img = True
        return True

    def on_scroll(self, n):
        self.zoom = max(1.0, min(16.0, self.zoom * (1.25 if n < 0 else 0.8)))
        if self.zoom <= 1.001:
            self.cx = self.cy = 0.5
        self.dirty_img = True
        return True

    def on_resize(self):
        self.dirty_img = True


