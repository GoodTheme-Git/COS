</ul>
<p>If a page will not load, this machine may have no network route. The error
page tells you which it was.</p>
</body></html>"""


class Webinator(Window):
    """A real text-mode browser: fetches over HTTP(S), renders HTML to text,
    numbers the links, and lets you follow them."""

    icon = 'W'
    min_w, min_h = 48, 12
    HOME = 'about:webinator'

    def __init__(self, state, url=None):
        super().__init__('Webinator', w=80, h=23)
        self.state = state
        self.url = ''
        self.page_title = ''
        self.raw = ''
        self.ctype = ''
        self.blocks = []
        self.links = []
        self.lines = []
        self.lattr = []
        self.link_rows = {}        # link number -> rendered line index
        self.link_sel = 0
        self.history = []
        self.future = []
        self.msg = 'G=go  S=search  TAB=next link  ENTER=follow  B=back  ?=help'
        self.insecure = False
        self.find = ''
        self.finding = False
        self._lastw = 0
        if url:
            self.go(url)
        else:
            self.load_start()

    def load_start(self):
        """The built-in start page: works with no network at all."""
        self.raw = START_PAGE
        self.ctype = 'text/html'
        self.url = 'about:webinator'
        self.scroll = 0
        self.link_sel = 0
        self.history = []
        self.future = []
        self.msg = 'G=go  S=search  TAB=next link  ENTER=follow  ?=help'
        self.parse()

    # -- networking ---------------------------------------------------------
    def _context(self):
        if self.insecure:
            ctx = ssl.create_default_context()
            ctx.check_hostname = False
            ctx.verify_mode = ssl.CERT_NONE
            return ctx
        return None

    def go(self, url, push=True):
        url = (url or '').strip()
        if not url:
            return
        if url.startswith('about:'):
            self.load_start()
            return
        if os.path.exists(os.path.expanduser(url)):
            url = 'file://' + os.path.abspath(os.path.expanduser(url))
        elif not urllib.parse.urlparse(url).scheme:
            url = 'https://' + url
        self.msg = f'Fetching {url} ...'
        final = url
        try:
            req = urllib.request.Request(url, headers={
                'User-Agent': WEB_UA,
                'Accept': 'text/html,application/xhtml+xml,text/plain;q=0.9,*/*;q=0.5',
                'Accept-Encoding': 'identity',
                'Accept-Language': 'en-US,en;q=0.9',
            })
            with urllib.request.urlopen(req, timeout=15,
                                        context=self._context()) as r:
                final = r.geturl()
                self.ctype = r.headers.get('Content-Type', '')
                charset = 'utf-8'
                if 'charset=' in self.ctype.lower():
                    charset = self.ctype.lower().split('charset=')[1].split(';')[0].strip()
                data = r.read(4_000_000)
            try:
                self.raw = data.decode(charset, errors='replace')
            except LookupError:
                self.raw = data.decode('utf-8', errors='replace')
        except urllib.error.HTTPError as e:
            self.msg = f'HTTP {e.code} {e.reason}'
            self.raw = f'<h1>HTTP {e.code}</h1><p>{_html.escape(str(e.reason))}</p>'
            self.ctype = 'text/html'
            if self.wm: self.wm.sound.play('error')
        except ssl.SSLCertVerificationError as e:
            self.msg = 'TLS certificate verification failed -- press I to retry insecurely'
            self.raw = (f'<h1>Certificate error</h1><p>{_html.escape(str(e))}</p>'
                        '<p>Press I to toggle insecure mode, then R to reload. '
                        'Only do that if you understand the risk.</p>')
            self.ctype = 'text/html'
            if self.wm: self.wm.sound.play('error')
            final = url
        except Exception as e:
            self.msg = f'{type(e).__name__}: {e}'
            self.raw = (f'<h1>Could not load page</h1><p>{_html.escape(str(e))}</p>'
                        '<p>Check the address, or that this machine has network '
                        'access.</p>')
            self.ctype = 'text/html'
            if self.wm: self.wm.sound.play('error')
            final = url
        else:
            self.msg = f'Loaded {human_size(len(self.raw))}  {self.ctype.split(";")[0]}'
            if self.wm: self.wm.sound.play('notify')
        if push and self.url:
            self.history.append(self.url)
            del self.history[:-100]
            self.future.clear()
        self.url = final or url
        self.parse()
        self.scroll = 0
        self.link_sel = 0

    def search(self, query):
        q = urllib.parse.quote_plus(query.strip())
        self.go(f'https://html.duckduckgo.com/html/?q={q}')

    # -- rendering ----------------------------------------------------------
    def parse(self):
        ct = (self.ctype or '').lower()
        if 'html' in ct or self.raw.lstrip()[:200].lower().startswith(
                ('<!doctype html', '<html')):
            p = HTMLToText(self.url)
            try:
                p.feed(self.raw)
                p.close()
            except Exception as e:
                p.blocks.append(('p', f'(parse error: {e})'))
            self.blocks = p.blocks
            self.links = p.links
            self.page_title = ' '.join(p.title.split())[:70]
        else:
            self.blocks = [('pre', l) for l in self.raw.split('\n')]
            self.links = []
            self.page_title = os.path.basename(
                urllib.parse.urlparse(self.url).path) or self.url
        pt = (self.page_title or self.url).strip()
        self.title = ('Webinator' if pt.lower() in ('webinator', '')
                      else f'Webinator - {pt}')[:60]
        self.layout()

    def layout(self):
        width = max(20, self.cw - 2)
        self._lastw = self.cw
        lines, lattr, link_rows = [], [], {}
        import re
        linkre = re.compile(r'\[(\d+)\]')
        for kind, text in self.blocks:
            if kind == 'hr':
                lines.append('-' * width); lattr.append(cp(CP_SHADOW)); continue
            if kind in HEAD_TAGS:
                lvl = int(kind[1])
                a = cp(CP_BRIGHT, bold=True) if lvl <= 2 else cp(CP_BRIGHT)
                if lines:
                    lines.append(''); lattr.append(cp(CP_TEXT))
                for l in wrap_text(text, width):
                    lines.append(l.upper() if lvl == 1 else l)
                    lattr.append(a)
                if lvl <= 2:
                    lines.append('=' * min(width, max(4, len(text))))
                    lattr.append(cp(CP_SHADOW))
            elif kind == 'li':
                for i, l in enumerate(wrap_text(text, width - 4)):
                    lines.append(('  * ' if i == 0 else '    ') + l)
                    lattr.append(cp(CP_TEXT))
            elif kind == 'pre':
                for l in text.split('\n'):
                    lines.append(l[:width]); lattr.append(cp(CP_GREEN))
            elif kind == 'tr':
                for l in wrap_text(text, width - 2):
                    lines.append('  ' + l); lattr.append(cp(CP_TEXT))
            else:
                for l in wrap_text(text, width):
                    lines.append(l); lattr.append(cp(CP_TEXT))
                lines.append(''); lattr.append(cp(CP_TEXT))
        for i, l in enumerate(lines):
            for m in linkre.finditer(l):
                link_rows.setdefault(int(m.group(1)), i)
        self.lines, self.lattr, self.link_rows = lines, lattr, link_rows

    HEADER = 2

    def status(self):
        if self.finding:
            return f'find: {self.find}_   ENTER=search  ESC=cancel'
        sel = ''
        if self.links and 0 <= self.link_sel < len(self.links):
            sel = f'  link {self.link_sel + 1}/{len(self.links)}: ' \
                  f'{self.links[self.link_sel]["href"][:40]}'
        return (self.msg + sel)[:max(10, self.w - 6)]

    def draw_client(self, c, active):
        c.fill(cp(CP_WINDOW))
        if self.cw != self._lastw:
            self.layout()
        # address bar
        c.put(0, 0, ' ' * c.w, cp(CP_INPUT))
        addr = f' {self.url}'
        c.put(0, 0, addr[:c.w - 10], cp(CP_INPUT, bold=True))
        flags = ('[INSEC]' if self.insecure else '') + \
                (f'[{len(self.links)} links]' if self.links else '')
        c.put(0, max(0, c.w - len(flags) - 1), flags, cp(CP_INPUT))
        for i in range(c.w):
            c.ch(1, i, curses.ACS_HLINE, cp(CP_SHADOW))
        vis = max(1, c.h - self.HEADER)
        self.scroll = max(0, min(self.scroll, max(0, len(self.lines) - vis)))
        need_sb = len(self.lines) > vis
        bodyw = c.w - (1 if need_sb else 0)
        selmark = f'[{self.link_sel + 1}]' if self.links else None
        for i in range(vis):
            ri = self.scroll + i
            if ri >= len(self.lines):
                break
            line = self.lines[ri]
            a = self.lattr[ri]
            c.put(self.HEADER + i, 0, line[:bodyw], a)
            # highlight link markers
            if self.links:
                import re
                for m in re.finditer(r'\[(\d+)\]', line[:bodyw]):
                    n = int(m.group(1))
                    hot = (n == self.link_sel + 1)
                    c.put(self.HEADER + i, m.start(), m.group(0),
                          cp(CP_SEL, bold=True) if hot else cp(CP_METER, bold=True))
            if self.find and self.find.lower() in line.lower():
                col = line.lower().index(self.find.lower())
                if col < bodyw:
                    c.put(self.HEADER + i, col, line[col:col + len(self.find)],
                          cp(CP_WARN, bold=True))
        if need_sb:
            c.scrollbar(self.HEADER, c.w - 1, vis, len(self.lines), vis,
                        self.scroll, cp(CP_SCROLL))

    # -- navigation ---------------------------------------------------------
    def reveal_link(self):
        row = self.link_rows.get(self.link_sel + 1)
        if row is None:
            return
        vis = max(1, self.chh - self.HEADER)
        if not (self.scroll <= row < self.scroll + vis):
            self.scroll = max(0, row - vis // 3)

    def follow(self, n=None):
        n = self.link_sel if n is None else n
        if 0 <= n < len(self.links):
            self.go(self.links[n]['href'])

    def back(self):
        if self.history:
            self.future.append(self.url)
            url = self.history.pop()
            self.go(url, push=False)
            self.msg = 'Back'
        else:
            self.msg = 'No history'

    def forward(self):
        if self.future:
            self.history.append(self.url)
            self.go(self.future.pop(), push=False)
            self.msg = 'Forward'

    def bookmark(self):
        try:
            os.makedirs(COS_HOME, exist_ok=True)
            with open(BOOKMARK_FILE, 'a') as f:
                f.write(f'{self.url}\t{self.page_title}\n')
            self.msg = 'Bookmarked'
            if self.wm: self.wm.sound.play('drop')
        except Exception as e:
            self.msg = f'Bookmark failed: {e}'

    def show_bookmarks(self):
        try:
            with open(BOOKMARK_FILE) as f:
                rows = [l.rstrip('\n') for l in f if l.strip()]
        except OSError:
            rows = []
        if not rows:
            self.msg = 'No bookmarks yet (press D to add one)'
            return
        if self.wm:
            self.wm.open(BookmarkList(self, rows))

    def save_page(self, path):
        try:
            with open(os.path.expanduser(path.strip()), 'w') as f:
                f.write('\n'.join(self.lines))
            self.msg = f'Saved text to {path}'
        except Exception as e:
            self.msg = f'Save failed: {e}'

    def on_key(self, key):
        if self.finding:
            if key in (curses.KEY_ENTER, 10, 13):
                self.finding = False
                self._find_next(); return True
            if key == 27:
                self.finding = False; self.find = ''; return True
            if key in (curses.KEY_BACKSPACE, 127, 8):
                self.find = self.find[:-1]; return True
            if 32 <= key <= 126:
                self.find += chr(key); return True
            return True
        vis = max(1, self.chh - self.HEADER)
        if key == curses.KEY_DOWN:
            self.scroll = min(max(0, len(self.lines) - vis), self.scroll + 1); return True
        if key == curses.KEY_UP:
            self.scroll = max(0, self.scroll - 1); return True
        if key in (curses.KEY_NPAGE, ord(' ')):
            self.scroll = min(max(0, len(self.lines) - vis), self.scroll + vis); return True
        if key == curses.KEY_PPAGE:
            self.scroll = max(0, self.scroll - vis); return True
        if key == curses.KEY_HOME:
            self.scroll = 0; return True
        if key == curses.KEY_END:
            self.scroll = max(0, len(self.lines) - vis); return True
        if key == 9:                                    # TAB
            if self.links:
                self.link_sel = (self.link_sel + 1) % len(self.links)
                self.reveal_link()
            return True
        if key == curses.KEY_BTAB:
            if self.links:
                self.link_sel = (self.link_sel - 1) % len(self.links)
                self.reveal_link()
            return True
        if key in (curses.KEY_ENTER, 10, 13):
            self.follow(); return True
        if key in (ord('g'), ord('G')):
            if self.wm:
                cur = '' if self.url.startswith('about:') else self.url
                self.wm.open(PromptWindow('Webinator: Go', 'Address:',
                                          cur or 'https://', self.go))
            return True
        if key in (ord('s'), ord('S')):
            if self.wm:
                self.wm.open(PromptWindow('Webinator: Search the Web',
                                          'Search terms:', '', self.search))
            return True
        if key in (ord('b'), ord('B'), curses.KEY_LEFT):
            self.back(); return True
        if key in (ord('f'), ord('F'), curses.KEY_RIGHT):
            self.forward(); return True
        if key in (ord('r'), ord('R'), curses.KEY_F5):
            if self.url:
                self.go(self.url, push=False)
            return True
        if key == ord('d'):
            self.bookmark(); return True
        if key == ord('D'):
            self.show_bookmarks(); return True
        if key in (ord('h'), ord('H')):
            self.go(self.HOME); return True
        if key in (ord('i'), ord('I')):
            self.insecure = not self.insecure
            self.msg = (f'Insecure TLS {"ENABLED -- certificates are NOT checked" if self.insecure else "disabled"}'
                        '  (press R to reload)')
            return True
        if key in (ord('v'), ord('V')):
            if self.wm:
                self.wm.open(TextWindow(f'Source: {self.url[:40]}',
                                        self.raw.split('\n')[:3000] or ['(empty)']))
            return True
        if key in (ord('w'), ord('W')):
            if self.wm:
                self.wm.open(PromptWindow('Save Page Text', 'Save to:',
                                          os.path.expanduser('~/page.txt'),
                                          self.save_page))
            return True
        if key == ord('/'):
            self.finding = True; self.find = ''; return True
        if key == ord('n'):
            self._find_next(); return True
        if key == ord('l'):
            if self.wm:
                self.wm.open(TextWindow(
                    f'Links on {self.page_title[:30]}',
                    [f'  [{l["n"]:>3}] {l["text"][:46]:<46} {l["href"]}'
                     for l in self.links] or ['  (no links)']))
            return True
        if key == ord('?'):
            if self.wm:
                self.wm.open(TextWindow('Webinator Keys', [
                    '  G        go to an address',
                    '  S        search the web (DuckDuckGo)',
                    '  TAB      select next link      Shift-TAB  previous',
                    '  ENTER    follow selected link',
                    '  1-9 ...  type L to list every link with its number',
                    '  B / F    back / forward',
                    '  R        reload              H  home',
                    '  SPACE    page down           PgUp/PgDn/arrows scroll',
                    '  /        find text in page   n  next match',
                    '  d / D    bookmark / list bookmarks',
                    '  v        view page source    w  save page text',
                    '  i        toggle insecure TLS (certs NOT verified)',
                    '',
                    '  Webinator renders HTML to text itself: no images, no',
                    '  CSS, no JavaScript. Forms are shown but not submitted.',
                ]))
            return True
        if 32 <= key <= 126 and chr(key).isdigit():
            n = int(chr(key))
            if 1 <= n <= len(self.links):
                self.link_sel = n - 1
                self.reveal_link()
            return True
        return False

    def _find_next(self):
        if not self.find:
            return
        q = self.find.lower()
        start = self.scroll + 1
        for off in range(len(self.lines)):
            i = (start + off) % len(self.lines)
            if q in self.lines[i].lower():
                self.scroll = max(0, i - 2)
                self.msg = f'Found "{self.find}" on line {i + 1}'
                return
        self.msg = f'"{self.find}" not found'

    def on_click(self, row, col, btn):
        if row == 0:
            if self.wm:
                cur = '' if self.url.startswith('about:') else self.url
                self.wm.open(PromptWindow('Webinator: Go', 'Address:',
                                          cur or 'https://', self.go))
            return True
        ri = self.scroll + (row - self.HEADER)
        if 0 <= ri < len(self.lines):
            import re
            line = self.lines[ri]
            for m in re.finditer(r'\[(\d+)\]', line):
                if m.start() <= col <= m.end() + 60:
                    n = int(m.group(1))
                    if 1 <= n <= len(self.links):
                        self.link_sel = n - 1
                        if (self.wm and self.wm.double) or btn == 3:
                            self.follow()
                        return True
        return True

    def on_scroll(self, n):
        vis = max(1, self.chh - self.HEADER)
        self.scroll = max(0, min(self.scroll + n * 3,
                                 max(0, len(self.lines) - vis)))
        return True


class BookmarkList(ScrollListWindow):
    icon = 'D'

    def __init__(self, browser, rows):
        super().__init__('Bookmarks', w=72, h=16)
        self.browser = browser
        self.items = rows

    def rows(self):
        return self.items

    def row_text(self, i, item):
        url, _, title = item.partition('\t')
        return f' {title[:30]:<30} {url}'

    def status(self):
        return 'ENTER=open   X=remove   ^W=close'

    def on_activate(self, i, item):
        url = item.split('\t')[0]
        self.browser.go(url)
        if self.wm:
            self.wm.focus(self.browser)

    def on_key(self, key):
        if key in (ord('x'), ord('X'), curses.KEY_DC) and self.items:
            del self.items[self.sel]
            try:
                with open(BOOKMARK_FILE, 'w') as f:
                    for row in self.items:
                        f.write(row + '\n')
            except OSError:
                pass
            return True
        return super().on_key(key)


