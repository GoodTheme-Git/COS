def cli_serve(args):
    """Run Pigeon without the desktop: COS as a plain file server."""
    port = SHARE_DEFAULT_PORT
    root = os.path.dirname(os.path.abspath(__file__))
    for a in args:
        if a.isdigit():
            port = int(a)
        else:
            root = a
    p = Pigeon(root, port)
    if not p.start():
        print(f'cos --serve: {p.error}', file=sys.stderr)
        return 1
    print(f'COS Pigeon {VERSION} -- serving {p.root}')
    print()
    for u in p.urls():
        print(f'  {u}')
    print()
    print('  On the other machine:')
    print(f'      {p.pull_command()}')
    print()
    fw = firewall_blocking(port)
    if fw == 'blocked':
        print(f'  ufw is active and port {port} is NOT allowed. Run:')
        print(f'      sudo ufw allow {port}/tcp')
        print()
    elif fw == 'maybe':
        print('  ufw is running and its rules need root to read. If the other')
        print('  machine cannot connect, that is almost certainly why:')
        print(f'      sudo ufw allow {port}/tcp')
        print()
    print('  Read-only, GET/HEAD only, dotfiles excluded. Ctrl-C to stop.')
    print()
    try:
        while True:
            time.sleep(0.5)
            while p.log:
                print('  ' + p.log.popleft())
    except KeyboardInterrupt:
        print('\nstopping...')
    finally:
        p.stop()
    return 0


def usage():
    print(__doc__)
    return 0


def run():
    args = sys.argv[1:]
    if args:
        a = args[0]
        if a == '--mouse-bridge':
            if len(args) < 2:
                print('usage: --mouse-bridge /dev/input/eventN', file=sys.stderr)
                return 2
            return mouse_bridge(args[1])
        if a == '--crash-test':
            os.environ['COS_CRASH_TEST'] = '1'
            args = args[1:]
            if not args:
                try:
                    curses.wrapper(main)
                except KeyboardInterrupt:
                    pass
                except CosFatal as e:
                    sys.stdout.write('\033[?1003l'); sys.stdout.flush()
                    report = (e.reason.rstrip() + '\n\n') if e.reason else ''
                    return handle_fatal(report + traceback.format_exc())
                except BaseException:
                    sys.stdout.write('\033[?1003l'); sys.stdout.flush()
                    return handle_fatal(traceback.format_exc())
                return 0
        if a == '--no-apps':
            os.environ['COS_NO_APPS'] = '1'
            sys.argv = [sys.argv[0]] + args[1:]
            args = args[1:]
            if not args:
                try:
                    curses.wrapper(main)
                except KeyboardInterrupt:
                    pass
                finally:
                    sys.stdout.write('\033[?1003l')
                    sys.stdout.flush()
                    print('\nCOS channel closed.')
                return 0
        if a == '--serve':
            return cli_serve(args[1:])
        if a == '--test-input':
            return cli_test_input()
        if a == '--test-sound':
            return cli_test_sound()
        if a == '--grant-input':
            return cli_grant_input()
        if a in ('-h', '--help'):
            return usage()
        print(f'unknown option {a}\n')
        return usage()
    try:
        curses.wrapper(main)
    except KeyboardInterrupt:
        pass
    except CosFatal as e:
        sys.stdout.write('\033[?1003l')
        sys.stdout.flush()
        report = ''
        if e.reason:
            report += e.reason.rstrip() + '\n\n'
        report += traceback.format_exc()
        return handle_fatal(report)
    except BaseException:
        sys.stdout.write('\033[?1003l')
        sys.stdout.flush()
        return handle_fatal(traceback.format_exc())
    finally:
        sys.stdout.write('\033[?1003l')
        sys.stdout.flush()
    print('\nCOS channel closed.')
    return 0


if __name__ == '__main__':
    sys.exit(run() or 0)
