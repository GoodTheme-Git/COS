TEXT_EXT = {'.txt', '.md', '.py', '.sh', '.c', '.h', '.cpp', '.js', '.json',
            '.cfg', '.conf', '.ini', '.log', '.csv', '.html', '.css', '.xml',
            '.yaml', '.yml', '.toml', '.rst', '.service', '.desktop', ''}


class FileManager(ScrollListWindow):
    icon = '/'
    min_w, min_h = 44, 11

    def __init__(self, state, path=None):
        super().__init__('File Manager', w=76, h=22)
        self.state = state
        self.path = os.path.abspath(os.path.expanduser(path or '~'))
        self.show_hidden = False
        self.entries = []
        self.msg = ''
        self.clip = None            # (op, path)
        self.refresh()

    # -- data ---------------------------------------------------------------
    def refresh(self):
        out = [('..', True, 0, 0, 0o040755)]
        try:
            with os.scandir(self.path) as it:
                items = []
                for e in it:
                    if not self.show_hidden and e.name.startswith('.'):
                        continue
                    try:
                        st = e.stat(follow_symlinks=False)
                        items.append((e.name, e.is_dir(), st.st_size,
                                      st.st_mtime, st.st_mode))
                    except OSError:
                        items.append((e.name, False, 0, 0, 0))
            items.sort(key=lambda t: (not t[1], t[0].lower()))
            out += items
        except PermissionError:
            self.msg = 'Permission denied'
        except OSError as e:
            self.msg = str(e)
        self.entries = out
        self.sel = min(self.sel, max(0, len(out) - 1))

    def rows(self):
        return self.entries

    def header_rows(self):
        return 2

    def visible_rows(self):
        return max(1, self.chh - 2)

    def status(self):
        if self.msg:
            return self.msg
        clip = f'  clip:{self.clip[0]} {os.path.basename(self.clip[1])}' if self.clip else ''
        return (f'{len(self.entries) - 1} items  ENTER=open  F2=rename  F5=copy  '
                f'F6=move  F7=mkdir  DEL=delete{clip}')

    def draw_header(self, c, active):
        c.put(0, 1, ('Path: ' + self.path)[:c.w - 2], cp(CP_BRIGHT, bold=True))
        hdr = f'{"Name":<30} {"Size":>9}  {"Modified":<16} Mode'
        c.put(1, 1, hdr[:c.w - 2], cp(CP_MENU_SEL))

    def row_text(self, i, item):
        name, is_dir, size, mtime, mode = item
        disp = name + ('/' if is_dir and name != '..' else '')
        sz = '<DIR>' if is_dir else human_size(size)
        when = datetime.fromtimestamp(mtime).strftime('%Y-%m-%d %H:%M') if mtime else ''
        perm = stat_str(mode) if mode else ''
        return f' {disp:<30.30} {sz:>9}  {when:<16} {perm}'

    def row_attr(self, i, item, selected, active):
        if selected:
            return cp(CP_SEL, bold=True) if active else cp(CP_MENU_SEL)
        name, is_dir, size, mtime, mode = item
        if is_dir:
            return cp(CP_BRIGHT, bold=True)
        if mode and (mode & 0o111):
            return cp(CP_GREEN)
        return cp(CP_TEXT)

    # -- actions ------------------------------------------------------------
    def selected_path(self):
        if not self.entries:
            return None
        name = self.entries[self.sel][0]
        if name == '..':
            return os.path.dirname(self.path)
        return os.path.join(self.path, name)

    def goto(self, path):
        if os.path.isdir(path):
            self.path = os.path.abspath(path)
            self.sel = 0
            self.scroll = 0
            self.msg = ''
            self.refresh()

    def on_activate(self, i, item):
        name, is_dir, size, mtime, mode = item
        target = self.selected_path()
        if not target:
            return
        if is_dir or os.path.isdir(target):
            self.goto(target)
            if self.wm: self.wm.sound.play('click')
            return
        ext = os.path.splitext(target)[1].lower()
        if ext in IMAGE_EXT and self.wm:
            if (self.state.get('media_backend') == 'ffplay'
                    and ffplay_available()):
                imgs = [os.path.join(self.path, e[0]) for e in self.entries
                        if not e[1]
                        and os.path.splitext(e[0])[1].lower() in IMAGE_EXT]
                if target in imgs:
                    i = imgs.index(target)
                    imgs = imgs[i:] + imgs[:i]
                self.wm.request_shell(
                    ffplay_session(imgs or [target], self.state, still=True,
                                   note='q for next image'), 'ffplay images')
                return
            v = self.wm.open_single(ImageViewer, self.state)
            v.open(target)
            self.wm.focus(v)
            return
        if ext in (AUDIO_EXT | VIDEO_EXT) and self.wm:
            d = self.wm.open_single(Druman, self.state)
            if target in d.tracks:
                d.play_index(d.tracks.index(target))
            else:
                d.tracks.append(target)
                d.refilter()
                d.play_index(len(d.tracks) - 1)
            self.wm.focus(d)
            return
        if ext in TEXT_EXT and os.path.getsize(target) < 2_000_000:
            if self.wm:
                self.wm.open(Editor(self.state, target))
            return
        if self.wm:
            self.wm.open(TextWindow(f'file: {name}', self.file_info(target)))

    def file_info(self, path):
        lines = []
        try:
            st = os.stat(path)
            lines += [f'  Path     : {path}',
                      f'  Size     : {human_size(st.st_size)}  ({st.st_size:,} bytes)',
                      f'  Mode     : {stat_str(st.st_mode)}  ({oct(st.st_mode & 0o7777)})',
                      f'  Owner    : uid {st.st_uid}  gid {st.st_gid}',
                      f'  Modified : {datetime.fromtimestamp(st.st_mtime)}',
                      f'  Accessed : {datetime.fromtimestamp(st.st_atime)}', '']
        except OSError as e:
            lines.append(f'  stat failed: {e}')
        if _which('file'):
            lines.append('  ' + run_cmd(['file', '-b', path]).strip())
            lines.append('')
        try:
            with open(path, 'rb') as f:
                head = f.read(512)
            lines.append('  -- first bytes --')
            for off in range(0, min(len(head), 256), 16):
                chunk = head[off:off + 16]
                hexs = ' '.join(f'{b:02x}' for b in chunk)
                txt = ''.join(chr(b) if 32 <= b < 127 else '.' for b in chunk)
                lines.append(f'  {off:04x}  {hexs:<47}  {txt}')
        except OSError:
            pass
        return lines

    def _do_delete(self, path):
        try:
            if os.path.isdir(path) and not os.path.islink(path):
                shutil.rmtree(path)
            else:
                os.remove(path)
            self.msg = f'Deleted {os.path.basename(path)}'
            self.refresh()
            if self.wm: self.wm.sound.play('drop')
        except Exception as e:
            self.msg = f'Delete failed: {e}'
            if self.wm: self.wm.sound.play('error')

    def _do_rename(self, newname):
        src = self.selected_path()
        if not src or not newname.strip():
            return
        dst = os.path.join(self.path, newname.strip())
        try:
            os.rename(src, dst)
            self.msg = f'Renamed to {newname}'
            self.refresh()
        except Exception as e:
            self.msg = f'Rename failed: {e}'
            if self.wm: self.wm.sound.play('error')

    def _do_mkdir(self, name):
        if not name.strip():
            return
        try:
            os.makedirs(os.path.join(self.path, name.strip()), exist_ok=False)
            self.msg = f'Created {name}'
            self.refresh()
        except Exception as e:
            self.msg = f'mkdir failed: {e}'
            if self.wm: self.wm.sound.play('error')

    def _paste(self):
        if not self.clip:
            self.msg = 'Clipboard empty -- F5 copy or F6 cut first'
            return
        op, src = self.clip
        dst = os.path.join(self.path, os.path.basename(src))
        try:
            if os.path.abspath(src) == os.path.abspath(dst):
                self.msg = 'Source and destination are the same'
                return
            if op == 'copy':
                if os.path.isdir(src):
                    shutil.copytree(src, dst)
                else:
                    shutil.copy2(src, dst)
            else:
                shutil.move(src, dst)
                self.clip = None
            self.msg = f'{op} -> {os.path.basename(dst)}'
            self.refresh()
            if self.wm: self.wm.sound.play('drop')
        except Exception as e:
            self.msg = f'{op} failed: {e}'
            if self.wm: self.wm.sound.play('error')

    def on_key(self, key):
        target = self.selected_path()
        if key in (curses.KEY_BACKSPACE, 127, 8, curses.KEY_LEFT):
            self.goto(os.path.dirname(self.path)); return True
        if key == curses.KEY_RIGHT:
            if target and os.path.isdir(target):
                self.goto(target)
            return True
        if key in (ord('h'), ord('H')):
            self.show_hidden = not self.show_hidden
            self.msg = f'Hidden files {"shown" if self.show_hidden else "hidden"}'
            self.refresh(); return True
        if key == curses.KEY_F5 and target:
            self.clip = ('copy', target)
            self.msg = f'Copied {os.path.basename(target)} -- F4 to paste'; return True
        if key == curses.KEY_F6 and target:
            self.clip = ('move', target)
            self.msg = f'Cut {os.path.basename(target)} -- F4 to paste'; return True
        if key == curses.KEY_F4:
            self._paste(); return True
        if key == curses.KEY_F7:
            if self.wm:
                self.wm.open(PromptWindow('New Folder', 'Folder name:', '',
                                          self._do_mkdir))
            return True
        if key == curses.KEY_F2 and target:
            if self.wm:
                self.wm.open(PromptWindow('Rename', 'New name:',
                                          os.path.basename(target), self._do_rename))
            return True
        if key in (curses.KEY_DC, curses.KEY_F8) and target:
            if os.path.basename(target) == '..':
                return True
            if self.wm:
                self.wm.open(ConfirmWindow(
                    'Confirm Delete',
                    ['Permanently delete this?', '', '  ' + target,
                     '', 'This cannot be undone.'],
                    lambda p=target: self._do_delete(p), danger=True))
            return True
        if key in (ord('i'), ord('I')) and target:
            if self.wm:
                self.wm.open(TextWindow(os.path.basename(target),
                                        self.file_info(target)))
            return True
        if key in (ord('x'), ord('X')) and target:
            if self.wm:
                self.wm.open(ConfirmWindow(
                    'Execute',
                    ['Run this program?', '', '  ' + target],
                    lambda p=target: self._exec(p)))
            return True
        if key in (ord('t'), ord('T')):
            if self.wm:
                sh = COSShell()
                self.wm.open(sh)
                try:
                    os.chdir(self.path)
                    sh.write(f'  cwd: {self.path}', cp(CP_GREEN))
                except OSError:
                    pass
            return True
        if key in (ord('g'), ord('G')):
            if self.wm:
                self.wm.open(PromptWindow('Go To Folder', 'Path:', self.path,
                                          self.goto))
            return True
        if key == curses.KEY_F9 or key == ord('~'):
            self.goto(os.path.expanduser('~')); return True
        if key in (curses.KEY_F12,):
            self.refresh(); self.msg = 'Refreshed'; return True
        return super().on_key(key)

    def _exec(self, path):
        try:
            subprocess.Popen([path], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
                             start_new_session=True, cwd=self.path)
            self.msg = f'Launched {os.path.basename(path)}'
        except Exception as e:
            self.msg = f'Exec failed: {e}'
            if self.wm: self.wm.sound.play('error')


def stat_str(mode):
    import stat as _st
    if not mode:
        return ''
    kind = ('d' if _st.S_ISDIR(mode) else
            'l' if _st.S_ISLNK(mode) else
            'c' if _st.S_ISCHR(mode) else
            'b' if _st.S_ISBLK(mode) else
            's' if _st.S_ISSOCK(mode) else
            'p' if _st.S_ISFIFO(mode) else '-')
    bits = ''
    for who in ('USR', 'GRP', 'OTH'):
        for what, ch in (('R', 'r'), ('W', 'w'), ('X', 'x')):
            bits += ch if mode & getattr(_st, f'S_I{what}{who}') else '-'
    return kind + bits


