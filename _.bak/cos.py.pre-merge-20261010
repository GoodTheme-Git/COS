# Only unambiguous audio extensions. Tracker formats are deliberately left
# out: '.mod' also means GRUB/kernel module, and ffplay cannot decode them.
AUDIO_EXT = {'.mp3', '.wav', '.flac', '.ogg', '.oga', '.opus', '.m4a',
             '.aac', '.wma', '.aiff', '.aif', '.mka', '.wv', '.ape', '.alac'}


def media_cmd(path, vol=80, seek=0):
    """Best available command line to play `path`, or None."""
    if SILENT:
        return None
    ext = os.path.splitext(path)[1].lower()
    if _which('ffplay'):
        cmd = ['ffplay', '-nodisp', '-autoexit', '-loglevel', 'quiet',
               '-volume', str(int(max(0, min(100, vol))))]
        if seek:
            cmd += ['-ss', str(int(seek))]
        return cmd + [path]
    if _which('mpv'):
        cmd = ['mpv', '--no-video', '--really-quiet',
               f'--volume={int(vol)}']
        if seek:
            cmd.append(f'--start={int(seek)}')
        return cmd + [path]
    if ext in ('.wav', '.flac') and _which('aplay') and ext == '.wav':
        return ['aplay', '-q', path]
    if _which('pw-play'):
        return ['pw-play', f'--volume={vol / 100:.2f}', path]
    if ext == '.mp3' and _which('mpg123'):
        return ['mpg123', '-q', path]
    return None


def play_media_detached(path, vol=80):
    if SILENT:
        return None
    cmd = media_cmd(path, vol)
    if not cmd:
        return None
    try:
        return subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL,
                                stdin=subprocess.DEVNULL,
                                start_new_session=True)
    except Exception:
        return None


def probe_duration(path):
    if not _which('ffprobe'):
        return None
    try:
        r = subprocess.run(['ffprobe', '-v', 'error', '-show_entries',
                            'format=duration', '-of',
                            'default=noprint_wrappers=1:nokey=1', path],
                           capture_output=True, text=True, timeout=6)
        return float(r.stdout.strip())
    except Exception:
        return None


def probe_tags(path):
    """Return (title, artist, album) from metadata, falling back to filename."""
    stem = os.path.splitext(os.path.basename(path))[0]
    title, artist, album = stem, '', ''
    if ' - ' in stem:
        a, _, t = stem.partition(' - ')
        artist, title = a.strip(), t.strip()
    if _which('ffprobe'):
        try:
            r = subprocess.run(
                ['ffprobe', '-v', 'error', '-show_entries',
                 'format_tags=title,artist,album', '-of',
                 'default=noprint_wrappers=1', path],
                capture_output=True, text=True, timeout=6)
            for line in r.stdout.splitlines():
                k, _, v = line.partition('=')
                v = v.strip()
                if not v:
                    continue
                k = k.strip().upper()
                if k.endswith('TITLE'):
                    title = v
                elif k.endswith('ARTIST'):
                    artist = v
                elif k.endswith('ALBUM'):
                    album = v
        except Exception:
            pass
    return title, artist, album


def set_system_volume(pct):
    """Set the machine's master volume.

    Only ever called from an explicit system-volume control -- never as a
    side effect of an in-app volume slider.
    """
    pct = int(max(0, min(100, pct)))
    for cmd in (['amixer', '-q', 'sset', 'Master', f'{pct}%'],
                ['wpctl', 'set-volume', '@DEFAULT_AUDIO_SINK@', f'{pct / 100:.2f}'],
                ['pactl', 'set-sink-volume', '@DEFAULT_SINK@', f'{pct}%']):
        if not _which(cmd[0]):
            continue
        try:
            if subprocess.run(cmd, timeout=4, stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL).returncode == 0:
                return cmd[0]
        except Exception:
            continue
    return None


def get_system_volume():
    if _which('amixer'):
        try:
            r = subprocess.run(['amixer', 'sget', 'Master'],
                               capture_output=True, text=True, timeout=4)
            for tok in r.stdout.split():
                if tok.startswith('[') and tok.endswith('%]'):
                    return int(tok[1:-2])
        except Exception:
            pass
    return None


