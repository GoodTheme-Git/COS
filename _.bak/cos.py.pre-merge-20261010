def cli_test_input():
    devs = list_input_devices()
    print(f'COS v{VERSION} -- raw input test\n')
    if not devs:
        print('No pointing devices found in /proc/bus/input/devices.')
        return 1
    for d in devs:
        print(f'   {d["path"]:<18} {d["kind"]:<9} '
              f'{"readable" if d["readable"] else "NO ACCESS":<10} {d["name"]}')
    print()
    state = dict(DEFAULTS)
    state['messages'] = []
    p = Pointer(state)
    if not p.start():
        print('start failed:', p.status)
        if not any(d['readable'] for d in devs):
            print(f"Run:  python3 '{os.path.basename(__file__)}' --grant-input")
        return 1
    for src in p.sources:
        print(f'-> reading {src.path:<18} {src.kind:<9} ({src.mode})'
              f'  {src.device["name"]}')
    for d in p.shadowed:
        print(f'   skipped {d["path"]:<18} duplicate of a touchpad '
              f'already open (same Phys=)')
    for d, why in p.failed:
        print(f'   failed  {d["path"]:<18} {why}')
    print('\nMove a finger on the pad, or the mouse. Ctrl-C to stop.\n')
    try:
        while True:
            time.sleep(0.1)
            evs = p.drain()
            if evs:
                x, y = p.pos
                kinds = ' '.join(str(e) for e in evs[-4:])
                print(f'\rpos {x:>4},{y:>4}  raw {p.raw[0]:>5},{p.raw[1]:>5}  '
                      f'fingers {p.fingers}  pkts {p.packets:>6}  {kinds:<40}',
                      end='', flush=True)
    except KeyboardInterrupt:
        print('\n')
    finally:
        p.stop()
    return 0


def cli_test_sound():
