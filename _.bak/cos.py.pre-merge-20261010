class Window:
    icon = '#'
    resizable = True
    # Control bytes this window needs for itself, so the global menu
    # shortcuts do not steal them (the editor's ^S being the obvious case).
    claims_ctrl = frozenset()
    min_w, min_h = 26, 7
    want_cursor = False          # show the terminal caret inside this window

    def __init__(self, title, w=50, h=16, x=None, y=None):
        self.title = title
        self.w, self.h = w, h
        self.x = 2 if x is None else x
        self.y = 2 if y is None else y
        self.closed = False
        self.maximized = False
        self._restore = None
        self.wm = None
        self.scroll = 0
        self.caret = None        # (row, col) client coords when want_cursor

    # -- geometry -----------------------------------------------------------
    @property
    def cw(self):
        return max(0, self.w - 2)

    @property
    def chh(self):
        return max(0, self.h - 2)

    def client_canvas(self, scr):
        return Canvas(scr, self.y + 1, self.x + 1, self.chh, self.cw)

    def clamp(self, lay):
        self.w = max(self.min_w, min(self.w, lay.ww))
        self.h = max(self.min_h, min(self.h, lay.wh))
        self.x = max(lay.wx, min(self.x, lay.wx + lay.ww - self.w))
        self.y = max(lay.wy, min(self.y, lay.wy + lay.wh - self.h))

    def title_buttons(self):
        """[(col_offset, width, name)] relative to window left edge."""
        btns = []
        col = self.w - 4
        btns.append((col, 3, 'close'))
        if self.resizable:
            col -= 3
            btns.append((col, 3, 'max'))
        return btns

    # -- framing ------------------------------------------------------------
    def draw(self, scr, active):
        attr = cp(CP_WINDOW)
        tattr = cp(CP_WIN_TITLE, bold=True) if active else cp(CP_TITLE_IDLE)
        if active:
            draw_shadow(scr, self.y, self.x, self.h, self.w, cp(CP_SHADOW))
        draw_box(scr, self.y, self.x, self.h, self.w, attr, attr)
        # title row
        _safestr(scr, self.y, self.x + 1, ' ' * (self.w - 2), tattr)
        t = f' {self.title} '
        _safestr(scr, self.y, self.x + 1, t[:max(0, self.w - 9)], tattr)
        for col, _wd, name in self.title_buttons():
            lbl = '[X]' if name == 'close' else ('[v]' if self.maximized else '[^]')
            _safestr(scr, self.y, self.x + col, lbl, tattr)
        # bottom hint
        st = self.status()
        if st:
            _safestr(scr, self.y + self.h - 1, self.x + 2,
                     f' {st} '[:max(0, self.w - 4)], cp(CP_STATUS))
        if self.resizable:
            _safech(scr, self.y + self.h - 1, self.x + self.w - 1,
                    curses.ACS_LRCORNER, cp(CP_BRIGHT, bold=True))
        self.draw_client(self.client_canvas(scr), active)

    # -- overridables -------------------------------------------------------
    def draw_client(self, c, active):
        c.put(0, 1, '(empty window)', cp(CP_TEXT))

    def status(self):
        return ''

    def on_key(self, key):
        return False

    def on_click(self, row, col, btn):
        return False

    def on_scroll(self, n):
        return False

    def pixel_rect(self, fw, fh):
        """True pixels for BETA graphics mode, or None to stay as cells.

        Return (col, row, width, height, rgb) where col/row are absolute
        cell coordinates on the desktop and rgb is width*height*3 bytes.
        Only the focused window is asked, and only in graphics mode, so a
        window that cannot cheaply produce pixels should just say no.
        """
        return None

    def tick(self):
        pass

    def on_close(self):
        pass

    def on_resize(self):
        pass

    # -- helpers ------------------------------------------------------------
    def notify(self, msg, sound='notify'):
        if self.wm:
            self.wm.notify(msg, sound)

    # Dialog shortcuts. Apps use these constantly, so they live on Window
    # rather than making every app reach into the window manager.
    def notice(self, title, body, kind='info', on_ok=None):
        if self.wm:
            return self.wm.open(NoticeWindow(title, body, kind, on_ok))
        return None

    def warn(self, title, body, on_ok=None):
        return self.notice(title, body, 'warn', on_ok)

    def error(self, title, body, on_ok=None, fatal=False):
        """An error dialog, or the blue screen when fatal=True."""
        if fatal:
            raise CosFatal(body if isinstance(body, str) else '\n'.join(body),
                           title)
        return self.notice(title, body, 'error', on_ok)

    def success(self, title, body, on_ok=None):
        return self.notice(title, body, 'ok', on_ok)

    def ask(self, title, body, on_yes=None, kind=None, yes='Yes',
            no='No', danger=False, on_no=None):
        """A question box. The answer arrives through the callbacks."""
        if self.wm:
            return self.wm.open(ConfirmWindow(title, body, on_yes, danger,
                                              kind, yes, no, on_no))
        return None

    def confirm(self, title, body, on_yes, danger=False):
        return self.ask(title, body, on_yes, danger=danger)

    def prompt(self, title, label, default='', on_ok=None):
        if self.wm:
            return self.wm.open(PromptWindow(title, label, default, on_ok))
        return None

    def progress(self, title, label='Working...', total=0, worker=None,
                 cancellable=True, on_done=None):
        if self.wm:
            return self.wm.open(ProgressWindow(title, label, total, worker,
                                               cancellable, on_done))
        return None

    def text(self, title, lines, w=None):
        if self.wm:
            return self.wm.open(TextWindow(title, lines, w))
        return None

    def play(self, name):
        if self.wm:
            self.wm.sound.play(name)

    def bsod(self, reason='', title='Fatal error'):
        """Stop COS on purpose and show the error screen.

        For when an app decides it cannot safely continue. The reason is
        printed above the traceback, so say something useful.
        """
        raise CosFatal(reason, title)

    def toggle_max(self, lay):
        if self.maximized:
            if self._restore:
                self.x, self.y, self.w, self.h = self._restore
            self.maximized = False
        else:
            self._restore = (self.x, self.y, self.w, self.h)
            self.x, self.y = lay.wx, lay.wy
            self.w, self.h = lay.ww, lay.wh
            self.maximized = True
        self.clamp(lay)
        self.on_resize()


class ScrollListWindow(Window):
    """Window with a scrolling selectable list. Subclass supplies rows()."""

    def __init__(self, title, w=56, h=18, x=None, y=None):
        super().__init__(title, w, h, x, y)
        self.sel = 0

    def rows(self):
        return []

    def row_attr(self, i, item, selected, active):
        if selected:
            return cp(CP_SEL, bold=True) if active else cp(CP_MENU_SEL)
        return cp(CP_TEXT)

    def row_text(self, i, item):
        return str(item)

    def on_activate(self, i, item):
        pass

    def visible_rows(self):
        return self.chh - self.header_rows() - self.footer_rows()

    def header_rows(self):
        return 0

    def footer_rows(self):
        return 0

    def draw_header(self, c, active):
        pass

    def draw_footer(self, c, active, top):
        pass

    def draw_client(self, c, active):
        c.fill(cp(CP_WINDOW))
        items = self.rows()
        hr = self.header_rows()
        vis = max(1, self.visible_rows())
        self.sel = max(0, min(self.sel, max(0, len(items) - 1)))
        if self.sel < self.scroll:
            self.scroll = self.sel
        if self.sel >= self.scroll + vis:
            self.scroll = self.sel - vis + 1
        self.scroll = max(0, min(self.scroll, max(0, len(items) - vis)))
        self.draw_header(c, active)
        need_sb = len(items) > vis
        body_w = c.w - (1 if need_sb else 0)
        for i in range(vis):
            ri = self.scroll + i
            if ri >= len(items):
                break
            sel = (ri == self.sel)
            txt = self.row_text(ri, items[ri])
            a = self.row_attr(ri, items[ri], sel, active)
            line = f'{txt:<{max(0, body_w)}}'[:max(0, body_w)]
            c.put(hr + i, 0, line, a)
        if need_sb:
            c.scrollbar(hr, c.w - 1, vis, len(items), vis, self.scroll, cp(CP_SCROLL))
        self.draw_footer(c, active, hr + vis)

    def on_key(self, key):
        items = self.rows()
        vis = max(1, self.visible_rows())
        if key in (curses.KEY_UP, ord('k')):
            self.sel = max(0, self.sel - 1); return True
        if key in (curses.KEY_DOWN, ord('j')):
            self.sel = min(len(items) - 1, self.sel + 1); return True
        if key == curses.KEY_PPAGE:
            self.sel = max(0, self.sel - vis); return True
        if key == curses.KEY_NPAGE:
            self.sel = min(len(items) - 1, self.sel + vis); return True
        if key == curses.KEY_HOME:
            self.sel = 0; return True
        if key == curses.KEY_END:
            self.sel = max(0, len(items) - 1); return True
        if key in (curses.KEY_ENTER, 10, 13):
            if items:
                self.on_activate(self.sel, items[self.sel])
            return True
        return False

    def on_scroll(self, n):
        items = self.rows()
        vis = max(1, self.visible_rows())
        self.scroll = max(0, min(self.scroll + n * 2, max(0, len(items) - vis)))
        self.sel = max(self.scroll, min(self.sel, self.scroll + vis - 1))
        return True

    def on_click(self, row, col, btn):
        hr = self.header_rows()
        items = self.rows()
        idx = self.scroll + (row - hr)
        if hr <= row and 0 <= idx < len(items):
            double = (self.wm and self.wm.was_double(self, idx))
            self.sel = idx
            if double or btn == 3:
                self.on_activate(idx, items[idx])
            return True
        return False


