def run_real_terminal():
    print()
    print('=' * 68)
    print('  COS Terminal  --  real shell session')
    print('  Type "exit" or press Ctrl-D to return to COS.')
    print('=' * 68)
    print()
    shell = os.environ.get('SHELL', '/bin/bash')
    try:
        subprocess.run([shell])
    except Exception:
        try:
            subprocess.run(['/bin/sh'])
        except Exception as e:
            print(f'Could not launch a shell: {e}')
            time.sleep(2)
    print()
    print('=' * 68)
    print('  Returning to COS...')
    print('=' * 68)
    time.sleep(0.4)


def run_cos_setup():
    here = os.path.dirname(os.path.abspath(__file__))
    setup = os.path.join(here, 'cos_setup.py')
    if not os.path.exists(setup):
        setup = os.path.join(os.path.dirname(os.path.abspath(sys.argv[0])),
                             'cos_setup.py')
    if os.path.exists(setup):
        try:
            subprocess.run([sys.executable, setup])
        except Exception as e:
            print(f'cos_setup.py failed: {e}')
            time.sleep(2)
    else:
        print('\n  cos_setup.py not found next to this script.\n')
        time.sleep(2)


def power_action(what):
    def _run():
        print()
        print(f'  COS: {what}')
        for cmd in ([['systemctl', what]] if what != 'suspend'
                    else [['systemctl', 'suspend']]):
            full = (['sudo'] + cmd) if os.geteuid() != 0 else cmd
            print('  running: ' + ' '.join(full))
            try:
                r = subprocess.run(full)
                if r.returncode == 0:
                    return
                print(f'  exited {r.returncode}')
            except Exception as e:
                print(f'  {e}')
        print(f'\n  Could not {what}. Try from a root shell:  systemctl {what}')
        input('  Press ENTER to return to COS... ')
    return _run


