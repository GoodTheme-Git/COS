            print(f'  failed: {e}')
        print()
        input('  Press ENTER to return to COS... ')
    return _run


# The client COS serves to the other machine. It syncs by hash, so only
# files that actually changed come across the wire.
PULL_CLIENT = r"""#!/usr/bin/env python3
# COS Pigeon -- pull files from a COS machine, transferring only what changed.
# Usage:  curl -s %(base)s/pull | python3 - [destination]
import hashlib, json, os, sys, urllib.request

BASE = "%(base)s"

def sha(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for c in iter(lambda: f.read(262144), b''):
            h.update(c)
    return h.hexdigest()

def main():
    dest = os.path.abspath(sys.argv[1] if len(sys.argv) > 1 else '.')
    os.makedirs(dest, exist_ok=True)
    with urllib.request.urlopen(BASE + '/manifest.json', timeout=20) as r:
        man = json.load(r)
    files = man['files']
    print(f'{len(files)} file(s) on {man["host"]}:{man["root"]}')
    new = changed = same = 0
    for item in files:
        rel, size, digest = item['path'], item['size'], item['sha256']
        target = os.path.join(dest, rel.replace('/', os.sep))
        if os.path.exists(target):
            try:
                if digest and sha(target) == digest:
                    same += 1
                    continue
            except OSError:
                pass
            changed += 1
            tag = 'changed'
        else:
            new += 1
            tag = 'new'
        os.makedirs(os.path.dirname(target) or '.', exist_ok=True)
        url = BASE + '/' + urllib.request.quote(rel)
        print(f'  {tag:>7}  {rel}  ({size} bytes)')
        with urllib.request.urlopen(url, timeout=120) as r, open(target, 'wb') as f:
            while True:
                chunk = r.read(262144)
                if not chunk:
                    break
                f.write(chunk)
    print(f'done: {new} new, {changed} updated, {same} already current -> {dest}')

if __name__ == '__main__':
    main()
"""


class PigeonHandler(http.server.SimpleHTTPRequestHandler):
    """Read-only HTTP for one directory, with a token and a sync manifest."""

    server_version = f'COS-Pigeon/{VERSION}'
    token = ''
    share_root = '.'
    log_sink = None
    hits = None

    def __init__(self, *a, **kw):
        kw['directory'] = self.share_root
        super().__init__(*a, **kw)

    # -- plumbing ----------------------------------------------------------
    def log_message(self, fmt, *args):
        if self.log_sink is not None:
            self.log_sink.append(f'{self.address_string()}  {fmt % args}'[:200])
        if self.hits is not None:
            self.hits[0] += 1

    def _strip_token(self):
        """Return the path with the token prefix removed, or None if wrong."""
        path = self.path.split('?', 1)[0].split('#', 1)[0]
        if not self.token:
            return path
        prefix = '/' + self.token
        if path == prefix:
            return '/'
        if path.startswith(prefix + '/'):
            return path[len(prefix):]
        return None

    def _deny(self, code=404, why='Not found'):
        self.send_error(code, why)

    def do_POST(self):
        self._deny(405, 'This server is read-only')

    do_PUT = do_DELETE = do_PATCH = do_POST

    def do_GET(self):
        inner = self._strip_token()
        if inner is None:
            return self._deny(404, 'Not found')
        if hidden_path(urllib.parse.unquote(inner)):
            return self._deny(403, 'Hidden files are not served')
        if inner in ('/', ''):
            return self._send_index()
        if inner == '/manifest.json':
            return self._send_manifest()
        if inner in ('/pull', '/pull.py'):
            return self._send_client()
        self.path = inner
        return super().do_GET()

    def do_HEAD(self):
        inner = self._strip_token()
        if inner is None:
            return self._deny(404, 'Not found')
        if hidden_path(urllib.parse.unquote(inner)):
            return self._deny(403, 'Hidden files are not served')
        if inner in ('/', '', '/manifest.json', '/pull', '/pull.py'):
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.end_headers()
            return
        self.path = inner
        return super().do_HEAD()

    # -- responses ---------------------------------------------------------
    def _base_url(self):
        host = self.headers.get('Host') or f'{local_addresses()[0]}:{self.server.server_port}'
        return f'http://{host}' + (f'/{self.token}' if self.token else '')

    def _write(self, body, ctype='text/html; charset=utf-8'):
        raw = body.encode('utf-8', 'replace')
        self.send_response(200)
        self.send_header('Content-Type', ctype)
        self.send_header('Content-Length', str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def _send_manifest(self):
        files = file_manifest(self.share_root)
        doc = {
            'cos': VERSION,
            'host': platform.node(),
            'root': os.path.abspath(self.share_root),
            'generated': datetime.now().isoformat(timespec='seconds'),
            'files': [{'path': r, 'size': sz, 'mtime': mt, 'sha256': d}
                      for r, sz, mt, d in files],
        }
        self._write(json.dumps(doc, indent=1), 'application/json; charset=utf-8')

    def _send_client(self):
        self._write(PULL_CLIENT % {'base': self._base_url()},
                    'text/x-python; charset=utf-8')

    def _send_index(self):
        files = file_manifest(self.share_root)
        base = self._base_url()
        total = sum(f[1] for f in files)
        rows = []
        for rel, size, mtime, digest in files:
            when = datetime.fromtimestamp(mtime).strftime('%Y-%m-%d %H:%M')
            rows.append(
                f'<tr><td><a href="{base}/{urllib.parse.quote(rel)}">'
                f'{_html.escape(rel)}</a></td>'
                f'<td align="right">{size:,}</td><td>{when}</td>'
                f'<td><code>{digest[:12]}</code></td></tr>')
        body = f"""<!doctype html><html><head><meta charset="utf-8">
<title>COS Pigeon on {_html.escape(platform.node())}</title>
<style>body{{font:14px monospace;margin:2em;max-width:60em}}
table{{border-collapse:collapse;width:100%}}
td,th{{border-bottom:1px solid #ccc;padding:.25em .5em;text-align:left}}
pre{{background:#f4f4f4;padding:.75em;overflow-x:auto}}</style></head><body>
<h1>COS Pigeon</h1>
<p>{len(files)} file(s), {total:,} bytes, from
<code>{_html.escape(os.path.abspath(self.share_root))}</code>
on <code>{_html.escape(platform.node())}</code>.</p>
<h2>Sync everything (only what changed moves)</h2>
<pre>curl -s {base}/pull | python3 - ~/cos</pre>
<p>Or grab the whole lot once:</p>
<pre>wget -r -np -nH --cut-dirs=1 -R "index.html*" {base}/</pre>
<h2>Files</h2>
<table><tr><th>name</th><th>bytes</th><th>modified</th><th>sha256</th></tr>
{''.join(rows)}</table>
<p><a href="{base}/manifest.json">manifest.json</a> &middot;
<a href="{base}/pull">pull client</a></p>
</body></html>"""
        self._write(body)


class Pigeon:
    """A read-only HTTP server for one directory, on a background thread."""

    def __init__(self, root, port=SHARE_DEFAULT_PORT, use_token=True):
        self.root = os.path.abspath(os.path.expanduser(root))
        self.port = int(port)
        self.token = secrets.token_hex(4) if use_token else ''
        self.httpd = None
        self.thread = None
        self.error = ''
        self.log = deque(maxlen=200)
        self.hits = [0]
        self.started = 0.0

    @property
    def running(self):
        return self.httpd is not None

    def start(self):
        if self.running:
            return True
        if not os.path.isdir(self.root):
            self.error = f'not a directory: {self.root}'
            return False
        handler = type('BoundPigeonHandler', (PigeonHandler,), {
            'token': self.token, 'share_root': self.root,
            'log_sink': self.log, 'hits': self.hits})
        try:
            socketserver.ThreadingTCPServer.allow_reuse_address = True
            self.httpd = socketserver.ThreadingTCPServer(('0.0.0.0', self.port),
                                                         handler)
            self.httpd.daemon_threads = True
        except OSError as e:
            self.httpd = None
            self.error = f'cannot listen on {self.port}: {e}'
            return False
        self.error = ''
        self.started = time.monotonic()
        self.thread = threading.Thread(target=self.httpd.serve_forever,
                                       kwargs={'poll_interval': 0.3},
                                       daemon=True, name='cos-pigeon')
        self.thread.start()
        self.log.append(f'serving {self.root} on port {self.port}')
        return True

    def stop(self):
        if self.httpd:
            try:
                self.httpd.shutdown()
                self.httpd.server_close()
            except Exception:
                pass
        self.httpd = None
        if self.thread:
            self.thread.join(timeout=1.0)
        self.thread = None

    def urls(self):
        suffix = f'/{self.token}' if self.token else ''
        return [f'http://{ip}:{self.port}{suffix}' for ip in local_addresses()]

    def pull_command(self, dest='~/cos'):
        return f'curl -s {self.urls()[0]}/pull | python3 - {dest}'


# =============================================================================
# CONSOLE / VT CONTROL  --  so a graphical player can own the screen
# =============================================================================
KDGETMODE = 0x4B3B
KDSETMODE = 0x4B3A
KD_TEXT = 0x00
KD_GRAPHICS = 0x01


def _console_fd():
    """A writable fd on this process's own virtual console."""
    cands = ['/dev/tty']
    vt = os.environ.get('XDG_VTNR', '')
    if vt.isdigit():
        cands.append(f'/dev/tty{vt}')
    for dev in cands:
        try:
            return os.open(dev, os.O_RDWR | os.O_NOCTTY)
        except OSError:
            continue
    return None


def console_mode():
    """KD_TEXT or KD_GRAPHICS for the current console, or None."""
    fd = _console_fd()
    if fd is None:
        return None
    try:
        buf = fcntl.ioctl(fd, KDGETMODE, struct.pack('i', 0))
        return struct.unpack('i', buf)[0]
    except OSError:
        return None
    finally:
        os.close(fd)


def set_console_graphics(on):
    """Hand the screen to a DRM/KMS client, or take it back.

    A bare console sits in KD_TEXT, where fbcon owns the scanout. A KMSDRM
    client (which is what SDL -- and therefore ffplay -- uses on a TTY) then
    becomes DRM master and flips its own buffer, but nothing reaches the
    screen until something forces a modeset: switching VT away and back is
    the usual accidental cure. Putting the console in KD_GRAPHICS first is
    what X, Wayland compositors and mpv's drm output all do, and it makes the
    picture appear immediately.
    """
    fd = _console_fd()
    if fd is None:
        return False
    try:
        fcntl.ioctl(fd, KDSETMODE, KD_GRAPHICS if on else KD_TEXT)
        return True
    except OSError:
        return False
    finally:
        os.close(fd)


class ConsoleGraphics:
    """Context manager that is paranoid about restoring text mode.

    Being left in KD_GRAPHICS means a black console, so restoration is
    wired to the normal exit path, to atexit, and to the signals that would
    otherwise kill us mid-playback.
    """

    SIGNALS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)

    def __init__(self, enable=True):
        self.enable = enable
        self.entered = False
        self.restored = False
        self._old = {}

    def restore(self, *_a):
        if self.entered and not self.restored:
            self.restored = True
            set_console_graphics(False)

    def __enter__(self):
        if not self.enable:
            return self
        atexit.register(self.restore)
        for sig in self.SIGNALS:
            try:
                self._old[sig] = signal.getsignal(sig)
                signal.signal(sig, self._on_signal)
            except (ValueError, OSError):
                pass
        self.entered = set_console_graphics(True)
        if not self.entered:
            self._unhook()
        return self

    def _on_signal(self, signum, frame):
        self.restore()
        old = self._old.get(signum)
        if callable(old):
            try:
                old(signum, frame)
                return
            except Exception:
                pass
        raise KeyboardInterrupt

    def _unhook(self):
        for sig, old in self._old.items():
            try:
                signal.signal(sig, old)
            except (ValueError, OSError):
                pass
        self._old.clear()
        try:
            atexit.unregister(self.restore)
        except Exception:
            pass

    def __exit__(self, *exc):
        self.restore()
        self._unhook()
        return False


def sdl_env():
    """Environment for an SDL player on this display, or lack of one."""
    env = dict(os.environ)
    if not (env.get('DISPLAY') or env.get('WAYLAND_DISPLAY')):
        # In a TTY the only usable SDL backend here is KMSDRM; naming it
        # skips two failed probes (x11, wayland) and avoids SDL quietly
        # settling on a dummy driver that renders nothing.
        env.setdefault('SDL_VIDEODRIVER', 'kmsdrm')
    return env


CONSOLE_FONT_DIR = '/usr/share/consolefonts'


def console_fonts(limit=24):
    """Installed console fonts, smallest cell first.

    A smaller console font means more character cells, which is the most
    direct way to give AsciiPic and AsciiVid more resolution.
    """
    import re as _re
    out = []
    try:
        names = os.listdir(CONSOLE_FONT_DIR)
    except OSError:
        return out
    seen = set()
    for n in names:
        if not n.startswith(('Lat15-', 'Lat2-', 'Uni1-', 'Uni2-', 'ter-')):
            continue
        stem = n.split('.')[0]
        if stem in seen:
            continue
        mm = _re.search(r'(\d+)x(\d+)$', stem)
        if mm:
            h, w = int(mm.group(1)), int(mm.group(2))
        else:
            mm = _re.search(r'(\d+)$', stem)
            if not mm:
                continue
            h, w = int(mm.group(1)), 8
        if h > 40 or w > 20:
            continue
        seen.add(stem)
        out.append((h * w, stem, w, h))
    # one entry per cell size: Lat15 covers western European text, and the
    # Lat2/Uni variants of the same size add nothing for our purposes
    out.sort(key=lambda t: (t[0], 0 if t[1].startswith('Lat15') else 1, t[1]))
    best = {}
    for _area, stem, w, h in out:
        best.setdefault((w, h), (stem, w, h))
    return sorted(best.values(), key=lambda t: t[1] * t[2])[:limit]


def set_console_font(name):
    """Return a callable that runs setfont on the bare console."""
    def _run():
        print()
        print('=' * 68)
        print('  COS -- console font')
        print('=' * 68)
        print()
        if not _which('setfont'):
            print('  setfont is not installed (apt install kbd)')
            time.sleep(2)
            return
        cmd = ['setfont'] if not name else ['setfont', name]
        print('  running: ' + ' '.join(cmd))
        print()
        try:
            r = subprocess.run(cmd)
        except Exception as e:
            print(f'  failed: {e}')
            time.sleep(2)
            return
        if r.returncode != 0:
            print()
            print('  setfont failed. Loading a console font usually needs')
            print('  CAP_SYS_TTY_CONFIG, so try it with sudo:')
            print('      sudo ' + ' '.join(cmd))
            print()
            try:
                ans = input('  Run it with sudo now? [y/N] ').strip().lower()
            except (EOFError, KeyboardInterrupt):
                ans = 'n'
            if ans.startswith('y'):
                try:
                    r = subprocess.run(['sudo'] + cmd)
                except Exception as e:
                    print(f'  {e}')
        if r.returncode == 0:
            print()
            print('  Font set. COS will pick up the new size on the next')
            print('  redraw -- more cells means more picture resolution.')
            time.sleep(1.2)
        else:
            print(f'  exited {r.returncode}')
            time.sleep(2)
    return _run


def ffplay_available():
    return bool(_which('ffplay'))


def ffplay_session(paths, state, still=False, note=''):
    """Return a callable that plays `paths` with ffplay on the bare console.

    Meant to be handed to WindowManager.request_shell, which drops curses
    first and puts it back afterwards.
    """
    if isinstance(paths, str):
        paths = [paths]
    paths = list(paths)

    def _run():
        if not ffplay_available():
            print('\n  ffplay is not installed.\n')
            time.sleep(2)
            return
        graphics = bool(state.get('ffplay_graphics_mode', True))
        env = sdl_env()
        vol = int(max(0, min(100, state.get('druman_volume', 80))))
        before = console_mode()
        print()
        print('=' * 68)
        print('  COS -- ffplay' + (f'  ({note})' if note else ''))
        print('=' * 68)
        for pth in paths[:4]:
            print(f'  {os.path.basename(pth)}')
        if len(paths) > 4:
            print(f'  ... and {len(paths) - 4} more')
        print()
        print('  q or ESC quits.  SPACE pauses.  arrows seek.')
        print(f'  SDL driver: {env.get("SDL_VIDEODRIVER", "auto")}'
              f'   console: {"graphics" if graphics else "text (no mode change)"}')
        if not graphics:
            print('  NOTE: with the console left in text mode you may have to')
            print('        switch VT away and back before the picture appears.')
        print()
        time.sleep(0.7)
        with ConsoleGraphics(graphics):
            for pth in paths:
                cmd = ['ffplay', '-hide_banner', '-loglevel', 'error',
                       '-volume', str(vol)]
                if state.get('ffplay_fullscreen', True):
                    cmd.append('-fs')
                if not still:
                    cmd.append('-autoexit')
                if SILENT:
                    cmd.append('-an')
                cmd.append(pth)
                try:
                    subprocess.run(cmd, env=env)
                except Exception as e:
                    print(f'  ffplay failed: {e}')
                    time.sleep(1.5)
                    break
        # make sure the console really is back in text mode
        after = console_mode()
        if after == KD_GRAPHICS:
            set_console_graphics(False)
        sys.stdout.write('\033[H\033[2J')
        sys.stdout.flush()
        if before is None and graphics:
            print('  (could not read the console mode; if the screen stayed')
            print('   blank, run:  sudo chvt 1 && sudo chvt '
                  f'{os.environ.get("XDG_VTNR", "3")})')
            time.sleep(2)
    return _run


# =============================================================================
# DESKTOP RENDERING  --  BETA: paint the desktop as pixels instead of cells
# =============================================================================
# Text mode is everything above: curses draws character cells and fbcon puts
# them on the panel. That is COS's native way to work and it always wins on
# compatibility.
#
# Graphics mode presents the same desktop as actual pixels. COS takes the
# console into KD_GRAPHICS so fbcon stops painting, becomes DRM master on the
# card, allocates a dumb buffer at the panel's preferred mode, and blits every
# cell itself out of a console font. Nothing above this line changes: windows
# still draw into curses exactly as before, and this reads the composed screen
# back and presents it. That is the whole point -- it is a presentation layer,
# not a second UI.
#
# What it buys: 24-bit colour instead of the console's eight, glyphs at the
# panel's real resolution, and a path for a window to hand over a rectangle of
# true pixels (see Window.pixel_rect) so a photograph is a photograph rather
# than 8160 character cells pretending to be one.
#
# It is BETA because taking the console and the CRTC is the one thing in COS
# that can leave a black screen if it goes wrong. Every failure path restores
# text mode, and ~/cos/desk_rendr_info.txt documents the recovery.

DRM_DEVICES = ('/dev/dri/card0', '/dev/dri/card1', '/dev/dri/card2')
DRM_IOCTL_BASE = 0x64


def _drm_iowr(nr, size):
    return (3 << 30) | (size << 16) | (DRM_IOCTL_BASE << 8) | nr


def _drm_io(nr):
    return (DRM_IOCTL_BASE << 8) | nr


DRM_SET_MASTER   = _drm_io(0x1e)
DRM_DROP_MASTER  = _drm_io(0x1f)
DRM_GET_CAP      = _drm_iowr(0x0c, 16)
DRM_MODE_RES     = _drm_iowr(0xA0, 64)
DRM_MODE_GETCRTC = _drm_iowr(0xA1, 104)
DRM_MODE_SETCRTC = _drm_iowr(0xA2, 104)
DRM_MODE_GETCONN = _drm_iowr(0xA7, 80)
DRM_MODE_ADDFB   = _drm_iowr(0xAE, 28)
DRM_MODE_RMFB    = _drm_iowr(0xAF, 4)
DRM_MODE_CREATE_DUMB  = _drm_iowr(0xB2, 32)
DRM_MODE_MAP_DUMB     = _drm_iowr(0xB3, 16)
DRM_MODE_DESTROY_DUMB = _drm_iowr(0xB4, 4)

DRM_CAP_DUMB_BUFFER = 1
DRM_MODE_CONNECTED = 1
DRM_MODE_TYPE_PREFERRED = 0x8
MODEINFO_FMT = '<I10H3I32s'
MODEINFO_SIZE = 68


class DrmDisplay:
    """A dumb-buffer framebuffer on the first connected display.

    Deliberately small: find a connected connector, take its preferred mode,
    allocate one buffer, point the CRTC at it, and hand out the mapping. No
    page flipping -- the scanout reads the buffer live, so a frame can tear,
    which on a desktop made of text is not worth a second buffer and a
    vblank wait for.
    """

    def __init__(self, path=None):
        self.path = path
        self.fd = -1
        self.width = 0
        self.height = 0
        self.pitch = 0
        self.size = 0
        self.handle = 0
        self.fb_id = 0
        self.crtc_id = 0
        self.conn_id = 0
        self.mode = b''
        self.mode_name = ''
        self.refresh = 0
        self.mm = None
        self.master = False
        self.saved_crtc = None
        self.error = ''

    # -- probing ----------------------------------------------------------
    @staticmethod
    def candidates():
        out = []
        try:
            for n in sorted(os.listdir('/dev/dri')):
                if n.startswith('card'):
                    out.append('/dev/dri/' + n)
        except OSError:
            out = [p for p in DRM_DEVICES if os.path.exists(p)]
        return out

    @classmethod
    def probe(cls):
        """(ok, note) without changing anything on screen."""
        cands = cls.candidates()
        if not cands:
            return False, 'no /dev/dri/card* device -- no KMS driver loaded'
        notes = []
        for path in cands:
            try:
                fd = os.open(path, os.O_RDWR | os.O_CLOEXEC)
            except OSError as e:
                notes.append('%s: %s' % (os.path.basename(path), e.strerror))
                continue
            try:
                buf = bytearray(struct.pack('QQ', DRM_CAP_DUMB_BUFFER, 0))
                fcntl.ioctl(fd, DRM_GET_CAP, buf, True)
                if not struct.unpack('QQ', bytes(buf))[1]:
                    notes.append('%s: no dumb buffers' % os.path.basename(path))
                    continue
                d = cls(path)
                d.fd = fd
                conn = d._find_connector()
                if not conn:
                    notes.append('%s: nothing connected' % os.path.basename(path))
                    continue
                return True, ('%s: %s %dx%d' % (os.path.basename(path),
                                                conn['name'], conn['w'], conn['h']))
            except OSError as e:
                notes.append('%s: %s' % (os.path.basename(path), e))
            finally:
                os.close(fd)
        return False, '; '.join(notes) or 'no usable DRM device'

    # -- connector / mode --------------------------------------------------
    CONN_TYPES = {1: 'VGA', 2: 'DVI-I', 3: 'DVI-D', 4: 'DVI-A', 5: 'Composite',
                  6: 'S-Video', 7: 'LVDS', 8: 'Component', 9: 'DIN', 10: 'DP',
                  11: 'HDMI-A', 12: 'HDMI-B', 13: 'TV', 14: 'eDP',
                  15: 'Virtual', 16: 'DSI', 17: 'DPI', 18: 'Writeback'}

    def _resources(self):
        buf = bytearray(64)
        fcntl.ioctl(self.fd, DRM_MODE_RES, buf, True)
        f = struct.unpack('QQQQ8I', bytes(buf))
        ncrtc, nconn = f[5], f[6]
        crtcs = (ctypes.c_uint32 * max(1, ncrtc))()
        conns = (ctypes.c_uint32 * max(1, nconn))()
        buf = bytearray(struct.pack('QQQQ8I', 0, ctypes.addressof(crtcs),
                                    ctypes.addressof(conns), 0,
                                    0, ncrtc, nconn, 0, 0, 0, 0, 0))
        fcntl.ioctl(self.fd, DRM_MODE_RES, buf, True)
        return list(crtcs)[:ncrtc], list(conns)[:nconn]

    def _connector(self, cid):
        buf = bytearray(struct.pack('<QQQQ12I', 0, 0, 0, 0,
                                    0, 0, 0, 0, cid, 0, 0, 0, 0, 0, 0, 0))
        fcntl.ioctl(self.fd, DRM_MODE_GETCONN, buf, True)
        v = struct.unpack('<QQQQ12I', bytes(buf))
        nmodes = v[4]
        if not nmodes:
            return None
        raw = bytearray(MODEINFO_SIZE * nmodes)
        cbuf = (ctypes.c_char * len(raw)).from_buffer(raw)
        buf = bytearray(struct.pack('<QQQQ12I', 0, ctypes.addressof(cbuf), 0, 0,
                                    nmodes, 0, 0, 0, cid, 0, 0, 0, 0, 0, 0, 0))
        fcntl.ioctl(self.fd, DRM_MODE_GETCONN, buf, True)
        v = struct.unpack('<QQQQ12I', bytes(buf))
        if v[11] != DRM_MODE_CONNECTED:
            return None
        best = None
        for i in range(v[4]):
            blob = bytes(raw[i * MODEINFO_SIZE:(i + 1) * MODEINFO_SIZE])
            m = struct.unpack(MODEINFO_FMT, blob)
            score = (1 if m[12] & DRM_MODE_TYPE_PREFERRED else 0,
                     m[1] * m[6], m[13])
            if best is None or score > best[0]:
                best = (score, blob, m)
        if best is None:
            return None
        _s, blob, m = best
        return {'id': cid, 'encoder': v[7], 'blob': blob,
                'w': m[1], 'h': m[6], 'refresh': m[13],
                'mode_name': m[14].split(b'\0')[0].decode('ascii', 'replace'),
                'mm_w': v[12], 'mm_h': v[13],
                'name': '%s-%d' % (self.CONN_TYPES.get(v[9], '?'), v[10])}

    def _find_connector(self):
        _crtcs, conns = self._resources()
        for cid in conns:
            try:
                c = self._connector(cid)
            except OSError:
                continue
            if c:
                return c
        return None

    def _crtc_for(self, conn):
        """The CRTC already driving this connector, else the first free one."""
        crtcs, _ = self._resources()
        for crid in crtcs:
            buf = bytearray(104)
            struct.pack_into('<QIIIIIII', buf, 0, 0, 0, crid, 0, 0, 0, 0, 0)
            try:
                fcntl.ioctl(self.fd, DRM_MODE_GETCRTC, buf, True)
            except OSError:
                continue
            v = struct.unpack('<QIIIIIII', bytes(buf[:36]))
            if v[7]:                               # mode_valid: it is lit
                return crid, bytes(buf)
        return (crtcs[0], None) if crtcs else (0, None)

    # -- lifecycle ---------------------------------------------------------
    def open(self):
        for path in ([self.path] if self.path else self.candidates()):
            try:
                fd = os.open(path, os.O_RDWR | os.O_CLOEXEC)
            except OSError as e:
                self.error = '%s: %s' % (path, e.strerror)
                continue
            self.fd = fd
            self.path = path
            try:
                conn = self._find_connector()
            except OSError as e:
                conn = None
                self.error = '%s: %s' % (path, e)
            if not conn:
                os.close(fd)
                self.fd = -1
                self.error = self.error or ('%s: nothing connected' % path)
                continue
            self.conn_id = conn['id']
            self.width, self.height = conn['w'], conn['h']
            self.mode = conn['blob']
            self.mode_name = conn['mode_name']
            self.refresh = conn['refresh']
            self.crtc_id, self.saved_crtc = self._crtc_for(conn)
            if not self.crtc_id:
                os.close(fd)
                self.fd = -1
                self.error = '%s: no CRTC available' % path
                continue
            return True
        return False

    def create_buffer(self):
        buf = bytearray(struct.pack('<IIIIIIQ', self.height, self.width,
                                    32, 0, 0, 0, 0))
        fcntl.ioctl(self.fd, DRM_MODE_CREATE_DUMB, buf, True)
        v = struct.unpack('<IIIIIIQ', bytes(buf))
        self.handle, self.pitch, self.size = v[4], v[5], v[6]
        buf = bytearray(struct.pack('<IIQ', self.handle, 0, 0))
        fcntl.ioctl(self.fd, DRM_MODE_MAP_DUMB, buf, True)
        offset = struct.unpack('<IIQ', bytes(buf))[2]
        self.mm = mmap.mmap(self.fd, self.size, mmap.MAP_SHARED,
                            mmap.PROT_READ | mmap.PROT_WRITE, offset=offset)
        buf = bytearray(struct.pack('<7I', 0, self.width, self.height,
                                    self.pitch, 32, 24, self.handle))
        fcntl.ioctl(self.fd, DRM_MODE_ADDFB, buf, True)
        self.fb_id = struct.unpack('<7I', bytes(buf))[0]
        return True

    def set_master(self):
        try:
            fcntl.ioctl(self.fd, DRM_SET_MASTER, 0)
            self.master = True
            return True
        except OSError as e:
            self.error = 'cannot become DRM master: %s' % e.strerror
            return False

    def show(self):
        """Point the CRTC at our buffer. This is the moment the screen changes."""
        conns = (ctypes.c_uint32 * 1)(self.conn_id)
        buf = bytearray(104)
        struct.pack_into('<QIIIIIII', buf, 0, ctypes.addressof(conns), 1,
                         self.crtc_id, self.fb_id, 0, 0, 0, 1)
        buf[36:104] = self.mode
        fcntl.ioctl(self.fd, DRM_MODE_SETCRTC, buf, True)
        return True

    def restore(self):
        """Give the screen back, in the order that cannot strand it."""
        if self.fd < 0:
            return
        try:
            if self.saved_crtc is not None and self.master:
                v = struct.unpack('<QIIIIIII', bytes(self.saved_crtc[:36]))
                conns = (ctypes.c_uint32 * 1)(self.conn_id)
                buf = bytearray(self.saved_crtc)
                struct.pack_into('<QIIIIIII', buf, 0, ctypes.addressof(conns),
                                 1, v[2], v[3], v[4], v[5], v[6], v[7])
                fcntl.ioctl(self.fd, DRM_MODE_SETCRTC, buf, True)
        except OSError:
            pass
        try:
            if self.mm:
                self.mm.close()
        except Exception:
            pass
        self.mm = None
        for call, arg in ((DRM_MODE_RMFB, self.fb_id),
                          (DRM_MODE_DESTROY_DUMB, self.handle)):
            if arg:
                try:
                    fcntl.ioctl(self.fd, call, struct.pack('<I', arg), True)
                except OSError:
                    pass
        self.fb_id = self.handle = 0
        if self.master:
            try:
                fcntl.ioctl(self.fd, DRM_DROP_MASTER, 0)
            except OSError:
                pass
            self.master = False
        try:
            os.close(self.fd)
        except OSError:
            pass
        self.fd = -1


# -- glyphs -------------------------------------------------------------------
PSF1_MAGIC = b'\x36\x04'
PSF2_MAGIC = b'\x72\xb5\x4a\x86'


def load_psf(path):
    """Parse a PSF1 or PSF2 console font into per-row bitmasks."""
    opener = gzip.open if path.endswith('.gz') else open
    with opener(path, 'rb') as f:
        data = f.read()
    if data[:2] == PSF1_MAGIC:
        mode, charsize = data[2], data[3]
        count = 512 if (mode & 1) else 256
        w, h, body, stride = 8, charsize, data[4:], charsize
    elif data[:4] == PSF2_MAGIC:
        (_m, _v, hdr, _fl, count, charsize, h, w) = struct.unpack('<8I', data[:32])
        body, stride = data[hdr:], charsize
    else:
        raise ValueError('not a PSF console font')
    if not (0 < w <= 32 and 0 < h <= 64):
        raise ValueError('implausible glyph size %dx%d' % (w, h))
    rowbytes = (w + 7) // 8
    shift = rowbytes * 8 - w
    glyphs = []
    for i in range(count):
        g = body[i * stride:(i + 1) * stride]
        rows = []
        for y in range(h):
            v = 0
            for b in range(rowbytes):
                k = y * rowbytes + b
                v = (v << 8) | (g[k] if k < len(g) else 0)
            rows.append(v >> shift)
        glyphs.append(rows)
    return {'w': w, 'h': h, 'count': count, 'glyphs': glyphs,
            'name': os.path.basename(path).split('.')[0]}


def find_psf(stem=''):
    """Locate a console font file, preferring the one COS is configured for."""
    names = []
    if stem:
        names += [stem + '.psf.gz', stem + '.psf', stem + '.psfu.gz']
    names += ['Lat15-VGA16.psf.gz', 'Lat15-Terminus16.psf.gz',
              'Lat15-Fixed16.psf.gz', 'Uni2-VGA16.psf.gz',
              'Lat15-VGA8.psf.gz']
    for n in names:
        p = os.path.join(CONSOLE_FONT_DIR, n)
        if os.path.isfile(p):
            return p
    try:
        for n in sorted(os.listdir(CONSOLE_FONT_DIR)):
            if n.startswith('Lat15-') and n.endswith(('.psf.gz', '.psf')):
                return os.path.join(CONSOLE_FONT_DIR, n)
    except OSError:
        pass
    return None


# The console's 16 colours as the Linux VT actually renders them. Bold turns
# the foreground into the bright half of the pair, which is why there are 16
# entries for 8 curses colours.
VT_PALETTE = [
    (0x00, 0x00, 0x00), (0xaa, 0x00, 0x00), (0x00, 0xaa, 0x00),
    (0xaa, 0x55, 0x00), (0x00, 0x00, 0xaa), (0xaa, 0x00, 0xaa),
    (0x00, 0xaa, 0xaa), (0xaa, 0xaa, 0xaa),
    (0x55, 0x55, 0x55), (0xff, 0x55, 0x55), (0x55, 0xff, 0x55),
    (0xff, 0xff, 0x55), (0x55, 0x55, 0xff), (0xff, 0x55, 0xff),
    (0x55, 0xff, 0xff), (0xff, 0xff, 0xff),
]

# VT100 line-drawing codes, which is what curses ACS_* characters arrive as
# once A_ALTCHARSET is set. Drawing them as pixel primitives beats hunting for
# a glyph: a Latin-1 console font has no box-drawing characters at all, and
# the result is crisper than any 8x16 bitmap of them.
#   arms: which of (north, south, west, east) to draw
ACS_ARMS = {
    'l': (0, 1, 0, 1), 'k': (0, 1, 1, 0), 'm': (1, 0, 0, 1), 'j': (1, 0, 1, 0),
    't': (1, 1, 0, 1), 'u': (1, 1, 1, 0), 'v': (1, 0, 1, 1), 'w': (0, 1, 1, 1),
    'n': (1, 1, 1, 1), 'q': (0, 0, 1, 1), 'x': (1, 1, 0, 0),
}
ACS_FILL = {'a': 0.5, 'h': 0.5, '0': 1.0}      # checkerboard, board, block
ACS_ASCII = {'`': '+', 'f': 'o', 'g': '#', '~': '*', ',': '<', '+': '>',
             '.': 'v', '-': '^', 'i': '#', 'o': '-', 's': '_', 'p': '-',
             'r': '-', 'y': '<', 'z': '>', '{': 'p', '|': '!', '}': 'f'}


class GlyphCache:
    """Pre-rendered cell bitmaps, one list of packed pixel rows per cell.

    A cell is drawn perhaps thousands of times a session with the same glyph
    and the same two colours, so the pixels are built once and afterwards a
    cell costs h slice assignments into the framebuffer and nothing else.
    """

    MAX = 4096

    def __init__(self, font):
        self.font = font
        self.w = font['w']
        self.h = font['h']
        self.count = font['count']
        self.cache = {}
        self.blank = {}

    def clear(self):
        self.cache.clear()
        self.blank.clear()

    def solid(self, rgb):
        row = self.blank.get(rgb)
        if row is None:
            row = bytes((rgb[2], rgb[1], rgb[0], 0)) * self.w
            if len(self.blank) < 256:
                self.blank[rgb] = row
        return row

    def cell(self, code, alt, fg, bg):
        key = (code, alt, fg, bg)
        hit = self.cache.get(key)
        if hit is not None:
            return hit
        if len(self.cache) >= self.MAX:
            self.cache.clear()
        w, h = self.w, self.h
        f = bytes((fg[2], fg[1], fg[0], 0))
        b = bytes((bg[2], bg[1], bg[0], 0))
        rows = None
        if alt:
            ch = chr(code)
            if ch in ACS_ARMS:
                rows = self._arms(ACS_ARMS[ch], f, b)
            elif ch in ACS_FILL:
                rows = self._fill(ACS_FILL[ch], f, b)
            else:
                code = ord(ACS_ASCII.get(ch, '?'))
        if rows is None:
            glyph = (self.font['glyphs'][code] if code < self.count
                     else self.font['glyphs'][ord('?')])
            rows = []
            for y in range(h):
                bits = glyph[y]
                rows.append(b''.join(
                    f if bits & (1 << (w - 1 - x)) else b for x in range(w)))
        out = tuple(rows)
        self.cache[key] = out
        return out

    def _arms(self, arms, f, b):
        """A box-drawing cell: arms from the centre to the edges."""
        w, h = self.w, self.h
        n, s, west, east = arms
        midx, midy = w // 2, h // 2
        thick = 2 if h >= 16 else 1
        rows = []
        for y in range(h):
            on_h = (midy <= y < midy + thick) and (west or east)
            cells = []
            for x in range(w):
                on_v = (midx <= x < midx + thick) and (n or s)
                lit = False
                if on_h and ((west and x < midx + thick) or (east and x >= midx)):
                    lit = True
                if on_v and ((n and y < midy + thick) or (s and y >= midy)):
                    lit = True
                cells.append(f if lit else b)
            rows.append(b''.join(cells))
        return rows

    def _fill(self, level, f, b):
        w, h = self.w, self.h
        rows = []
        for y in range(h):
            if level >= 1.0:
                rows.append(f * w)
            else:
                rows.append(b''.join(
                    f if ((x + y) & 1) == 0 else b for x in range(w)))
        return rows


# -- the way back out ---------------------------------------------------------
# Graphics mode is the one feature in COS that can leave nothing on screen:
# it holds both the console and the CRTC. Two things guard that.
#
# The marker file is written just before the mode set and removed once the
# desktop has been up for a few seconds. Finding it at startup means the last
# attempt did not survive, so COS starts in text mode and says so instead of
# walking into the same wall again.
#
# The watchdog is a plain timer thread. If the mode set returns but nothing
# is actually visible, no keystroke will ever arrive to undo it, so the timer
# puts text mode back by itself unless the main loop keeps saying it is alive.
GDR_MARKER = os.path.join(COS_HOME, 'gdr-attempt')
GDR_WATCHDOG_SECONDS = 20
COS_RENDER_ENV = 'COS_RENDER_ACTIVE'


def tty_number():
    """The VT number COS is on, for 'Ctrl+Alt+F<n>' advice. None if not a VT."""
    try:
        name = os.ttyname(0) if os.isatty(0) else ''
    except OSError:
        return None
    m = re.match(r'/dev/tty(\d+)$', name) if name else None
    return int(m.group(1)) if m else None


def gdr_marker_write(note):
    try:
        os.makedirs(COS_HOME, exist_ok=True)
        with open(GDR_MARKER, 'w') as f:
            f.write('%s\n%s\n' % (time.strftime('%Y-%m-%d %H:%M:%S'), note))
        return True
    except OSError:
        return False


def gdr_marker_clear():
    try:
        os.remove(GDR_MARKER)
    except OSError:
        pass


def gdr_marker_read():
    try:
        with open(GDR_MARKER) as f:
            return f.read().strip()
    except OSError:
        return ''


class GdrWatchdog:
    """Restores text mode unless the main loop keeps petting it.

    Nothing clever: a thread that waits, and if it was not told the desktop
    is alive, calls the restore function. The point is that it does not need
    the screen, the keyboard, or the main loop to be working.
    """

    def __init__(self, seconds, on_timeout):
        self.seconds = seconds
        self.on_timeout = on_timeout
        self.pet = threading.Event()
        self.done = threading.Event()
        self.fired = False
        self.thread = None

    def start(self):
        self.thread = threading.Thread(target=self._run, daemon=True,
                                       name='cos-gdr-watchdog')
        self.thread.start()

    def _run(self):
        if self.pet.wait(self.seconds):
            return
        if self.done.is_set():
            return
        self.fired = True
        try:
            self.on_timeout()
        except Exception:
            pass

    def alive(self):
        """The desktop drew a frame and took a keystroke: stand down."""
        self.pet.set()

    def cancel(self):
        self.done.set()
        self.pet.set()


DESK_RENDER_DOC = os.path.expanduser('~/cos/desk_rendr_info.txt')


def desktop_render_notes():
    """The (i) text: the document on disk, or a built-in summary."""
    for path in (DESK_RENDER_DOC,
                 os.path.join(os.path.dirname(os.path.abspath(__file__)),
                              'desk_rendr_info.txt')):
        try:
            with open(path, encoding='utf-8', errors='replace') as f:
                body = f.read().replace('\t', '    ').rstrip().split('\n')
            return ['  ' + ln.rstrip() for ln in body] + \
                   ['', '  -- read from ' + path]
        except OSError:
            continue
    return [
        '', '  DESKTOP RENDERING (BETA)', '',
        '  Text mode     curses draws character cells and the kernel',
        '                console puts them on the panel. This is how COS',
        '                has always worked and it always works.',
        '',
        '  Graphics mode COS takes the console and the display controller',
        '                and paints the same desktop as pixels: 24-bit',
        '                colour instead of eight, and windows can hand over',
        '                real pixels instead of character cells.',
        '',
        '  Changing this restarts COS. If the screen goes black, COS puts',
        '  text mode back by itself after %d seconds; Ctrl+Alt+F1 and back',
        '  gets you out by hand.',
        '',
        '  (The fuller notes live in ~/cos/desk_rendr_info.txt, which is',
        '  missing right now.)',
    ]


class GraphicsDesktop:
    """Presents the composed curses screen as pixels on a DRM framebuffer.

    Nothing else in COS knows this exists. Windows draw into curses as they
    always have; this reads the finished screen back with inch() and paints
    it. Only the cells that actually changed are repainted, which is what
    makes it fast enough to be usable: a desktop at rest changes the clock
    and the pointer and nothing else.
    """

    def __init__(self, state):
        self.state = state
        self.drm = None
        self.console = None
        self.font = None
        self.glyphs = None
        self.active = False
        self.status = 'off'
        self.error = ''
        self.cols = 0
        self.rows = 0
        self.ox = 0
        self.oy = 0
        self.prev = []
        self.frames = 0
        self.full_redraws = 0
        self.last_ms = 0.0
        self.overlays = []
        self._ov_cache = []

    # -- capability --------------------------------------------------------
    @staticmethod
    def probe(state=None):
        notes = []
        ok, note = DrmDisplay.probe()
        notes.append('DRM: ' + note)
        if not ok:
            return False, notes
        path = find_psf((state or {}).get('console_font', ''))
        if not path:
            notes.append('font: no PSF console font in ' + CONSOLE_FONT_DIR)
            return False, notes
        try:
            f = load_psf(path)
        except Exception as e:
            notes.append('font: %s: %s' % (os.path.basename(path), e))
            return False, notes
        notes.append('font: %s %dx%d' % (f['name'], f['w'], f['h']))
        if _console_fd() is None:
            notes.append('console: not a real VT -- KD_GRAPHICS unavailable')
            return False, notes
        notes.append('console: can take KD_GRAPHICS')
        return True, notes

    # -- lifecycle ---------------------------------------------------------
    def start(self):
        if self.active:
            return True
        self.error = ''
        path = find_psf(self.state.get('console_font', ''))
        if not path:
            self.error = 'no PSF console font found in ' + CONSOLE_FONT_DIR
            self.status = self.error
            return False
        try:
            self.font = load_psf(path)
        except Exception as e:
            self.error = 'font %s: %s' % (os.path.basename(path), e)
            self.status = self.error
            return False
        self.glyphs = GlyphCache(self.font)
        self.drm = DrmDisplay()
        if not self.drm.open():
            self.error = self.drm.error or 'no usable DRM device'
            self.status = self.error
            self.drm = None
            return False
        # The console has to go first: fbcon must stop painting before the
        # CRTC changes hands, or it fights us for the scanout.
        self.console = ConsoleGraphics(True)
        self.console.__enter__()
        if not self.console.entered:
            self._teardown()
            self.error = 'could not put the console in KD_GRAPHICS'
            self.status = self.error
            return False
        try:
            if not self.drm.set_master():
                raise OSError(self.drm.error)
            self.drm.create_buffer()
            self.drm.show()
        except OSError as e:
            self._teardown()
            self.error = str(e)
            self.status = 'mode set failed: %s' % e
            return False
        self.cols = self.drm.width // self.font['w']
        self.rows = self.drm.height // self.font['h']
        self.ox = (self.drm.width - self.cols * self.font['w']) // 2
        self.oy = (self.drm.height - self.rows * self.font['h']) // 2
        self.prev = []
        self.active = True
        # os.execve and a hard exit both skip everything else; atexit is the
        # last thing that still runs, and a black screen is the cost of
        # missing it.
        atexit.register(self.stop)
        global _LAST_GFX
        _LAST_GFX = self
        self.status = ('%s %dx%d @%dHz -> %dx%d cells, %s %dx%d'
                       % (os.path.basename(self.drm.path), self.drm.width,
                          self.drm.height, self.drm.refresh, self.cols,
                          self.rows, self.font['name'],
                          self.font['w'], self.font['h']))
        return True

    def _teardown(self):
        if self.drm:
            self.drm.restore()
            self.drm = None
        if self.console:
            # __exit__, not restore(): it also puts the signal handlers and
            # the atexit hook back, and graphics mode can be stopped and
            # started several times in one session.
            self.console.__exit__(None, None, None)
            self.console = None

    def stop(self):
        if not (self.active or self.drm or self.console):
            return
        self._teardown()
        self.active = False
        self.prev = []
        self.status = 'off'

    # -- painting ----------------------------------------------------------
    @staticmethod
    def rgb_for(pair, bold, rev):
        try:
            fg, bg = curses.pair_content(pair)
        except (curses.error, ValueError):
            fg, bg = 7, 0
        if fg < 0: fg = 7
        if bg < 0: bg = 0
        if rev:
            fg, bg = bg, fg
        if bold and fg < 8:
            fg += 8
        return VT_PALETTE[fg & 15], VT_PALETTE[bg & 15]

    def read_screen(self, scr):
        """The composed screen as (code, altcharset, pair, bold, reverse)."""
        rows = []
        h, w = scr.getmaxyx()
        h = min(h, self.rows)
        w = min(w, self.cols)
        inch = scr.inch
        A_CHARTEXT = curses.A_CHARTEXT
        A_ALTCHARSET = curses.A_ALTCHARSET
        A_BOLD = curses.A_BOLD
        A_REVERSE = curses.A_REVERSE
        PAIR = curses.A_COLOR
        for y in range(h):
            row = []
            for x in range(w):
                v = inch(y, x)
                row.append((v & A_CHARTEXT,
                            1 if v & A_ALTCHARSET else 0,
                            (v & PAIR) >> 8,
                            1 if v & A_BOLD else 0,
                            1 if v & A_REVERSE else 0))
            rows.append(row)
        return rows

    def present(self, scr, force=False):
        """Blit the screen. Only changed cells are touched."""
        if not self.active or not self.drm or not self.drm.mm:
            return False
        t0 = time.monotonic()
        cells = self.read_screen(scr)
        mm = self.drm.mm
        pitch = self.drm.pitch
        fw, fh = self.font['w'], self.font['h']
        cellbytes = fw * 4
        prev = self.prev
        full = force or len(prev) != len(cells)
        if full:
            self.full_redraws += 1
            self._clear()
            prev = [[None] * self.cols for _ in range(len(cells))]
        glyph = self.glyphs.cell
        ox4 = self.ox * 4
        touched = 0
        # Cells a pixel overlay is about to cover are not worth drawing: the
        # overlay lands on top of them in the same frame. They are marked
        # unknown so they come back the moment the overlay moves or goes.
        covered = self._covered_cells()
        for y, row in enumerate(cells):
            prow = prev[y] if y < len(prev) else [None] * len(row)
            if len(prow) < len(row):
                prow = prow + [None] * (len(row) - len(prow))
            base = (self.oy + y * fh) * pitch + ox4
            yc = covered.get(y)
            for x, cell in enumerate(row):
                if yc and yc[0] <= x < yc[1]:
                    prow[x] = None
                    continue
                if cell == prow[x]:
                    continue
                prow[x] = cell
                code, alt, pair, bold, rev = cell
                fg, bg = self.rgb_for(pair, bold, rev)
                bits = glyph(code, alt, fg, bg)
                off = base + x * cellbytes
                for i in range(fh):
                    o = off + i * pitch
                    mm[o:o + cellbytes] = bits[i]
                touched += 1
            if y < len(prev):
                prev[y] = prow
        self.prev = prev
        for ov in self.overlays:
            self._blit_rgb(*ov)
        self.overlays = []
        self._covered = {}
        self.frames += 1
        self.last_ms = (time.monotonic() - t0) * 1000.0
        return touched or full

    def _covered_cells(self):
        """{row: (first_col, last_col+1)} for the pending pixel overlays."""
        out = {}
        if not self.overlays:
            return out
        fw, fh = self.font['w'], self.font['h']
        for col, row, w, h, _rgb in self.overlays:
            c1 = col + (w + fw - 1) // fw
            r1 = row + (h + fh - 1) // fh
            for r in range(max(0, row), min(self.rows, r1)):
                lo, hi = out.get(r, (10 ** 9, -1))
                out[r] = (min(lo, max(0, col)), max(hi, min(self.cols, c1)))
        return {r: v for r, v in out.items() if v[1] > v[0]}

    def _clear(self, rgb=(0, 0, 0)):
        mm = self.drm.mm
        line = bytes((rgb[2], rgb[1], rgb[0], 0)) * self.drm.width
        pitch = self.drm.pitch
        for y in range(self.drm.height):
            o = y * pitch
            mm[o:o + len(line)] = line

    def blit_pixels(self, col, row, w, h, rgb):
        """Queue a true-pixel rectangle, placed on the cell grid.

        `rgb` is w*h*3 bytes. This is the escape hatch from character cells:
        a window that has real pixels (a photograph, a video frame) hands
        them over and they land at the panel's resolution instead of being
        squeezed into a 1120-tone approximation.
        """
        self.overlays.append((col, row, w, h, rgb))

    @staticmethod
    def rgb_to_bgrx(rgb, count):
        """Pack RGB24 into the framebuffer's BGRX8888, without a Python loop.

        Extended-slice assignment on a bytearray runs in C, so three of them
        convert a megapixel in a few milliseconds. The obvious per-pixel loop
        takes most of a second and makes the whole idea unusable.
        """
        out = bytearray(count * 4)
        out[0::4] = rgb[2:count * 3:3]      # blue
        out[1::4] = rgb[1:count * 3:3]      # green
        out[2::4] = rgb[0:count * 3:3]      # red
        return bytes(out)

    def _packed(self, rgb, w, h):
        """Converted pixels for this exact buffer, cached by identity.

        A window hands back the same bytes object frame after frame while
        nothing about the picture changes, so `is` is all the cache key this
        needs and it costs nothing to check.
        """
        for obj, wh, packed in self._ov_cache:
            if obj is rgb and wh == (w, h):
                return packed
        packed = self.rgb_to_bgrx(rgb, w * h)
        self._ov_cache = ([(rgb, (w, h), packed)] + self._ov_cache)[:2]
        return packed

    def _blit_rgb(self, col, row, w, h, rgb):
        if not (self.drm and self.drm.mm) or w <= 0 or h <= 0:
            return
        fw, fh = self.font['w'], self.font['h']
        x0 = self.ox + col * fw
        y0 = self.oy + row * fh
        if x0 < 0 or y0 < 0 or len(rgb) < w * h * 3:
            return
        packed = self._packed(rgb, w, h)
        vis_w = min(w, self.drm.width - x0)
        vis_h = min(h, self.drm.height - y0)
        if vis_w <= 0 or vis_h <= 0:
            return
        mm = self.drm.mm
        pitch = self.drm.pitch
        srcpitch = w * 4
        n = vis_w * 4
        for y in range(vis_h):
            src = y * srcpitch
            o = (y0 + y) * pitch + x0 * 4
            mm[o:o + n] = packed[src:src + n]
        # the overlay is not in the cell model, so force those cells next frame
        c0, r0 = col, row
        c1 = min(self.cols, col + (w + fw - 1) // fw)
        r1 = min(self.rows, row + (h + fh - 1) // fh)
        for yy in range(r0, min(r1, len(self.prev))):
            for xx in range(c0, min(c1, len(self.prev[yy]))):
                self.prev[yy][xx] = None


