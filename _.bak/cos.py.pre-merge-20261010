    def status(self):
        return self.msg or ('LEFT/RIGHT change   ENTER toggle/run   '
                            'settings save on close')

    def row_text(self, i, item):
        kind, label, key, extra = item
        if kind == 'head':
            return f' -- {label} ' + '-' * 40
        if kind == 'action':
            return f'   [ {label} ]'
        val = self.state.get(key)
        if kind == 'bool':
            show = '[X]' if val else '[ ]'
            return f'   {show} {label}'
        if kind == 'choice':
            if not extra:
                cur = str(val)
            elif key in STRING_CHOICES:
                cur = choice_label(key, val if val in extra else extra[0])
            else:
                cur = extra[int(val) % len(extra)]
            return f'   {label:<32} < {cur} >'
        if kind == 'int':
            return f'   {label:<32} < {val} >'
        if kind == 'float':
            return f'   {label:<32} < {float(val or 0):.1f} >'
        return f'   {label}'

    def row_attr(self, i, item, selected, active):
        if item[0] == 'head':
            return cp(CP_BRIGHT, bold=True)
        if selected:
            return cp(CP_SEL, bold=True) if active else cp(CP_MENU_SEL)
        if item[0] == 'action':
            return cp(CP_GREEN)
        return cp(CP_TEXT)

    def _skip(self, d):
        while 0 <= self.sel < len(self.defs) and self.defs[self.sel][0] == 'head':
            self.sel += d
        self.sel = max(0, min(self.sel, len(self.defs) - 1))
        if self.defs[self.sel][0] == 'head':
            self.sel = max(0, min(self.sel - d, len(self.defs) - 1))

    def adjust(self, delta):
        kind, label, key, extra = self.defs[self.sel]
        if kind == 'bool':
            self.state[key] = not self.state.get(key)
        elif kind == 'choice':
            if not extra:
                return
            if key in STRING_CHOICES:
                cur = self.state.get(key, extra[0])
                i = extra.index(cur) if cur in extra else 0
                self.state[key] = extra[(i + delta) % len(extra)]
            else:
                self.state[key] = (int(self.state.get(key, 0)) + delta) % len(extra)
        elif kind == 'int':
            lo, hi, step = extra
            # Hand-tuning the pointer means the user wants their number kept.
            if key in ('pointer_speed', 'scroll_speed'):
                self.state['pointer_auto_speed'] = False
            self.state[key] = max(lo, min(hi, int(self.state.get(key, lo))
                                          + delta * step))
        elif kind == 'float':
            lo, hi, step = extra
            self.state[key] = round(max(lo, min(hi, float(
                self.state.get(key, lo) or lo) + delta * step)), 2)
        else:
            return
        self.apply(key)

    def apply(self, key):
        if key == 'desktop_render':
            # The renderer is chosen once, while COS is starting: it owns the
            # console and the CRTC from then on, and swapping those underneath
            # a running desktop is exactly the kind of half-state that leaves
            # a black screen. So the switch is a restart, deliberately.
            self._ask_render_restart()
        elif key == 'theme_idx':
            apply_theme(int(self.state['theme_idx']))
        elif key == 'wallpaper_idx':
            pass
        elif key in ('pointer_on', 'pointer_speed', 'scroll_speed',
                     'pointer_auto_speed'):
            if key == 'pointer_on':
                if self.state['pointer_on']:
                    self.ptr.restart()
                else:
                    self.ptr.stop()
            else:
                self.ptr.calibrate()
                self.msg = self.ptr.calib_note
        elif key == 'sound_on' and self.state['sound_on']:
            self.snd.play('click')
        elif key in ('sound_volume',):
            self.snd.play('key')
        elif key == 'druman_volume':
            pass            # applies to Druman's player, not the system mixer
        self.msg = ''

    def _ask_render_restart(self):
        want = self.state.get('desktop_render', 'text')
        active = os.environ.get(COS_RENDER_ENV, 'text')
        if want == active:
            # arrowed back to what is already running: nothing to restart for
            self.msg = 'Already running in %s.' % RENDER_LABELS.get(want, want)
            save_config(self.state)
            return
        if want == 'graphics':
            ok, notes = GraphicsDesktop.probe(self.state)
            if not ok:
                self.state['desktop_render'] = active
                save_config(self.state)
                self.msg = 'Graphics mode cannot run here: ' + '; '.join(notes)
                if self.wm:
                    self.wm.open(NoticeWindow(
                        'Graphics mode unavailable',
                        'COS checked before switching, and graphics mode\n'
                        'cannot run on this machine:\n\n  '
                        + '\n  '.join(notes)
                        + '\n\nThe setting has been put back to Text mode.',
                        kind='warn'))
                return
            body = ('COS has to restart to change how the desktop is drawn.\n'
                    '\n'
                    'Graphics mode takes the console and the display\n'
                    'controller, so it can only be set up while COS is\n'
                    'starting -- not underneath a running desktop.\n'
                    '\n'
                    'It is BETA. If the screen goes black, COS puts text\n'
                    'mode back by itself within %d seconds, and\n'
                    'Ctrl+Alt+F1 then Ctrl+Alt+F%s gets you out by hand.\n'
                    '\n'
                    'Settings are saved first. Open windows are lost.\n'
                    '\n'
                    'Restart into graphics mode now?'
                    % (GDR_WATCHDOG_SECONDS, tty_number() or 'n'))
            yes = 'Restart'
        else:
            body = ('COS has to restart to change how the desktop is drawn.\n'
                    '\n'
                    'Settings are saved first. Open windows are lost.\n'
                    '\n'
                    'Restart into text mode now?')
            yes = 'Restart'
        if not self.wm:
            # No way to ask, so no way to agree: leave the setting alone
            # rather than arranging a surprise for the next restart.
            self._revert_render()
            return
        self.wm.open(ConfirmWindow(
            'Desktop rendering', body,
            on_yes=lambda: self.wm.request_shell(_do_restart(self.state),
                                                 'restart'),
            on_no=self._revert_render,
            yes=yes, no='Not yet', danger=(want == 'graphics')))

    def _revert_render(self):
        """Said no to the restart, so the setting must not silently stick."""
        cur = os.environ.get(COS_RENDER_ENV, 'text')
        self.state['desktop_render'] = cur
        save_config(self.state)
        self.msg = 'Left on %s until the next restart.' % RENDER_LABELS.get(
            cur, cur)

    def run_action(self, key):
        if key == 'render_info':
            if self.wm:
                self.wm.open(TextWindow('Desktop Rendering -- BETA',
                                        desktop_render_notes(), w=88))
        elif key == 'render_probe':
            ok, notes = GraphicsDesktop.probe(self.state)
            if self.wm:
                self.wm.open(TextWindow(
                    'Graphics mode: ' + ('available' if ok else 'not available'),
                    ['', '  ' + ('Graphics mode should work on this machine.'
                                 if ok else
                                 'Graphics mode cannot run here. Text mode is'
                                 ' unaffected.'), '']
                    + ['  ' + n for n in notes]
                    + ['', '  Nothing was changed by this check.'], w=74))
        elif key == 'set_password':
            if self.wm:
                self.wm.open(PromptWindow(
                    'Login password',
                    'New password (blank cancels):', '', self._set_password))
        elif key == 'clear_password':
            if self.wm:
                self.wm.open(ConfirmWindow(
                    'Clear the password',
                    'Remove the login password?\n'
                    '\n'
                    'The startup screen will then let anyone straight in.',
                    on_yes=self._clear_password, yes='Clear', no='Keep'))
        elif key == 'apply_font':
            name = self.state.get('console_font', '')
            if self.wm:
                self.wm.request_shell(set_console_font(name),
                                      'setfont ' + (name or '(default)'))
        elif key == 'res_report':
            if self.wm:
                self.wm.open(TextWindow('Resolution', resolution_report(
                    self.state, self.wm), w=72))
        elif key == 'sysvol':
            # Deliberately a prompt rather than a +/- row: nothing should be
            # able to walk the machine's master volume with arrow keys.
            cur = get_system_volume()
            if self.wm:
                self.wm.open(PromptWindow(
                    'System Volume',
                    f'Master volume percent (currently '
                    f'{cur if cur is not None else "unknown"}):',
                    str(cur if cur is not None else 50), self._set_sysvol))
        elif key == 'test_sound':
            self.msg = f'Backend: {self.snd.backend or "none"} -- {self.snd.note}'
            for i, name in enumerate(['boot', 'click', 'notify', 'error']):
                self.snd.play(name)
                time.sleep(0.18)
        elif key == 'resynth':
            ok = self.snd.ensure_sounds(force=True)
            self.snd.pick_backend()
            self.msg = ('Re-synthesized built-in sounds. ' + self.snd.note) if ok \
                else self.snd.note
        elif key == 'trackpad':
            if self.wm:
                self.wm.open(TrackpadSetup(self.state, self.ptr))
        elif key == 'desktop':
            if self.wm:
                self.wm.open(DesktopSettings(self.state))
        elif key == 'save':
            self.msg = f'Saved to {COS_CONFIG}' if save_config(self.state) \
                else 'Save failed'
            self.snd.play('drop')
        elif key == 'reset':
            if self.wm:
                self.wm.open(ConfirmWindow(
                    'Reset Settings',
                    ['Reset every COS setting to its default?', '',
                     'Your music folders and bookmarks are kept.'],
                    self._reset, danger=True))

    def _set_password(self, text):
        text = text.strip()
        if not text:
            self.msg = 'Cancelled; the password is unchanged'
            return
        salt, digest = hash_password(text)
        self.state['login_salt'] = salt
        self.state['login_hash'] = digest
        self.state['login_enabled'] = True
        if not self.state.get('login_user'):
            self.state['login_user'] = os.environ.get('USER', 'operator')
        save_config(self.state)
        self.success('Password set',
                     ['COS will ask for it at startup.', '',
                      'It is stored as a PBKDF2 hash, not as the password,',
                      'but this is a screen lock for the look of the thing --',
                      'not real protection. Anyone who can edit',
                      '  ' + COS_CONFIG,
                      'can switch it off, so do not rely on it.', '',
                      'Forgotten it? Set login_enabled to false in that file.'])

    def _clear_password(self):
        self.state['login_salt'] = ''
        self.state['login_hash'] = ''
        self.state['login_enabled'] = False
        save_config(self.state)
        self.msg = 'Password cleared and the login screen switched off'

    def _set_sysvol(self, text):
        try:
            pct = int(float(text.strip().rstrip('%')))
        except ValueError:
            self.msg = 'Not a number'
            return
        used = set_system_volume(pct)
        self.msg = (f'System volume set to {max(0, min(100, pct))}% via {used}'
                    if used else 'No mixer control found (amixer/wpctl/pactl)')

    def _reset(self):
        keep = self.state.get('druman_dirs', [])
        for k, v in DEFAULTS.items():
            self.state[k] = v.copy() if isinstance(v, list) else v
        self.state['druman_dirs'] = keep
        apply_theme(0)
        save_config(self.state)
        self.msg = 'Settings reset to defaults.'

    def on_key(self, key):
        if key == curses.KEY_UP:
            self.sel = max(0, self.sel - 1); self._skip(-1); return True
        if key == curses.KEY_DOWN:
            self.sel = min(len(self.defs) - 1, self.sel + 1); self._skip(1); return True
        if key == curses.KEY_LEFT:
            self.adjust(-1); return True
        if key == curses.KEY_RIGHT:
            self.adjust(+1); return True
        if key in (curses.KEY_ENTER, 10, 13, ord(' ')):
            kind, label, k, extra = self.defs[self.sel]
            if kind == 'action':
                self.run_action(k)
            elif kind == 'bool':
                self.adjust(1)
            else:
                self.adjust(1)
            return True
        return super().on_key(key)

    def on_click(self, row, col, btn):
        idx = self.scroll + row
        if 0 <= idx < len(self.defs) and self.defs[idx][0] != 'head':
            self.sel = idx
            kind = self.defs[idx][0]
            if kind == 'action':
                self.run_action(self.defs[idx][2])
            elif kind == 'bool':
                self.adjust(1)
            else:
                self.adjust(1 if col > self.cw // 2 else -1)
            return True
        return False

    def on_close(self):
        save_config(self.state)


