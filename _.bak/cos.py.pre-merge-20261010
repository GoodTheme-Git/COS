class TextWindow(Window):
    """Scrollable read-only text panel."""
    icon = 'i'

    def __init__(self, title, lines, w=None, h=None, attrs=None):
        self.lines = [str(l) for l in lines]
        longest = max((len(l) for l in self.lines), default=20)
        w = w or min(max(longest + 4, 30), 96)
        h = h or min(len(self.lines) + 3, 24)
        super().__init__(title, w, h)
        self.attrs = attrs or {}

    def status(self):
        return f'{len(self.lines)} lines  UP/DN/PgUp/PgDn  ^W=close'

    def set_lines(self, lines):
        self.lines = [str(l) for l in lines]
        self.scroll = min(self.scroll, max(0, len(self.lines) - 1))

    def draw_client(self, c, active):
        c.fill(cp(CP_WINDOW))
        vis = c.h
        self.scroll = max(0, min(self.scroll, max(0, len(self.lines) - vis)))
        need_sb = len(self.lines) > vis
        for i in range(vis):
            ri = self.scroll + i
            if ri >= len(self.lines):
                break
            a = self.attrs.get(ri, cp(CP_TEXT))
            c.put(i, 1, self.lines[ri][:c.w - 2 - (1 if need_sb else 0)], a)
        if need_sb:
            c.scrollbar(0, c.w - 1, vis, len(self.lines), vis, self.scroll,
                        cp(CP_SCROLL))

    def on_key(self, key):
        vis = self.chh
        if key == curses.KEY_UP:
            self.scroll = max(0, self.scroll - 1); return True
        if key == curses.KEY_DOWN:
            self.scroll = min(max(0, len(self.lines) - vis), self.scroll + 1); return True
        if key == curses.KEY_PPAGE:
            self.scroll = max(0, self.scroll - vis); return True
        if key == curses.KEY_NPAGE:
            self.scroll = min(max(0, len(self.lines) - vis), self.scroll + vis); return True
        if key == curses.KEY_HOME:
            self.scroll = 0; return True
        if key == curses.KEY_END:
            self.scroll = max(0, len(self.lines) - vis); return True
        return False

    def on_scroll(self, n):
        self.scroll = max(0, min(self.scroll + n * 3,
                                 max(0, len(self.lines) - self.chh)))
        return True


class PromptWindow(Window):
    """Single-line text input with a callback."""
    icon = '?'
    resizable = False
    want_cursor = True
    min_h = 7

    def __init__(self, title, label, default='', on_ok=None, w=56):
        super().__init__(title, w, 8)
        self.label = label
        self.buf = default
        self.on_ok = on_ok
        # The default starts out "selected": the first thing you type replaces
        # it, the way an address bar works. Arrow keys keep it instead.
        self.fresh = bool(default)
        self.hint = 'ENTER=accept   ESC=cancel   typing replaces the default'

    def status(self):
        return self.hint

    def draw_client(self, c, active):
        c.fill(cp(CP_WINDOW))
        c.put(1, 2, self.label[:c.w - 4], cp(CP_BRIGHT, bold=True))
        fieldw = c.w - 6
        c.put(3, 2, ' ' * fieldw, cp(CP_INPUT))
        shown = self.buf[-(fieldw - 1):]
        c.put(3, 2, shown, cp(CP_SEL, bold=True) if self.fresh
              else cp(CP_INPUT, bold=True))
        self.caret = (3, min(c.w - 1, 2 + len(shown)))

    def on_key(self, key):
        if key in (curses.KEY_ENTER, 10, 13):
            val = self.buf
            cb = self.on_ok
            if self.wm:
                self.wm.close(self)
            if cb:
                cb(val)
            return True
        if key == 27:
            if self.wm:
                self.wm.close(self)
            return True
        if key in (curses.KEY_BACKSPACE, 127, 8):
            self.buf = '' if self.fresh else self.buf[:-1]
            self.fresh = False
            return True
        if key == 21:
            self.buf = ''
            self.fresh = False
            return True
        if key in (curses.KEY_LEFT, curses.KEY_RIGHT, curses.KEY_END,
                   curses.KEY_HOME):
            self.fresh = False          # keep the default and edit it
            return True
        if 32 <= key <= 126:
            self.buf = chr(key) if self.fresh else self.buf + chr(key)
            self.fresh = False
            return True
        return False


class NoticeWindow(Window):
    """A message with an icon, an accent bar and one OK button.

    Four flavours so the shape of the message is readable before the text
    is: information, warning, error, success.
    """

    icon = 'i'
    resizable = False
    min_h = 8

    KINDS = {
        'info':  ('(i)', CP_BRIGHT, 'notify'),
        'warn':  ('(!)', CP_WARN,   'warn'),
        'error': ('(X)', CP_WARN,   'error'),
        'ok':    ('(+)', CP_GREEN,  'drop'),
    }

    def __init__(self, title, body, kind='info', on_ok=None, w=None):
        lines = body.split('\n') if isinstance(body, str) else [str(l) for l in body]
        self.lines = lines or ['']
        self.kind = kind if kind in self.KINDS else 'info'
        longest = max((len(l) for l in self.lines), default=20)
        width = w or min(max(longest + 12, 36), 74)
        super().__init__(title, width, min(len(self.lines) + 7, 22))
        self.on_ok = on_ok
        self.scroll = 0
        self._sounded = False

    def status(self):
        extra = '  UP/DN to scroll' if len(self.lines) > self.chh - 3 else ''
        return f'ENTER or ESC closes{extra}'

    def tick(self):
        if not self._sounded:
            self._sounded = True
            self.play(self.KINDS[self.kind][2])

    def draw_client(self, c, active):
        c.fill(cp(CP_WINDOW))
        glyph, colour, _snd = self.KINDS[self.kind]
        # accent bar down the left so the flavour reads at a glance
        for r in range(c.h - 2):
            c.put(r, 0, ' ', cp(colour, rev=True))
        c.put(1, 2, glyph, cp(colour, bold=True))
        body_x = 6
        vis = max(1, c.h - 3)
        self.scroll = max(0, min(self.scroll, max(0, len(self.lines) - vis)))
        for i in range(vis):
            ri = self.scroll + i
            if ri >= len(self.lines):
                break
            c.put(1 + i, body_x, self.lines[ri][:max(0, c.w - body_x - 1)],
                  cp(CP_TEXT))
        if len(self.lines) > vis:
            c.scrollbar(1, c.w - 1, vis, len(self.lines), vis, self.scroll,
                        cp(CP_SCROLL))
        label = '  OK  '
        bx = max(2, (c.w - len(label)) // 2)
        c.put(c.h - 1, bx, label, cp(CP_SEL, bold=True))
        self._btn = (c.h - 1, bx, len(label))

    def _close(self):
        cb = self.on_ok
        if self.wm:
            self.wm.close(self)
        if cb:
            cb()

    def on_key(self, key):
        if key in (curses.KEY_ENTER, 10, 13, 27, ord(' ')):
            self._close(); return True
        if key == curses.KEY_UP:
            self.scroll = max(0, self.scroll - 1); return True
        if key == curses.KEY_DOWN:
            self.scroll += 1; return True
        if key == curses.KEY_PPAGE:
            self.scroll = max(0, self.scroll - self.chh); return True
        if key == curses.KEY_NPAGE:
            self.scroll += self.chh; return True
        return False

    def on_click(self, row, col, btn):
        r, bx, bw = getattr(self, '_btn', (-1, 0, 0))
        if row == r and bx <= col < bx + bw:
            self._close()
        return True

    def on_scroll(self, n):
        self.scroll = max(0, self.scroll + n)
        return True


class Progress:
    """The handle a worker thread uses to report progress.

    Everything here is safe to call from another thread; the window only
    ever reads these values while drawing.
    """

    def __init__(self, win):
        self._win = win

    @property
    def cancelled(self):
        return self._win.cancelled

    def set(self, done, label=None):
        self._win.set(done, label)

    def advance(self, n=1, label=None):
        self._win.advance(n, label)

    def label(self, text):
        self._win.set(None, text)

    def total(self, n):
        with self._win.lock:
            self._win.total_units = max(0, int(n))


class ProgressWindow(Window):
    """A loading bar. Determinate when a total is known, marquee when not.

    A worker callable can be handed in and is run on its own thread with a
    Progress handle, so an app does not have to manage threading to show
    something moving.
    """

    icon = '=';
    resizable = False
    min_w, min_h = 38, 9

    def __init__(self, title, label='Working...', total=0, worker=None,
                 cancellable=True, on_done=None):
        super().__init__(title, 58, 10)
        self.lock = threading.Lock()
        self.total_units = max(0, int(total or 0))
        self.done_units = 0
        self.label_text = label
        self.cancellable = cancellable
        self.cancelled = False
        self.finished = False
        self.failed = ''
        self.result = None
        self.on_done = on_done
        self.started = time.monotonic()
        self.ended = 0.0
        self.phase = 0
        self._worker = worker
        self._thread = None
        self._closing_at = 0.0
        if worker:
            self._thread = threading.Thread(target=self._run, daemon=True,
                                            name='cos-progress')
            self._thread.start()

    # -- worker side --------------------------------------------------------
    def _run(self):
        try:
            self.result = self._worker(Progress(self))
        except Exception as e:
            self.fail(f'{type(e).__name__}: {e}')
            return
        if not self.finished:
            self.finish()

    def set(self, done, label=None):
        with self.lock:
            if done is not None:
                self.done_units = max(0, int(done))
            if label is not None:
                self.label_text = str(label)

    def advance(self, n=1, label=None):
        with self.lock:
            self.done_units += int(n)
            if label is not None:
                self.label_text = str(label)

    def finish(self, msg=None):
        with self.lock:
            self.finished = True
            self.ended = time.monotonic()
            if msg:
                self.label_text = str(msg)
            if self.total_units:
                self.done_units = self.total_units

    def fail(self, msg):
        with self.lock:
            self.finished = True
            self.failed = str(msg)
            self.ended = time.monotonic()

    # -- window side --------------------------------------------------------
    @property
    def fraction(self):
        with self.lock:
            if not self.total_units:
                return None
            return max(0.0, min(1.0, self.done_units / self.total_units))

    def status(self):
        if self.failed:
            return 'failed -- ENTER closes'
        if self.finished:
            return 'done -- ENTER closes'
        return ('ESC cancels' if self.cancellable else 'working...')

    def tick(self):
        if not self.finished:
            self.phase = (self.phase + 1) % 1000
        elif self._closing_at and time.monotonic() >= self._closing_at:
            self._close()

    def draw_client(self, c, active):
        c.fill(cp(CP_WINDOW))
        with self.lock:
            label = self.label_text
            done, total = self.done_units, self.total_units
            failed, finished = self.failed, self.finished
        colour = CP_WARN if failed else (CP_GREEN if finished else CP_BRIGHT)
        c.put(1, 2, (failed or label)[:c.w - 4], cp(colour, bold=True))
        bw = max(10, c.w - 6)
        frac = (done / total) if total else None
        if failed:
            c.bar(3, 2, bw, 1.0, cp(CP_WARN), cp(CP_SHADOW))
        elif frac is not None:
            c.bar(3, 2, bw, max(0.0, min(1.0, frac)),
                  cp(CP_METER, bold=True), cp(CP_SHADOW))
        else:
            # marquee: a block sliding back and forth while the length is
            # unknown, so the window still shows that something is happening
            span = max(4, bw // 5)
            travel = max(1, bw - span)
            pos = self.phase % (travel * 2)
            if pos > travel:
                pos = travel * 2 - pos
            for i in range(bw):
                inside = pos <= i < pos + span
                c.ch(3, 2 + i,
                     curses.ACS_CKBOARD if inside else '-',
                     cp(CP_METER, bold=True) if inside else cp(CP_SHADOW))
        el = (self.ended or time.monotonic()) - self.started
        if total:
            pct = f'{(frac or 0) * 100:5.1f}%'
            rate = done / el if el > 0.3 else 0
            eta = ((total - done) / rate) if (rate > 0 and done < total) else 0
            detail = (f'{done:,} / {total:,}   {pct}   {human_time(el)} elapsed'
                      + (f'   ETA {human_time(eta)}' if eta and not finished else ''))
        else:
            detail = f'{done:,} done   {human_time(el)} elapsed' if done \
                     else f'{human_time(el)} elapsed'
        c.put(5, 2, detail[:c.w - 4], cp(CP_TEXT))
        if finished or failed:
            label2 = '  OK  '
            bx = max(2, (c.w - len(label2)) // 2)
            c.put(c.h - 1, bx, label2, cp(CP_SEL, bold=True))
            self._btn = (c.h - 1, bx, len(label2))
        elif self.cancellable:
            label2 = ' Cancel '
            bx = max(2, (c.w - len(label2)) // 2)
            c.put(c.h - 1, bx, label2, cp(CP_MENU_SEL))
            self._btn = (c.h - 1, bx, len(label2))
        else:
            self._btn = (-1, 0, 0)

    def close_in(self, seconds):
        """Dismiss automatically a moment after finishing."""
        self._closing_at = time.monotonic() + seconds

    def _close(self):
        cb = self.on_done
        if self.wm:
            self.wm.close(self)
        if cb:
            cb(self)

    def on_key(self, key):
        if self.finished or self.failed:
            if key in (curses.KEY_ENTER, 10, 13, 27, ord(' ')):
                self._close()
            return True
        if key == 27 and self.cancellable:
            self.cancelled = True
            self.set(None, 'cancelling...')
            return True
        return True          # a modal bar swallows keys while it works

    def on_click(self, row, col, btn):
        r, bx, bw = getattr(self, '_btn', (-1, 0, 0))
        if row == r and bx <= col < bx + bw:
            if self.finished or self.failed:
                self._close()
            elif self.cancellable:
                self.cancelled = True
                self.set(None, 'cancelling...')
        return True

    def on_close(self):
        self.cancelled = True


class ConfirmWindow(Window):
    """A question box: icon, accent bar, and two answers.

    The same shape as NoticeWindow so a question reads as a question
    before the text is even parsed. Button labels are configurable, so
    this covers Yes/No, OK/Cancel and Continue/Abort without three
    near-identical classes.
    """

    icon = '?'
    resizable = False
    min_h = 9

    KINDS = {
        'question': ('(?)', CP_BRIGHT, 'menu'),
        'warn':     ('(!)', CP_WARN,   'warn'),
        'danger':   ('(!)', CP_WARN,   'warn'),
        'info':     ('(i)', CP_BRIGHT, 'notify'),
    }

    def __init__(self, title, body, on_yes=None, danger=False, kind=None,
                 yes='Yes', no='No', on_no=None, default_no=None):
        lines = (body.split('\n') if isinstance(body, str)
                 else [str(l) for l in body])
        self.lines = lines or ['']
        self.kind = kind if kind in self.KINDS else ('danger' if danger
                                                     else 'question')
        longest = max((len(l) for l in self.lines), default=20)
        width = min(max(longest + 12, 40), 74)
        super().__init__(title, width, min(len(self.lines) + 8, 22))
        self.on_yes = on_yes
        self.on_no = on_no
        self.danger = danger or self.kind == 'danger'
        self.yes_label = str(yes)
        self.no_label = str(no)
        # a dangerous question starts on the safe answer
        self.choice = 1 if (self.danger if default_no is None else default_no) else 0
        self.scroll = 0
        self._sounded = False

    def status(self):
        keys = '%s/%s' % (self.yes_label[:1].upper(), self.no_label[:1].upper())
        extra = '  UP/DN scrolls' if len(self.lines) > self.chh - 3 else ''
        return 'LEFT/RIGHT or %s   ENTER confirms   ESC cancels%s' % (keys, extra)

    def tick(self):
        if not self._sounded:
            self._sounded = True
            self.play(self.KINDS[self.kind][2])

    def draw_client(self, c, active):
        c.fill(cp(CP_WINDOW))
        glyph, colour, _snd = self.KINDS[self.kind]
        for r in range(c.h - 2):
            c.put(r, 0, ' ', cp(colour, rev=True))
        c.put(1, 2, glyph, cp(colour, bold=True))
        body_x = 6
        vis = max(1, c.h - 3)
        self.scroll = max(0, min(self.scroll, max(0, len(self.lines) - vis)))
        for i in range(vis):
            ri = self.scroll + i
            if ri >= len(self.lines):
                break
            a = (cp(colour, bold=True) if (self.danger and ri == 0)
                 else cp(CP_TEXT))
            c.put(1 + i, body_x, self.lines[ri][:max(0, c.w - body_x - 1)], a)
        if len(self.lines) > vis:
            c.scrollbar(1, c.w - 1, vis, len(self.lines), vis, self.scroll,
                        cp(CP_SCROLL))
        row = c.h - 1
        labels = [('  %s  ' % self.yes_label, 0), ('  %s  ' % self.no_label, 1)]
        total = sum(len(l) for l, _ in labels) + 4
        col = max(2, (c.w - total) // 2)
        self._btns = []
        for lbl, idx in labels:
            a = cp(CP_SEL, bold=True) if self.choice == idx else cp(CP_MENU_SEL)
            c.put(row, col, lbl, a)
            self._btns.append((row, col, len(lbl), idx))
            col += len(lbl) + 4

    def _answer(self, yes):
        cb = self.on_yes if yes else self.on_no
        if self.wm:
            self.wm.close(self)
        if cb:
            cb()

    def on_key(self, key):
        if key in (curses.KEY_LEFT, curses.KEY_RIGHT, 9):
            self.choice = 1 - self.choice; return True
        yk = self.yes_label[:1].lower()
        nk = self.no_label[:1].lower()
        if key < 256 and chr(key).lower() == yk:
            self.choice = 0; self._answer(True); return True
        if key < 256 and chr(key).lower() == nk:
            self.choice = 1; self._answer(False); return True
        if key == 27:
            self._answer(False); return True
        if key in (curses.KEY_ENTER, 10, 13, ord(' ')):
            self._answer(self.choice == 0); return True
        if key == curses.KEY_UP:
            self.scroll = max(0, self.scroll - 1); return True
        if key == curses.KEY_DOWN:
            self.scroll += 1; return True
        return False

    def on_click(self, row, col, btn):
        for r, bc, bw, idx in getattr(self, '_btns', []):
            if row == r and bc <= col < bc + bw:
                self.choice = idx
                self._answer(idx == 0)
                return True
        return True

    def on_scroll(self, n):
        self.scroll = max(0, self.scroll + n)
        return True


