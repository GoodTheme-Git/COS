class SoundEngine:
    """Synthesizes a WAV set once, then fires them off as detached processes."""

    BACKENDS = [
        ('pw-play',  lambda p, v: ['pw-play', '--volume', f'{v/100:.2f}', p]),
        ('aplay',    lambda p, v: ['aplay', '-q', p]),
        ('ffplay',   lambda p, v: ['ffplay', '-nodisp', '-autoexit',
                                   '-loglevel', 'quiet', '-volume', str(v), p]),
        ('paplay',   lambda p, v: ['paplay', p]),
    ]

    # No sound may repeat faster than this, and no more than BURST_MAX may
    # start inside BURST_WINDOW. A runaway caller should never be able to turn
    # the speakers into a wall of noise.
    REPEAT_GAP = 0.12
    BURST_WINDOW = 1.0
    BURST_MAX = 8

    def __init__(self, state):
        self.state = state
        self.backend = None
        self.builder = None
        self.procs = []
        self.ready = False
        self.note = 'not initialized'
        self._last_played = {}
        self._recent = deque(maxlen=self.BURST_MAX)

    # -- synthesis ----------------------------------------------------------
    def ensure_sounds(self, force=False):
        try:
            os.makedirs(BUILTIN_DIR, exist_ok=True)
        except Exception as e:
            self.note = f'cannot create {BUILTIN_DIR}: {e}'
            return False
        made = 0
        for name, spec in SOUND_SPECS.items():
            path = os.path.join(BUILTIN_DIR, name + '.wav')
            if force or not os.path.exists(path):
                try:
                    data = _render(spec)
                    with wave.open(path, 'wb') as w:
                        w.setnchannels(1)
                        w.setsampwidth(2)
                        w.setframerate(RATE)
                        w.writeframes(data.tobytes())
                    made += 1
                except Exception as e:
                    self.note = f'synth failed for {name}: {e}'
                    return False
        if made:
            self.note = f'synthesized {made} sound(s)'
        return True

    # -- backend selection --------------------------------------------------
    def pick_backend(self):
        probe = find_sound_file('key')
        if not probe:
            return False
        for name, builder in self.BACKENDS:
            if not _which(name):
                continue
            try:
                r = subprocess.run(builder(probe, 10), timeout=2.5,
                                   stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL)
                if r.returncode == 0:
                    self.backend, self.builder = name, builder
                    self.note = f'backend: {name}'
                    self.ready = True
                    return True
            except Exception:
                continue
        self.note = 'no working audio backend (tried pw-play/aplay/ffplay)'
        return False

    def init(self):
        if self.ensure_sounds():
            self.pick_backend()
        return self.ready

    # -- playback -----------------------------------------------------------
    def play(self, name):
        if SILENT or not (self.ready and self.state.get('sound_on', True)):
            return
        path = find_sound_file(name)
        if not path:
            return
        now = time.monotonic()
        if now - self._last_played.get(name, 0.0) < self.REPEAT_GAP:
            return
        if (len(self._recent) == self.BURST_MAX
                and now - self._recent[0] < self.BURST_WINDOW):
            return
        vol = int(self.state.get('sound_volume', 70))
        try:
            self.procs = [p for p in self.procs if p.poll() is None]
            if len(self.procs) > 6:          # don't let blips pile up
                return
            self._last_played[name] = now
            self._recent.append(now)
            self.procs.append(subprocess.Popen(
                self.builder(path, vol),
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                stdin=subprocess.DEVNULL, start_new_session=True))
        except Exception:
            pass

    def play_blocking(self, name, timeout=3):
        if SILENT:
            return
        path = find_sound_file(name)
        if not (self.ready and path):
            return
        try:
            subprocess.run(self.builder(path, int(self.state.get('sound_volume', 70))),
                           timeout=timeout, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
        except Exception:
            pass

    def shutdown(self):
        for p in self.procs:
            try:
                p.terminate()
            except Exception:
                pass
        for p in self.procs:
            try:
                p.wait(timeout=0.4)     # reap, so no zombies are left behind
            except Exception:
                pass
        self.procs = []


def _which(prog):
    for d in os.environ.get('PATH', '/usr/bin:/bin').split(':'):
        f = os.path.join(d, prog)
        if os.path.isfile(f) and os.access(f, os.X_OK):
            return f
    return None


# =============================================================================
# CELL ART  --  rendering pictures and video into character cells
# =============================================================================
# Approximate sRGB of the Linux console palette, normal and bold.
CONSOLE_RGB = [(0, 0, 0), (170, 0, 0), (0, 170, 0), (170, 85, 0),
               (0, 0, 170), (170, 0, 170), (0, 170, 170), (170, 170, 170)]
BRIGHT_RGB = [(85, 85, 85), (255, 85, 85), (85, 255, 85), (255, 255, 85),
              (85, 85, 255), (255, 85, 255), (85, 255, 255), (255, 255, 255)]

# Glyphs ordered by how much of the cell they ink in, on a typical 8x16
# console font. Plain ASCII only: ACS line-drawing cannot go in an addstr.
RAMP = ' .:;+*%#@M'
RAMP_COVER = (0.00, 0.07, 0.14, 0.20, 0.28, 0.36, 0.46, 0.60, 0.74, 0.86)

PALETTE_CACHE = os.path.join(COS_HOME, 'palette.cache')


class CellArt:
    """Maps RGB pixels onto (colour pair, glyph, bold) triples.

    Each cell blends its background and foreground colour in the proportion
    the glyph inks, so a pair of colours plus a density ramp yields far more
    tones than the eight the console actually has.
    """

    def __init__(self):
        self.tones = []          # (rgb, pair_offset, glyph_index, bold, swap)
        self.cache = {}          # (r>>4, g>>4, b>>4) -> (pair_off, gi, bold, swap)
        self._build()
        self._load_cache()

    def _build(self):
        for pi, (a, b) in enumerate(MEDIA_COMBOS):
            for bold in (False, True):
                for swap in (False, True):
                    # pair pi paints fg=b on bg=a; swap uses the ramp from the
                    # other end, which is the same thing as exchanging them.
                    fg = (BRIGHT_RGB if bold else CONSOLE_RGB)[a if swap else b]
                    bg = CONSOLE_RGB[b if swap else a]
                    for gi, cover in enumerate(RAMP_COVER):
                        rgb = (bg[0] + (fg[0] - bg[0]) * cover,
                               bg[1] + (fg[1] - bg[1]) * cover,
                               bg[2] + (fg[2] - bg[2]) * cover)
                        self.tones.append((rgb, pi, gi, bold, swap))

    # -- nearest-tone lookup, filled on demand -------------------------------
    def lookup(self, r, g, b):
        key = (r >> 4, g >> 4, b >> 4)
        hit = self.cache.get(key)
        if hit is not None:
            return hit
        tr, tg, tb = (key[0] << 4) + 8, (key[1] << 4) + 8, (key[2] << 4) + 8
        best = None
        bd = 1e18
        for rgb, pi, gi, bold, swap in self.tones:
            dr = rgb[0] - tr
            dg = rgb[1] - tg
            db = rgb[2] - tb
            # luma-weighted, so brightness errors matter more than hue
            d = dr * dr * 0.30 + dg * dg * 0.59 + db * db * 0.11
            if d < bd:
                bd = d
                best = (pi, gi, bold, swap)
        self.cache[key] = best
        return best

    @staticmethod
    def tone_rgb(pi, gi, bold, swap):
        a, b = MEDIA_COMBOS[pi]
        fg = (BRIGHT_RGB if bold else CONSOLE_RGB)[a if swap else b]
        bg = CONSOLE_RGB[b if swap else a]
        cover = RAMP_COVER[gi]
        return (bg[0] + (fg[0] - bg[0]) * cover,
                bg[1] + (fg[1] - bg[1]) * cover,
                bg[2] + (fg[2] - bg[2]) * cover)

    def to_cells(self, data, cols, rows, dither=False):
        """Convert rgb24 pixels to 3 bytes per cell: pair, glyph, flags.

        Doing the colour search once and keeping the result means a
        pre-rendered video costs nothing per frame but the drawing itself.
        With `dither` the quantisation error is diffused into the
        neighbouring cells (Floyd-Steinberg), which matters a lot when the
        palette is only eight colours wide.
        """
        need = cols * rows * 3
        if not data or len(data) < need:
            return b''
        out = bytearray(need)
        if not dither:
            look = self.lookup
            for i in range(0, need, 3):
                pi, gi, bold, swap = look(data[i], data[i + 1], data[i + 2])
                out[i] = pi
                out[i + 1] = gi
                out[i + 2] = (1 if bold else 0) | (2 if swap else 0)
            return bytes(out)
        # error-diffusing path: keep one row of forward error plus the next
        cur = [0.0] * (cols * 3 + 6)
        nxt = [0.0] * (cols * 3 + 6)
        look = self.lookup
        tone = self.tone_rgb
        for y in range(rows):
            base = y * cols * 3
            for x in range(cols):
                i = base + x * 3
                k = x * 3
                r = data[i] + cur[k]
                g = data[i + 1] + cur[k + 1]
                b = data[i + 2] + cur[k + 2]
                rc = 0 if r < 0 else (255 if r > 255 else int(r))
                gc = 0 if g < 0 else (255 if g > 255 else int(g))
                bc = 0 if b < 0 else (255 if b > 255 else int(b))
                pi, gi, bold, swap = look(rc, gc, bc)
                out[i] = pi
                out[i + 1] = gi
                out[i + 2] = (1 if bold else 0) | (2 if swap else 0)
                ar, ag, ab = tone(pi, gi, bold, swap)
                er, eg, eb = r - ar, g - ag, b - ab
                # 7/16 right, 3/16 below-left, 5/16 below, 1/16 below-right
                cur[k + 3] += er * 0.4375
                cur[k + 4] += eg * 0.4375
                cur[k + 5] += eb * 0.4375
                if x:
                    nxt[k - 3] += er * 0.1875
                    nxt[k - 2] += eg * 0.1875
                    nxt[k - 1] += eb * 0.1875
                nxt[k] += er * 0.3125
                nxt[k + 1] += eg * 0.3125
                nxt[k + 2] += eb * 0.3125
                nxt[k + 3] += er * 0.0625
                nxt[k + 4] += eg * 0.0625
                nxt[k + 5] += eb * 0.0625
            cur, nxt = nxt, cur
            for j in range(len(nxt)):
                nxt[j] = 0.0
        return bytes(out)

    def draw_cells(self, canvas, cells, cols, rows, y0=0, x0=0):
        """Blit pre-converted cell triples, grouping equal attributes."""
        if not cells:
            return
        if len(cells) < cols * rows * 3:
            rows = len(cells) // (cols * 3)
            if rows <= 0:
                return
        ramp = RAMP
        base_pair = MEDIA_PAIR_BASE
        for y in range(rows):
            base = y * cols * 3
            run_attr = None
            run = []
            run_start = 0
            for x in range(cols):
                i = base + x * 3
                flags = cells[i + 2]
                attr = curses.color_pair(base_pair + cells[i])
                if flags & 1:
                    attr |= curses.A_BOLD
                if flags & 2:
                    attr |= curses.A_REVERSE
                ch = ramp[cells[i + 1]]
                if attr != run_attr:
                    if run:
                        canvas.put(y0 + y, x0 + run_start, ''.join(run), run_attr)
                    run_attr, run, run_start = attr, [ch], x
                else:
                    run.append(ch)
            if run:
                canvas.put(y0 + y, x0 + run_start, ''.join(run), run_attr)

    def _load_cache(self):
        try:
            with open(PALETTE_CACHE, 'rb') as f:
                blob = f.read()
        except OSError:
            return
        if len(blob) % 7 != 0:
            return
        for i in range(0, len(blob), 7):
            k = (blob[i], blob[i + 1], blob[i + 2])
            self.cache[k] = (blob[i + 3], blob[i + 4],
                             bool(blob[i + 5]), bool(blob[i + 6]))

    def save_cache(self):
        if not self.cache:
            return
        try:
            os.makedirs(COS_HOME, exist_ok=True)
            out = bytearray()
            for (a, b, c), (pi, gi, bold, swap) in self.cache.items():
                out += bytes((a, b, c, pi, gi, 1 if bold else 0, 1 if swap else 0))
            with open(PALETTE_CACHE, 'wb') as f:
                f.write(bytes(out))
        except Exception:
            pass

    # -- drawing -------------------------------------------------------------
    def draw(self, canvas, data, cols, rows, y0=0, x0=0, mono=False,
             dither=False):
        """Blit rgb24 `data` (cols*rows*3 bytes) into a Canvas."""
        if not data or cols <= 0 or rows <= 0:
            return
        if not mono:
            cells = self.to_cells(data, cols, rows, dither=dither)
            self.draw_cells(canvas, cells, cols, rows, y0, x0)
            return
        need = cols * rows * 3
        if len(data) < need:
            rows = len(data) // (cols * 3)
            if rows <= 0:
                return
        for y in range(rows):
            base = y * cols * 3
            run_attr = None
            run_chars = []
            run_start = 0
            for x in range(cols):
                i = base + x * 3
                r, g, b = data[i], data[i + 1], data[i + 2]
                if mono:
                    lum = (r * 30 + g * 59 + b * 11) // 100
                    gi = min(len(RAMP) - 1, lum * len(RAMP) // 256)
                    attr = cp(CP_TEXT, bold=(lum > 170))
                    ch = RAMP[gi]
                else:
                    pi, gi, bold, swap = self.lookup(r, g, b)
                    attr = curses.color_pair(MEDIA_PAIR_BASE + pi)
                    if bold:
                        attr |= curses.A_BOLD
                    if swap:
                        attr |= curses.A_REVERSE
                    ch = RAMP[gi]
                if attr != run_attr:
                    if run_chars:
                        canvas.put(y0 + y, x0 + run_start, ''.join(run_chars),
                                   run_attr)
                    run_attr = attr
                    run_chars = [ch]
                    run_start = x
                else:
                    run_chars.append(ch)
            if run_chars:
                canvas.put(y0 + y, x0 + run_start, ''.join(run_chars), run_attr)


_CELL_ART = None


def cell_art():
    global _CELL_ART
    if _CELL_ART is None:
        _CELL_ART = CellArt()
    return _CELL_ART


# A console cell is usually twice as tall as it is wide, but that depends
# entirely on the loaded font: an 8x8 VGA font is square, Terminus 12x6 is
# 2:1, DejaVu 59x32 is nearly 2:1 the other way. Getting it wrong squashes
# or stretches every picture, so measure it when we can.
CELL_ASPECT = 2.0
CELL_ASPECT_CHOICES = ['auto', '1.0', '1.25', '1.5', '2.0', '2.5']


def screen_pixels():
    """Panel size in pixels, from sysfs (world readable), or None."""
    for path in ('/sys/class/graphics/fb0/virtual_size',):
        try:
            with open(path) as f:
                w, _, h = f.read().strip().partition(',')
            return int(w), int(h)
        except Exception:
            continue
    return None


def detect_cell_aspect(cols, rows):
    """How many times taller than wide one cell is, measured."""
    px = screen_pixels()
    if not px or cols <= 0 or rows <= 0:
        return None
    pw, ph = px
    cw = pw / cols
    ch = ph / rows
    if cw <= 0.5:
        return None
    a = ch / cw
    return a if 0.4 <= a <= 4.0 else None


def cell_aspect_value(state):
    choice = str(state.get('cell_aspect', 'auto'))
    if choice != 'auto':
        try:
            return max(0.4, min(4.0, float(choice)))
        except ValueError:
            pass
    return float(state.get('_cell_aspect_detected') or CELL_ASPECT)


def fit_cells(img_w, img_h, max_cols, max_rows, mode='fit', aspect=None):
    """Pick a cell grid that preserves the picture's aspect ratio."""
    if img_w <= 0 or img_h <= 0 or max_cols <= 0 or max_rows <= 0:
        return max(1, max_cols), max(1, max_rows)
    if mode == 'stretch':
        return max(1, max_cols), max(1, max_rows)
    cell = float(aspect or CELL_ASPECT)
    aspect = img_w / img_h
    cols = max_cols
    rows = int(round(cols / (aspect * cell)))
    if mode == 'fit' and rows > max_rows:
        rows = max_rows
        cols = int(round(rows * aspect * cell))
    elif mode == 'fill' and rows < max_rows:
        rows = max_rows
        cols = int(round(rows * aspect * cell))
    return max(1, min(cols, max_cols)), max(1, min(rows, max_rows))


