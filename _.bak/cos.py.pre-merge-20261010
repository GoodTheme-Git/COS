SHARE_DEFAULT_PORT = 8420
_HASH_CACHE = {}


def file_sha256(path, size, mtime):
    """Hash a file, remembered by (size, mtime) so manifests are cheap."""
    key = (path, size, int(mtime))
    hit = _HASH_CACHE.get(key)
    if hit:
        return hit
    h = hashlib.sha256()
    try:
        with open(path, 'rb') as f:
            for chunk in iter(lambda: f.read(262144), b''):
                h.update(chunk)
    except OSError:
        return ''
    digest = h.hexdigest()
    _HASH_CACHE[key] = digest
    if len(_HASH_CACHE) > 4000:
        _HASH_CACHE.clear()
        _HASH_CACHE[key] = digest
    return digest


# Never worth carrying across the network: editor leftovers, caches, and the
# timestamped backups COS itself writes before patching.
SHARE_SKIP_DIRS = {'__pycache__', 'node_modules', 'venv', '.git', 'build',
                   'dist', '.mypy_cache', '.pytest_cache'}
SHARE_SKIP_SUFFIX = ('~', '.pyc', '.pyo', '.swp', '.swo', '.tmp', '.temp',
                     '.save', '.orig', '.rej', '.lock')


def skipped_name(name):
    low = name.lower()
    if low.endswith(SHARE_SKIP_SUFFIX):
        return True
    # cos(10).py.bak-204430 and friends
    return '.bak' in low


def hidden_path(rel):
    """True for anything we refuse to serve: dotfiles, caches, backups."""
    parts = [p for p in rel.replace(os.sep, '/').split('/') if p]
    for i, part in enumerate(parts):
        if part.startswith('.'):
            return True
        if part in SHARE_SKIP_DIRS:
            return True
        if i == len(parts) - 1 and skipped_name(part):
            return True
    return False


def file_manifest(root, max_files=3000, max_mb=512):
    """[(relative path, size, mtime, sha256)] for everything under root."""
    root = os.path.abspath(root)
    out = []
    budget = max_mb * 1_000_000
    for base, dirs, files in os.walk(root):
        dirs[:] = sorted(d for d in dirs
                         if not d.startswith('.') and d not in SHARE_SKIP_DIRS)
        for name in sorted(files):
            if name.startswith('.') or skipped_name(name):
                continue
            full = os.path.join(base, name)
            rel = os.path.relpath(full, root).replace(os.sep, '/')
            try:
                st = os.stat(full)
            except OSError:
                continue
            if not stat_is_regular(st):
                continue
            digest = file_sha256(full, st.st_size, st.st_mtime) if st.st_size <= budget else ''
            out.append((rel, st.st_size, st.st_mtime, digest))
            if len(out) >= max_files:
                return out
    return out


def stat_is_regular(st):
    import stat as _st
    return _st.S_ISREG(st.st_mode)


def local_addresses():
    """Every address this machine answers on, best guess first."""
    addrs = []
    try:
        out = subprocess.run(['ip', '-brief', '-4', 'addr'], capture_output=True,
                             text=True, timeout=4).stdout
        for line in out.splitlines():
            parts = line.split()
            if len(parts) >= 3 and parts[0] != 'lo':
                for tok in parts[2:]:
                    ip = tok.split('/')[0]
                    if ip and not ip.startswith('127.'):
                        addrs.append(ip)
    except Exception:
        pass
    if not addrs:
        try:
            sk = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            sk.connect(('8.8.8.8', 80))
            addrs.append(sk.getsockname()[0])
            sk.close()
        except Exception:
            pass
    return addrs or ['127.0.0.1']


def firewall_blocking(port):
    """Is this port reachable from the network?

    Returns 'open', 'blocked', 'maybe' (a firewall is up but its rules need
    root to read, so assume the worst and say so), or '' for no firewall.
    """
    if not _which('ufw'):
        return ''
    text = ''
    for cmd in (['ufw', 'status'], ['sudo', '-n', 'ufw', 'status']):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
            if r.returncode == 0 and r.stdout.strip():
                text = r.stdout
                break
        except Exception:
            continue
    if text:
        if 'inactive' in text.lower():
            return 'open'
        return 'open' if str(port) in text else 'blocked'
    # Reading the rules needs root. Fall back to whether ufw is even running:
    # if it is, the port is probably blocked and saying nothing would leave
    # the user staring at a connection that just times out.
    try:
        r = subprocess.run(['systemctl', 'is-active', 'ufw'],
                           capture_output=True, text=True, timeout=5)
        if r.stdout.strip() == 'active':
            return 'maybe'
    except Exception:
        pass
    return ''


