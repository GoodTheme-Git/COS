    curses.init_pair(CP_PROG,    curses.COLOR_BLACK, curses.COLOR_CYAN)

def ss(win, y, x, s, a=0):
    try: win.addstr(y, x, s, a)
    except curses.error: pass

# ── Layout helpers ────────────────────────────────────────────────────────────
def draw_bg(stdscr, title='COS Setup'):
    H, W = stdscr.getmaxyx()
    stdscr.bkgd(' ', curses.color_pair(CP_BG))
    stdscr.clear()
    # top title bar
    ss(stdscr, 0, 0, ' ' * W, curses.color_pair(CP_TITLE))
    t = f'  COS - Channel Operating System Setup  |  {title}'
    ss(stdscr, 0, 0, t[:W], curses.color_pair(CP_TITLE) | curses.A_BOLD)
    # bottom hint bar
    ss(stdscr, H-1, 0, ' ' * W, curses.color_pair(CP_HINT))
    hint = '  Tab/Arrows=navigate   Enter=select   Space=toggle   ESC=back'
    ss(stdscr, H-1, 0, hint[:W], curses.color_pair(CP_HINT))
    if _STEP[1]:
        draw_progress(stdscr, *_STEP)
    stdscr.refresh()

_STEP = [0, 0]      # (page, pages) shown along the bottom by draw_bg

def make_panel(stdscr, title, h, w, extra_hint=''):
    H, W = stdscr.getmaxyx()
    y = max(1, (H - h) // 2)
    x = max(0, (W - w) // 2)
    try: win = curses.newwin(h, w, y, x)
    except curses.error: return None, y, x
    win.bkgd(' ', curses.color_pair(CP_PANEL))
    win.border()
    t = f' {title} '
    ss(win, 0, max(0, (w - len(t)) // 2), t[:w-2],
       curses.color_pair(CP_PANEL_T) | curses.A_BOLD)
    if extra_hint:
        ss(win, h-1, max(0, (w - len(extra_hint)) // 2),
           extra_hint[:w-2], curses.color_pair(CP_HINT))
    return win, y, x

def draw_progress(stdscr, step, total):
    H, W = stdscr.getmaxyx()
    pct = step / total
    bar_w = W - 24
    filled = int(bar_w * pct)
    ss(stdscr, H-2, 2,
       f' Step {step}/{total}  [{"#"*filled}{"."*(bar_w-filled)}] {int(pct*100):>3}% ',
       curses.color_pair(CP_PROG))

def draw_buttons(win, h, w, buttons, sel):
    """Draw [  OK  ] [Cancel] style buttons."""
    total_w = sum(len(b)+4 for b in buttons) + len(buttons)-1
    x = (w - total_w) // 2
    y = h - 2
    for i, btn in enumerate(buttons):
        label = f'  {btn}  '
        a = curses.color_pair(CP_BTN_SEL)|curses.A_BOLD if i==sel \
            else curses.color_pair(CP_BTN)
        ss(win, y, x, f'[{label}]', a)
        x += len(label) + 2 + 1

def input_field(win, y, x, w, value, active):
    a = curses.color_pair(CP_INPUT_A) if active else curses.color_pair(CP_INPUT)
    display = value + ('_' if active else '')
    ss(win, y, x, ' ' * w, a)
    ss(win, y, x, display[:w], a)


